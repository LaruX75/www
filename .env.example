# Canva Content Pipeline — vaadittavat ympäristömuuttujat.
# Kopioi tämä nimelle .env ja täytä arvot. .env on gitignoressa.
#
# Canva Connect API — luo integraatio osoitteessa:
#   https://www.canva.dev/docs/connect/appendix/quickstart/
#   → Register your integration
# Ohjelmallinen käyttö vaatii Refresh Tokenin (Authorization Code -flow).
# Toteuta OAuth-käynnistys erikseen jos tarvitset uuden refreshin.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=

# Anthropic API — vaihe 3 (enrichment). Ei tarvita vaiheessa 1 tai 2.
ANTHROPIC_API_KEY=
