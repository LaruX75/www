---
layout: base.njk
title: Kouluttaja, puhuja ja vaikuttaja
description: "Jari Laru kouluttaa tekoälystä ja oppimisteknologiasta, puhuu koulutuksen tulevaisuudesta sekä vaikuttaa tutkimuksessa, mediassa ja Oulun päätöksenteossa."
lang: fi
translationKey: home
pageStyles:
  - /css/modules/_home.css
  - /css/home-page.css
---

{% set uniquePresentationKeys = [] %}
{% for item in ((canva and canva.tableRows) or []) %}
  {% set key = ((item.sourceUrl or item.url or item.pageUrl or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in (collections.presentations or []) %}
  {% set key = ((((item.data and (item.data.sourceUrl or item.data.url or item.url)) or "") ~ "|" ~ ((item.data and item.data.title) or ""))) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in ((finnaAoe and finnaAoe.rows) or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in (googleslides or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in ((youtube and youtube.tableRows) or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% set heroPresentationCount = uniquePresentationKeys | length %}
{% set heroPublicationCount = (researchfi or []) | length %}
{% set heroOpinionCount = (collections.pub_mielipide or []) | length %}
{% set heroSpeechCount = (collections.pub_puhe or []) | length %}
{% set heroStatementItems = [] %}
{% for item in (collections.publications or []) %}
    {% if item.data.type == "lausunto" %}
        {% set _ = (heroStatementItems.push(item), null) %}
    {% endif %}
{% endfor %}
{% set heroStatementCount = heroStatementItems | length %}
{% set heroMediaCount = ((mediaArchive and mediaArchive.all) or []) | length %}
{% set heroRoles = [
    { label: "Kouluttaja (Larux t:mi)", href: "/kouluttaja/" },
    { label: "Kuntapäättäjä", href: "/politiikka/" },
    { label: "Yliopistonlehtori", href: "/tyoni-yliopistonlehtorina/" }
] %}
{% set homeCopy = {
    heroTitle: "Kouluttaja, puhuja ja vaikuttaja koulutuksen tulevaisuuden puolesta.",
    heroLead: "Etsitkö koulutusta, puheenvuoroa tai taustaa tekoälylukutaidosta, oppimisesta ja teknologian järkevästä käytöstä? Tältä sivustolta löydät Jari Larun työn, kirjoitukset, mediaosumat ja päätöksentekoon liittyvät aineistot.",
    heroPanelText: "Luvut näyttävät, missä Jari Larun työ on ollut esillä: koulutuksissa, esityksissä, tutkimuksessa, lausunnoissa, mediassa, opinnäytteiden ohjauksessa ja poliittisissa puheenvuoroissa.",
    pathsTitle: "Mitä etsit?",
    pathsLead: "Valitse aloituskohta sen mukaan, etsitkö ammatillista taustaa, kirjoituksia ja puheenvuoroja, mediaosumia vai poliittista työtä.",
    focusTitle: "Koulutukset, puheenvuorot ja sparraus",
    focusLead: "Jari Larun käytännön työ näkyy koulutuksina, keynote-puheenvuoroina ja kehittämisen tukena. Tutkimus ja kunnallinen päätöksenteko tuovat siihen taustaa.",
    recentTitle: "Viimeksi esillä",
    recentLead: "Kirjoituksista, esityksistä, lausunnoista ja mediaosumista näet, mitä Jari Larun eri rooleissa on viimeksi tapahtunut."
} %}
{% set heroStats = [
    { count: heroPresentationCount, label: "Esitystä tai oppimateriaalia", href: "/esitykset/" },
    { count: heroPublicationCount, label: "tieteellistä julkaisua", href: "/julkaisut/" },
    { count: heroStatementCount, label: "asiantuntijalausuntoa", href: "/lausunnot/#lausunnot" },
    { count: heroMediaCount, label: "mediaosumaa", href: "/mediassa/" },
    { count: heroSpeechCount, label: "puheenvuoroa", href: "/valtuustotyo/#puheet" },
    { count: theses.stats.total, label: "ohjattua opinnäytettä", href: "/opinnaytteet/" }
] %}

<section class="section-flush home-hero-section" id="heroSection">
    <div class="home-hero-backdrop" style="--hero-img: url('{{ '/img/WIN_20210329_16_06_01_Pro.jpg' | url }}')">
        <div class="container home-hero-content">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-7">
                    <p class="home-hero-eyebrow mb-2">{{ pageContent.etusivu.hero.eyebrow }}</p>
                    <h1 class="home-hero-title mb-3">{{ homeCopy.heroTitle }}</h1>
                    <p class="home-hero-lead mb-4">{{ homeCopy.heroLead }}</p>
                    <div class="home-hero-roles mb-4">
                        {% for role in heroRoles %}
                        <a class="home-hero-role-item" href="{{ role.href }}">{{ role.label }}</a>
                        {% endfor %}
                    </div>
                    <div class="home-hero-actions">
                        <a class="btn btn-primary rounded-pill px-4" href="{{ pageContent.etusivu.intro.cta1.href }}">{{ pageContent.etusivu.intro.cta1.label }}</a>
                        <a class="btn btn-outline-secondary rounded-pill px-4 home-hero-btn-secondary" href="/politiikka/">Politiikka</a>
                        <a class="home-hero-link" href="{{ pageContent.etusivu.intro.cta2.href }}">{{ pageContent.etusivu.intro.cta2.label }}</a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="home-hero-panel">
                        <p class="home-hero-panel-kicker">Näyttöä eri rooleista</p>
                        <p class="home-hero-panel-text">{{ homeCopy.heroPanelText }}</p>
                        <dl class="home-hero-kpi-grid mb-0">
                            {% for stat in heroStats | sort(true, false, "count") %}
                            <div class="home-hero-kpi">
                                <dd class="home-hero-kpi-value"><a class="home-hero-kpi-link" href="{{ stat.href }}">{{ stat.count }}</a></dd>
                                <dt class="home-hero-kpi-label">{{ stat.label }}</dt>
                            </div>
                            {% endfor %}
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="home-hero-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,30 C240,60 480,0 720,30 C960,60 1200,0 1440,30 L1440,60 L0,60 Z"/>
        </svg>
    </div>
</section>

{% set featuredPresentationRows = (canva.fiRows or canva.tableRows or []) | take(3) %}
{% set recentAcademicPosts = (collections.blogAcademic or []) | take(2) %}
{% set recentPoliticsItems = [] %}
{% for post in collections.politicsAndOpinions %}
    {% if post.fileSlug != "etusivu" and recentPoliticsItems.length < 2 %}
        {% set _ = (recentPoliticsItems.push(post), null) %}
    {% endif %}
{% endfor %}
{% set featuredPublications = (researchfi or []).slice(0, 2) %}
{% set featuredRecentWritingItems = [] %}
{% for item in (collections.writing_expert or []) | sort(true, false, "date") %}
    {% if item.data.type != "lausunto" and item.data.type != "puhe" and item.data.title %}
        {% set _ = (featuredRecentWritingItems.push(item), null) %}
    {% endif %}
{% endfor %}
{% set featuredRecentPost = featuredRecentWritingItems[0] or (collections.blog or [])[0] %}
{% set featuredRecentPresentation = ((canva.fiRows or canva.tableRows or [])[0]) %}
{% set featuredRecentStatement = heroStatementItems[0] %}
{% set featuredRecentMedia = ((mediaArchive and mediaArchive.all) or [])[0] %}

{% set topicProfileKeys = ["tekoalylukutaito", "opettajankoulutus", "julkinen-asiantuntijuus-mediassa"] %}
{% set topicProfileTitleId = "home-topic-profiles-title" %}
{% set topicProfileEyebrow = "Teemat" %}
{% set topicProfileTitle = "Keskeiset asiantuntijateemat" %}
{% set topicProfileLead = "Jos etsit tiettyä aihetta, näiltä sivuilta löydät samaan teemaan liittyvät kirjoitukset, lausunnot, esitykset, mediaosumat ja tutkimusnäytön." %}

<section class="py-5 home-paths-section" id="aloita">
    <div class="site-shell">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">{{ pageContent.etusivu.paths.sectionLabel }}</p>
            <h2 class="home-section-title">{{ homeCopy.pathsTitle }}</h2>
            <p class="home-section-lead mb-0">{{ homeCopy.pathsLead }}</p>
        </div>
        <div class="home-paths-grid">
            {% for card in pageContent.etusivu.paths.cards %}
            <a href="{{ card.href }}" class="home-path-card{% if loop.first %} home-path-card--primary{% endif %}">
                <span class="home-path-card-icon"><i class="bi {{ card.icon }}"></i></span>
                <p class="home-path-card-kicker">{{ card.title }}</p>
                <p class="home-path-card-text">{{ card.desc }}</p>
                <span class="home-path-card-cta">{{ card.cta }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

<section class="home-university-mission-section pb-5">
    <div class="site-shell">
        <div class="home-university-mission">
            <div>
                <p class="home-section-kicker mb-1">Yliopistotyö</p>
                <h2 class="h3 mb-2">Tutkimus, opetus ja yhteiskunnallinen vuorovaikutus</h2>
                <p class="home-impact-statement mb-2">Tutkimuksesta opetukseen, työkaluihin ja päätöksentekoon.</p>
                <p class="mb-0 text-muted">Jari Laru tekee oppimisen, teknologian ja tekoälyn tutkimuksesta ymmärrettävää ja käyttökelpoista. Työ näkyy opettajankoulutuksessa, materiaaleissa, täydennyskoulutuksissa, lausunnoissa ja julkisessa keskustelussa.</p>
                <div class="home-impact-grid" aria-label="Mitä työstä syntyy">
                    <div>
                        <span>Koulutus</span>
                        <p>Opettajankoulutus ja täydennyskoulutukset vievät tutkimusta opettajien ja organisaatioiden arkeen.</p>
                    </div>
                    <div>
                        <span>Osaaminen</span>
                        <p>Tekoälylukutaito, digipedagogiikka ja teknologian ymmärtävä käyttö vahvistuvat käytännön kautta.</p>
                    </div>
                    <div>
                        <span>Materiaalit ja työkalut</span>
                        <p>Avoimet esitykset, oppimateriaalit ja kokeiluympäristöt tekevät ilmiöistä käsiteltäviä.</p>
                    </div>
                    <div>
                        <span>Päätöksenteko ja julkinen keskustelu</span>
                        <p>Lausunnot, media ja luottamustehtävät tuovat tutkimusperustaisia näkökulmia koulutuksen kehittämiseen ja päätöksentekoon.</p>
                    </div>
                </div>
            </div>
            <div class="home-university-mission-links">
                <a href="/tutkimus/">Tutkimus</a>
                <a href="/portfolio/">Opetus</a>
                <a href="/yhteiskunnallinen-vuorovaikutus/">Vuorovaikutus</a>
            </div>
        </div>
    </div>
</section>

<section class="py-5 home-recent-section" id="ajankohtaista" data-home-mobile-priority="2">
    <div class="site-shell">
        <details class="home-mobile-disclosure" data-home-mobile-collapse open>
            <summary class="home-mobile-disclosure-summary">
                <span>{{ homeCopy.recentTitle }}</span>
                <small>Kirjoitukset, esitykset, lausunnot ja mediaosumat</small>
            </summary>
            <div class="home-mobile-disclosure-body">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">Kirjoitukset ja esiintymiset</p>
            <h2 class="home-section-title">{{ homeCopy.recentTitle }}</h2>
            <p class="home-section-lead mb-0">{{ homeCopy.recentLead }}</p>
        </div>
        <div class="home-recent-editorial">
            <article class="home-recent-card">
                {% set featuredRecentPostRoleFlags = [] %}
                {% if featuredRecentPost and featuredRecentPost.data.opinionRoles %}
                    {% for role in featuredRecentPost.data.opinionRoles %}
                        {% set _ = (featuredRecentPostRoleFlags.push(role), null) %}
                    {% endfor %}
                {% elif featuredRecentPost and featuredRecentPost.data.writingRoles %}
                    {% for role in featuredRecentPost.data.writingRoles %}
                        {% set _ = (featuredRecentPostRoleFlags.push(role), null) %}
                    {% endfor %}
                {% endif %}
                <p class="home-recent-card-kicker">{% if featuredRecentPostRoleFlags.indexOf("political") != -1 and featuredRecentPostRoleFlags.indexOf("expert") != -1 %}Asiantuntija + politiikka{% else %}Asiantuntijakirjoitus{% endif %}</p>
                {% if featuredRecentPost %}
                <h3 class="home-recent-card-title"><a href="{{ featuredRecentPost.url }}">{{ featuredRecentPost.data.title | truncate(76) }}</a></h3>
                <p class="home-recent-card-meta">{{ featuredRecentPost.date | dateFormat }}</p>
                {% if featuredRecentPost.data.description %}
                <p class="home-recent-card-text">{{ featuredRecentPost.data.description | truncate(180) }}</p>
                {% endif %}
                <a href="/blogi/" class="home-recent-card-link">Kaikki kirjoitukset</a>
                {% endif %}
            </article>

            <article class="home-recent-card">
                <p class="home-recent-card-kicker">Esitys</p>
                {% if featuredRecentPresentation %}
                <h3 class="home-recent-card-title"><a href="{{ featuredRecentPresentation.url }}" target="_blank" rel="noopener noreferrer">{{ featuredRecentPresentation.title | truncate(76) }}</a></h3>
                <p class="home-recent-card-meta">{{ featuredRecentPresentation.date | dateFormat }}{% if featuredRecentPresentation.location %} · {{ featuredRecentPresentation.location }}{% endif %}</p>
                <p class="home-recent-card-text">Nosto koulutuksesta tai puheenvuorosta, jossa käsitellään tekoälyä, oppimista tai koulun arkea.</p>
                <a href="/esitykset/" class="home-recent-card-link">Kaikki esitykset</a>
                {% endif %}
            </article>

            <article class="home-recent-card">
                <p class="home-recent-card-kicker">Lausunto</p>
                {% if featuredRecentStatement %}
                <h3 class="home-recent-card-title"><a href="{{ featuredRecentStatement.url }}">{{ featuredRecentStatement.data.title | truncate(76) }}</a></h3>
                <p class="home-recent-card-meta">{{ featuredRecentStatement.date | dateFormat }}{% if featuredRecentStatement.data.subtitle %} · {{ featuredRecentStatement.data.subtitle }}{% endif %}</p>
                {% if featuredRecentStatement.data.description %}
                <p class="home-recent-card-text">{{ featuredRecentStatement.data.description | truncate(180) }}</p>
                {% else %}
                <p class="home-recent-card-text">Asiantuntijalausunto opetuksen, tekoälyn tai koulutuksen valmistelun tueksi.</p>
                {% endif %}
                <a href="/lausunnot/#lausunnot" class="home-recent-card-link">Kaikki lausunnot</a>
                {% endif %}
            </article>

            <article class="home-recent-card">
                <p class="home-recent-card-kicker">Mediassa</p>
                {% if featuredRecentMedia %}
                <h3 class="home-recent-card-title"><a href="{{ featuredRecentMedia.url }}">{{ featuredRecentMedia.data.title | truncate(76) }}</a></h3>
                <p class="home-recent-card-meta">{{ featuredRecentMedia.date | dateFormat }}{% if featuredRecentMedia.data.mediaOutlet %} · {{ featuredRecentMedia.data.mediaOutlet }}{% endif %}</p>
                {% if featuredRecentMedia.data.description %}
                <p class="home-recent-card-text">{{ featuredRecentMedia.data.description | truncate(180) }}</p>
                {% else %}
                <p class="home-recent-card-text">Haastattelu, podcast tai muu mediaosuma, jossa Jari Laru on mukana asiantuntijana.</p>
                {% endif %}
                <a href="/mediassa/" class="home-recent-card-link">Kaikki mediaosumat</a>
                {% endif %}
            </article>
        </div>
            </div>
        </details>
    </div>
</section>

{% include "topic-profile-links.njk" %}

<section class="py-5 home-larux-section" id="koulutus">
    <div class="site-shell">
        <div class="home-larux-panel">
            <div>
                <p class="home-section-kicker mb-1">Larux t:mi</p>
                <h2 class="h3 mb-2">Koulutuksia, puheenvuoroja ja sparrausta</h2>
                <p class="mb-0 text-muted">Tarvitsetko tekoälyn, oppimisteknologian tai pedagogiikan asiantuntijaa tilaisuuteen, koulutukseen tai kehittämistyöhön? Laruxin kautta sovitaan käytännön yhteistyöstä.</p>
            </div>
            <div class="home-larux-actions">
                <a class="btn btn-primary rounded-pill px-4" href="/kouluttaja/">Tutustu Laruxin palveluihin</a>
                <a class="btn btn-outline-secondary rounded-pill px-4" href="/esitykset/">Katso esityksiä ja materiaaleja</a>
            </div>
        </div>
    </div>
</section>

{% set testimonialLang = "fi" %}
{% set testimonialPlacement = "home" %}
{% include "testimonials.njk" %}

<section class="py-5 bg-body-tertiary home-closing-section" id="yhteys">
    <div class="site-shell">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="home-closing-panel text-center">
                    <p class="text-uppercase text-muted fw-bold mb-2">Seuraava askel</p>
                    <h2 class="fw-bold mb-3">{{ pageContent.etusivu.closing.heading }}</h2>
                    <p class="mb-4">{{ pageContent.etusivu.closing.text }}</p>
                    <div class="home-closing-actions d-flex flex-wrap justify-content-center gap-2 mb-3">
                        <a class="btn btn-primary rounded-pill px-4" href="{{ pageContent.etusivu.closing.cta1.href }}">{{ pageContent.etusivu.closing.cta1.label }}</a>
                        <a class="btn btn-outline-secondary rounded-pill px-4" href="{{ pageContent.etusivu.closing.cta2.href }}">{{ pageContent.etusivu.closing.cta2.label }}</a>
                        <a class="btn btn-outline-secondary rounded-pill px-4" href="{{ pageContent.etusivu.closing.cta3.href }}">{{ pageContent.etusivu.closing.cta3.label }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
