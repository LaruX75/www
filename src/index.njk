---
layout: base.njk
title: Kouluttaja, puhuja ja vaikuttaja
description: "Jari Laru kouluttaa tekoälystä ja oppimisteknologiasta, puhuu koulutuksen tulevaisuudesta sekä vaikuttaa tutkimuksessa, mediassa ja Oulun päätöksenteossa."
lang: fi
translationKey: home
pageStyles:
  - /css/modules/_home.css
  - /css/home-page.css
---

{% set uniquePresentationKeys = [] %}
{% for item in ((canva and canva.tableRows) or []) %}
  {% set key = ((item.sourceUrl or item.url or item.pageUrl or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in (collections.presentations or []) %}
  {% set key = ((((item.data and (item.data.sourceUrl or item.data.url or item.url)) or "") ~ "|" ~ ((item.data and item.data.title) or ""))) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in ((finnaAoe and finnaAoe.rows) or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in (googleslides or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in ((youtube and youtube.tableRows) or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (uniquePresentationKeys.indexOf(key) == -1) %}
    {% set _ = (uniquePresentationKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% set heroPresentationCount = uniquePresentationKeys | length %}
{% set heroPublicationCount = (researchfi or []) | length %}
{% set heroOpinionCount = (collections.pub_mielipide or []) | length %}
{% set heroSpeechCount = (collections.pub_puhe or []) | length %}
{% set heroStatementItems = [] %}
{% for item in (collections.publications or []) %}
    {% if item.data.type == "lausunto" %}
        {% set _ = (heroStatementItems.push(item), null) %}
    {% endif %}
{% endfor %}
{% set heroStatementCount = heroStatementItems | length %}
{% set heroMediaCount = ((mediaArchive and mediaArchive.all) or []) | length %}
{% set heroRoles = [
    { label: "Kouluttaja (Larux t:mi)", href: "/kouluttaja/" },
    { label: "Kuntapäättäjä", href: "/politiikka/" },
    { label: "Yliopistonlehtori", href: "/tyoni-yliopistonlehtorina/" }
] %}
{% set homeCopy = {
    heroTitle: "Kouluttaja, puhuja ja vaikuttaja koulutuksen tulevaisuuden puolesta.",
    heroLead: "Etsitkö koulutusta, puheenvuoroa tai taustaa tekoälylukutaidosta, oppimisesta ja teknologian järkevästä käytöstä? Tältä sivustolta löydät Jari Larun työn, kirjoitukset, mediaosumat ja päätöksentekoon liittyvät aineistot.",
    heroPanelText: "Luvut näyttävät, missä Jari Larun työ on ollut esillä: koulutuksissa, esityksissä, tutkimuksessa, lausunnoissa, mediassa, opinnäytteiden ohjauksessa ja poliittisissa puheenvuoroissa.",
    pathsTitle: "Mitä etsit?",
    pathsLead: "Valitse aloituskohta sen mukaan, etsitkö ammatillista taustaa, kirjoituksia ja puheenvuoroja, mediaosumia vai poliittista työtä.",
    focusTitle: "Koulutukset, puheenvuorot ja sparraus",
    focusLead: "Jari Larun käytännön työ näkyy koulutuksina, keynote-puheenvuoroina ja kehittämisen tukena. Tutkimus ja kunnallinen päätöksenteko tuovat siihen taustaa.",
    recentTitle: "Viimeksi esillä",
    recentLead: "Kirjoituksista, esityksistä, lausunnoista ja mediaosumista näet, mitä Jari Larun eri rooleissa on viimeksi tapahtunut."
} %}
{% set heroStats = [
    { count: heroPresentationCount, label: "Esitystä tai oppimateriaalia", href: "/esitykset/" },
    { count: heroPublicationCount, label: "tieteellistä julkaisua", href: "/julkaisut/" },
    { count: heroSpeechCount, label: "puheenvuoroa", href: "/valtuustotyo/#puheet" },
    { count: theses.stats.total, label: "ohjattua opinnäytettä", href: "/opinnaytteet/" }
] %}

<section class="section-flush home-hero-section" id="heroSection">
    <div class="home-hero-backdrop" style="--hero-img: url('{{ '/img/WIN_20210329_16_06_01_Pro.jpg' | url }}')">
        <div class="container home-hero-content">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-7">
                    <p class="home-hero-eyebrow mb-2">{{ pageContent.etusivu.hero.eyebrow }}</p>
                    <h1 class="home-hero-title mb-3">{{ homeCopy.heroTitle }}</h1>
                    <p class="home-hero-lead mb-4">{{ homeCopy.heroLead }}</p>
                    <div class="home-hero-roles mb-4">
                        {% for role in heroRoles %}
                        <a class="home-hero-role-item" href="{{ role.href }}">{{ role.label }}</a>
                        {% endfor %}
                    </div>
                    <div class="home-hero-actions">
                        <a class="btn btn-primary rounded-pill px-4" href="{{ pageContent.etusivu.intro.cta1.href }}">{{ pageContent.etusivu.intro.cta1.label }}</a>
                        <a class="btn btn-outline-secondary rounded-pill px-4 home-hero-btn-secondary" href="/politiikka/">Politiikka</a>
                        <a class="home-hero-link" href="{{ pageContent.etusivu.intro.cta2.href }}">{{ pageContent.etusivu.intro.cta2.label }}</a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="home-hero-panel">
                        <p class="home-hero-panel-kicker">Näyttöä eri rooleista</p>
                        <p class="home-hero-panel-text">{{ homeCopy.heroPanelText }}</p>
                        <dl class="home-hero-kpi-grid mb-0">
                            {% for stat in heroStats | sort(true, false, "count") %}
                            <div class="home-hero-kpi">
                                <dd class="home-hero-kpi-value"><a class="home-hero-kpi-link" href="{{ stat.href }}">{{ stat.count }}</a></dd>
                                <dt class="home-hero-kpi-label">{{ stat.label }}</dt>
                            </div>
                            {% endfor %}
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="home-hero-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,30 C240,60 480,0 720,30 C960,60 1200,0 1440,30 L1440,60 L0,60 Z"/>
        </svg>
    </div>
</section>

{% set heroInitiativeCount = (collections.politics or []) | length %}
{% set trainingMeta = (trainingFeedback and trainingFeedback.meta) or {} %}

{% set roleLatestResearch = (researchfi or [])[0] %}
{% set roleLatestPresentation = ((canva.fiRows or canva.tableRows or [])[0]) %}
{% set roleLatestCouncilSpeech = false %}
{% for item in (collections.pub_puhe or []) | sort(true, false, "date") %}
    {% if not roleLatestCouncilSpeech %}
        {% set speechCtx = item.data.speechContext or "" %}
        {% set forums = item.data.forum or [] %}
        {% set isCouncil = speechCtx == "valtuusto" or speechCtx == "kyselytunti" or item.data.event == "Oulun kaupunginvaltuusto" or forums.indexOf("Kaupunginvaltuusto") != -1 %}
        {% if isCouncil %}
            {% set roleLatestCouncilSpeech = item %}
        {% endif %}
    {% endif %}
{% endfor %}
{% set roleLatestInitiative = ((collections.politics or []) | sort(true, false, "date"))[0] %}
{% set roleLatestPresentationTitle = roleLatestPresentation.title or "" %}

{% set homeRoleTopicSlugs = {
    university: "opettajankoulutus",
    politics: "oulun-palveluverkko-ja-kaupunkikehitys",
    training: "tekoalylukutaito"
} %}

{% set homeTopicSlugs = ["tekoalylukutaito", "opettajankoulutus", "oulun-palveluverkko-ja-kaupunkikehitys", "koulutusteknologia-ja-oppimisymparistot", "julkinen-asiantuntijuus-mediassa", "lapinakyva-paatoksenteko-ja-tiedolla-johtaminen"] %}


<section class="py-5 home-roles-section" id="roolit">
    <div class="site-shell">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">Kolme roolia · yksi jatkumo</p>
            <h2 class="home-section-title">Yliopistonlehtori · Kuntapäättäjä · Kouluttaja</h2>
            <p class="home-section-lead mb-0">Sivuston sisältö rakentuu näiden kolmen roolin ympärille. Kussakin näet ajankohtaisen työn, taustaluvut ja pääsyn syvempään aineistoon.</p>
        </div>

        <div class="home-roles-grid">
            <article class="home-role-card home-role-card--university">
                <p class="home-role-kicker">Yliopistotyö</p>
                <h3 class="home-role-title">Yliopistonlehtori</h3>
                <p class="home-role-subtitle">Teknologiatuetun oppimisen ja opetuksen yliopistonlehtori, KTK-tiedekunta, Oulun yliopisto.</p>
                <dl class="home-role-facts">
                    <div>
                        <dt>tieteellistä julkaisua</dt>
                        <dd>{{ heroPublicationCount }}</dd>
                    </div>
                    <div>
                        <dt>ohjattua opinnäytettä</dt>
                        <dd>{{ theses.stats.total }}</dd>
                    </div>
                </dl>
                <div class="home-role-focus">
                    <p class="home-role-focus-kicker">Ajankohtainen fokus</p>
                    <p class="home-role-focus-text">Generation AI -ohjelma, tekoälylukutaito ja opettajankoulutuksen kehittäminen.</p>
                </div>
                {% if roleLatestResearch %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">Uusin julkaisu</p>
                    <a href="{{ roleLatestResearch.url or '/julkaisut/' }}"{% if roleLatestResearch.url %} target="_blank" rel="noopener noreferrer"{% endif %} class="home-role-latest-link">{{ roleLatestResearch.title | truncate(90) }}</a>
                    {% if roleLatestResearch.year %}<p class="home-role-latest-meta">{{ roleLatestResearch.year }}{% if roleLatestResearch.venue %} · {{ roleLatestResearch.venue | truncate(50) }}{% endif %}</p>{% endif %}
                </div>
                {% endif %}
                <a class="home-role-cta" href="/tyoni-yliopistonlehtorina/">Avaa yliopistotyö <i class="bi bi-arrow-right ms-1"></i></a>
            </article>

            <article class="home-role-card home-role-card--politics">
                <p class="home-role-kicker">Politiikka</p>
                <h3 class="home-role-title">Kuntapäättäjä</h3>
                <p class="home-role-subtitle">Kansallinen Kokoomus · 2. varavaltuutettu, sivistyslautakunnan jäsen, Oulun kaupunki.</p>
                <dl class="home-role-facts">
                    <div>
                        <dt>puheenvuoroa</dt>
                        <dd>{{ heroSpeechCount }}</dd>
                    </div>
                    <div>
                        <dt>valtuustoaloitetta</dt>
                        <dd>{{ heroInitiativeCount }}</dd>
                    </div>
                </dl>
                <div class="home-role-focus">
                    <p class="home-role-focus-kicker">Ajankohtainen fokus</p>
                    <p class="home-role-focus-text">Sivistys ja koulutus, palveluverkko sekä avoin ja tiedolla johdettu päätöksenteko.</p>
                </div>
                {% if roleLatestCouncilSpeech %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">Uusin valtuustopuheenvuoro</p>
                    <a href="{{ roleLatestCouncilSpeech.url }}" class="home-role-latest-link">{{ roleLatestCouncilSpeech.data.title | truncate(90) }}</a>
                    <p class="home-role-latest-meta">{{ roleLatestCouncilSpeech.date | dateFormat }}</p>
                </div>
                {% elif roleLatestInitiative %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">Uusin aloite</p>
                    <a href="{{ roleLatestInitiative.url }}" class="home-role-latest-link">{{ roleLatestInitiative.data.title | truncate(90) }}</a>
                    <p class="home-role-latest-meta">{{ roleLatestInitiative.date | dateFormat }}</p>
                </div>
                {% endif %}
                <a class="home-role-cta" href="/politiikka/">Avaa politiikka <i class="bi bi-arrow-right ms-1"></i></a>
            </article>

            <article class="home-role-card home-role-card--training">
                <p class="home-role-kicker">Larux t:mi</p>
                <h3 class="home-role-title">Kouluttaja</h3>
                <p class="home-role-subtitle">Sivutoimisesti täydennyskoulutuksia ja asiantuntijapuheenvuoroja tekoälystä, oppimisteknologiasta ja modernista pedagogiikasta.</p>
                <dl class="home-role-facts">
                    <div>
                        <dt>vuoden koulutuskooste</dt>
                        <dd>{{ trainingMeta.aikavali or "2017–" }}</dd>
                    </div>
                    <div>
                        <dt>palautekeskiarvo</dt>
                        <dd class="home-role-facts-small">{{ trainingMeta.kainutlaatuinenKeskiarvo or "—" }}</dd>
                    </div>
                </dl>
                <div class="home-role-focus">
                    <p class="home-role-focus-kicker">Ajankohtainen fokus</p>
                    <p class="home-role-focus-text">Tekoäly opetuksessa: käytännön työkalut, kokeilut ja opettajayhteisöjen sparraus.</p>
                </div>
                {% if roleLatestPresentation and roleLatestPresentationTitle %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">Uusin esitys</p>
                    <a href="{{ roleLatestPresentation.url }}" target="_blank" rel="noopener noreferrer" class="home-role-latest-link">{{ roleLatestPresentationTitle | truncate(90) }}</a>
                    {% if roleLatestPresentation.date %}<p class="home-role-latest-meta">{{ roleLatestPresentation.date | dateFormat }}</p>{% endif %}
                </div>
                {% endif %}
                <a class="home-role-cta" href="/kouluttaja/">Avaa kouluttajapalvelut <i class="bi bi-arrow-right ms-1"></i></a>
            </article>
        </div>
    </div>
</section>

{% set timelineYears = [2022, 2023, 2024, 2025, 2026] %}
{% set timelineRows = collections | homepageTimeline(researchfi, (canva.fiRows or canva.tableRows or []), timelineYears) %}

<section class="py-5 home-timeline-section" id="aikajana">
    <div class="site-shell">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">Viimeiset viisi vuotta</p>
            <h2 class="home-section-title">Työn jatkumo julkaisuina, puheenvuoroina ja esityksinä</h2>
            <p class="home-section-lead mb-0">Aikajana näyttää vuosittain tieteelliset julkaisut, valtuustopuheenvuorot ja täydennyskoulutus-/asiantuntijaesitykset. Jokainen palkki on suhteessa suurimpaan vuoteen.</p>
        </div>

        <div class="home-timeline">
            <ul class="home-timeline-legend" aria-label="Aikajanan sarjat">
                <li><span class="home-timeline-swatch home-timeline-swatch--publications"></span> Tieteelliset julkaisut</li>
                <li><span class="home-timeline-swatch home-timeline-swatch--speeches"></span> Puheenvuorot (valtuusto + muut)</li>
                <li><span class="home-timeline-swatch home-timeline-swatch--presentations"></span> Esitykset ja koulutukset</li>
            </ul>

            <div class="home-timeline-rows" role="list">
                {% for row in timelineRows %}
                <div class="home-timeline-row" role="listitem">
                    <div class="home-timeline-year">{{ row.year }}</div>
                    <div class="home-timeline-bars">
                        <div class="home-timeline-bar-line" title="Tieteelliset julkaisut: {{ row.publications }}">
                            <span class="home-timeline-bar home-timeline-bar--publications" style="width: {{ row.publicationsPct }}%;"></span>
                            <span class="home-timeline-bar-count">{{ row.publications }}</span>
                        </div>
                        <div class="home-timeline-bar-line" title="Puheenvuorot: {{ row.speeches }}">
                            <span class="home-timeline-bar home-timeline-bar--speeches" style="width: {{ row.speechesPct }}%;"></span>
                            <span class="home-timeline-bar-count">{{ row.speeches }}</span>
                        </div>
                        <div class="home-timeline-bar-line" title="Esitykset ja koulutukset: {{ row.presentations }}">
                            <span class="home-timeline-bar home-timeline-bar--presentations" style="width: {{ row.presentationsPct }}%;"></span>
                            <span class="home-timeline-bar-count">{{ row.presentations }}</span>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-body-tertiary home-topics-section" id="teemat">
    <div class="site-shell">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">Teemat läpi roolien</p>
            <h2 class="home-section-title">Samat aiheet jatkuvat tutkimuksesta opetukseen, kirjoituksiin ja päätöksentekoon</h2>
            <p class="home-section-lead mb-0">Teemaprofiili kokoaa aiheeseen liittyvät julkaisut, esitykset, kirjoitukset, lausunnot ja mediaosumat samalle sivulle. Numero kertoo, kuinka monta sisältöä kustakin teemasta on koottu.</p>
        </div>

        <div class="home-topics-grid">
            {% for slug in homeTopicSlugs %}
                {% set topic = false %}
                {% for t in seoTopics %}{% if t.slug == slug %}{% set topic = t %}{% endif %}{% endfor %}
                {% if topic %}
                    {% set topicItemList = collections | topicItems(topic, 200) %}
                    {% set researchList = researchfi | curatedResearchForTopic(topic.researchThemes or [], 200) %}
                    {% set topicTotal = topicItemList.totalCount + researchList.length %}
                    {% if topicTotal > 0 %}
                    <a href="/teemat/{{ topic.slug }}/" class="home-topic-pill">
                        <p class="home-topic-pill-kicker">{{ topic.eyebrow }}</p>
                        <p class="home-topic-pill-title">{{ topic.title }}</p>
                        <p class="home-topic-pill-count">{{ topicTotal }} aiheeseen liittyvää sisältöä</p>
                        <span class="home-topic-pill-cta">Avaa teemaprofiili <i class="bi bi-arrow-right ms-1"></i></span>
                    </a>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>

        <div class="home-topics-footer">
            <a href="/teemat/" class="btn btn-outline-primary rounded-pill px-4">Kaikki teemaprofiilit <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>

<section class="py-5 home-larux-section" id="koulutus">
    <div class="site-shell">
        <div class="home-larux-panel">
            <div>
                <p class="home-section-kicker mb-1">Larux t:mi</p>
                <h2 class="h3 mb-2">Koulutuksia, puheenvuoroja ja sparrausta</h2>
                <p class="mb-0 text-muted">Tarvitsetko tekoälyn, oppimisteknologian tai pedagogiikan asiantuntijaa tilaisuuteen, koulutukseen tai kehittämistyöhön? Laruxin kautta sovitaan käytännön yhteistyöstä.</p>
            </div>
            <div class="home-larux-actions">
                <a class="btn btn-primary rounded-pill px-4" href="/kouluttaja/">Tutustu Laruxin palveluihin</a>
                <a class="btn btn-outline-secondary rounded-pill px-4" href="/esitykset/">Katso esityksiä ja materiaaleja</a>
            </div>
        </div>
    </div>
</section>

{% set testimonialLang = "fi" %}
{% set testimonialPlacement = "home" %}
{% include "testimonials.njk" %}

<section class="py-5 bg-body-tertiary home-closing-section" id="yhteys">
    <div class="site-shell">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="home-closing-panel text-center">
                    <p class="text-uppercase text-muted fw-bold mb-2">Seuraava askel</p>
                    <h2 class="fw-bold mb-3">{{ pageContent.etusivu.closing.heading }}</h2>
                    <p class="mb-4">{{ pageContent.etusivu.closing.text }}</p>
                    <div class="home-closing-actions d-flex flex-wrap justify-content-center gap-2 mb-3">
                        <a class="btn btn-primary rounded-pill px-4" href="{{ pageContent.etusivu.closing.cta1.href }}">{{ pageContent.etusivu.closing.cta1.label }}</a>
                        <a class="btn btn-outline-secondary rounded-pill px-4" href="{{ pageContent.etusivu.closing.cta2.href }}">{{ pageContent.etusivu.closing.cta2.label }}</a>
                        <a class="btn btn-outline-secondary rounded-pill px-4" href="{{ pageContent.etusivu.closing.cta3.href }}">{{ pageContent.etusivu.closing.cta3.label }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
