---
layout: base.njk
---
{% set currentLang = lang or (page.url | langFromUrl) %}
{% set sourceHref = publicUrl or sourceUrl or url %}
{% set publicSourceHref = sourceHref %}
{% if sourceHref and "canva.com" in sourceHref %}
  {% set publicSourceHref = sourceHref | canvaPublicUrl %}
{% endif %}
{% set sourceText = "Esitys" %}
{% if source == "slideshare" %}
  {% set sourceText = "SlideShare" %}
{% elif source == "canva" %}
  {% set sourceText = "Canva" %}
{% elif source == "aoe" %}
  {% set sourceText = "AOE" %}
{% elif source == "ouka" %}
  {% set sourceText = "Oulun kaupunki / verkkomateriaali" %}
{% elif sourceHref and "canva.com" in sourceHref %}
  {% set sourceText = "Canva" %}
{% elif sourceHref and ("youtube.com" in sourceHref or "youtu.be" in sourceHref) %}
  {% set sourceText = "YouTube" %}
{% endif %}
{% set isVideoPreview = publicSourceHref and ("youtube.com" in publicSourceHref or "youtu.be" in publicSourceHref) %}
{# PRESENTATION-COMPOSITION-01: the KURSSITOTEUTUS section below owns
   the course-implementation identity (courseId + courseName + semester).
   Käyttöyhteys must not repeat that same relationship via
   `presentationContextSummary` when a verified implementation backlink
   exists, or the same fact reads twice. Suppress it there; the
   Käyttöyhteys card still renders for its other independent fields. #}
{% set showContextSummary = presentationContextSummary and not courseImplementationBacklink %}
{% set hasPresentationContext = event or audience or showContextSummary or teachingUnitLabel or kategoria or jarjestaja or location %}
{# Kempele semantic verification: three INDEPENDENT canonical
   Presentation type-specific fields (Canonical Content v1 §3):
     location   — geographic place        (e.g. "Kempele")
     kategoria  — usage-context type      (e.g. "täydennyskoulutus")
     jarjestaja — organiser entity        (e.g. "Kempeleen kunta (VESO-koulutus)")
   We show them under three separate labels so the semantics never
   conflate. Kategoria strings come in lower-case from Canva;
   capitalize for display. #}
{% set kategoriaLabel = kategoria | capitalize %}

{% import "detail-hero.njk" as heroPartial %}

{# DETAIL-UX-01A: promote canonical Presentation preview to hero aside
   when a thumbnail exists in canonical data. Mirrors Media detail's
   hero pattern. Falls back to single-column hero when thumbnail is
   absent (4/138 records). The thumbnail is content, not decoration —
   it links to the same publicSourceHref as the primary CTA. #}
{% set presentationHeroAside %}
{% if thumbnail %}
<aside class="content-detail-visual" aria-label="Esityksen esikatselu">
  <a href="{{ publicSourceHref or page.url }}" {% if publicSourceHref %}target="_blank" rel="noopener noreferrer"{% endif %} class="content-detail-thumb{% if isVideoPreview %} video-preview{% endif %}" data-pagefind-ignore>
    <img src="{{ thumbnail }}" alt="" loading="lazy" decoding="async">
  </a>
</aside>
{% endif %}
{% endset %}

{# DETAIL-UX-01A: destination-specific primary CTA label derived from
   canonical `source` semantics (Canva/SlideShare/AOE/YouTube/OUKA).
   No new source classifier introduced — all mappings come from the
   existing sourceText resolver above. #}
{% set presentationCtaLabel = "Avaa materiaali" %}
{% if isVideoPreview %}
  {% set presentationCtaLabel = "Katso tallenne YouTubessa" %}
{% elif source == "canva" or (publicSourceHref and "canva" in publicSourceHref) %}
  {% set presentationCtaLabel = "Avaa esitys Canvassa" %}
{% elif source == "slideshare" %}
  {% set presentationCtaLabel = "Avaa esitys SlideSharessa" %}
{% elif source == "aoe" %}
  {% set presentationCtaLabel = "Avaa materiaali AOE:ssa" %}
{% elif source == "ouka" %}
  {% set presentationCtaLabel = "Avaa Oulun kaupungin materiaali" %}
{% endif %}

{% call heroPartial.heroShell(
  variant="presentation",
  eyebrow="Esitys tai opetusmateriaali",
  title=title,
  lead=(subtitle or description or null),
  aside=(presentationHeroAside if thumbnail else null),
  eyebrowPagefindIgnore=true,
  titlePagefindWeight="10",
  leadPagefindWeight="6",
  titleMode="compact"
) %}
  <div class="content-detail-meta" aria-label="Esityksen perustiedot" data-pagefind-ignore>
    <span>{{ sourceText }}</span>
    {% if date %}<span>{{ date | dateFormat }}</span>{% endif %}
    {% if sourceLanguage %}<span>{{ "English" if sourceLanguage == "en" else ("Suomi" if sourceLanguage == "fi" else sourceLanguage) }}</span>{% endif %}
    {% if slideCount %}<span>{{ slideCount }} diaa</span>{% endif %}
  </div>
  {# DETAIL-UX-ORIENT-01: hero-actions renders only when a real
     primary action exists (Writing-no-source drops the wrapper).
     Return-to-origin is NOT here — it lives in a trailing region
     below (see end of file) so it never competes with the CTA and
     never depends on the hero-actions wrapper. #}
  {% if publicSourceHref %}
  <div class="content-detail-actions" data-pagefind-ignore>
    <a href="{{ publicSourceHref }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-4">{{ presentationCtaLabel }}</a>
  </div>
  {% endif %}
{% endcall %}

<section class="content-detail-body-section content-detail-body-section--presentation py-5">
  <div class="site-shell">
    <article class="content-detail-main content-detail-main--presentation">
      <div class="content-detail-card content-detail-card--presentation">
        <p class="content-detail-card-kicker" data-pagefind-ignore>Esitys</p>
        {# DETAIL-UX-01A: thumbnail moved to hero aside above (see
           presentationHeroAside). Inline body thumbnail removed to
           avoid the same preview rendering twice. #}
        <div class="content-prose">{{ content | safe }}</div>
      </div>

      <div class="presentation-detail-support">
        {% if hasPresentationContext %}
        <div class="content-detail-side-card content-detail-support-card">
          <p class="content-detail-card-kicker">Käyttöyhteys</p>
          <dl class="content-detail-definition-list content-detail-definition-list--context mb-0">
            {% if location %}
            <div>
              <dt>Paikka</dt>
              <dd>{{ location }}</dd>
            </div>
            {% endif %}
            {% if kategoria %}
            <div>
              <dt>Käyttöyhteys</dt>
              <dd>{{ kategoriaLabel }}</dd>
            </div>
            {% endif %}
            {% if jarjestaja %}
            <div>
              <dt>Järjestäjä</dt>
              <dd>{{ jarjestaja }}</dd>
            </div>
            {% endif %}
            {% if event %}
            <div>
              <dt>Tilaisuus</dt>
              <dd>{{ event }}</dd>
            </div>
            {% endif %}
            {% if audience %}
            <div>
              <dt>Kohderyhmä</dt>
              <dd>{{ audience }}</dd>
            </div>
            {% endif %}
            {% if showContextSummary %}
            <div>
              <dt>Opetuskonteksti</dt>
              <dd>{{ presentationContextSummary }}</dd>
            </div>
            {% endif %}
            {% if teachingUnitLabel %}
            <div>
              <dt>Opetusyhteys</dt>
              <dd>{{ teachingUnitLabel }}</dd>
            </div>
            {% endif %}
          </dl>
        </div>
        {% endif %}
      </div>

      {# PRESENTATION-COMPOSITION-01: Kurssitoteutus — unified course
         relationship section. Combines:
           1. Course-implementation backlink (when a verified local
              /opetus/ page exists for the exact (courseId, periodId)).
           2. Same-implementation / same-course peers.
         Same conditions as before — the underlying data helpers
         (`courseImplementationBacklink`, `coursePeerRelation`) are
         unchanged. The two used to render as separate sibling sections,
         which repeated the "this belongs to course X" fact twice and
         fragmented the user's view of the course relationship. The
         combined section shows the course identity once, then the
         actions and peers as one coherent group.

         Deliberate rendering rules:
           • Opaque `periodId` (e.g. "2013-2014-a") is never surfaced;
             we use only trusted display labels (`courseName`,
             `semesterLabel`, `period` letter, `academicYear`).
           • In implementation mode the header shows the specific
             implementation identity via `semesterLabel`.
           • In course-fallback mode the copy still explains the
             cross-implementation ambiguity.
           • Empty state (no backlink AND no peers) → section omitted.
         COURSE-RELATION-UX-01 peer semantics and cap unchanged.
         DETAIL-UX-SEQUENCE-01 remains CLOSED / DEFERRED — no
         sequence metadata is introduced. #}
      {% set hasBacklink = courseImplementationBacklink and (courseImplementationBacklink.lang == currentLang or (currentLang == "fi" and courseImplementationBacklink.lang == "fi")) %}
      {% set hasPeers = coursePeerRelation and coursePeerRelation.peers and coursePeerRelation.peers.length %}
      {% if hasBacklink or hasPeers %}
      <section class="content-detail-course-implementation{% if hasPeers %} content-detail-course-peers content-detail-course-peers--{{ coursePeerRelation.mode }}{% endif %}" aria-labelledby="kurssitoteutus-heading">
        <h2 id="kurssitoteutus-heading" class="h5 fw-bold mb-2">
          {% if hasBacklink %}
            {{ "Course implementation" if currentLang == "en" else "Kurssitoteutus" }}
          {% elif coursePeerRelation.mode == "implementation" %}
            {{ "In the same course implementation" if currentLang == "en" else "Samassa kurssitoteutuksessa" }}
          {% else %}
            {{ "From the same course" if currentLang == "en" else "Samalta opintojaksolta" }}
          {% endif %}
        </h2>

        {% if hasBacklink %}
        <p class="mb-2 fw-semibold">
          {{ courseImplementationBacklink.courseName }}
          {% if courseImplementationBacklink.semesterLabel or courseImplementationBacklink.period %}
            <span class="text-muted fw-normal">
              (
              {%- if courseImplementationBacklink.semesterLabel %}{{ courseImplementationBacklink.semesterLabel }}{% endif -%}
              {%- if courseImplementationBacklink.semesterLabel and courseImplementationBacklink.period %} · {% endif -%}
              {%- if courseImplementationBacklink.period %}{{ "period" if currentLang == "en" else "periodi" }} {{ courseImplementationBacklink.period }}{% endif -%}
              )
            </span>
          {% endif %}
        </p>
        <p class="mb-3">
          <a class="btn btn-outline-primary rounded-pill px-4" href="{{ courseImplementationBacklink.pageUrl }}">
            {{ "Open course page" if currentLang == "en" else "Avaa kurssisivu" }}
          </a>
        </p>
        {% elif hasPeers and coursePeerRelation.mode == "course-fallback" %}
        <p class="text-muted small mb-3">
          {% if currentLang == "en" %}Materials from course {{ coursePeerRelation.courseId }}{% if coursePeerRelation.courseName %} — {{ coursePeerRelation.courseName }}{% endif %}. Content may come from different yearly implementations.{% else %}Materiaaleja opintojaksolta {{ coursePeerRelation.courseId }}{% if coursePeerRelation.courseName %} — {{ coursePeerRelation.courseName }}{% endif %}. Aineisto voi olla eri vuosien toteutuksista.{% endif %}
        </p>
        {% endif %}

        {% if hasPeers %}
        <p class="text-uppercase small text-muted fw-semibold mb-2">
          {{ "Other materials from this implementation" if currentLang == "en" else "Muut tämän toteutuksen materiaalit" }}
        </p>
        <ul class="list-unstyled mb-0 d-grid gap-2">
          {% for peer in coursePeerRelation.peers %}
          <li class="course-peer-item">
            <a href="{{ peer.url }}" class="fw-semibold text-decoration-none d-block">{{ peer.title }}</a>
            {% if peer.date %}<div class="text-muted small">{{ peer.date | dateFormat }}</div>{% endif %}
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </section>
      {% endif %}

      <div class="content-detail-related content-detail-related--presentation">
          {% include "content-context-sidebar.njk" %}
      </div>
    </article>
  </div>
</section>

{# DETAIL-UX-ORIENT-01: trailing RETURN-TO-ORIGIN region. Renders
   the O1 return-link partial (JS-hidden by default). Sidebar
   `content-context-archive-link` above continues to serve as
   the always-visible SITE ORIENTATION link → /esitykset/. #}
<footer class="content-detail-origin py-4" aria-label="{{ 'Return to origin' if currentLang == 'en' else 'Palaa lähtökohtaan' }}">
  <div class="site-shell">
    {% set orientationLang = currentLang %}
    {% set orientationReturnFallback = "/esitykset/" %}
    {% set orientationReturnPrefixes = ["/esitykset/", "/en/presentations/", "/opetus/", "/en/teaching/", "/etsi/", "/en/search/"] %}
    {% include "detail-return-link.njk" %}
  </div>
</footer>
