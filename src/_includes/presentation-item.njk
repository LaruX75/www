---
layout: base.njk
---
{% set currentLang = lang or (page.url | langFromUrl) %}
{% set sourceHref = publicUrl or sourceUrl or url %}
{% set publicSourceHref = sourceHref %}
{% if sourceHref and "canva.com" in sourceHref %}
  {% set publicSourceHref = sourceHref | canvaPublicUrl %}
{% endif %}
{% set sourceText = "Esitys" %}
{% if source == "slideshare" %}
  {% set sourceText = "SlideShare" %}
{% elif source == "aoe" %}
  {% set sourceText = "AOE" %}
{% elif source == "ouka" %}
  {% set sourceText = "Oulun kaupunki / verkkomateriaali" %}
{% elif sourceHref and "canva.com" in sourceHref %}
  {% set sourceText = "Canva" %}
{% elif sourceHref and ("youtube.com" in sourceHref or "youtu.be" in sourceHref) %}
  {% set sourceText = "YouTube" %}
{% endif %}
{% set isVideoPreview = publicSourceHref and ("youtube.com" in publicSourceHref or "youtu.be" in publicSourceHref) %}

<section class="content-detail-hero content-detail-hero--presentation py-5 border-bottom">
  <div class="site-shell">
    <div class="content-detail-hero-grid">
      <div class="content-detail-copy">
        <p class="content-detail-eyebrow mb-2">Esitys tai opetusmateriaali</p>
        <h1 class="content-detail-title mb-3">{{ title }}</h1>
        {% if subtitle %}
          <p class="content-detail-lead mb-3">{{ subtitle }}</p>
        {% elif description %}
          <p class="content-detail-lead mb-3">{{ description }}</p>
        {% endif %}
        <div class="content-detail-actions">
          {% if publicSourceHref %}
            <a href="{{ publicSourceHref }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-4">{% if isVideoPreview %}Katso tallenne{% else %}Avaa materiaali{% endif %}</a>
          {% endif %}
          <a href="/esitykset/" class="btn btn-outline-secondary rounded-pill px-4">Kaikki esitykset</a>
        </div>
      </div>

      <aside class="content-detail-visual" aria-label="Esityksen esikatselu">
        {% if thumbnail %}
          <a href="{{ publicSourceHref or page.url }}" {% if publicSourceHref %}target="_blank" rel="noopener noreferrer"{% endif %} class="content-detail-thumb{% if isVideoPreview %} video-preview{% endif %}">
            <img src="{{ thumbnail }}" alt="" loading="lazy" decoding="async">
          </a>
        {% else %}
          <div class="content-detail-thumb content-detail-thumb--empty">
            <i class="bi bi-easel2" aria-hidden="true"></i>
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

<section class="content-detail-body-section py-5">
  <div class="site-shell">
    <article class="content-detail-main">
      <div class="content-detail-card">
        <p class="content-detail-card-kicker">Sisällön kuvaus</p>
        <div class="content-prose">{{ content | safe }}</div>
      </div>

      <aside class="content-detail-sidebar">
        <div class="content-detail-side-card content-detail-meta-card">
          <p class="content-detail-card-kicker">Materiaali ja käyttöyhteys</p>
          <dl class="content-detail-definition-list mb-0">
            <div>
              <dt>Lähde</dt>
              <dd>{{ sourceText }}</dd>
            </div>
            {% if event %}
            <div>
              <dt>Tilaisuus</dt>
              <dd>{{ event }}</dd>
            </div>
            {% endif %}
            {% if audience %}
            <div>
              <dt>Kohderyhmä</dt>
              <dd>{{ audience }}</dd>
            </div>
            {% endif %}
            {% if date %}
            <div>
              <dt>Päiväys</dt>
              <dd>{{ date | dateFormat }}</dd>
            </div>
            {% endif %}
          </dl>
        </div>

        {% if courseContexts and courseContexts.length %}
        <div class="content-detail-side-card content-detail-course-card">
          <p class="content-detail-card-kicker">Opintojaksokonteksti</p>
          <div class="content-detail-course-list">
            {% for course in courseContexts %}
              <div class="content-detail-course-item">
                <p class="content-detail-course-title mb-1">
                  {% if course.courseId %}<span>{{ course.courseId }}</span>{% endif %}
                  {{ course.courseName }}
                </p>
                <p class="content-detail-course-meta mb-1">
                  {% if course.linkType == "explicit_course_code" %}
                    Kurssikoodi löytyi materiaalista.
                  {% elif course.linkType == "explicit_course_name" %}
                    Kurssinimi löytyi materiaalista.
                  {% elif course.linkType == "probable_legacy_course_material" %}
                    Todennäköinen vanha kurssimateriaali.
                  {% elif course.linkType == "possible_reuse_of_course_material" %}
                    Mahdollinen uudelleenkäyttö muussa koulutuksessa.
                  {% elif course.linkType == "contextual_topic_or_pathway" %}
                    Kurssipolun tai teeman konteksti.
                  {% else %}
                    Kurssikonteksti.
                  {% endif %}
                </p>
                {% if course.matchedTerms and course.matchedTerms.length %}
                  <div class="content-detail-course-tags">
                    {% for term in course.matchedTerms %}
                      {% if loop.index <= 3 %}<span>{{ term }}</span>{% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <div class="content-detail-related">
          {% include "content-context-sidebar.njk" %}
        </div>
      </aside>
    </article>
  </div>
</section>
