---
layout: base.njk
---
{% set currentLang = lang or (page.url | langFromUrl) %}
{% set sourceHref = publicUrl or sourceUrl or url %}
{% set publicSourceHref = sourceHref %}
{% if sourceHref and "canva.com" in sourceHref %}
  {% set publicSourceHref = sourceHref | canvaPublicUrl %}
{% endif %}
{% set sourceText = "Esitys" %}
{% if source == "slideshare" %}
  {% set sourceText = "SlideShare" %}
{% elif source == "canva" %}
  {% set sourceText = "Canva" %}
{% elif source == "aoe" %}
  {% set sourceText = "AOE" %}
{% elif source == "ouka" %}
  {% set sourceText = "Oulun kaupunki / verkkomateriaali" %}
{% elif sourceHref and "canva.com" in sourceHref %}
  {% set sourceText = "Canva" %}
{% elif sourceHref and ("youtube.com" in sourceHref or "youtu.be" in sourceHref) %}
  {% set sourceText = "YouTube" %}
{% endif %}
{% set isVideoPreview = publicSourceHref and ("youtube.com" in publicSourceHref or "youtu.be" in publicSourceHref) %}
{% set hasPresentationContext = event or audience or presentationContextSummary or teachingUnitLabel or kategoria or jarjestaja or location %}
{# Kempele semantic verification: three INDEPENDENT canonical
   Presentation type-specific fields (Canonical Content v1 §3):
     location   — geographic place        (e.g. "Kempele")
     kategoria  — usage-context type      (e.g. "täydennyskoulutus")
     jarjestaja — organiser entity        (e.g. "Kempeleen kunta (VESO-koulutus)")
   We show them under three separate labels so the semantics never
   conflate. Kategoria strings come in lower-case from Canva;
   capitalize for display. #}
{% set kategoriaLabel = kategoria | capitalize %}

{% import "detail-hero.njk" as heroPartial %}

{# DETAIL-UX-01A: promote canonical Presentation preview to hero aside
   when a thumbnail exists in canonical data. Mirrors Media detail's
   hero pattern. Falls back to single-column hero when thumbnail is
   absent (4/138 records). The thumbnail is content, not decoration —
   it links to the same publicSourceHref as the primary CTA. #}
{% set presentationHeroAside %}
{% if thumbnail %}
<aside class="content-detail-visual" aria-label="Esityksen esikatselu">
  <a href="{{ publicSourceHref or page.url }}" {% if publicSourceHref %}target="_blank" rel="noopener noreferrer"{% endif %} class="content-detail-thumb{% if isVideoPreview %} video-preview{% endif %}" data-pagefind-ignore>
    <img src="{{ thumbnail }}" alt="" loading="lazy" decoding="async">
  </a>
</aside>
{% endif %}
{% endset %}

{# DETAIL-UX-01A: destination-specific primary CTA label derived from
   canonical `source` semantics (Canva/SlideShare/AOE/YouTube/OUKA).
   No new source classifier introduced — all mappings come from the
   existing sourceText resolver above. #}
{% set presentationCtaLabel = "Avaa materiaali" %}
{% if isVideoPreview %}
  {% set presentationCtaLabel = "Katso tallenne YouTubessa" %}
{% elif source == "canva" or (publicSourceHref and "canva" in publicSourceHref) %}
  {% set presentationCtaLabel = "Avaa esitys Canvassa" %}
{% elif source == "slideshare" %}
  {% set presentationCtaLabel = "Avaa esitys SlideSharessa" %}
{% elif source == "aoe" %}
  {% set presentationCtaLabel = "Avaa materiaali AOE:ssa" %}
{% elif source == "ouka" %}
  {% set presentationCtaLabel = "Avaa Oulun kaupungin materiaali" %}
{% endif %}

{% call heroPartial.heroShell(
  variant="presentation",
  eyebrow="Esitys tai opetusmateriaali",
  title=title,
  lead=(subtitle or description or null),
  aside=(presentationHeroAside if thumbnail else null),
  eyebrowPagefindIgnore=true,
  titlePagefindWeight="10",
  leadPagefindWeight="6"
) %}
  <div class="content-detail-meta" aria-label="Esityksen perustiedot" data-pagefind-ignore>
    <span>{{ sourceText }}</span>
    {% if date %}<span>{{ date | dateFormat }}</span>{% endif %}
    {% if sourceLanguage %}<span>{{ "English" if sourceLanguage == "en" else ("Suomi" if sourceLanguage == "fi" else sourceLanguage) }}</span>{% endif %}
    {% if slideCount %}<span>{{ slideCount }} diaa</span>{% endif %}
  </div>
  <div class="content-detail-actions" data-pagefind-ignore>
    {% if publicSourceHref %}
      <a href="{{ publicSourceHref }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-4">{{ presentationCtaLabel }}</a>
    {% endif %}
    {% set orientationLang = currentLang %}
    {% set orientationHubHref = "/esitykset/" %}
    {% set orientationHubLabel = "Kaikki esitykset" %}
    {% set orientationReturnPrefixes = ["/esitykset/", "/en/presentations/"] %}
    {% include "detail-orientation.njk" %}
  </div>
{% endcall %}

<section class="content-detail-body-section content-detail-body-section--presentation py-5">
  <div class="site-shell">
    <article class="content-detail-main content-detail-main--presentation">
      <div class="content-detail-card content-detail-card--presentation">
        <p class="content-detail-card-kicker" data-pagefind-ignore>Esitys</p>
        {# DETAIL-UX-01A: thumbnail moved to hero aside above (see
           presentationHeroAside). Inline body thumbnail removed to
           avoid the same preview rendering twice. #}
        <div class="content-prose">{{ content | safe }}</div>
      </div>

      <div class="presentation-detail-support">
        {% if hasPresentationContext %}
        <div class="content-detail-side-card content-detail-support-card">
          <p class="content-detail-card-kicker">Käyttöyhteys</p>
          <dl class="content-detail-definition-list content-detail-definition-list--context mb-0">
            {% if location %}
            <div>
              <dt>Paikka</dt>
              <dd>{{ location }}</dd>
            </div>
            {% endif %}
            {% if kategoria %}
            <div>
              <dt>Käyttöyhteys</dt>
              <dd>{{ kategoriaLabel }}</dd>
            </div>
            {% endif %}
            {% if jarjestaja %}
            <div>
              <dt>Järjestäjä</dt>
              <dd>{{ jarjestaja }}</dd>
            </div>
            {% endif %}
            {% if event %}
            <div>
              <dt>Tilaisuus</dt>
              <dd>{{ event }}</dd>
            </div>
            {% endif %}
            {% if audience %}
            <div>
              <dt>Kohderyhmä</dt>
              <dd>{{ audience }}</dd>
            </div>
            {% endif %}
            {% if presentationContextSummary %}
            <div>
              <dt>Opetuskonteksti</dt>
              <dd>{{ presentationContextSummary }}</dd>
            </div>
            {% endif %}
            {% if teachingUnitLabel %}
            <div>
              <dt>Opetusyhteys</dt>
              <dd>{{ teachingUnitLabel }}</dd>
            </div>
            {% endif %}
          </dl>
        </div>
        {% endif %}
      </div>

      {# DETAIL-UX-01C-B-COURSE: build-time canonical peer list from
         shared courseContexts[].courseId. Renders only when peers
         exist. Empty state → section omitted (no "ei muita sisältöjä"
         placeholder). Selection lives in presentations.11tydata.js
         via peerPresentationsByCourse computed. No graph traversal,
         no browser JS, no similarity heuristic. #}
      {% if peerPresentationsByCourse and peerPresentationsByCourse.length %}
      <section class="content-detail-course-peers" aria-labelledby="samalla-kurssilla-heading">
        <h2 id="samalla-kurssilla-heading" class="h5 fw-bold mb-3">
          {{ "On the same course" if currentLang == "en" else "Samalla kurssilla" }}
        </h2>
        {% set peerCourseId = peerPresentationsByCourse[0].courseId %}
        {% set peerCourseName = peerPresentationsByCourse[0].courseName %}
        {% if peerCourseId %}
        <p class="text-muted small mb-3">
          {% if currentLang == "en" %}Other presentations from course {{ peerCourseId }}{% if peerCourseName %} — {{ peerCourseName }}{% endif %}.{% else %}Muut opintojakson {{ peerCourseId }}{% if peerCourseName %} — {{ peerCourseName }}{% endif %} esitykset.{% endif %}
        </p>
        {% endif %}
        <ul class="list-unstyled mb-0 d-grid gap-2">
          {% for peer in peerPresentationsByCourse %}
          <li class="course-peer-item">
            <a href="{{ peer.url }}" class="fw-semibold text-decoration-none d-block">{{ peer.title }}</a>
            {% if peer.date %}<div class="text-muted small">{{ peer.date | dateFormat }}</div>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      <div class="content-detail-related content-detail-related--presentation">
          {% include "content-context-sidebar.njk" %}
      </div>
    </article>
  </div>
</section>
