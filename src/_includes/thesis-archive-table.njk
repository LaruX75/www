{#
  thesis-archive-table.njk — converged single-table SSR archive.

  Required context:
    thesesArchive            — current archive page descriptor
    thesisArchiveTableId     — table id used by tests / a11y labels
    thesisArchiveTbodyId     — tbody id targeted by Find & Explore on thesis pages
    thesisArchiveHeading     — visible section heading
    thesisArchiveDescription — short lead paragraph
    thesisArchiveLang        — "fi" or "en"
    thesisArchiveLandingUrl  — locale landing URL
    thesisArchivePageBase    — locale pagination base
#}
{% set thesisArchiveIsEn = thesisArchiveLang == "en" %}
{% set thesisArchiveYearOrderId = thesisArchiveYearOrderId or (thesisArchiveTableId + "YearOrder") %}
{% set thesisArchiveAuthorSortId = thesisArchiveAuthorSortId or (thesisArchiveTableId + "AuthorSort") %}
{% set thesisArchiveTypeRoleId = thesisArchiveTypeRoleId or (thesisArchiveTableId + "TypeRole") %}
<section class="thesis-archive-list py-4"
         data-thesis-archive
         data-thesis-archive-scope="{{ thesesArchive.scope }}"
         data-thesis-archive-current-page="{{ thesesArchive.currentPage }}"
         data-thesis-archive-total-pages="{{ thesesArchive.pageCount }}">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1" id="{{ thesisArchiveTableId }}Heading">{{ thesisArchiveHeading }}</h2>
            <p class="text-muted mb-0">{{ thesisArchiveDescription }}</p>
          </div>
          <span class="badge text-bg-light border text-dark">{{ thesesArchive.totalCount }}</span>
        </div>

        {% set thesisPagerCurrentPage = thesesArchive.currentPage %}
        {% set thesisPagerTotalPages = thesesArchive.pageCount %}
        {% set thesisPagerLandingUrl = thesisArchiveLandingUrl %}
        {% set thesisPagerPageBase = thesisArchivePageBase %}
        {% set thesisPagerIsEn = thesisArchiveIsEn %}
        {% set thesisPagerPosition = "top" %}
        {% include "thesis-archive-pager.njk" %}

        <div class="table-responsive mt-2">
          <table id="{{ thesisArchiveTableId }}" class="table table-sm thesis-archive-table align-top mb-0" aria-describedby="{{ thesisArchiveTableId }}Heading">
            <caption class="visually-hidden">
              {{ thesisArchiveHeading }} — {{ (thesisArchiveIsEn and 'page') or 'sivu' }} {{ thesesArchive.currentPage }} / {{ thesesArchive.pageCount }}
            </caption>
            <thead>
              <tr>
                <th scope="col" class="thesis-archive-col-year">
                  {# THESIS-HUB-02: year-order dropdown drives Find & Explore.
                     Subarchive templates that do not include Find & Explore
                     pass `thesisArchiveWithFindExplore=false` and get a
                     plain header label. #}
                  {% if thesisArchiveWithFindExplore %}
                  <div class="thesis-archive-header-control">
                    <span class="thesis-archive-header-label">{{ (thesisArchiveIsEn and 'Year') or 'Vuosi' }}</span>
                    <label class="visually-hidden" for="{{ thesisArchiveYearOrderId }}">{{ (thesisArchiveIsEn and 'Archive year ordering') or 'Arkiston vuosijärjestys' }}</label>
                    <select id="{{ thesisArchiveYearOrderId }}" class="form-select form-select-sm thesis-archive-header-select" data-find-explore-year-order aria-label="{{ (thesisArchiveIsEn and 'Archive year ordering') or 'Arkiston vuosijärjestys' }}">
                      <option value="year-desc">{{ (thesisArchiveIsEn and 'Newest first') or 'Uusin ensin' }}</option>
                      <option value="year-asc">{{ (thesisArchiveIsEn and 'Oldest first') or 'Vanhin ensin' }}</option>
                    </select>
                  </div>
                  {% else %}
                  <span class="thesis-archive-header-label">{{ (thesisArchiveIsEn and 'Year') or 'Vuosi' }}</span>
                  {% endif %}
                </th>
                <th scope="col" class="thesis-archive-col-author">
                  {% if thesisArchiveWithFindExplore %}
                  <div class="thesis-archive-header-control">
                    <span class="thesis-archive-header-label">{{ (thesisArchiveIsEn and 'Author') or 'Tekijä' }}</span>
                    <label class="visually-hidden" for="{{ thesisArchiveAuthorSortId }}">{{ (thesisArchiveIsEn and 'Archive author ordering') or 'Arkiston tekijäjärjestys' }}</label>
                    <select id="{{ thesisArchiveAuthorSortId }}" class="form-select form-select-sm thesis-archive-header-select" data-find-explore-author-sort aria-label="{{ (thesisArchiveIsEn and 'Archive author ordering') or 'Arkiston tekijäjärjestys' }}">
                      <option value="use-year">{{ (thesisArchiveIsEn and 'By year') or 'Vuoden mukaan' }}</option>
                      <option value="author-asc">{{ (thesisArchiveIsEn and 'Author A-Z') or 'Tekijä A-Ö' }}</option>
                      <option value="author-desc">{{ (thesisArchiveIsEn and 'Author Z-A') or 'Tekijä Ö-A' }}</option>
                    </select>
                  </div>
                  {% else %}
                  <span class="thesis-archive-header-label">{{ (thesisArchiveIsEn and 'Author') or 'Tekijä' }}</span>
                  {% endif %}
                </th>
                <th scope="col" class="thesis-archive-col-title">{{ (thesisArchiveIsEn and 'Title') or 'Otsikko' }}</th>
                <th scope="col" class="thesis-archive-col-type">
                  {# THESIS-HUB-02: type/role dropdown drives Find & Explore
                     replacement of tbody rows. Only render when the caller
                     actually ships those options (hub/subarchive pages that
                     are single-scope pass an empty list and the plain
                     header label is used instead). #}
                  {% if thesisArchiveWithFindExplore and thesisArchiveTypeRoleOptions and thesisArchiveTypeRoleOptions.length %}
                  <div class="thesis-archive-header-control">
                    <span class="thesis-archive-header-label">{{ (thesisArchiveIsEn and 'Type / role') or 'Tyyppi / rooli' }}</span>
                    <label class="visually-hidden" for="{{ thesisArchiveTypeRoleId }}">{{ (thesisArchiveIsEn and 'Archive type and role filter') or 'Arkiston tyyppi- ja roolisuodatin' }}</label>
                    <select id="{{ thesisArchiveTypeRoleId }}" class="form-select form-select-sm thesis-archive-header-select" data-find-explore-type-role aria-label="{{ (thesisArchiveIsEn and 'Archive type and role filter') or 'Arkiston tyyppi- ja roolisuodatin' }}">
                      <option value="">{{ (thesisArchiveIsEn and 'All') or 'Kaikki' }}</option>
                      {% for option in thesisArchiveTypeRoleOptions %}
                      <option value="{{ option.value }}">{{ option.label }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  {% else %}
                  <span class="thesis-archive-header-label">{{ (thesisArchiveIsEn and 'Type / role') or 'Tyyppi / rooli' }}</span>
                  {% endif %}
                </th>
                <th scope="col" class="thesis-archive-col-source text-end">{{ (thesisArchiveIsEn and 'Source') or 'Lähde' }}</th>
              </tr>
            </thead>
            <tbody id="{{ thesisArchiveTbodyId }}" data-find-explore-results>
              {% if thesesArchive.visibleRows.length %}
                {% for row in thesesArchive.visibleRows %}
                <tr class="thesis-archive-row">
                  <td class="thesis-archive-col-year small text-muted"><span class="d-inline-block">{{ row.year }}</span></td>
                  <td class="thesis-archive-col-author small text-muted">{{ row.authorLine }}</td>
                  <th scope="row" class="thesis-archive-col-title">
                    <a class="thesis-archive-title-link fw-semibold text-decoration-none d-block" href="{{ row.pageUrl }}">{{ row.title }}</a>
                  </th>
                  <td class="thesis-archive-col-type small">{{ row.typeRoleLabel }}</td>
                  <td class="thesis-archive-col-source text-end">
                    {% if row.sourceUrl %}
                    <a class="btn btn-sm btn-outline-secondary"
                       href="{{ row.sourceUrl }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="{{ (thesisArchiveIsEn and 'Open in OuluREPO: ') or 'Avaa OuluREPOssa: ' }}{{ row.title }}">
                      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                      <span class="ms-1">OuluREPO</span>
                    </a>
                    {% endif %}
                  </td>
                </tr>
                {% endfor %}
              {% else %}
                <tr class="thesis-archive-row thesis-archive-row--empty">
                  <td colspan="5" class="text-muted small">{{ (thesisArchiveIsEn and 'No theses on this page.') or 'Tällä sivulla ei ole opinnäytteitä.' }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>

        {% set thesisPagerPosition = "bottom" %}
        {% include "thesis-archive-pager.njk" %}
      </div>
    </div>
  </div>
</section>
