{#
  thesis-archive-sections.njk — three-section SSR archive container.
  Renders all three thesis sections (advised masters, advised
  bachelors, reviewed) at the current per-section page states derived
  from the surrounding paginated permalink.

  Required context:
    thesesArchive          — one page descriptor from
                             thesesArchivePages{Fi,En} (has grouped +
                             pageCounts + sections + pageState)
    thesesArchiveLang      — "fi" or "en"
    thesesArchiveLanding   — landing permalink for the locale
    thesesArchiveLabels    — { advisedMasters, advisedBachelors, reviewed }
                             with { title, description, icon, accent }
#}
{% set thesesArchiveIsEn = thesesArchiveLang == "en" %}
<div class="thesis-archive-sections"
     data-thesis-archive-sections
     data-thesis-archive-scope="{{ thesesArchive.scope }}"
     data-thesis-archive-landing="{{ thesesArchiveLanding }}"
     data-thesis-archive-active-section="{{ thesesArchive.activeSectionKey or '' }}">
  {% for section in thesesArchive.sections %}
    {% set sectionMeta = thesesArchiveLabels[section.key] %}
    {% set thesisSectionKey = section.key %}
    {% set thesisSectionSlug = section.slug %}
    {% set thesisSectionPermalinkBase = section.permalinkBase %}
    {% set thesisSectionLandingUrl = thesesArchiveLanding %}
    {% set thesisSectionAnchor = section.anchor %}
    {% set thesisSectionTitle = sectionMeta.title %}
    {% set thesisSectionIcon = sectionMeta.icon %}
    {% set thesisSectionAccent = sectionMeta.accent %}
    {% set thesisSectionDescription = sectionMeta.description %}
    {% set thesisSectionItems = thesesArchive.grouped[section.key] %}
    {% set thesisSectionCurrentPage = thesesArchive.pageState[section.key] %}
    {% set thesisSectionTotalPages = thesesArchive.pageCounts[section.key] %}
    {% set thesisSectionLang = thesesArchiveLang %}
    {% set thesisSectionPageSize = thesesArchive.pageSize %}
    {% include "thesis-archive-table.njk" %}
  {% endfor %}
</div>
