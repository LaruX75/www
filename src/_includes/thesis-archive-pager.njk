{#
  thesis-archive-pager.njk — single-archive pagination controls.

  Required context:
    thesisPagerCurrentPage   — 1..N
    thesisPagerTotalPages    — >=1
    thesisPagerLandingUrl    — landing permalink for page 1
    thesisPagerPageBase      — e.g. "/opinnaytteet/sivu/"
    thesisPagerPosition      — "top" | "bottom"
    thesisPagerIsEn          — boolean for FI/EN labels
#}
{% if thesisPagerTotalPages > 1 %}
<nav class="thesis-archive-pager thesis-archive-pager--{{ thesisPagerPosition }}"
     data-thesis-archive-pager
     data-thesis-archive-pager-position="{{ thesisPagerPosition }}"
     data-thesis-archive-current="{{ thesisPagerCurrentPage }}"
     data-thesis-archive-total="{{ thesisPagerTotalPages }}"
     aria-label="{{ (thesisPagerIsEn and 'Archive pagination') or 'Arkiston sivutus' }} ({{ thesisPagerPosition }})">
  <ul class="pagination pagination-sm mb-0">
    {%- for pageNumber in range(1, thesisPagerTotalPages + 1) -%}
      {%- set pagerHref = thesisPagerLandingUrl if pageNumber == 1 else thesisPagerPageBase + pageNumber + "/" -%}
      {%- set isActive = pageNumber == thesisPagerCurrentPage -%}
      <li class="page-item{% if isActive %} active{% endif %}">
        {%- if isActive -%}
        <span class="page-link" aria-current="page">{{ pageNumber }}<span class="visually-hidden"> ({{ (thesisPagerIsEn and 'current page') or 'nykyinen sivu' }})</span></span>
        {%- else -%}
        <a class="page-link" href="{{ pagerHref }}" aria-label="{{ (thesisPagerIsEn and 'Go to page ') or 'Siirry sivulle ' }}{{ pageNumber }}">{{ pageNumber }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
{% endif %}
