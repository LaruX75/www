{#
  thesis-archive-pager.njk — per-section pagination controls.
  Renders identically for the top and bottom position of a section so
  the two paginators are trivially synchronised (both come from the
  same section state, both link to the same permalinks).

  Required context:
    thesisPagerSectionKey   — one of "advisedMasters" | "advisedBachelors" | "reviewed"
    thesisPagerSectionSlug  — URL slug for the section (locale-dependent)
    thesisPagerPermalinkBase — e.g. "/opinnaytteet/ohjatut-gradut/"
    thesisPagerCurrentPage  — 1..N (integer)
    thesisPagerTotalPages   — >=1
    thesisPagerLandingUrl   — landing permalink for page 1 (locale-dependent)
    thesisPagerPosition     — "top" or "bottom" (for aria labels only)
    thesisPagerIsEn         — boolean for FI/EN labels
#}
{% if thesisPagerTotalPages > 1 %}
<nav class="thesis-archive-pager thesis-archive-pager--{{ thesisPagerPosition }}"
     data-thesis-pager
     data-thesis-pager-section="{{ thesisPagerSectionKey }}"
     data-thesis-pager-position="{{ thesisPagerPosition }}"
     data-thesis-pager-current="{{ thesisPagerCurrentPage }}"
     data-thesis-pager-total="{{ thesisPagerTotalPages }}"
     aria-label="{{ (thesisPagerIsEn and 'Section pagination') or 'Osion sivutus' }} — {{ thesisPagerSectionKey }} ({{ thesisPagerPosition }})">
  <ul class="pagination pagination-sm mb-0">
    {%- for pageNumber in range(1, thesisPagerTotalPages + 1) -%}
      {%- set pagerHref = thesisPagerLandingUrl if pageNumber == 1 else thesisPagerPermalinkBase + "page/" + pageNumber + "/" -%}
      {%- set isActive = pageNumber == thesisPagerCurrentPage -%}
      <li class="page-item{% if isActive %} active{% endif %}">
        {%- if isActive -%}
        <span class="page-link" aria-current="page">{{ pageNumber }}<span class="visually-hidden"> ({{ (thesisPagerIsEn and 'current page') or 'nykyinen sivu' }})</span></span>
        {%- else -%}
        <a class="page-link"
           href="{{ pagerHref }}"
           data-thesis-pager-link
           data-thesis-pager-target-section="{{ thesisPagerSectionKey }}"
           data-thesis-pager-target-page="{{ pageNumber }}"
           aria-label="{{ (thesisPagerIsEn and 'Go to page ') or 'Siirry sivulle ' }}{{ pageNumber }}">{{ pageNumber }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
{% endif %}
