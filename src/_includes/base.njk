<!DOCTYPE html>
<html lang="{{ lang or (page.url | langFromUrl) }}">
<head>
  {% set isHomePage = page.url == "/" or page.url == "/en/" %}
  {#
    breadcrumbKey, breadcrumbDetailTitle ja breadcrumbDetailUrl paatellaan
    eleventyComputed-datassa (src/src.11tydata.js). Aiempi 63 rivin
    Nunjucks-if/elif-ketju on siirretty datakerrokseen.
  #}
  {% set _baseLang = lang or (page.url | langFromUrl) %}
  {% set _baseTitle = title or site.name %}
  {% set _baseSection = ("Blog" if _baseLang == "en" else "Blogi") if ("blog" in (tags or [])) else (("Publications" if _baseLang == "en" else "Julkaisut") if ("publications" in (tags or [])) else (("Politics" if _baseLang == "en" else "Politiikka") if ("politics" in (tags or [])) else site.name)) %}
  {% set _baseContentMeta = ({
    "schemaType": schemaType,
    "type": type,
    "tags": tags,
    "mediaType": mediaType,
    "contentType": contentType,
    "source": source,
    "lang": _baseLang
  }) | resolveContentMeta(_baseLang) %}
  {% setAsync "_ogRaw" %}{% ogImage "og-image.og.njk", { title: _baseTitle, section: _baseSection, siteName: site.name, domain: "jarilaru.fi", ogBgDataUrl: ogBgDataUrl } %}{% endsetAsync %}
  {% set ogImageOverrideValue = og_image or ogImage or ogImageOverride %}
  {% set generatedOgImage = _ogRaw if _ogRaw and _ogRaw != "null" else "/img/WIN_20210329_16_06_01_Pro.jpg" %}
  {% set trustedThumbnailEligible = thumbnail and (
    _baseContentMeta.pageBlockType == "presentation"
    or mediaType
    or _baseContentMeta.contentType == "blogPost"
    or _baseContentMeta.contentType == "opinion"
    or _baseContentMeta.contentType == "column"
    or _baseContentMeta.contentType == "speech"
    or _baseContentMeta.contentType == "statement"
    or _baseContentMeta.contentType == "initiative"
  ) %}
  {% set trustedThumbnailValue = thumbnail if trustedThumbnailEligible else "" %}
  {% set resolvedOgImage = ogImageOverrideValue if ogImageOverrideValue else (trustedThumbnailValue if trustedThumbnailValue else generatedOgImage) %}
  {% set resolvedOgImageIsPageSpecific = true if ogImageOverrideValue or trustedThumbnailValue else false %}
  {% set resolvedOgImageAlt = ({
    "title": _baseTitle,
    "currentLang": _baseLang,
    "isPageSpecificImage": resolvedOgImageIsPageSpecific,
    "imageAlt": ogImageAlt or og_image_alt or socialImageAlt or imageAlt
  }) | socialImageAlt %}
  {% include "_meta.njk" %}
  {% include "_ldschema.njk" %}
  {% for stylesheet in (pageStyles or []) %}
  <link rel="stylesheet" href="{{ stylesheet }}">
  {% endfor %}
</head>
<body>
  {% set currentLang = lang or (page.url | langFromUrl) %}
  <span hidden data-pagefind-filter="Kieli:{{ 'English' if currentLang == 'en' else 'Suomi' }}"></span>
  {% if pagefindDocument and pagefindDocument.filters %}
    {% for filter in pagefindDocument.filters %}
  <span hidden data-pagefind-filter="{{ filter.name }}:{{ filter.value }}"></span>
    {% endfor %}
    {% for metaName, metaValue in (pagefindDocument.meta or {}) %}
      {% if metaValue %}
  <span hidden data-pagefind-meta="{{ metaName }}:{{ metaValue }}"></span>
      {% endif %}
    {% endfor %}
    {% if pagefindDocument.seedText %}
  <span hidden>{{ pagefindDocument.seedText }}</span>
    {% endif %}
  {% endif %}
  <a class="visually-hidden-focusable skip-link btn btn-primary m-2 position-absolute" style="z-index: 9999; top: 0; left: 0;" href="#main-content">{{ "Skip to main content" if currentLang == "en" else "Hyppää pääsisältöön" }}</a>

  {% include "header.njk" %}

  {% if not isHomePage and not suppressSubpageHero %}
  <section class="subpage-hero-placeholder" aria-hidden="true">
    <div class="subpage-hero-image"></div>
  </section>
  {% endif %}

  {% include "breadcrumb.njk" %}

  <main id="main-content" class="site-main{% if pageMainClass %} {{ pageMainClass }}{% endif %}">
    <div class="bss-scope{% if pageScopeClass %} {{ pageScopeClass }}{% endif %}">
      {% if pageShell %}
        <div class="{{ pageShellClass or 'site-shell' }}">
          {{ content | safe }}
        </div>
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>
  </main>

  {% include "footer.njk" %}

  {% include "_news-ticker.njk" %}

  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous" defer></script>
  <script src="/js/bootstrap.min.js" defer></script>
  <script src="/js/external-media-consent.js" defer></script>
  <script src="/js/site-ui.js?v=20260820-o1-orientation-1" defer></script>

  {% include "_a11y-toolbar.njk" %}

  <link rel="stylesheet" href="/css/a11y-hc-overrides.css">

  {% if not suppressTableFilters %}
  <script src="/js/table-filters.js" defer></script>
  {% endif %}
  <script src="/js/a11y.js" defer></script>
  {% for scriptPath in (pageScripts or []) %}
  <script src="{{ scriptPath }}" defer></script>
  {% endfor %}
</body>
</html>
