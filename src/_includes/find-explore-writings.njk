{% set findExploreMountId = findExploreId or "findExplore" %}
<section class="find-explore find-explore--{{ findExploreKind or 'writings' }}" aria-labelledby="{{ findExploreMountId }}Heading" data-find-explore data-find-explore-kind="{{ findExploreKind or 'writings' }}" {% if findExploreKinds %}data-find-explore-kinds="{{ findExploreKinds }}"{% endif %} data-find-explore-scope="{{ findExploreScope }}" data-find-explore-lang="{{ findExploreLang }}" {% if findExploreSearchLanguage %}data-find-explore-search-language="{{ findExploreSearchLanguage }}"{% endif %} {% if findExploreLanguageFilter %}data-find-explore-language-filter="{{ findExploreLanguageFilter }}"{% endif %} {% if findExploreSeedQuery %}data-find-explore-seed-query="{{ findExploreSeedQuery }}"{% endif %}{% if findExploreExternalResultsId %} data-find-explore-results-id="{{ findExploreExternalResultsId }}"{% endif %}{% if findExploreExternalYearOrderId %} data-find-explore-year-order-id="{{ findExploreExternalYearOrderId }}"{% endif %}{% if findExploreExternalAuthorSortId %} data-find-explore-author-sort-id="{{ findExploreExternalAuthorSortId }}"{% endif %}{% if findExploreExternalTypeRoleId %} data-find-explore-type-role-id="{{ findExploreExternalTypeRoleId }}"{% endif %}>
  <div class="site-shell">
    <div class="find-explore-card card border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="row g-4 align-items-start">
          <div class="col-lg-4">
            <p class="text-uppercase small text-muted mb-2">{{ findExploreEyebrow }}</p>
            <h2 id="{{ findExploreMountId }}Heading" class="h3 mb-2">{{ findExploreTitle }}</h2>
            <p class="text-muted mb-0">{{ findExploreDescription }}</p>
          </div>
          <div class="col-lg-8">
            <form class="find-explore-controls" role="search" data-find-explore-form>
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label small text-muted mb-1" for="{{ findExploreMountId }}Query">{{ findExploreSearchLabel }}</label>
                  <input id="{{ findExploreMountId }}Query" class="form-control form-control-lg" type="search" name="q" autocomplete="off" placeholder="{{ findExplorePlaceholder }}" data-find-explore-query>
                </div>
                {% if not findExploreHideTypeControl %}
                <div class="col-md-5">
                  <label class="form-label small text-muted mb-1" for="{{ findExploreMountId }}Type">{{ findExploreTypeLabel }}</label>
                  <select id="{{ findExploreMountId }}Type" class="form-select" name="type" data-find-explore-type>
                    <option value="">{{ findExploreAllTypesLabel }}</option>
                    {% for option in findExploreTypeOptions %}
                    <option value="{{ option.value }}">{{ option.label }}{% if option.count %} ({{ option.count }}){% endif %}</option>
                    {% endfor %}
                  </select>
                </div>
                {% endif %}
                {% if not findExploreHideRoleControl and findExploreRoleOptions and (findExploreRoleOptions | length) %}
                <div class="col-md-4">
                  <label class="form-label small text-muted mb-1" for="{{ findExploreMountId }}Role">{{ findExploreRoleLabel }}</label>
                  <select id="{{ findExploreMountId }}Role" class="form-select" name="role" data-find-explore-role>
                    <option value="">{{ findExploreAllRolesLabel }}</option>
                    {% for option in findExploreRoleOptions %}
                    <option value="{{ option.value }}">{{ option.label }}{% if option.count %} ({{ option.count }}){% endif %}</option>
                    {% endfor %}
                  </select>
                </div>
                {% endif %}
                {% if not findExploreHideYearControl %}
                <div class="col-md-4">
                  <label class="form-label small text-muted mb-1" for="{{ findExploreMountId }}Year">{{ findExploreYearLabel }}</label>
                  <select id="{{ findExploreMountId }}Year" class="form-select" name="year" data-find-explore-year>
                    <option value="">{{ findExploreAllYearsLabel }}</option>
                    {% for year in findExploreYears %}
                    <option value="{{ year }}">{{ year }}</option>
                    {% endfor %}
                  </select>
                </div>
                {% endif %}
                {% if findExploreTopicOptions and (findExploreTopicOptions | length) %}
                <div class="col-md-4">
                  <label class="form-label small text-muted mb-1" for="{{ findExploreMountId }}Topic">{{ findExploreTopicLabel }}</label>
                  <select id="{{ findExploreMountId }}Topic" class="form-select" name="topic" data-find-explore-topic>
                    <option value="">{{ findExploreAllTopicsLabel }}</option>
                    {% for option in findExploreTopicOptions %}
                    <option value="{{ option.value }}">{{ option.label }}{% if option.count %} ({{ option.count }}){% endif %}</option>
                    {% endfor %}
                  </select>
                </div>
                {% endif %}
                {% if findExploreQualityOptions and (findExploreQualityOptions | length) %}
                <div class="col-md-3">
                  <label class="form-label small text-muted mb-1" for="{{ findExploreMountId }}Quality">{{ findExploreQualityLabel }}</label>
                  <select id="{{ findExploreMountId }}Quality" class="form-select" name="quality" data-find-explore-quality>
                    <option value="">{{ findExploreAllQualityLabel }}</option>
                    {% for option in findExploreQualityOptions %}
                    <option value="{{ option.value }}">{{ option.label }}{% if option.count %} ({{ option.count }}){% endif %}</option>
                    {% endfor %}
                  </select>
                </div>
                {% endif %}
                {% if findExploreTopicOptions and (findExploreTopicOptions | length) %}
                <div class="col-md-3 d-flex align-items-end">
                {% else %}
                <div class="col-md-3 d-flex align-items-end">
                {% endif %}
                  <button class="btn btn-outline-secondary w-100" type="button" data-find-explore-reset>{{ findExploreResetLabel }}</button>
                </div>
              </div>
            </form>
            <div class="find-explore-status mt-3" role="status" aria-live="polite" aria-atomic="true" data-find-explore-status>
              {{ findExploreInitialStatus }}
            </div>
            {% if not findExploreExternalResultsId %}
            <div class="find-explore-results mt-3" data-find-explore-results></div>
            {% endif %}
            <button class="btn btn-outline-primary btn-sm mt-3 d-none" type="button" data-find-explore-more>{{ findExploreMoreLabel }}</button>
            <noscript>
              <p class="alert alert-info mt-3 mb-0">{{ findExploreNoScript }}</p>
            </noscript>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
