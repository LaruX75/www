{#
  Yhteiset navigaatio-macrot.

  Aiemmin megaNavTrigger oli maaritelty identtisena molemmissa
  kielikohtaisissa nav-tiedostoissa (_nav-fi.njk ja _nav-en.njk).
  Diff oli tyhja - macrolla ei ollut lainkaan kielikohtaista logiikkaa,
  vaan kaikki teksti (avaa-labelit, aria-labels) tulee kutsujan
  parametreista.

  Kaytto:
    {% import "_nav-macros.njk" as nav %}
    {{ nav.megaNavTrigger(url, title, icon, isActive, menuId, toggleId, openLabel) }}
#}
{% macro megaNavTrigger(url, title, icon, isActive, menuId, toggleId, openLabel) %}
<div class="mega-nav-trigger">
  <a class="nav-link mega-nav-link{% if isActive %} active{% endif %}" href="{{ url }}"{% if isActive %} aria-current="page"{% endif %}>
    <i class="{{ icon }} me-1"></i>{{ title }}
  </a>
  <button
    class="nav-link mega-nav-toggle dropdown-toggle"
    type="button"
    id="{{ toggleId }}"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="{{ menuId }}"
    aria-label="{{ openLabel }} {{ title }}"
  >
    <span class="visually-hidden">{{ openLabel }} {{ title }}</span>
  </button>
</div>
{% endmacro %}

{#
  Mobile-only "jump to top-level page" link rendered as the first child of
  each `.mega-wrap`. Hidden on desktop via .mega-mobile-jump { display: none }
  and revealed inside `@media (max-width: 767.98px)`. All inputs are
  deterministic at build time: the URL and title come from the same header
  navigation data that feeds `megaNavTrigger`; the jumpPrefix is the
  language-specific label set in header.njk. No runtime derivation needed.
#}
{% macro mobileJumpLink(url, title, jumpPrefix) %}
{% if url and url != '#' -%}
<a class="mega-mobile-jump" href="{{ url }}" aria-label="{{ jumpPrefix }} {{ title }}"><i class="bi bi-arrow-up-right-circle me-2"></i>{{ jumpPrefix }} {{ title }}</a>
{%- endif %}
{% endmacro %}

{#
  Compact horizontal overview strip rendered above the grouped-route
  sections of a mega-menu (desktop). Shared by Työ and Minä.

  Introduced by MEGAMENU-IA-01 (inline in Työ) and extracted here in
  MEGAMENU-SYSTEM-01B when Minä became the second consumer.

  Each link entry must have {title, href, icon} and may have
  {description, external}. Description is intentionally not rendered
  in the strip — chips stay compact. Callers pass an `aria-label`
  string that names the strip in the current locale.
#}
{% macro overviewStrip(links, ariaLabel) %}
{% if links %}
<nav class="mega-overview-strip" aria-label="{{ ariaLabel }}">
  {% for link in links %}
    <a class="mega-overview-link" href="{{ link.href }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
      <i class="{{ link.icon }}"></i><span>{{ link.title }}</span>
    </a>
  {% endfor %}
</nav>
{% endif %}
{% endmacro %}

{#
  Compact horizontal overview strip rendered inside the mobile
  offcanvas `<details>` block, above the section grid. Uses larger
  touch targets than the desktop variant.
#}
{% macro mobileOverviewStrip(links, ariaLabel) %}
{% if links %}
<nav class="mobile-nav-overview-strip" aria-label="{{ ariaLabel }}">
  {% for link in links %}
    <a class="mobile-nav-overview-link" href="{{ link.href }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
      <i class="{{ link.icon }}"></i><span>{{ link.title }}</span>
    </a>
  {% endfor %}
</nav>
{% endif %}
{% endmacro %}
