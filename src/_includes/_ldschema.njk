  {% set currentLang = lang or ("en" if (page.url and page.url.startsWith("/en/")) else "fi") %}
  {% set pageTitle = title or site.name %}
  {% set siteDescription = site.descriptionEn if currentLang == "en" else site.description %}
  {% set descriptionMissing = (not description) or description == site.description or description == site.descriptionEn %}
  {% set pageDescription = description or siteDescription %}
  {% if descriptionMissing and keyword %}
    {% if currentLang == "en" %}
      {% set pageDescription = 'Keyword "' ~ keyword.name ~ '" brings together ' ~ keyword.count ~ ' writings, speeches, or publications from the Jari Laru site.' %}
    {% else %}
      {% set pageDescription = 'Avainsana "' ~ keyword.name ~ '" kokoaa ' ~ keyword.count ~ ' kirjoitusta, puhetta tai julkaisua Jari Larun sivustolta.' %}
    {% endif %}
  {% elif descriptionMissing and category %}
    {% if currentLang == "en" %}
      {% set pageDescription = 'Category "' ~ category.name ~ '" gathers ' ~ category.count ~ ' related items from the Jari Laru site, including writings, speeches, and publications.' %}
    {% else %}
      {% set pageDescription = 'Kategoria "' ~ category.name ~ '" kokoaa ' ~ category.count ~ ' sisältöä Jari Larun sivustolta: kirjoituksia, puheita ja julkaisuja samasta aihepiiristä.' %}
    {% endif %}
  {% elif descriptionMissing and title and title.startsWith("Avainsana: ") %}
    {% set pageDescription = 'Avainsana "' ~ (title | replace("Avainsana: ", "")) ~ '" kokoaa kirjoituksia, puheita ja julkaisuja Jari Larun sivustolta.' %}
  {% elif descriptionMissing and title and title.startsWith("Keyword: ") %}
    {% set pageDescription = 'Keyword "' ~ (title | replace("Keyword: ", "")) ~ '" brings together writings, speeches, and publications from the Jari Laru site.' %}
  {% endif %}
  {% set effectivePublished = datePublished or page.date %}
  {% set pageDescription = pageDescription | seoDescription({ title: pageTitle, source: source, type: type, date: effectivePublished, pageUrl: page.url, tags: tags, categories: categories, currentLang: currentLang }) %}
  {% set siteBase = site.url or "https://www.jarilaru.fi" %}
  {% set pageUrl = page.url | absoluteUrl(siteBase) %}
  {% set imageAbs = resolvedOgImage | absoluteUrl(siteBase) %}
  {# Person-noodin @image on aina Jarin profiilikuva (Schema.org / Google
     Knowledge Graph -yhteensopivuus). Sivukohtainen imageAbs (yleensa OG-
     kuva) sailyy muissa noodeissa (Article, ImageObject jne.). #}
  {% set personImageAbs = "/img/WIN_20210329_16_06_01_Pro.jpg" | absoluteUrl(siteBase) %}
  {% set personId = siteBase + "#person" %}
  {% set orgId = siteBase + "#laruxtmi" %}
  {% set websiteId = siteBase + "#website" %}
  {% set breadcrumbId = pageUrl + "#breadcrumb" %}
  {% set uniName = "University of Oulu" if currentLang == "en" else "Oulun yliopisto" %}
  {% set uniId = "https://www.oulu.fi/#organization" %}
  {% set langCode = "fi-FI" if currentLang == "fi" else "en-US" %}

  {#
    Sisaltotyypin ja Schema.org-tyypin paattely tehdaan yhdella
    resolveContentMeta-filtterilla (src/_utils/resolveContentMeta.js).
    schemaType-frontmatter voittaa aina. Palauttaa:
    { contentType, contentTypeLabel, section, schemaType,
      pageBlockType, specialPageType }.
    Tassa templaatissa kaytetaan vain schemaType/pageBlockType/
    specialPageType-kenttia; muut ovat myohempaa kayttoa varten.
  #}
  {% set _contentMeta = ({
    "schemaType": schemaType,
    "type": type,
    "tags": tags,
    "mediaType": mediaType,
    "contentType": contentType,
    "source": source
  }) | resolveContentMeta %}
  {% set resolvedSchemaType = _contentMeta.schemaType %}
  {% set pageBlockType = _contentMeta.pageBlockType %}
  {% set specialPageType = _contentMeta.specialPageType %}

  {# --- Breadcrumb-lista rakennetaan aina jos ei kotisivu --- #}
  {% set ldBcItems = [] %}
  {% if not isHomePage %}
    {% set bcHomeUrl = "/en/" if currentLang == "en" else "/" %}
    {% set bcHomeTitle = "Home" if currentLang == "en" else "Etusivu" %}
    {% set bcNodes = headerNav.en if currentLang == "en" else headerNav.fi %}
    {% set bcNavItems = (bcNodes | eleventyNavigationBreadcrumb(breadcrumbKey, { includeSelf: true, allowMissing: true })) if breadcrumbKey else [] %}
    {% set bcAppendCurrent = pageTitle and (not bcNavItems.length or bcNavItems[bcNavItems.length - 1].url != page.url) %}
    {% set _ = (ldBcItems.push({ "@type": "ListItem", "position": 1, "name": bcHomeTitle, "item": bcHomeUrl | absoluteUrl(siteBase) }), null) %}
    {% for crumb in bcNavItems %}
      {% if crumb.url != bcHomeUrl and crumb.title != bcHomeTitle %}
        {% set _ = (ldBcItems.push({ "@type": "ListItem", "position": ldBcItems.length + 1, "name": crumb.title, "item": crumb.url | absoluteUrl(siteBase) }), null) %}
      {% endif %}
    {% endfor %}
    {% if breadcrumbDetailTitle and bcAppendCurrent %}
      {% set _ = (ldBcItems.push({ "@type": "ListItem", "position": ldBcItems.length + 1, "name": breadcrumbDetailTitle, "item": breadcrumbDetailUrl | absoluteUrl(siteBase) }), null) %}
    {% endif %}
    {% if bcAppendCurrent %}
      {% set _ = (ldBcItems.push({ "@type": "ListItem", "position": ldBcItems.length + 1, "name": pageTitle }), null) %}
    {% endif %}
  {% endif %}

  {# --- Rakennetaan @graph-noodit --- #}
  {% set graph = [] %}

  {% set searchUrlTemplate = siteBase + ("/en/search/?q={search_term_string}" if currentLang == "en" else "/haku/?q={search_term_string}") %}
  {% set _ = (graph.push({
    "@type": "WebSite",
    "@id": websiteId,
    "url": siteBase,
    "name": site.name,
    "description": siteDescription,
    "inLanguage": langCode,
    "publisher": { "@id": personId },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": searchUrlTemplate
      },
      "query-input": "required name=search_term_string"
    }
  }), null) %}

  {% set _ = (graph.push({
    "@type": "Person",
    "@id": personId,
    "name": site.author,
    "givenName": "Jari",
    "familyName": "Laru",
    "honorificPrefix": ("EdD" if currentLang == "en" else "KT"),
    "url": siteBase,
    "image": personImageAbs,
    "jobTitle": ("University Lecturer" if currentLang == "en" else "Yliopistonlehtori"),
    "worksFor": { "@id": uniId },
    "affiliation": { "@id": uniId },
    "alumniOf": { "@id": uniId },
    "knowsLanguage": ["fi", "en"],
    "sameAs": (site.sameAs or [])
  }), null) %}

  {% set _ = (graph.push({
    "@type": "CollegeOrUniversity",
    "@id": uniId,
    "name": uniName,
    "url": "https://www.oulu.fi"
  }), null) %}

  {% if not isHomePage and ldBcItems.length %}
    {% set _ = (graph.push({
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      "itemListElement": ldBcItems
    }), null) %}
  {% endif %}

  {% if pageBlockType == "presentation" %}
    {% set presNode = {
      "@type": "PresentationDigitalDocument",
      "@id": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "url": pageUrl,
      "datePublished": (effectivePublished | dateToRfc3339),
      "inLanguage": langCode,
      "author": { "@id": personId },
      "publisher": { "@id": personId }
    } %}
    {% if thumbnail %}{% set _ = (presNode.__setitem__ if false else null) %}{% set presNode = (presNode | merge({ "thumbnailUrl": thumbnail })) %}{% endif %}
    {% if url %}{% set presNode = (presNode | merge({ "sameAs": [url] })) %}{% endif %}
    {% if not isHomePage and ldBcItems.length %}{% set presNode = (presNode | merge({ "breadcrumb": { "@id": breadcrumbId } })) %}{% endif %}
    {% set _ = (graph.push(presNode), null) %}

  {% elif pageBlockType == "article" %}
    {% set extSameAs = [] %}
    {% if sourceUrl %}{% set _ = (extSameAs.push(sourceUrl), null) %}{% endif %}
    {% if externalUrl and externalUrl != sourceUrl %}{% set _ = (extSameAs.push(externalUrl), null) %}{% endif %}
    {% set articleNode = {
      "@type": resolvedSchemaType,
      "@id": pageUrl,
      "headline": pageTitle,
      "description": pageDescription,
      "url": pageUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "image": { "@type": "ImageObject", "url": imageAbs },
      "datePublished": (effectivePublished | dateToRfc3339),
      "inLanguage": langCode,
      "author": { "@id": personId },
      "publisher": { "@id": personId },
      "isPartOf": { "@id": websiteId }
    } %}
    {% set effectiveModified = modified or gitDates[page.inputPath] %}
    {% if effectiveModified %}{% set articleNode = (articleNode | merge({ "dateModified": (effectiveModified | dateToRfc3339) })) %}{% endif %}
    {% if categories and categories.length %}{% set articleNode = (articleNode | merge({ "articleSection": categories })) %}{% endif %}
    {% if keywords and keywords.length %}{% set articleNode = (articleNode | merge({ "keywords": keywords })) %}{% endif %}
    {% if extSameAs.length %}{% set articleNode = (articleNode | merge({ "sameAs": extSameAs })) %}{% endif %}
    {% if not isHomePage and ldBcItems.length %}{% set articleNode = (articleNode | merge({ "breadcrumb": { "@id": breadcrumbId } })) %}{% endif %}
    {% set _ = (graph.push(articleNode), null) %}

  {% elif pageBlockType == "business" %}
    {% set bizNode = {
      "@type": resolvedSchemaType,
      "@id": orgId,
      "name": "Larux t:mi",
      "alternateName": pageTitle,
      "description": pageDescription,
      "url": pageUrl,
      "image": { "@type": "ImageObject", "url": imageAbs },
      "inLanguage": langCode,
      "areaServed": { "@type": "Country", "name": "Finland" },
      "founder": { "@id": personId },
      "employee": { "@id": personId },
      "sameAs": (site.sameAs or []),
      "isPartOf": { "@id": websiteId }
    } %}
    {% if not isHomePage and ldBcItems.length %}{% set bizNode = (bizNode | merge({ "breadcrumb": { "@id": breadcrumbId } })) %}{% endif %}
    {% if services and services.length %}
      {% set offerItems = [] %}
      {% for svc in services %}
        {% set _ = (offerItems.push({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": svc.name,
            "description": svc.description,
            "provider": { "@id": orgId },
            "areaServed": { "@type": "Country", "name": "Finland" }
          }
        }), null) %}
      {% endfor %}
      {% set bizNode = (bizNode | merge({
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": ("Services" if currentLang == "en" else "Palvelut"),
          "itemListElement": offerItems
        }
      })) %}
    {% endif %}
    {% set _ = (graph.push(bizNode), null) %}

  {% elif pageBlockType == "thesis" %}
    {% set thesisNode = {
      "@type": "Thesis",
      "@id": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "url": pageUrl,
      "image": { "@type": "ImageObject", "url": imageAbs },
      "inLanguage": langCode,
      "datePublished": (datePublished or (effectivePublished | dateToRfc3339)),
      "author": { "@id": personId },
      "publisher": { "@id": uniId },
      "isPartOf": { "@id": websiteId }
    } %}
    {% if thesisSchemaAuthors and thesisSchemaAuthors.length %}{% set thesisNode = (thesisNode | merge({ "author": thesisSchemaAuthors })) %}{% endif %}
    {% if thesisSchemaSameAs %}{% set thesisNode = (thesisNode | merge({ "sameAs": thesisSchemaSameAs })) %}{% endif %}
    {% if thesisSchemaKeywords and thesisSchemaKeywords.length %}{% set thesisNode = (thesisNode | merge({ "keywords": thesisSchemaKeywords })) %}{% endif %}
    {% if thesisSchemaCitation %}{% set thesisNode = (thesisNode | merge({ "citation": thesisSchemaCitation })) %}{% endif %}
    {% if not isHomePage and ldBcItems.length %}{% set thesisNode = (thesisNode | merge({ "breadcrumb": { "@id": breadcrumbId } })) %}{% endif %}
    {% set _ = (graph.push(thesisNode), null) %}

  {% elif pageBlockType == "specialpage" %}
    {% set specialNode = {
      "@type": specialPageType,
      "@id": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "url": pageUrl,
      "image": { "@type": "ImageObject", "url": imageAbs },
      "inLanguage": langCode,
      "isPartOf": { "@id": websiteId },
      "author": { "@id": personId }
    } %}
    {% if schemaAbout and schemaAbout.length %}{% set specialNode = (specialNode | merge({ "about": schemaAbout })) %}{% endif %}
    {% if schemaMentions and schemaMentions.length %}{% set specialNode = (specialNode | merge({ "mentions": schemaMentions })) %}{% endif %}
    {% if specialPageType == "ProfilePage" or specialPageType == "AboutPage" %}{% set specialNode = (specialNode | merge({ "mainEntity": { "@id": personId } })) %}{% endif %}
    {% if not isHomePage and ldBcItems.length %}{% set specialNode = (specialNode | merge({ "breadcrumb": { "@id": breadcrumbId } })) %}{% endif %}
    {% set _ = (graph.push(specialNode), null) %}

  {% else %}
    {% set webNode = {
      "@type": "WebPage",
      "@id": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "url": pageUrl,
      "image": { "@type": "ImageObject", "url": imageAbs },
      "inLanguage": langCode,
      "isPartOf": { "@id": websiteId },
      "author": { "@id": personId }
    } %}
    {% if schemaAbout and schemaAbout.length %}{% set webNode = (webNode | merge({ "about": schemaAbout })) %}{% endif %}
    {% if schemaMentions and schemaMentions.length %}{% set webNode = (webNode | merge({ "mentions": schemaMentions })) %}{% endif %}
    {% if not isHomePage and ldBcItems.length %}{% set webNode = (webNode | merge({ "breadcrumb": { "@id": breadcrumbId } })) %}{% endif %}
    {% set _ = (graph.push(webNode), null) %}
  {% endif %}

  <script type="application/ld+json">
  {{ { "@context": "https://schema.org", "@graph": graph } | jsonSafe | safe }}
  </script>
