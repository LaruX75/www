{% set currentLang = lang or (page.url | langFromUrl) %}
{% set currentTags = tags or [] %}
{% set currentKeywords = keywords or [] %}
{% set currentContexts = contexts or [] %}
{% set currentContentContexts = contentContexts or [] %}
{% set currentPlaces = places or [] %}
{% set currentEntities = entities or [] %}
{% set currentForums = forum or [] %}
{% set currentAgendaTitle = agenda_title or "" %}
{% set isSpeechContext = type == "puhe" %}
{% set isQuestionHour = currentAgendaTitle == "Valtuuston kyselytunti" or ("Valtuuston kyselytunti" in currentContexts) %}
{% set relatedItems = collections | relatedContent(page.url, categories, currentKeywords, currentTags, type, currentContexts, 4) %}
{% set sameMeetingGroup = collections | sameCouncilMeetingGroup(page.url, 6, currentLang) %}
{% set termCloud = collections | contentTermCloud([], currentKeywords, 12) %}
{% set isEnglish = currentLang == "en" %}
{% set txt = {
  "context": "Collection",
  "toc": "Contents",
  "belongs": "Browse the same material",
  "contexts": "Context paths",
  "topicProfiles": "Topic paths",
  "topicProfilesTitle": "This content is part of",
  "categories": "Categories",
  "contentContexts": "Content context",
  "places": "Places and areas",
  "entities": "People and organizations",
  "forums": "Forum",
  "handling": "Handling",
  "sameMeeting": "Same council meeting",
  "meetingPage": "Open meeting",
  "protocol": "Minutes",
  "meetingVideo": "Meeting video",
  "tags": "Tags",
  "keywords": "Keywords",
  "related": "See also",
  "noRelated": "No closely related items found yet."
} if isEnglish else {
  "context": "Kokonaisuus",
  "toc": "Sisällys",
  "belongs": "Selaa samaa aineistoa",
  "contexts": "Kontekstipolut",
  "topicProfiles": "Aihepolut",
  "topicProfilesTitle": "Tämä sisältö liittyy",
  "categories": "Kategoriat",
  "contentContexts": "Sisältökonteksti",
  "places": "Paikat ja alueet",
  "entities": "Toimijat ja organisaatiot",
  "forums": "Toimielin",
  "handling": "Käsittely",
  "sameMeeting": "Samassa kokouksessa",
  "meetingPage": "Avaa kokous",
  "protocol": "Pöytäkirja",
  "meetingVideo": "Kokousvideo",
  "tags": "Tunnisteet",
  "keywords": "Avainsanat",
  "related": "Katso myös",
  "noRelated": "Läheisiä sisältöjä ei vielä löytynyt."
} %}

{% set contentContextLabels = {
  "akateemiset juhlat": "Akateemiset juhlat",
  "kaupunkistrategia": "Kaupunkistrategia",
  "kulttuuripääkaupunki": "Kulttuuripääkaupunki",
  "lukion valtaus": "Lukion valtaus",
  "museo- ja tiedekeskus": "Museo- ja tiedekeskus",
  "pääpuhe": "Pääpuhe",
  "puhe miekalle": "Puhe miekalle",
  "talousarvio": "Talousarvio",
  "tohtoripromootio": "Tohtoripromootio",
  "valmisteluprosessi": "Valmisteluprosessi",
  "ylioppilasjuhla": "Ylioppilasjuhla"
} %}

{% set topicMatches = [] %}
{% if not isEnglish and seoTopics %}
  {% set topicMatches = seoTopics | matchingTopics(title, description, categories, currentKeywords, currentTags, type, currentContexts, page.url, 2 if isSpeechContext else 3) %}
{% endif %}

{#
  Sivupalkin "Selaa samaa aineistoa" -linkin { typeLabel, archiveHref,
  archiveLabel } lasketaan JS-filtterissa sidebarContext (aiemmin 82 rivin
  Nunjucks-ketju). Sivupalkkilabelit sailyvat rikkaampina kuin
  resolveContentMeta:n contentTypeLabel (esim. "Mediaosuma / video",
  "Poliittinen ja asiantuntijamielipide").
#}
{% set _sidebarCtx = ({
  "tags": currentTags,
  "contexts": currentContexts,
  "opinionRoles": opinionRoles,
  "type": type,
  "speechContext": speechContext,
  "mediaType": mediaType,
  "mediaRole": mediaRole,
  "agenda_title": currentAgendaTitle
}) | sidebarContext(currentLang) %}
{% set typeLabel = _sidebarCtx.typeLabel %}
{% set archiveHref = _sidebarCtx.archiveHref %}
{% set archiveLabel = _sidebarCtx.archiveLabel %}

<div class="content-context-sidebar">
  {% if tocMarkup %}
  <div class="content-context-card content-context-toc">
    <p class="content-context-kicker">{{ txt.toc }}</p>
    {{ tocMarkup | safe }}
  </div>
  {% endif %}

  <div class="content-context-card content-context-card--primary">
    <p class="content-context-kicker">{{ txt.context }}</p>
    <h2 class="content-context-title">{{ txt.belongs }}</h2>
    <a class="content-context-type" href="{{ archiveHref }}">
      <span>{{ typeLabel }}</span>
      <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  {% if topicMatches.length %}
  <div class="content-context-card content-context-card--topics">
    <p class="content-context-kicker">{{ txt.topicProfiles }}</p>
    <h2 class="content-context-title">{{ txt.topicProfilesTitle }}</h2>
    <div class="content-context-topiclist">
      {% for topic in topicMatches %}
      <a class="content-context-topic" href="/teemat/{{ topic.slug }}/">
        <span>{{ topic.title }}</span>
        <small>Avaa aihepolku</small>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if currentContexts.length and not isSpeechContext %}
  <div class="content-context-card">
    <p class="content-context-kicker">{{ txt.contexts }}</p>
    <div class="content-context-chiplist">
      {% for ctx in currentContexts %}
      <a class="content-context-chip content-context-chip--context" href="{{ ctx | contextHref(currentLang) }}">{{ ctx | contextLabel(currentLang) }}</a>
      {% endfor %}
    </div>
    {% if currentForums.length %}
    <div class="content-context-forum">
      <p class="content-context-subkicker">{{ txt.forums }}</p>
      <div class="content-context-chiplist">
        {% for item in currentForums %}
        <a class="content-context-chip content-context-chip--forum" href="{{ '/en/writings/#puheet' if isEnglish else '/valtuustotyo/#puheet' }}">{{ item }}</a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if isSpeechContext and currentForums.length %}
  <div class="content-context-card">
    <p class="content-context-kicker">{{ txt.handling }}</p>
    <div class="content-context-chiplist">
      {% for item in currentForums %}
      <a class="content-context-chip content-context-chip--forum" href="{{ '/en/writings/#puheet' if isEnglish else '/valtuustotyo/#puheet' }}">{{ item }}</a>
      {% endfor %}
      {% if isQuestionHour %}
      <span class="content-context-chip content-context-chip--context">{{ currentAgendaTitle or "Valtuuston kyselytunti" }}</span>
      {% endif %}
      {% for item in currentContentContexts %}
      {% if not isQuestionHour or item != "Valtuuston kyselytunti" %}
      <span class="content-context-chip content-context-chip--context">{{ contentContextLabels[item] or item }}</span>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if sameMeetingGroup.items.length %}
  <div class="content-context-card content-context-card--same-meeting">
    <p class="content-context-kicker">{{ txt.sameMeeting }}</p>
    <h2 class="content-context-title">{{ sameMeetingGroup.meetingLabel }}</h2>
    <p class="content-context-meeting-meta">
      <span>{{ sameMeetingGroup.contextLabel }}</span>
      <span>{{ sameMeetingGroup.meetingDate | dateFormat }}</span>
      <a href="/politiikka/kaupunginvaltuusto/kokoukset/{{ sameMeetingGroup.meetingDate }}/">{{ txt.meetingPage }}</a>
      {% if sameMeetingGroup.protocolUrl %}
      <a href="{{ sameMeetingGroup.protocolUrl }}" target="_blank" rel="noopener">{{ txt.protocol }}</a>
      {% endif %}
      {% if sameMeetingGroup.video and sameMeetingGroup.video.url %}
      <a href="{{ sameMeetingGroup.video.url }}" target="_blank" rel="noopener">{{ txt.meetingVideo }}</a>
      {% endif %}
    </p>
    <ol class="content-context-related content-context-related--same-meeting">
      {% for item in sameMeetingGroup.items %}
      <li>
        <a href="{{ item.url }}">{{ item.title }}</a>
        <span>{{ item.typeLabel }}{% if item.detailLabel %} · {{ item.detailLabel }}{% endif %}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  {% if not isSpeechContext and (currentContentContexts.length or currentPlaces.length or currentEntities.length) %}
  <div class="content-context-card">
    {% if currentContentContexts.length %}
      <p class="content-context-kicker">{{ txt.contentContexts }}</p>
      <div class="content-context-chiplist">
        {% for item in currentContentContexts %}
        <span class="content-context-chip content-context-chip--context">{{ item }}</span>
        {% endfor %}
      </div>
    {% endif %}
    {% if currentPlaces.length %}
      <div class="content-context-forum">
        <p class="content-context-subkicker">{{ txt.places }}</p>
        <div class="content-context-chiplist">
          {% for item in currentPlaces %}
          <span class="content-context-chip content-context-chip--forum">{{ item }}</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    {% if currentEntities.length %}
      <div class="content-context-forum">
        <p class="content-context-subkicker">{{ txt.entities }}</p>
        <div class="content-context-chiplist">
          {% for item in currentEntities %}
          <span class="content-context-chip content-context-chip--category">{{ item }}</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
  {% endif %}

  {% if categories and not isSpeechContext %}
  <details class="content-context-card content-context-details">
    <summary class="content-context-details-summary">{{ txt.categories }}</summary>
    <div class="content-context-chiplist">
      {% for cat in categories %}
      {% if cat | taxonomyIndexed(collections.categoryList, 2) %}
      <a class="content-context-chip content-context-chip--category" href="{{ '/en/categories/' if isEnglish else '/kategoriat/' }}{{ cat | slugify }}/">{{ cat | termLabel("en" if isEnglish else "fi", "category") }}</a>
      {% else %}
      <span class="content-context-chip content-context-chip--category">{{ cat | termLabel("en" if isEnglish else "fi", "category") }}</span>
      {% endif %}
      {% endfor %}
    </div>
  </details>
  {% endif %}

  {% if termCloud.length and not isSpeechContext %}
  <details class="content-context-card content-context-details">
    <summary class="content-context-details-summary">{{ txt.keywords }}</summary>
    <div class="content-context-cloud">
      {% for term in termCloud %}
      {% if term.name | taxonomyIndexed(collections.keywordList, 3) %}
      <a class="content-context-term content-context-term--{{ term.weight }}" href="{{ '/en/keywords/' if isEnglish else '/avainsanat/' }}{{ term.name | slugify }}/">
        {{ term.name }}
      </a>
      {% else %}
      <span class="content-context-term content-context-term--{{ term.weight }}">
        {{ term.name }}
      </span>
      {% endif %}
      {% endfor %}
    </div>
  </details>
  {% endif %}

  {% if isSpeechContext and (currentKeywords.length or currentContentContexts.length or currentPlaces.length or currentEntities.length) %}
  <details class="content-context-card content-context-details">
    <summary class="content-context-details-summary">{{ txt.tags }}</summary>
    <div class="content-context-chiplist">
      {% if not currentForums.length %}
        {% for item in currentContentContexts %}
        <span class="content-context-chip content-context-chip--context">{{ contentContextLabels[item] or item }}</span>
        {% endfor %}
      {% endif %}
      {% for item in currentKeywords %}
      {% if item | taxonomyIndexed(collections.keywordList, 3) %}
      <a class="content-context-chip content-context-chip--category" href="{{ '/en/keywords/' if isEnglish else '/avainsanat/' }}{{ item | slugify }}/">{{ item }}</a>
      {% else %}
      <span class="content-context-chip content-context-chip--category">{{ item }}</span>
      {% endif %}
      {% endfor %}
      {% for item in currentPlaces %}
      <span class="content-context-chip content-context-chip--forum">{{ item }}</span>
      {% endfor %}
      {% for item in currentEntities %}
        {% if item != "Oulun kaupunginvaltuusto" %}
        <span class="content-context-chip content-context-chip--category">{{ item }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </details>
  {% endif %}

  <div class="content-context-card">
    <p class="content-context-kicker">{{ txt.related }}</p>
    {% if relatedItems.length %}
    <ol class="content-context-related">
      {% for item in relatedItems %}
      <li>
        <a href="{{ item.url }}">{{ item.title }}</a>
        <span>{{ item.typeLabel }}</span>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="small text-muted mb-0">{{ txt.noRelated }}</p>
    {% endif %}
  </div>

  <a class="content-context-archive-link" href="{{ archiveHref }}">{{ archiveLabel }}</a>
</div>
