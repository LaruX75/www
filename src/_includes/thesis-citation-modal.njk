{#
  thesis-citation-modal.njk — TH-CITE1 Phase 4B.

  Detail-page citation/export modal. Split from thesis-hub-modals.njk
  intentionally: the abstract-modal that used to ship alongside the
  citation modal was tied to the old rich archive-card UX and is not
  needed on the thesis detail page, where the abstract is already
  rendered natively in the body.

  All bibliographic composition inside the modal must go through the
  shared publicationCitation renderer via `data-thesis-csl` on the
  trigger element. No raw-field composition happens here.
#}
{% set thesisHubIsEn = (currentLang or lang or "fi") == "en" %}
<div class="modal fade citation-export-modal" id="thesisCitationModal" tabindex="-1" aria-labelledby="thesisCitationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="thesisCitationModalLabel">{{ "Export citation" if thesisHubIsEn else "Vie lähdeviite" }}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close' if thesisHubIsEn else 'Sulje' }}"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-lg-5">
            <label for="thesisCitationFormatSelect" class="form-label small text-muted">{{ "Citation format" if thesisHubIsEn else "Viittausmuoto" }}</label>
            <select id="thesisCitationFormatSelect" class="form-select form-select-sm">
              <option value="apa">APA 7</option>
              <option value="mla">MLA</option>
              <option value="chicago">Chicago</option>
              <option value="bibtex">BibTeX (.bib)</option>
            </select>
          </div>
          <div class="col-12 col-lg-7">
            <div class="citation-export-actions">
              <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="thesisCitationCopyBtn">
                <i class="bi bi-clipboard me-1"></i>{{ "Copy" if thesisHubIsEn else "Kopioi" }}
              </button>
              <button type="button" class="btn btn-primary btn-sm rounded-pill" id="thesisCitationDownloadBtn">
                <i class="bi bi-download me-1"></i>{{ "Download" if thesisHubIsEn else "Lataa" }}
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="thesisCitationZoteroBtn" title="{{ 'Download RIS for Zotero import' if thesisHubIsEn else 'Lataa RIS Zotero-tuontiin' }}">
                <img src="https://cdn.simpleicons.org/zotero/cc2936" alt="" width="14" height="14" class="me-1 align-text-bottom">Zotero
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="thesisCitationMendeleyBtn" title="{{ 'Download RIS for Mendeley import' if thesisHubIsEn else 'Lataa RIS Mendeley-tuontiin' }}">
                <img src="https://cdn.simpleicons.org/mendeley/9d1620" alt="" width="14" height="14" class="me-1 align-text-bottom">Mendeley
              </button>
            </div>
          </div>
        </div>
        <div class="mt-3">
          <label for="thesisCitationOutput" class="form-label small text-muted mb-1">{{ "Preview" if thesisHubIsEn else "Esikatselu" }}</label>
          <textarea id="thesisCitationOutput" class="form-control form-control-sm font-monospace" rows="12" readonly></textarea>
        </div>
      </div>
    </div>
  </div>
</div>
