<section class="py-5 bg-body-tertiary border-top border-bottom" id="kaikki-esitykset" aria-labelledby="kaikki-esitykset-heading" data-presentation-mobile-priority="2">
  <div class="site-shell">
    <details class="presentation-mobile-disclosure" data-presentation-mobile-collapse open>
      <summary class="presentation-mobile-disclosure-summary">
        <span>Kaikki esitykset ja materiaalit</span>
        <small>Selaa ja rajaa sisältöjä</small>
      </summary>
      <div class="presentation-mobile-disclosure-body">
        <div class="presentation-section-head">
          <p class="presentation-section-kicker mb-1">Kaikki esitykset ja materiaalit</p>
          <h2 id="kaikki-esitykset-heading" class="presentation-section-title">Selaa esityksiä ja opetusmateriaaleja</h2>
          <p class="presentation-section-lead mb-0">Valitse ensin käyttötarkoitus. Opintojakso- ja muut tarkemmat rajaukset tulevat mukaan vasta, kun niistä on hyötyä.</p>
        </div>

        <div class="presentation-archive-toolbar" aria-label="Suodata esityksiä käyttötarkoituksen ja tarkennusten mukaan">
          <div class="presentation-archive-filter-group presentation-archive-filter-group--primary">
            <span class="presentation-archive-filter-label">Mitä etsit?</span>
            <button class="presentation-archive-filter is-active" type="button" data-presentation-filter="all">Kaikki</button>
            <button class="presentation-archive-filter" type="button" data-presentation-filter="route:puheenvuorot">Puheenvuorot</button>
            <button class="presentation-archive-filter" type="button" data-presentation-filter="route:opintojaksot">Opintojaksot</button>
            <button class="presentation-archive-filter" type="button" data-presentation-filter="route:koulutukset">Koulutukset ja työpajat</button>
            <button class="presentation-archive-filter" type="button" data-presentation-filter="route:materiaalit">Videot ja materiaalit</button>
          </div>

          <div class="presentation-archive-refiners" data-presentation-refiners hidden>
            <div class="presentation-archive-refiner" data-presentation-refiner="route:puheenvuorot" hidden>
              <span class="presentation-archive-filter-label">Tarkenna puheenvuoroja</span>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="category:konferenssi-keynote">Keynotet</button>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="category:kansainvälinen-konferenssi">Konferenssit</button>
            </div>

            <div class="presentation-archive-refiner" data-presentation-refiner="route:opintojaksot" hidden>
              <div class="presentation-archive-filter-group presentation-archive-filter-group--select">
                <label class="presentation-archive-filter-label" for="presentation-course-filter">Tarkenna opintojaksoa</label>
                <select class="presentation-archive-select" id="presentation-course-filter" aria-label="Rajaa opintojaksokontekstin mukaan">
                  <option value="all">Kaikki opintojaksot</option>
                </select>
              </div>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="category:tdk-luento">Yliopistoluennot</button>
            </div>

            <div class="presentation-archive-refiner" data-presentation-refiner="route:koulutukset" hidden>
              <span class="presentation-archive-filter-label">Tarkenna koulutuksia</span>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="category:täydennyskoulutus">Täydennyskoulutukset</button>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="category:webinaari">Webinaarit</button>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="category:hanke-esittely">Hanke-esittelyt</button>
            </div>

            <div class="presentation-archive-refiner" data-presentation-refiner="route:materiaalit" hidden>
              <span class="presentation-archive-filter-label">Tarkenna materiaaleja</span>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="aoe">Avoimet oppimateriaalit</button>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="video">Videot</button>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="analysis">Analyysit</button>
              <button class="presentation-archive-filter" type="button" data-presentation-filter="oppimisymparisto">Oppimisympäristöt</button>
            </div>
          </div>

          <details class="presentation-archive-advanced">
            <summary>Tarkenna hakua</summary>
            <div class="presentation-archive-advanced-body">
              <div class="presentation-archive-filter-group">
                <span class="presentation-archive-filter-label">Rooli</span>
                <button class="presentation-archive-filter" type="button" data-presentation-filter="profile:kouluttaja">Kouluttaja</button>
                <button class="presentation-archive-filter" type="button" data-presentation-filter="profile:tutkija">Tutkija</button>
                <button class="presentation-archive-filter" type="button" data-presentation-filter="profile:asiantuntija">Asiantuntija</button>
              </div>
            </div>
          </details>
        </div>

        <div class="presentation-archive-status" id="presentation-unified-status" aria-live="polite"></div>
        <div class="presentation-archive-grid" id="presentation-unified-archive"></div>
        <nav class="mt-4" aria-label="Kaikki esitykset ja materiaalit -sivutus">
          <ul class="pagination pagination-sm mb-0 justify-content-center" id="presentation-unified-pagination"></ul>
        </nav>
      </div>
    </details>
  </div>
</section>
