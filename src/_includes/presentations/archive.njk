{% set archiveItems = presentationArchiveItems or ((presentationsPage and presentationsPage.items) or []) %}
{% set archiveLocale = presentationArchiveLocale or (lang or "fi") %}
{% set archiveFilterYears = presentationArchiveFilterYears or ((presentationsPage and presentationsPage.filterYears) or []) %}
{% set archiveFilterTopics = presentationArchiveFilterTopics or ((presentationsPage and presentationsPage.filterTopics) or []) %}
{% set cardReturnTo = "/en/presentations/" if archiveLocale == "en" else "/esitykset/" %}

{% if archiveLocale == "en" %}
  {% set presentationArchiveSectionSummary = "Browse presentations" %}
  {% set presentationArchiveSectionDetail = "Search by free text, year or topic" %}
  {% set presentationArchiveKicker = "Canonical archive" %}
  {% set presentationArchiveTitle = "Find presentations and learning materials" %}
  {% set presentationArchiveLead = "The shared archive lists canonical presentations only once per presentation. Search by free text, year or topic, and each result follows the approved preferred landing." %}
  {% set presentationArchiveSearchLabel = "Search" %}
  {% set presentationArchiveSearchPlaceholder = "Search titles, topics or events" %}
  {% set presentationArchiveYearLabel = "Year" %}
  {% set presentationArchiveAllYearsLabel = "All years" %}
  {% set presentationArchiveTopicLabel = "Topic" %}
  {% set presentationArchiveTopicPlaceholder = "Choose or type a topic" %}
  {% set presentationArchiveTopicHint = "All results also include topicless presentations unless you choose a specific topic." %}
  {% set presentationArchiveResetLabel = "Reset" %}
  {% set presentationArchiveOpenLabel = "Open" %}
  {% set presentationArchiveExternalBadgeLabel = "External" %}
  {% set presentationArchiveLocalBadgeLabel = "Local page" %}
  {% set presentationArchiveMetaAriaLabel = "Presentation metadata" %}
  {% set presentationArchivePaginationLabel = "Presentations pagination" %}
{% else %}
  {% set presentationArchiveSectionSummary = "Kaikki esitykset" %}
  {% set presentationArchiveSectionDetail = "Hae vapaasti tai rajaa vuodella ja aiheella" %}
  {% set presentationArchiveKicker = "Kanoninen arkisto" %}
  {% set presentationArchiveTitle = "Selaa esityksiä ja opetusmateriaaleja" %}
  {% set presentationArchiveLead = "Jaettu Find & Explore -arkisto näyttää yhden kanonisen tuloksen per esitys. Rajaa vapaasanalla, vuodella tai aiheella, ja avaus noudattaa hyväksyttyä ensisijaista laskeutumista." %}
  {% set presentationArchiveSearchLabel = "Haku" %}
  {% set presentationArchiveSearchPlaceholder = "Hae otsikoita, aiheita tai tapahtumia" %}
  {% set presentationArchiveYearLabel = "Vuosi" %}
  {% set presentationArchiveAllYearsLabel = "Kaikki vuodet" %}
  {% set presentationArchiveTopicLabel = "Aihe" %}
  {% set presentationArchiveTopicPlaceholder = "Valitse tai kirjoita aihe" %}
  {% set presentationArchiveTopicHint = "Kaikki-tulosjoukko sisältää myös esitykset, joille ei ole merkitty aihetta." %}
  {% set presentationArchiveResetLabel = "Tyhjennä" %}
  {% set presentationArchiveOpenLabel = "Avaa" %}
  {% set presentationArchiveExternalBadgeLabel = "Ulkoinen" %}
  {% set presentationArchiveLocalBadgeLabel = "Paikallinen sivu" %}
  {% set presentationArchiveMetaAriaLabel = "Esityksen metatiedot" %}
  {% set presentationArchivePaginationLabel = "Esitysten sivutus" %}
{% endif %}

<section class="py-5 bg-body-tertiary border-top border-bottom" id="kaikki-esitykset" aria-labelledby="kaikki-esitykset-heading" data-presentation-mobile-priority="2">
  <div class="site-shell">
    <details class="presentation-mobile-disclosure" data-presentation-mobile-collapse open>
      <summary class="presentation-mobile-disclosure-summary">
        <span>{{ presentationArchiveSectionSummary }}</span>
        <small>{{ presentationArchiveSectionDetail }}</small>
      </summary>
      <div class="presentation-mobile-disclosure-body">
        <div class="presentation-section-head">
          <p class="presentation-section-kicker mb-1">{{ presentationArchiveKicker }}</p>
          <h2 id="kaikki-esitykset-heading" class="presentation-section-title">{{ presentationArchiveTitle }}</h2>
          <p class="presentation-section-lead mb-0">{{ presentationArchiveLead }}</p>
        </div>

        <div class="presentation-archive-root" data-presentation-find-explore data-locale="{{ archiveLocale }}">
          {% if archiveLocale == "fi" %}
          <div class="starter-chips" data-starter-chips aria-label="Aloita tästä: valmiit esitysteemat">
            <p class="starter-chips-eyebrow">Aloita tästä</p>
            <ul class="starter-chips-list">
              <li><button type="button" class="starter-chip" data-starter-chip data-starter-chip-target="#presentation-archive-topic" data-starter-chip-value="AI literacy" data-starter-chip-event="change">AI literacy</button></li>
              <li><button type="button" class="starter-chip" data-starter-chip data-starter-chip-target="#presentation-archive-topic" data-starter-chip-value="Tekoäly" data-starter-chip-event="change">Tekoäly</button></li>
              <li><button type="button" class="starter-chip" data-starter-chip data-starter-chip-target="#presentation-archive-topic" data-starter-chip-value="Koulutusteknologia" data-starter-chip-event="change">Koulutusteknologia</button></li>
              <li><button type="button" class="starter-chip" data-starter-chip data-starter-chip-target="#presentation-archive-topic" data-starter-chip-value="Opettajankoulutus" data-starter-chip-event="change">Opettajankoulutus</button></li>
              <li><button type="button" class="starter-chip" data-starter-chip data-starter-chip-target="#presentation-archive-topic" data-starter-chip-value="Mobiilioppiminen" data-starter-chip-event="change">Mobiilioppiminen</button></li>
            </ul>
          </div>
          {% endif %}
          <form class="presentation-archive-controls" data-presentation-controls>
            <div class="presentation-archive-controls-grid">
              <div class="presentation-archive-control">
                <label class="presentation-archive-filter-label" for="presentation-archive-search">{{ presentationArchiveSearchLabel }}</label>
                <input id="presentation-archive-search" class="presentation-archive-input" type="search" placeholder="{{ presentationArchiveSearchPlaceholder }}" data-presentation-control="search">
              </div>

              <div class="presentation-archive-control">
                <label class="presentation-archive-filter-label" for="presentation-archive-year">{{ presentationArchiveYearLabel }}</label>
                <select id="presentation-archive-year" class="presentation-archive-select" data-presentation-control="year">
                  <option value="">{{ presentationArchiveAllYearsLabel }}</option>
                  {% for year in archiveFilterYears %}
                    <option value="{{ year }}">{{ year }}</option>
                  {% endfor %}
                </select>
              </div>

              <div class="presentation-archive-control">
                <label class="presentation-archive-filter-label" for="presentation-archive-topic">{{ presentationArchiveTopicLabel }}</label>
                <input id="presentation-archive-topic" class="presentation-archive-input" type="search" list="presentation-archive-topic-list" placeholder="{{ presentationArchiveTopicPlaceholder }}" data-presentation-control="topic">
                <datalist id="presentation-archive-topic-list">
                  {% for topic in archiveFilterTopics %}
                    <option value="{{ topic }}"></option>
                  {% endfor %}
                </datalist>
              </div>

              <div class="presentation-archive-control presentation-archive-control--action">
                <button type="reset" class="btn btn-outline-secondary rounded-pill px-4" data-presentation-reset>{{ presentationArchiveResetLabel }}</button>
              </div>
            </div>

            <p class="presentation-archive-hint mb-0">{{ presentationArchiveTopicHint }}</p>
          </form>

          <div class="presentation-archive-status" data-presentation-status aria-live="polite"></div>

          <div class="presentation-archive-grid" data-presentation-results>
            {% for item in archiveItems | sort(attribute="date", reverse=true) %}
              {% if loop.index <= 12 %}
                {% include "presentations/result-card.njk" %}
              {% endif %}
            {% endfor %}
          </div>

          <nav class="mt-4" aria-label="{{ presentationArchivePaginationLabel }}" data-presentation-pagination-nav hidden>
            <ul class="pagination pagination-sm mb-0 justify-content-center" data-presentation-pagination></ul>
          </nav>

          <div hidden data-presentation-card-templates aria-hidden="true">
{%- for item in archiveItems -%}
<template data-presentation-card-url="{{ item.landingUrl or item.localPageUrl or item.pageUrl or item.url or item.externalUrl or item.sourceUrl or '' }}" data-presentation-card-title="{{ item.title or '' }}">{%- include "presentations/result-card.njk" -%}</template>
{%- endfor -%}
          </div>
        </div>
      </div>
    </details>
  </div>
</section>
