<section class="py-5 presentation-analysis-era-section border-top" id="tausta-ja-lahteet" aria-labelledby="tausta-ja-lahteet-heading" data-presentation-mobile-priority="3">
  <div class="site-shell">
    <div class="presentation-section-head">
      <p class="presentation-section-kicker mb-1">Tausta ja lähteet</p>
      <h2 id="tausta-ja-lahteet-heading" class="presentation-section-title">Analyysit, käyttötilanteet ja lähdepalvelut samalla tasolla</h2>
      <p class="presentation-section-lead mb-0">Tämä osio kokoaa sivun taustakerrokset yhteen. Täältä löytyvät aineiston kehityskaaret, kaikki tunnistetut käyttötilanteet, käyttötavan mukaan ryhmitelty esityshistoria sekä alkuperäiset palvelukohtaiset lähdeluettelot.</p>
    </div>

    <div class="presentation-analysis-links mb-4">
      <a href="/esitykset/canva-analyysi/" class="presentation-analysis-link">
        <span class="presentation-analysis-icon"><i class="bi bi-bar-chart-line"></i></span>
        <strong>Canva-esitykset 2021-2026</strong>
        <small>75 analysoitua esitystä, joissa näkyy uudempi kouluttaja- ja tekoälylukutaitoprofiili.</small>
      </a>
      <a href="/esitykset/slideshare-analyysi/" class="presentation-analysis-link">
        <span class="presentation-analysis-icon"><i class="bi bi-collection-play"></i></span>
        <strong>SlideShare-esitykset 2009-2020</strong>
        <small>Vanhempi esityskaari mobiilioppimisesta, CSCL:stä ja opettajankoulutuksesta.</small>
      </a>
    </div>

    <div class="presentation-background-stack">
      <details class="presentation-service-archive">
        <summary>
          <span>
            <strong>Kaikki käyttötilanteet ja palautteet</strong>
            <span>{{ presentationContextItems | length }} tunnistettua tilannetta, joissa materiaali liittyy tiettyyn luentoon, koulutukseen, keynoteen tai työpajaan.</span>
          </span>
        </summary>
        <div class="presentation-service-archive-body">
          <div class="presentation-context-grid">
            {% for context in presentationContextItems | sort(attribute="date", reverse=true) %}
            <article class="presentation-context-card">
              <div class="presentation-context-card-head">
                <span class="presentation-context-type">{{ context.typeLabel }}</span>
                <span class="presentation-context-date">{{ context.displayDate or (context.date | dateFormat) }}</span>
              </div>
              <h3 class="presentation-context-title">{{ context.title }}</h3>
              <p class="presentation-context-summary">{{ context.summary }}</p>
              <dl class="presentation-context-meta">
                <div>
                  <dt>Rooli</dt>
                  <dd>{{ context.role }}</dd>
                </div>
                <div>
                  <dt>Kohderyhmä</dt>
                  <dd>{{ context.audience }}</dd>
                </div>
                <div>
                  <dt>Järjestäjä</dt>
                  <dd>{{ context.organizer }}</dd>
                </div>
              </dl>
              {% if context.topics and context.topics.length %}
              <div class="presentation-context-topics" aria-label="Teemat">
                {% for topic in context.topics %}
                <span>{{ topic }}</span>
                {% endfor %}
              </div>
              {% endif %}
              {% if context.materials and context.materials.length %}
              <div class="presentation-context-materials">
                <p class="presentation-context-subtitle">Kytketyt aineistot</p>
                <div class="d-flex flex-wrap gap-2">
                  {% for material in context.materials %}
                    {% if material.url %}
                    <a href="{{ material.url }}"{% if material.url.startsWith("http") %} target="_blank" rel="noopener noreferrer"{% endif %} class="btn btn-outline-primary btn-sm rounded-pill px-3">{{ material.label }}</a>
                    {% else %}
                    <span class="presentation-context-material-static">{{ material.label }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
              {% endif %}
              {% if context.feedbackIds and context.feedbackIds.length %}
              <div class="presentation-context-feedback">
                <p class="presentation-context-subtitle">Palaute</p>
                {% for feedback in testimonials.items %}
                  {% if context.feedbackIds.indexOf(feedback.id) != -1 %}
                  <blockquote>
                    <p>“{{ feedback.content.fi.quote }}”</p>
                    <footer>{{ feedback.content.fi.attribution }}</footer>
                  </blockquote>
                  {% endif %}
                {% endfor %}
              </div>
              {% endif %}
            </article>
            {% endfor %}
          </div>
        </div>
      </details>

      <details class="presentation-service-archive">
        <summary>
          <span>
            <strong>Käyttötavan mukaan ryhmitelty koko esityskaari</strong>
            <span>Kaikki {{ presentationContextGroups.total }} esitystä käyttötavan mukaan: yliopistokurssit, täydennyskoulutukset, konferenssit, webinaarit ja työpajat.</span>
          </span>
        </summary>
        <div class="presentation-service-archive-body">
          <div class="presentation-context-groups">
            {% for group in presentationContextGroups.groups %}
            <article class="presentation-context-group-card">
              <div class="presentation-context-group-head">
                <span class="presentation-context-group-icon"><i class="bi {{ group.icon }}"></i></span>
                <div>
                  <p class="presentation-context-group-kicker mb-1">{{ group.kicker }}</p>
                  <h3 class="presentation-context-group-title mb-0">{{ group.title }}</h3>
                </div>
                <span class="presentation-context-group-count">{{ group.totalCount }}</span>
              </div>
              <p class="presentation-context-group-desc">{{ group.description }}</p>
              <ul class="presentation-context-group-list">
                {% for item in group.featured %}
                <li>
                  <a href="{{ item.url }}">{{ item.title }}</a>
                  <span class="presentation-context-group-date">{{ item.date | dateFormat }}</span>
                </li>
                {% endfor %}
              </ul>
              {% if group.rest.length %}
              <details class="presentation-context-group-rest">
                <summary>Näytä loput ({{ group.rest.length }})</summary>
                <ul class="presentation-context-group-list">
                  {% for item in group.rest %}
                  <li>
                    <a href="{{ item.url }}">{{ item.title }}</a>
                    <span class="presentation-context-group-date">{{ item.date | dateFormat }}</span>
                  </li>
                  {% endfor %}
                </ul>
              </details>
              {% endif %}
            </article>
            {% endfor %}
          </div>
        </div>
      </details>

      <details class="presentation-service-archive">
        <summary>
          <span>
            <strong>Palvelukohtaiset lähdeluettelot</strong>
            <span>Canva, YouTube, AOE ja SlideShare alkuperäisten lähteiden mukaan. Tätä osaa tarvitaan, kun haluat tarkistaa lähteen tai etsiä tietyn palvelun sisältöjä.</span>
          </span>
        </summary>
        <div class="presentation-service-archive-body">

  {# ===================== CANVA ===================== #}
  <section class="mb-5" aria-labelledby="canva-heading">
    <h2 id="canva-heading" class="section-title mb-4">
      <i class="bi bi-star-fill text-warning me-2" style="font-size: 1rem;"></i>Canva-esitykset
    </h2>

    {# CTA-kortti: Canva-analyysi #}
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning">
      <div class="card-body p-4">
        <div class="row align-items-center g-3">
          <div class="col-auto d-none d-sm-block">
            <i class="bi bi-bar-chart-line text-warning" style="font-size:2rem;"></i>
          </div>
          <div class="col">
            <p class="text-uppercase text-muted fw-semibold small mb-1">Analyysi</p>
            <h3 class="h5 fw-bold mb-1">Canva-esitykset 2021–2026 – 83 esitystä analysoituna</h3>
            <p class="text-muted small mb-0">Teemat, kehityskaaret, laajimmat esitykset ja punaiset langat – tekoälylukutaidon vuosikymmen.</p>
          </div>
          <div class="col-12 col-sm-auto">
            <a href="/esitykset/canva-analyysi/" class="btn btn-warning btn-sm px-3 text-dark">
              Lue analyysi <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    {% if canva and canva.tableRows and canva.tableRows.length %}
      <div id="featured-canva"></div>
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table">
            <thead>
              <tr>
                <th class="text-center" style="width:140px">Päivämäärä</th>
                <th style="min-width:170px">Esikatselu</th>
                <th style="min-width:200px;max-width:260px;">Otsikko</th>
                <th style="min-width:220px">Tiivistelmä</th>
                <th style="min-width:190px">Avainsanat</th>
                <th style="width:90px" class="text-center">Avaa</th>
              </tr>
            </thead>
            <tbody id="table-body-canva"></tbody>
          </table>
        </div>
      </div>
      <ul id="mobile-list-canva" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
      <nav class="mt-3" aria-label="Canva-sivutus">
        <ul class="pagination pagination-sm mb-0" id="pagination-canva"></ul>
      </nav>

      <div class="mt-3 text-muted small">
        Lähde: Canva (JSON).
      </div>
    {% else %}
      <p class="text-muted">Ei Canva-esityksiä.</p>
    {% endif %}
  </section>

  {# ===================== YOUTUBE ===================== #}
  <section class="mb-5" aria-labelledby="youtube-heading">
    <h2 id="youtube-heading" class="section-title mb-4">
      <i class="bi bi-youtube text-danger me-2" style="font-size: 1rem;"></i>YouTube-videot
    </h2>

    {% if youtube and youtube.videos and youtube.videos.length %}
      <div id="featured-youtubeVideos"></div>
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table">
            <thead>
              <tr>
                <th style="min-width:140px">Esikatselu</th>
                <th style="min-width:200px">Otsikko</th>
                <th style="min-width:220px">Kuvaus</th>
                <th class="text-nowrap">Päiväys</th>
                <th class="text-nowrap">Avaa</th>
              </tr>
            </thead>
            <tbody id="table-body-youtubeVideos"></tbody>
          </table>
        </div>
      </div>
      <ul id="mobile-list-youtubeVideos" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
      <nav class="mt-3" aria-label="YouTube-video-sivutus">
        <ul class="pagination pagination-sm mb-0" id="pagination-youtubeVideos"></ul>
      </nav>
      <div class="mt-3 text-muted small">
        Lähde: YouTube Data API v3{% if youtube.source == 'cache' %} (välimuistista){% endif %}.
      </div>
    {% endif %}

    {% if youtube and youtube.tableRows and youtube.tableRows.length %}
      <h3 class="h6 text-uppercase text-muted fw-semibold mt-5 mb-2" style="letter-spacing:.04em;">Soittolistat</h3>
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table">
            <thead>
              <tr>
                <th>Otsikko</th>
                <th>Kuvaus</th>
                <th class="text-nowrap">Päiväys / vuosi</th>
                <th class="text-nowrap">Avaa</th>
              </tr>
            </thead>
            <tbody id="table-body-youtube"></tbody>
          </table>
        </div>
      </div>
      <ul id="mobile-list-youtube" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
      <nav class="mt-3" aria-label="YouTube-sivutus">
        <ul class="pagination pagination-sm mb-0" id="pagination-youtube"></ul>
      </nav>
    {% endif %}

    {% if not (youtube and (youtube.videos.length or youtube.tableRows.length)) %}
      <div class="card border-0 bg-light-subtle">
        <div class="card-body">
          <p class="mb-2 fw-semibold">YouTube-sisältöä ei ole juuri nyt saatavilla tässä näkymässä.</p>
          <p class="text-muted mb-3 small">Jos etsit videoita tai tallenteita, voit tarkistaa ne suoraan YouTube-kanavalta.</p>
          <a href="https://www.youtube.com/jarilaru" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Avaa YouTube-kanava</a>
        </div>
      </div>
    {% endif %}
  </section>

  {# ===================== AOE ===================== #}
  <section class="mb-5" aria-labelledby="aoe-heading">
    <h2 id="aoe-heading" class="section-title mb-4">
      <i class="bi bi-book-fill text-success me-2" style="font-size: 1rem;"></i>AOE-oppimateriaalit
    </h2>
    {% if finnaAoe and finnaAoe.rows and finnaAoe.rows.length %}
      <div id="featured-aoe"></div>
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table">
            <thead>
              <tr>
                <th>Otsikko</th>
                <th>Kuvaus</th>
                <th class="text-nowrap">Päiväys / vuosi</th>
                <th class="text-nowrap">Avaa</th>
              </tr>
            </thead>
            <tbody id="table-body-aoe"></tbody>
          </table>
        </div>
      </div>
      <ul id="mobile-list-aoe" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
      <nav class="mt-3" aria-label="AOE-sivutus">
        <ul class="pagination pagination-sm mb-0" id="pagination-aoe"></ul>
      </nav>
      <div class="mt-3 text-muted small">
        Lähde: <a href="https://www.finna.fi/" target="_blank" rel="noopener noreferrer">Finna</a> / <a href="https://aoe.fi/" target="_blank" rel="noopener noreferrer">Avointen oppimateriaalien kirjasto (AOE)</a>{% if finnaAoe.source == 'cache' %} (välimuistista){% endif %}.
      </div>
    {% else %}
      <p class="text-muted">Ei AOE-oppimateriaaleja saatavilla.</p>
    {% endif %}
  </section>


  {# ================= SLIDESHARE ================== #}
  <section class="mb-5" aria-labelledby="slideshare-heading">

    <h2 id="slideshare-heading" class="section-title mb-4">
      <i class="bi bi-collection-play me-2" style="font-size: 1rem;"></i>SlideShare-esitykset
    </h2>

    {# CTA-kortti: SlideShare-analyysi #}
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-primary">
      <div class="card-body p-4">
        <div class="row align-items-center g-3">
          <div class="col-auto d-none d-sm-block">
            <i class="bi bi-bar-chart-line text-primary" style="font-size:2rem;"></i>
          </div>
          <div class="col">
            <p class="text-uppercase text-muted fw-semibold small mb-1">Analyysi</p>
            <h3 class="h5 fw-bold mb-1">SlideShare-esitykset 2009–2020 – 117 esitystä analysoituna</h3>
            <p class="text-muted small mb-0">Teemat, kehityskaaret, katsotuimmat ja punaiset langat vuosikymmenittäin – mobiilioppimisesta tekoälyyn.</p>
          </div>
          <div class="col-12 col-sm-auto">
            <a href="/esitykset/slideshare-analyysi/" class="btn btn-primary btn-sm px-3">
              Lue analyysi <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
    {% if ssDataItems.length %}
      <div id="featured-slideshare"></div>
      <div class="d-none d-md-block">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table">
            <thead>
              <tr>
                <th class="text-center" style="width:140px">Päivämäärä</th>
                <th style="min-width:170px">Esikatselu</th>
                <th style="min-width:200px;max-width:260px;">Otsikko</th>
                <th style="min-width:220px">Tiivistelmä</th>
                <th style="min-width:190px">Avainsanat</th>
                <th style="width:90px" class="text-center">Avaa</th>
              </tr>
            </thead>
            <tbody id="table-body-slideshare"></tbody>
          </table>
        </div>
      </div>
      <ul id="mobile-list-slideshare" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
      <nav class="mt-3" aria-label="SlideShare-sivutus">
        <ul class="pagination pagination-sm mb-0" id="pagination-slideshare"></ul>
      </nav>
    {% else %}
      <p class="text-muted">Ei SlideShare-esityksiä saatavilla.</p>
    {% endif %}

    <div class="mt-4 text-center">
      <a href="https://www.slideshare.net/larux" target="_blank" rel="noopener noreferrer" class="btn btn-primary px-4 py-2">
        Katso kaikki SlideSharessa ({{ ssDataItems.length }}) <i class="bi bi-arrow-up-right"></i>
      </a>
    </div>
  </section>

  {# Staattinen linkkilista kaikkiin esityssivuihin (SEO-navigaatio) #}
  <section class="mb-5">
    <div class="site-shell">
      {% set archiveTotal = (collections.presentations | length) + ((finnaAoe.rows or []) | length) + ((youtube.tableRows or []) | length) %}
      <details>
        <summary class="text-muted small py-2" style="cursor:pointer;">Kaikki paikalliset sisältösivut ja lähteet ({{ archiveTotal }})</summary>

        <div class="mt-3">
          <h3 class="h6 fw-bold">Esityssivut sivustolla</h3>
          <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mt-1">
            {% for item in collections.presentations | sort(attribute="data.date", reverse=true) %}
              <li class="col">
                <a class="small fw-semibold text-decoration-none" href="{{ item.url }}">{{ item.data.title }}</a>
                <div class="small text-muted mt-1">
                  {{ item.data.source or item.data.type or "esitys" }}{% if item.data.date %} · {{ item.data.date | dateFormat }}{% endif %}
                </div>
                {% set archiveDesc = item.data.description or (item.content | excerpt) %}
                {% if archiveDesc %}
                  <div class="small text-muted">{{ archiveDesc }}</div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>

        {% if finnaAoe and finnaAoe.rows and finnaAoe.rows.length %}
          <div class="mt-4">
            <h3 class="h6 fw-bold">AOE-oppimateriaalit</h3>
            <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mt-1">
              {% for row in finnaAoe.rows %}
                <li class="col">
                  <a class="small fw-semibold text-decoration-none" href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.title }}</a>
                  <div class="small text-muted mt-1">AOE / Finna{% if row.year %} · {{ row.year }}{% endif %}</div>
                  {% if row.summary %}
                    <div class="small text-muted">{{ row.summary }}</div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}


        {% if youtube and youtube.tableRows and youtube.tableRows.length %}
          <div class="mt-4">
            <h3 class="h6 fw-bold">YouTube-soittolistat</h3>
            <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mt-1">
              {% for row in youtube.tableRows %}
                <li class="col">
                  <a class="small fw-semibold text-decoration-none" href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.title }}</a>
                  <div class="small text-muted mt-1">YouTube{% if row.date or row.year %} · {{ row.date or row.year }}{% endif %}</div>
                  {% if row.description or row.summary %}
                    <div class="small text-muted">{{ row.description or row.summary }}</div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </details>
    </div>
  </section>

        </div>
      </details>
    </div>
  </div>
</section>
