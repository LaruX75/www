<section class="py-5 presentation-analysis-era-section border-top" id="tausta-ja-lahteet" aria-labelledby="tausta-ja-lahteet-heading" data-presentation-mobile-priority="3">
  <div class="site-shell">
    <div class="presentation-section-head">
      <p class="presentation-section-kicker mb-1">Tausta ja lähteet</p>
      <h2 id="tausta-ja-lahteet-heading" class="presentation-section-title">Jos haluat tarkistaa taustan, jatka tänne</h2>
      <p class="presentation-section-lead mb-0">Täältä löydät esitysten kehityskaaret, tilaisuuksiin liittyvät materiaalit sekä alkuperäiset Canva-, YouTube-, AOE- ja SlideShare-linkit.</p>
    </div>

    <div class="presentation-analysis-links mb-4">
      {% set presentationAnalysisTextWrap = false %}

      {% set presentationAnalysisHref = "/esitykset/canva-analyysi/" %}
      {% set presentationAnalysisIcon = "bi-bar-chart-line" %}
      {% set presentationAnalysisTitle = "Canva-esitykset 2021-2026" %}
      {% set presentationAnalysisDescription = "Uudempi esityskaari koulutuksista, tekoälylukutaidosta ja avoimista materiaaleista." %}
      {% include "presentations/analysis-link.njk" %}

      {% set presentationAnalysisHref = "/esitykset/slideshare-analyysi/" %}
      {% set presentationAnalysisIcon = "bi-collection-play" %}
      {% set presentationAnalysisTitle = "SlideShare-esitykset 2009-2020" %}
      {% set presentationAnalysisDescription = "Vanhempi esityskaari mobiilioppimisesta, CSCL:stä ja opettajankoulutuksesta." %}
      {% include "presentations/analysis-link.njk" %}
    </div>

    <div class="presentation-background-stack">
      <details class="presentation-service-archive">
        <summary>
          <span>
            <strong>Tilaisuudet ja palautteet</strong>
            <span>{{ presentationContextItems | length }} tilaisuutta, joissa materiaali liittyy tiettyyn luentoon, koulutukseen, keynoteen tai työpajaan.</span>
          </span>
        </summary>
        <div class="presentation-service-archive-body">
          <div class="presentation-context-grid">
            {% for context in presentationContextItems | sort(attribute="date", reverse=true) %}
            {% set presentationContextCardShowFeedback = true %}
            {% include "presentations/context-card.njk" %}
            {% endfor %}
          </div>
        </div>
      </details>

      <details class="presentation-service-archive">
        <summary>
          <span>
            <strong>Esitykset käyttötavan mukaan</strong>
            <span>Kaikki {{ presentationContextGroups.total }} esitystä käyttötavan mukaan: yliopistokurssit, täydennyskoulutukset, konferenssit, webinaarit ja työpajat.</span>
          </span>
        </summary>
        <div class="presentation-service-archive-body">
          <div class="presentation-context-groups">
            {% for group in presentationContextGroups.groups %}
            {% include "presentations/context-group-card.njk" %}
            {% endfor %}
          </div>
        </div>
      </details>

      <details class="presentation-service-archive">
        <summary>
          <span>
            <strong>Alkuperäiset lähteet</strong>
            <span>Canva-, YouTube-, AOE- ja SlideShare-linkit löytyvät omista koonneistaan, jos haluat tarkistaa lähteen tai etsiä tietyn palvelun sisältöjä.</span>
          </span>
        </summary>
        <div class="presentation-service-archive-body">
          {% include "presentations/source-archive-canva.njk" %}
          {% include "presentations/source-archive-youtube.njk" %}
          {% include "presentations/source-archive-aoe.njk" %}
          {% include "presentations/source-archive-slideshare.njk" %}
          {% include "presentations/source-archive-local-links.njk" %}

        </div>
      </details>
    </div>
  </div>
</section>
