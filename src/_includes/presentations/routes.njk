<section class="py-5 presentation-browse-section border-top" id="reitit" aria-labelledby="reitit-heading">
  <div class="site-shell">
    {% set routeCards = [
      {
        number: "01",
        label: "Vaikuttavat puheenvuorot",
        title: "Keynotet, konferenssit ja tutkimukseen nojaavat asiantuntijapuheenvuorot",
        description: "Aloita tästä, kun etsit laajoja puheenvuoroja tekoälystä, oppimisesta, teknologiasta ja koulutuksen muutoksesta.",
        filter: "route:puheenvuorot"
      },
      {
        number: "02",
        label: "Koulutukset, luennot ja työpajat",
        title: "Opettajille, opiskelijoille ja verkostoille tehdyt käytännön materiaalit",
        description: "Täältä löydät materiaaleja täydennyskoulutuksiin, yliopistoluennolle, webinaareihin, hankkeiden esittelyihin ja työpajoihin.",
        filter: "route:koulutukset"
      },
      {
        number: "03",
        label: "Videot ja avoimet materiaalit",
        title: "Tallenteet, videosarjat ja julkiseen käyttöön jaetut oppimateriaalit",
        description: "Aloita tästä, kun haluat katsoa tallenteen, jakaa materiaalin tai käyttää avointa oppimateriaalia opetuksen tukena.",
        filter: "route:materiaalit"
      }
    ] %}

    <div class="presentation-section-head">
      <p class="presentation-section-kicker mb-1">Aloita tästä</p>
      <h2 id="reitit-heading" class="presentation-section-title">Millaista materiaalia etsit?</h2>
      <p class="presentation-section-lead mb-0">Sivua voi selata käyttötarkoituksen mukaan: puheenvuorot, koulutukset ja luennot sekä katsottavat tai jaettavat materiaalit.</p>
    </div>

    <div class="presentation-route-grid">
      {% for routeCard in routeCards %}
      {% include "presentations/route-card.njk" %}
      {% endfor %}
    </div>

    <div class="presentation-route-support">
      {% set presentationAnalysisHref = "#tausta-ja-lahteet" %}
      {% set presentationAnalysisTextWrap = true %}

      {% set presentationAnalysisIcon = "bi-bar-chart-line" %}
      {% set presentationAnalysisTitle = "Miten teemat ovat kehittyneet?" %}
      {% set presentationAnalysisDescription = "Canva- ja SlideShare-koonnit avaavat, miten aiheet ovat muuttuneet vuosien varrella." %}
      {% include "presentations/analysis-link.njk" %}

      {% set presentationAnalysisIcon = "bi-archive" %}
      {% set presentationAnalysisTitle = "Mistä alkuperäiset sisällöt löytyvät?" %}
      {% set presentationAnalysisDescription = "Canva, YouTube, AOE ja SlideShare löytyvät omista koonneistaan sivun lopusta." %}
      {% include "presentations/analysis-link.njk" %}
    </div>
  </div>
</section>
