<section class="py-5 presentation-browse-section border-top" id="reitit" aria-labelledby="reitit-heading">
  <div class="site-shell">
    {% set routeCards = [
      {
        number: "01",
        label: "Vaikuttavat puheenvuorot",
        title: "Keynotet, konferenssit ja tutkimuksen kautta painavat esiintymiset",
        description: "Tällä pääreitillä näkyvät aineistot, joiden ensisijainen käyttö on keynote-puheenvuoroissa, konferensseissa tai tutkimuksen kautta painavissa asiantuntijaesiintymisissä.",
        filter: "route:puheenvuorot"
      },
      {
        number: "02",
        label: "Koulutukset ja työpajat",
        title: "Opettajille, organisaatioille ja verkostoille tehdyt käytännön materiaalit",
        description: "Tällä pääreitillä näkyvät aineistot, joiden ensisijainen käyttö on täydennyskoulutuksissa, webinaareissa, hankkeiden esittelyissä tai työpajamaisissa kokonaisuuksissa.",
        filter: "route:koulutukset"
      },
      {
        number: "03",
        label: "Videot ja avoimet materiaalit",
        title: "Tallenteet, videosarjat ja julkiseen käyttöön jaetut oppimateriaalit",
        description: "Tällä pääreitillä näkyvät aineistot, jotka on tarkoitettu ennen kaikkea katsottaviksi, jaettaviksi tai suoraan opetukseen vietäviksi materiaaleiksi.",
        filter: "route:materiaalit"
      }
    ] %}

    <div class="presentation-section-head">
      <p class="presentation-section-kicker mb-1">Aloita tästä</p>
      <h2 id="reitit-heading" class="presentation-section-title">Kolme pääreittiä aineistoon</h2>
      <p class="presentation-section-lead mb-0">Valitse reitti sen mukaan, mikä on aineiston ensisijainen käyttötapa. Sama aineisto voi liittyä myös muihin reitteihin, mutta tässä näkymässä se näkyy yhden pääreitin kautta.</p>
    </div>

    <div class="presentation-route-grid">
      {% for routeCard in routeCards %}
      {% include "presentations/route-card.njk" %}
      {% endfor %}
    </div>

    <div class="presentation-route-support">
      {% set presentationAnalysisHref = "#tausta-ja-lahteet" %}
      {% set presentationAnalysisTextWrap = true %}

      {% set presentationAnalysisIcon = "bi-bar-chart-line" %}
      {% set presentationAnalysisTitle = "Aineiston tulkinta ja kehityskaaret" %}
      {% set presentationAnalysisDescription = "Kaksi analyysisivua ja käyttökontekstien tausta alempana samalla sivulla." %}
      {% include "presentations/analysis-link.njk" %}

      {% set presentationAnalysisIcon = "bi-archive" %}
      {% set presentationAnalysisTitle = "Lähdepalvelut ja tekninen arkisto" %}
      {% set presentationAnalysisDescription = "Canva, YouTube, AOE ja SlideShare löytyvät edelleen, mutta ne eivät enää ohjaa sivun ensisijaista lukutapaa." %}
      {% include "presentations/analysis-link.njk" %}
    </div>
  </div>
</section>
