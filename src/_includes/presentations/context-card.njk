<article class="presentation-context-card">
  <div class="presentation-context-card-head">
    <span class="presentation-context-type">{{ context.typeLabel | pageText(lang) }}</span>
    <span class="presentation-context-date">{{ (context.displayDate or (context.date | dateFormat)) | pageText(lang) }}</span>
  </div>
  <h3 class="presentation-context-title">{{ context.title | pageText(lang) }}</h3>
  <p class="presentation-context-summary">{{ context.summary | pageText(lang) }}</p>
  <dl class="presentation-context-meta">
    <div>
      <dt>{{ "Rooli" | pageText(lang) }}</dt>
      <dd>{{ context.role | pageText(lang) }}</dd>
    </div>
    <div>
      <dt>{{ "Kohderyhmä" | pageText(lang) }}</dt>
      <dd>{{ context.audience | pageText(lang) }}</dd>
    </div>
    <div>
      <dt>{{ "Järjestäjä" | pageText(lang) }}</dt>
      <dd>{{ context.organizer | pageText(lang) }}</dd>
    </div>
  </dl>
  {% if context.topics and context.topics.length %}
  <div class="presentation-context-topics" aria-label="{{ "Teemat" | pageText(lang) }}">
    {% for topic in context.topics %}
    <span>{{ topic | pageText(lang) }}</span>
    {% endfor %}
  </div>
  {% endif %}
  {% if context.materials and context.materials.length %}
  <div class="presentation-context-materials">
    <p class="presentation-context-subtitle">{{ "Tilaisuuteen liittyvät materiaalit" | pageText(lang) }}</p>
    <div class="d-flex flex-wrap gap-2">
      {% for material in context.materials %}
        {% if material.url %}
        <a href="{{ material.url | localeUrl(lang) }}"{% if material.url.startsWith("http") %} target="_blank" rel="noopener noreferrer"{% endif %} class="btn btn-outline-primary btn-sm rounded-pill px-3">{{ material.label | pageText(lang) }}</a>
        {% else %}
        <span class="presentation-context-material-static">{{ material.label | pageText(lang) }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% if presentationContextCardShowFeedback and context.feedbackIds and context.feedbackIds.length %}
  <div class="presentation-context-feedback">
    <p class="presentation-context-subtitle">{{ "Palaute" | pageText(lang) }}</p>
    {% for feedback in testimonials.items %}
      {% if context.feedbackIds.indexOf(feedback.id) != -1 %}
      <blockquote>
        <p>“{{ feedback.content.fi.quote | pageText(lang) }}”</p>
        <footer>{{ feedback.content.fi.attribution | pageText(lang) }}</footer>
      </blockquote>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}
</article>
