{# ===================== CANVA ===================== #}
{% set canvaSection = presentationsPage.sourceSections.fi[1] %}
<section class="mb-5" aria-labelledby="canva-heading">
  <h2 id="canva-heading" class="section-title mb-4">
    <i class="bi bi-star-fill text-warning me-2" style="font-size: 1rem;"></i>Canva-esitykset
  </h2>

  <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-auto d-none d-sm-block">
          <i class="bi bi-bar-chart-line text-warning" style="font-size:2rem;"></i>
        </div>
        <div class="col">
          <p class="text-uppercase text-muted fw-semibold small mb-1">Analyysi</p>
          <h3 class="h5 fw-bold mb-1">Canva-esitykset 2021–2026</h3>
          <p class="text-muted small mb-0">Teemat, kehityskaaret, laajimmat esitykset ja punaiset langat – tekoälylukutaidon vuosikymmen.</p>
        </div>
        <div class="col-12 col-sm-auto">
          <a href="/esitykset/canva-analyysi/" class="btn btn-warning btn-sm px-3 text-dark">
            Lue analyysi <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  {% if canvaSection.count %}
    {% set presentationSourceSection = canvaSection %}
    {% set presentationSourceLocale = "fi" %}
    {% include "presentations/source-group-content.njk" %}
    <div class="mt-3 text-muted small">
      Lähde: Canva (JSON).
    </div>
  {% else %}
    <p class="text-muted">Ei Canva-esityksiä.</p>
  {% endif %}
</section>
