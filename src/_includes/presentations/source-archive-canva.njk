{# ===================== CANVA ===================== #}
<section class="mb-5" aria-labelledby="canva-heading">
  <h2 id="canva-heading" class="section-title mb-4">
    <i class="bi bi-star-fill text-warning me-2" style="font-size: 1rem;"></i>Canva-esitykset
  </h2>

  <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-auto d-none d-sm-block">
          <i class="bi bi-bar-chart-line text-warning" style="font-size:2rem;"></i>
        </div>
        <div class="col">
          <p class="text-uppercase text-muted fw-semibold small mb-1">Analyysi</p>
          <h3 class="h5 fw-bold mb-1">Canva-esitykset 2021–2026</h3>
          <p class="text-muted small mb-0">Teemat, kehityskaaret, laajimmat esitykset ja punaiset langat – tekoälylukutaidon vuosikymmen.</p>
        </div>
        <div class="col-12 col-sm-auto">
          <a href="/esitykset/canva-analyysi/" class="btn btn-warning btn-sm px-3 text-dark">
            Lue analyysi <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  {% if canva and canva.tableRows and canva.tableRows.length %}
    <div id="featured-canva"></div>
    <div class="d-none d-md-block">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th class="text-center" style="width:140px">Päivämäärä</th>
              <th style="min-width:170px">Esikatselu</th>
              <th style="min-width:200px;max-width:260px;">Otsikko</th>
              <th style="min-width:220px">Tiivistelmä</th>
              <th style="min-width:190px">Avainsanat</th>
              <th style="width:90px" class="text-center">Avaa</th>
            </tr>
          </thead>
          <tbody id="table-body-canva"></tbody>
        </table>
      </div>
    </div>
    <ul id="mobile-list-canva" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
    <nav class="mt-3" aria-label="Canva-sivutus">
      <ul class="pagination pagination-sm mb-0" id="pagination-canva"></ul>
    </nav>

    <div class="mt-3 text-muted small">
      Lähde: Canva (JSON).
    </div>
  {% else %}
    <p class="text-muted">Ei Canva-esityksiä.</p>
  {% endif %}
</section>
