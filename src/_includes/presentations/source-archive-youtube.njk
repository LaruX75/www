{# ===================== YOUTUBE ===================== #}
<section class="mb-5" aria-labelledby="youtube-heading">
  <h2 id="youtube-heading" class="section-title mb-4">
    <i class="bi bi-youtube text-danger me-2" style="font-size: 1rem;"></i>YouTube-videot
  </h2>

  {% if youtube and youtube.videos and youtube.videos.length %}
    <div id="featured-youtubeVideos"></div>
    <div class="d-none d-md-block">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th style="min-width:140px">Esikatselu</th>
              <th style="min-width:200px">Otsikko</th>
              <th style="min-width:220px">Kuvaus</th>
              <th class="text-nowrap">Päiväys</th>
              <th class="text-nowrap">Avaa</th>
            </tr>
          </thead>
          <tbody id="table-body-youtubeVideos"></tbody>
        </table>
      </div>
    </div>
    <ul id="mobile-list-youtubeVideos" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
    <nav class="mt-3" aria-label="YouTube-video-sivutus">
      <ul class="pagination pagination-sm mb-0" id="pagination-youtubeVideos"></ul>
    </nav>
    <div class="mt-3 text-muted small">
      Lähde: YouTube Data API v3{% if youtube.source == 'cache' %} (välimuistista){% endif %}.
    </div>
  {% endif %}

  {% if youtube and youtube.tableRows and youtube.tableRows.length %}
    <h3 class="h6 text-uppercase text-muted fw-semibold mt-5 mb-2" style="letter-spacing:.04em;">Soittolistat</h3>
    <div class="d-none d-md-block">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th>Otsikko</th>
              <th>Kuvaus</th>
              <th class="text-nowrap">Päiväys / vuosi</th>
              <th class="text-nowrap">Avaa</th>
            </tr>
          </thead>
          <tbody id="table-body-youtube"></tbody>
        </table>
      </div>
    </div>
    <ul id="mobile-list-youtube" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
    <nav class="mt-3" aria-label="YouTube-sivutus">
      <ul class="pagination pagination-sm mb-0" id="pagination-youtube"></ul>
    </nav>
  {% endif %}

  {% if not (youtube and (youtube.videos.length or youtube.tableRows.length)) %}
    <div class="card border-0 bg-light-subtle">
      <div class="card-body">
        <p class="mb-2 fw-semibold">YouTube-sisältöä ei ole juuri nyt saatavilla tässä koonnissa.</p>
        <p class="text-muted mb-3 small">Jos etsit videoita tai tallenteita, voit tarkistaa ne suoraan YouTube-kanavalta.</p>
        <a href="https://www.youtube.com/jarilaru" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Avaa YouTube-kanava</a>
      </div>
    </div>
  {% endif %}
</section>
