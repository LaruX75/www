<section class="py-5 presentation-feature-section" id="kokonaisuudet" aria-labelledby="kokonaisuudet-heading">
  <div class="site-shell">
    <div class="presentation-section-head">
      <p class="presentation-section-kicker mb-1">Nostot</p>
      <h2 id="kokonaisuudet-heading" class="presentation-section-title">Aloita näistä esityksistä ja koulutuksista</h2>
      <p class="presentation-section-lead mb-0">Nostot auttavat löytämään kokonaisuuksia, joissa esitys, tilaisuus ja mahdollinen palaute kuuluvat yhteen.</p>
    </div>

    <div id="presentation-feature-showcase" class="presentation-feature-showcase" aria-live="polite"></div>

    {% if highlightedContextItems.length %}
    <div class="presentation-context-preview-head">
      <div class="presentation-context-preview-copy">
        <p class="presentation-section-kicker mb-1">Missä materiaaleja on käytetty?</p>
        <h3 class="presentation-section-subtitle mb-2">Neljä esimerkkiä tilaisuuksista</h3>
        <p class="presentation-section-lead mb-0">Korteista näet, kenelle tilaisuus oli suunnattu, kuka sen järjesti ja mitkä materiaalit siihen liittyivät.</p>
      </div>
      <div class="presentation-context-preview-stats">
        <span><strong>{{ presentationContextItems | length }}</strong> tilaisuutta ja käyttöyhteyttä</span>
        <span><strong>{{ presentationContextFeedbackTotal }}</strong> palautteeseen kytkettyä viitettä</span>
      </div>
    </div>

    <div class="presentation-context-grid presentation-context-grid--preview">
      {% for context in highlightedContextItems %}
      {% set presentationContextCardShowFeedback = false %}
      {% include "presentations/context-card.njk" %}
      {% endfor %}
    </div>

    <div class="presentation-context-preview-actions">
      <a href="#tausta-ja-lahteet" class="btn btn-outline-secondary rounded-pill px-4">Avaa kaikki tilaisuudet ja lähteet</a>
    </div>
    {% endif %}
  </div>
</section>
