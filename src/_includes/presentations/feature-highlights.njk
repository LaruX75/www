<section class="py-5 presentation-feature-section" id="kokonaisuudet" aria-labelledby="kokonaisuudet-heading">
  <div class="site-shell">
    <div class="presentation-section-head">
      <p class="presentation-section-kicker mb-1">Valitut kokonaisuudet</p>
      <h2 id="kokonaisuudet-heading" class="presentation-section-title">Tärkeimmät puheenvuorot, koulutukset ja käyttötilanteet ensin</h2>
      <p class="presentation-section-lead mb-0">Sivun alussa näkyvät sekä kuratoidut päänostot että tilanteet, joissa materiaali, tilaisuus ja mahdollinen palaute muodostavat yhden kokonaisuuden. Näin aineisto avautuu heti käytön, ei pelkän lähdepalvelun, kautta.</p>
    </div>

    <div id="presentation-feature-showcase" class="presentation-feature-showcase" aria-live="polite"></div>

    {% if highlightedContextItems.length %}
    <div class="presentation-context-preview-head">
      <div class="presentation-context-preview-copy">
        <p class="presentation-section-kicker mb-1">Missä aineisto on ollut käytössä?</p>
        <h3 class="presentation-section-subtitle mb-2">Neljä esimerkkiä käyttötilanteista</h3>
        <p class="presentation-section-lead mb-0">Näissä korteissa näkyvät tilaisuuden rooli, kohderyhmä, järjestäjä ja siihen kytketyt materiaalit samassa näkymässä.</p>
      </div>
      <div class="presentation-context-preview-stats">
        <span><strong>{{ presentationContextItems | length }}</strong> tunnistettua käyttötilannetta</span>
        <span><strong>{{ presentationContextFeedbackTotal }}</strong> palautteeseen kytkettyä viitettä</span>
      </div>
    </div>

    <div class="presentation-context-grid presentation-context-grid--preview">
      {% for context in highlightedContextItems %}
      {% set presentationContextCardShowFeedback = false %}
      {% include "presentations/context-card.njk" %}
      {% endfor %}
    </div>

    <div class="presentation-context-preview-actions">
      <a href="#tausta-ja-lahteet" class="btn btn-outline-secondary rounded-pill px-4">Avaa kaikki käyttötilanteet ja lähteet</a>
    </div>
    {% endif %}
  </div>
</section>
