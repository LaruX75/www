<a href="{{ presentationAnalysisHref | localeUrl(lang) }}" class="presentation-analysis-link">
  <span class="presentation-analysis-icon"><i class="bi {{ presentationAnalysisIcon }}"></i></span>
  {% if presentationAnalysisTextWrap %}
  <span>
    <strong>{{ presentationAnalysisTitle | pageText(lang) }}</strong>
    <small>{{ presentationAnalysisDescription | pageText(lang) }}</small>
  </span>
  {% else %}
  <strong>{{ presentationAnalysisTitle | pageText(lang) }}</strong>
  <small>{{ presentationAnalysisDescription | pageText(lang) }}</small>
  {% endif %}
</a>
