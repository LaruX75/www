{# ================= SLIDESHARE ================== #}
<section class="mb-5" aria-labelledby="slideshare-heading">
  <h2 id="slideshare-heading" class="section-title mb-4">
    <i class="bi bi-collection-play me-2" style="font-size: 1rem;"></i>SlideShare-esitykset
  </h2>

  <div class="card border-0 shadow-sm mb-4 border-start border-4 border-primary">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-auto d-none d-sm-block">
          <i class="bi bi-bar-chart-line text-primary" style="font-size:2rem;"></i>
        </div>
        <div class="col">
          <p class="text-uppercase text-muted fw-semibold small mb-1">Analyysi</p>
          <h3 class="h5 fw-bold mb-1">SlideShare-esitykset 2009–2020 – 117 esitystä analysoituna</h3>
          <p class="text-muted small mb-0">Teemat, kehityskaaret, katsotuimmat ja punaiset langat vuosikymmenittäin – mobiilioppimisesta tekoälyyn.</p>
        </div>
        <div class="col-12 col-sm-auto">
          <a href="/esitykset/slideshare-analyysi/" class="btn btn-primary btn-sm px-3">
            Lue analyysi <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  {% if ssDataItems.length %}
    <div id="featured-slideshare"></div>
    <div class="d-none d-md-block">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th class="text-center" style="width:140px">Päivämäärä</th>
              <th style="min-width:170px">Esikatselu</th>
              <th style="min-width:200px;max-width:260px;">Otsikko</th>
              <th style="min-width:220px">Tiivistelmä</th>
              <th style="min-width:190px">Avainsanat</th>
              <th style="width:90px" class="text-center">Avaa</th>
            </tr>
          </thead>
          <tbody id="table-body-slideshare"></tbody>
        </table>
      </div>
    </div>
    <ul id="mobile-list-slideshare" class="list-unstyled mb-0 d-md-none presentation-mobile-list" role="list"></ul>
    <nav class="mt-3" aria-label="SlideShare-sivutus">
      <ul class="pagination pagination-sm mb-0" id="pagination-slideshare"></ul>
    </nav>
  {% else %}
    <p class="text-muted">Ei SlideShare-esityksiä saatavilla.</p>
  {% endif %}

  <div class="mt-4 text-center">
    <a href="https://www.slideshare.net/larux" target="_blank" rel="noopener noreferrer" class="btn btn-primary px-4 py-2">
      Katso kaikki SlideSharessa ({{ ssDataItems.length }}) <i class="bi bi-arrow-up-right"></i>
    </a>
  </div>
</section>
