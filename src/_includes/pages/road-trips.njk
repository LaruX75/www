        <p class="lead mb-0" style="color:rgba(255,255,255,0.72)">{{ "Eurooppaa autolla, laivalla ja lentokoneella — perheen voimin ristiin rastiin vuodesta 2007." | pageText(lang) }}</p>
      </div>
      <div class="col-lg-4">
        <div class="row g-2 text-center">
          <div class="col-4">
