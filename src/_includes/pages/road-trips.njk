<!-- MATKAILU-BLOGIPOSTAUKSET -->
<section class="py-5">
  <div class="site-shell">
    <h2 class="h3 fw-bold mb-1">{{ "Matkailu-blogista" | pageText(lang) }}</h2>
    <p class="text-muted mb-4">{{ "Kaikki matkailuun liittyvät blogipostaukset." | pageText(lang) }}</p>

    <div class="list-group list-group-flush border rounded shadow-sm">
      {% for post in collections.blog | reverse %}
        {% if post.data.categories and ("Matkailu" in post.data.categories) %}
        <a href="{{ post.url | localeUrl(lang) }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
          <div class="flex-shrink-0 text-center" style="width:3.5rem">
            <span class="badge text-bg-secondary">{{ post.date | dateYear | pageText(lang) }}</span>
          </div>
          <div class="flex-grow-1">
            <div class="fw-semibold">{{ post.data.title | pageText(lang) }}</div>
            {% if post.data.description %}
            <div class="small text-muted text-truncate" style="max-width:60ch">{{ post.data.description | truncate(120) | pageText(lang) }}</div>
            {% endif %}
          </div>
          <i class="bi bi-arrow-right-circle text-primary flex-shrink-0"></i>
        </a>
        {% endif %}
      {% endfor %}
    </div>

    <p class="text-muted small mt-3">
      <a href="{{ "/blogi/?kategoria=Matkailu" | localeUrl(lang) }}" class="text-decoration-none">{{ "→ Kaikki blogipostaukset matkailusta" | pageText(lang) }}</a>
    </p>
  </div>
</section>

<style>
/* ---- Matkat hero ---- */
.matkat-hero {
  background-color: #0f172a;
  border-bottom: 2px solid rgba(255,255,255,0.08);
}
.matkat-stat-box {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 0.75rem;
  padding: 0.75rem 0.5rem;
}
.matkat-stat-num {
  font-size: 1.6rem;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.matkat-stat-lbl {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.5);
  margin-top: 0.2rem;
}

/* ---- Trip cards ---- */
.matkat-card {
  border-radius: 0.75rem;
  overflow: hidden;
  transition: transform 0.15s, box-shadow 0.15s;
}
.matkat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.12) !important;
}
.matkat-card-dream {
  opacity: 0.88;
}
.matkat-card-img-wrap {
  position: relative;
  height: 210px;
  overflow: hidden;
  background: #1e2a3a;
}
.matkat-card-img-placeholder {
  background: #1e2a3a;
}
.matkat-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.3s;
}
.matkat-card:hover .matkat-card-img {
  transform: scale(1.04);
}
.matkat-year-badge {
  position: absolute;
  top: 0.6rem;
  left: 0.6rem;
  background: rgba(15,23,42,0.82);
  color: #fff;
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 2rem;
  backdrop-filter: blur(4px);
}
.matkat-type-badge {
  position: absolute;
  bottom: 0.6rem;
  left: 0.6rem;
  font-size: 0.72rem;
  font-weight: 600;
  border-radius: 2rem;
  padding: 0.2rem 0.6rem;
}
.matkat-dream-overlay {
  position: absolute;
  top: 0.6rem;
  right: 0.6rem;
  background: rgba(255,193,7,0.9);
  color: #000;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 2rem;
}

/* ---- Dark mode ---- */
[data-bs-theme="dark"] .matkat-card {
  border-color: rgba(255,255,255,0.08);
}
[data-bs-theme="dark"] .matkat-card-img-wrap {
  background: #111827;
}

/* ---- Blog list ---- */
.list-group-item-action:hover .bi-arrow-right-circle {
  color: var(--bs-primary) !important;
}
</style>
