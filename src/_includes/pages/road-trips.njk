          </div>
          <div class="col-4">
            <div class="matkat-stat-box">
              <div class="matkat-stat-num">15+</div>
              <div class="matkat-stat-lbl">{{ "maata" | pageText(lang) }}</div>
            </div>
          </div>
          <div class="col-4">
            <div class="matkat-stat-box">
              <div class="matkat-stat-num">{{ "~30k" | pageText(lang) }}</div>
