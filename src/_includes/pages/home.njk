<section class="py-5 home-milestones-section" id="aikajana">
    <div class="site-shell">
        {% set firstMilestone = milestones[0] %}
        {% set lastMilestone = milestones[(milestones | length) - 1] %}
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">{{ "Uran kaari ·" | pageText(lang) }} {{ firstMilestone.year | pageText(lang) }}–{{ lastMilestone.year | pageText(lang) }}</p>
            <h2 class="home-section-title">{{ "Merkkitapahtumia tutkimuksen, opetuksen ja politiikan varrelta" | pageText(lang) }}</h2>
            <p class="home-section-lead mb-0">{{ "Kuratoitu aikajana kertoo, miten työ on rakentunut kolmen roolin ympärille yli 20 vuoden aikana. Klikkaa merkkitapahtumaa siirtyäksesi asianomaiselle sivulle." | pageText(lang) }}</p>
        </div>

        <ul class="home-milestones-legend" aria-label="{{ "Merkkitapahtumien kategoriat" | pageText(lang) }}">
            <li><span class="home-milestone-swatch home-milestone-swatch--tausta"></span> {{ "Tausta" | pageText(lang) }}</li>
            <li><span class="home-milestone-swatch home-milestone-swatch--tutkimus"></span> {{ "Tutkimus" | pageText(lang) }}</li>
            <li><span class="home-milestone-swatch home-milestone-swatch--opetus"></span> {{ "Opetus ja koulutus" | pageText(lang) }}</li>
            <li><span class="home-milestone-swatch home-milestone-swatch--politiikka"></span> {{ "Politiikka" | pageText(lang) }}</li>
            <li><span class="home-milestone-swatch home-milestone-swatch--palkinto"></span> {{ "Palkinto" | pageText(lang) }}</li>
        </ul>

        <div class="home-milestones-scroll" role="region" aria-label="{{ "Aikajana, vieritä horisontaalisesti" | pageText(lang) }}">
            <ol class="home-milestones-track">
                {% for milestone in milestones %}
                {% if milestone.phaseStart %}
                <li class="home-milestone-phase" aria-hidden="false">
                    <p class="home-milestone-phase-label">{{ milestone.phaseStart.label | pageText(lang) }}</p>
                    <h3 class="home-milestone-phase-title">{{ milestone.phaseStart.title | pageText(lang) }}</h3>
                    <p class="home-milestone-phase-desc">{{ milestone.phaseStart.description | pageText(lang) }}</p>
                </li>
                {% endif %}
                <li class="home-milestone home-milestone--{{ milestone.category }}{% if loop.index0 % 2 == 0 %} home-milestone--above{% else %} home-milestone--below{% endif %}">
                    <a href="{{ milestone.href | localeUrl(lang) }}" class="home-milestone-card">
                        <p class="home-milestone-category" data-year="{{ milestone.year }}">{{ milestone.category | capitalize | pageText(lang) }}</p>
                        <h3 class="home-milestone-title">{{ milestone.title | pageText(lang) }}</h3>
                        <p class="home-milestone-description">{{ milestone.description | pageText(lang) }}</p>
                    </a>
                    <div class="home-milestone-node">
                        <span class="home-milestone-dot" aria-hidden="true"></span>
                        <span class="home-milestone-year">{{ milestone.year | pageText(lang) }}</span>
                    </div>
                </li>
                {% endfor %}
            </ol>
        </div>
        <p class="home-milestones-hint text-muted small mb-0 mt-2">{{ "Vieritä sivusuuntaan nähdäksesi kaikki merkkitapahtumat →" | pageText(lang) }}</p>
    </div>
</section>

<section class="py-5 bg-body-tertiary home-topics-section" id="teemat">
    <div class="site-shell">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">{{ "Teemat läpi roolien" | pageText(lang) }}</p>
            <h2 class="home-section-title">{{ "Samat aiheet jatkuvat tutkimuksesta opetukseen, kirjoituksiin ja päätöksentekoon" | pageText(lang) }}</h2>
            <p class="home-section-lead mb-0">{{ "Teemaprofiili kokoaa aiheeseen liittyvät julkaisut, esitykset, kirjoitukset, lausunnot ja mediaosumat samalle sivulle. Numero kertoo, kuinka monta sisältöä kustakin teemasta on koottu." | pageText(lang) }}</p>
        </div>

        <div class="home-topics-grid">
            {% for slug in homeTopicSlugs %}
                {% set topic = false %}
                {% for t in seoTopics %}{% if t.slug == slug %}{% set topic = t %}{% endif %}{% endfor %}
                {% if topic %}
                    {% set topicItemList = collections | topicItems(topic, 200) %}
                    {% set researchList = researchfi | curatedResearchForTopic(topic.researchThemes or [], 200) %}
                    {% set topicTotal = topicItemList.totalCount + researchList.length %}
                    {% if topicTotal > 0 %}
                    <a href="{{ "/teemat/" | localeUrl(lang) }}{{ topic.slug }}/" class="home-topic-pill">
                        <p class="home-topic-pill-kicker">{{ topic.eyebrow | pageText(lang) }}</p>
                        <p class="home-topic-pill-title">{{ topic.title | pageText(lang) }}</p>
                        <p class="home-topic-pill-count">{{ topicTotal | pageText(lang) }} {{ "aiheeseen liittyvää sisältöä" | pageText(lang) }}</p>
                        <span class="home-topic-pill-cta">{{ "Avaa teemaprofiili" | pageText(lang) }} <i class="bi bi-arrow-right ms-1"></i></span>
                    </a>
                    {% endif %}
                {% endif %}
            {% endfor %}
