                    <p class="home-role-latest-kicker">{{ "Uusin julkaisu" | pageText(lang) }}</p>
                    <a href="{{ roleLatestResearch.pageUrl | localeUrl(lang) }}" class="home-role-latest-link">{{ roleLatestResearch.title | truncate(90) | pageText(lang) }}</a>
                    {% if roleLatestResearch.year %}<p class="home-role-latest-meta">{{ roleLatestResearch.year | pageText(lang) }}{% if roleLatestResearch.journal %} · {{ roleLatestResearch.journal | truncate(50) | pageText(lang) }}{% endif %}</p>{% endif %}
