{% set heroInitiativeCount = (collections.politics or []) | length %}
{% set trainingMeta = (trainingFeedback and trainingFeedback.meta) or {} %}

{# HOME-LANDING-01: latest-content role cards route through the existing
   canonical Publications and Presentations pipelines and land on
   canonical local detail pages (/julkaisut/{id}/ and /presentations/{slug}/),
   not raw source URLs. See docs/home-landing-01-canonical-latest-2026-08-30.md. #}
{% set roleLatestResearch = (publicationDetailPages.items or []) | sort(true, false, "date") | first %}
{% set roleLatestPresentation = (collections.presentations or []) | sort(true, false, "date") | first %}
{% set roleLatestCouncilSpeech = false %}
{% for item in (collections.pub_puhe or []) | sort(true, false, "date") %}
    {% if not roleLatestCouncilSpeech %}
        {% set speechCtx = item.data.speechContext or "" %}
        {% set forums = item.data.forum or [] %}
        {% set isCouncil = speechCtx == "valtuusto" or speechCtx == "kyselytunti" or item.data.event == "Oulun kaupunginvaltuusto" or forums.indexOf("Kaupunginvaltuusto") != -1 %}
        {% if isCouncil %}
            {% set roleLatestCouncilSpeech = item %}
        {% endif %}
    {% endif %}
{% endfor %}
{% set roleLatestInitiative = ((collections.politics or []) | sort(true, false, "date"))[0] %}

{% set homeRoleTopicSlugs = {
    university: "opettajankoulutus",
    politics: "oulun-palveluverkko-ja-kaupunkikehitys",
    training: "tekoalylukutaito"
} | localizeCopy(lang) %}

{% set homeTopicSlugs = ["tekoalylukutaito", "opettajankoulutus", "oulun-palveluverkko-ja-kaupunkikehitys", "koulutusteknologia-ja-oppimisymparistot", "julkinen-asiantuntijuus-mediassa", "lapinakyva-paatoksenteko-ja-tiedolla-johtaminen"] %}
{% set homeRecognitionItems = [
    {
        year: "2020",
        title: "Kansallinen avoimen tieteen palkinto",
        description: "Tunnustus avoimen tieteen, avoimen opetuksen ja opettajien tukemisen pitkäjänteisestä työstä."
    },
    {
        year: "2014",
        title: "Vuoden tieto- ja viestintätekniikkaopettaja",
        description: "Tunnustus opetusteknologian tutkimuksen, opetuksen ja asiantuntijuuden yhdistämisestä."
    }
] | localizeCopy(lang) %}


<section class="py-5 home-roles-section" id="roolit">
    <div class="site-shell">
        <div class="home-section-head">
            <p class="home-section-kicker mb-1">{{ "Kolme roolia · yksi jatkumo" | pageText(lang) }}</p>
            <h2 class="home-section-title">{{ "Yliopistonlehtori · Kuntapäättäjä · Kouluttaja" | pageText(lang) }}</h2>
            <p class="home-section-lead mb-0">{{ "Sivuston sisältö rakentuu näiden kolmen roolin ympärille. Kussakin kortissa näkyvät ajankohtainen työ, taustaluvut ja linkki syvempään aineistoon." | pageText(lang) }}</p>
        </div>

        <div class="home-roles-grid">
            <article class="home-role-card home-role-card--university">
                <p class="home-role-kicker">{{ "Yliopistotyö" | pageText(lang) }}</p>
                <h3 class="home-role-title">{{ "Yliopistonlehtori" | pageText(lang) }}</h3>
                <p class="home-role-subtitle">{{ "Teknologiatuetun oppimisen ja opetuksen yliopistonlehtori, KTK-tiedekunta, Oulun yliopisto." | pageText(lang) }}</p>
                <dl class="home-role-facts">
                    <div>
                        <dt>{{ "tieteellistä julkaisua" | pageText(lang) }}</dt>
                        <dd>{{ heroPublicationCount | pageText(lang) }}</dd>
                    </div>
                    <div>
                        <dt>{{ "ohjattua opinnäytettä" | pageText(lang) }}</dt>
                        <dd>{{ theses.stats.total | pageText(lang) }}</dd>
                    </div>
                </dl>
                <div class="home-role-focus">
                    <p class="home-role-focus-kicker">{{ "Ajankohtainen fokus" | pageText(lang) }}</p>
                    <p class="home-role-focus-text">{{ "Generation AI -ohjelma, tekoälylukutaito ja opettajankoulutuksen kehittäminen." | pageText(lang) }}</p>
                </div>
                {% if roleLatestResearch and roleLatestResearch.pageUrl %}
