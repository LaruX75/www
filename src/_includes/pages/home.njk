                <a class="home-role-cta" href="{{ "/politiikka/" | localeUrl(lang) }}">{{ "Avaa politiikka" | pageText(lang) }} <i class="bi bi-arrow-right ms-1"></i></a>
            </article>

            <article class="home-role-card home-role-card--training">
                <p class="home-role-kicker">{{ "Larux t:mi" | pageText(lang) }}</p>
                <h3 class="home-role-title">{{ "Kouluttaja" | pageText(lang) }}</h3>
                <p class="home-role-subtitle">{{ "Sivutoimisesti täydennyskoulutuksia ja asiantuntijapuheenvuoroja tekoälystä, oppimisteknologiasta ja modernista pedagogiikasta." | pageText(lang) }}</p>
                <dl class="home-role-facts">
                    <div>
                        <dt>{{ "vuoden koulutuskooste" | pageText(lang) }}</dt>
                        <dd>{{ (trainingMeta.aikavali or "2017–") | pageText(lang) }}</dd>
                    </div>
                    <div>
                        <dt>{{ "palautekeskiarvo" | pageText(lang) }}</dt>
                        <dd class="home-role-facts-small">{{ (trainingMeta.kainutlaatuinenKeskiarvo or "—") | pageText(lang) }}</dd>
                    </div>
                </dl>
                <div class="home-role-focus">
                    <p class="home-role-focus-kicker">{{ "Ajankohtainen fokus" | pageText(lang) }}</p>
                    <p class="home-role-focus-text">{{ "Tekoäly opetuksessa: käytännön työkalut, kokeilut ja opettajayhteisöjen sparraus." | pageText(lang) }}</p>
                </div>
                {% if roleLatestPresentation and roleLatestPresentation.url %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">{{ "Uusin esitys" | pageText(lang) }}</p>
                    <a href="{{ roleLatestPresentation.url | localeUrl(lang) }}" class="home-role-latest-link">{{ roleLatestPresentation.data.title | truncate(90) | pageText(lang) }}</a>
                    {% if roleLatestPresentation.data.date %}<p class="home-role-latest-meta">{{ roleLatestPresentation.data.date | dateFormat | pageText(lang) }}</p>{% endif %}
                </div>
                {% endif %}
                <a class="home-role-cta" href="{{ "/kouluttaja/" | localeUrl(lang) }}">{{ "Avaa kouluttajapalvelut" | pageText(lang) }} <i class="bi bi-arrow-right ms-1"></i></a>
            </article>
        </div>
    </div>
</section>

