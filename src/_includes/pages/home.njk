                {% if roleLatestCouncilSpeech %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">{{ "Uusin valtuustopuheenvuoro" | pageText(lang) }}</p>
                    <a href="{{ roleLatestCouncilSpeech.url | localeUrl(lang) }}" class="home-role-latest-link">{{ roleLatestCouncilSpeech.data.title | truncate(90) | pageText(lang) }}</a>
                    <p class="home-role-latest-meta">{{ roleLatestCouncilSpeech.date | dateFormat | pageText(lang) }}</p>
                </div>
                {% elif roleLatestInitiative %}
                <div class="home-role-latest">
                    <p class="home-role-latest-kicker">{{ "Uusin aloite" | pageText(lang) }}</p>
                    <a href="{{ roleLatestInitiative.url | localeUrl(lang) }}" class="home-role-latest-link">{{ roleLatestInitiative.data.title | truncate(90) | pageText(lang) }}</a>
                    <p class="home-role-latest-meta">{{ roleLatestInitiative.date | dateFormat | pageText(lang) }}</p>
