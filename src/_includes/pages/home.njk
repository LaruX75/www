                {% endif %}
                <a class="home-role-cta" href="{{ "/tyoni-yliopistonlehtorina/" | localeUrl(lang) }}">{{ "Avaa yliopistotyö" | pageText(lang) }} <i class="bi bi-arrow-right ms-1"></i></a>
            </article>

            <article class="home-role-card home-role-card--politics">
                <p class="home-role-kicker">{{ "Politiikka" | pageText(lang) }}</p>
                <h3 class="home-role-title">{{ "Kuntapäättäjä" | pageText(lang) }}</h3>
                <p class="home-role-subtitle">{{ "Kansallinen Kokoomus · 2. varavaltuutettu, sivistyslautakunnan jäsen, Oulun kaupunki." | pageText(lang) }}</p>
                <dl class="home-role-facts">
                    <div>
                        <dt>{{ "puheenvuoroa" | pageText(lang) }}</dt>
                        <dd>{{ heroSpeechCount | pageText(lang) }}</dd>
                    </div>
                    <div>
                        <dt>{{ "valtuustoaloitetta" | pageText(lang) }}</dt>
                        <dd>{{ heroInitiativeCount | pageText(lang) }}</dd>
                    </div>
                </dl>
                <div class="home-role-focus">
                    <p class="home-role-focus-kicker">{{ "Ajankohtainen fokus" | pageText(lang) }}</p>
                    <p class="home-role-focus-text">{{ "Sivistys ja koulutus, palveluverkko sekä avoin ja tiedolla johdettu päätöksenteko." | pageText(lang) }}</p>
