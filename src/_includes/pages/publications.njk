<script>
document.addEventListener('DOMContentLoaded', function() {
  // Inline data from Eleventy
  const publications = [
    {% for pub in canonicalPublications %}
    { year: {{ pub.year or 0 }}, type: "{{ pub.typeCode or '' }}", authors: "{{ (pub.authors or '') | replace('"', '\\"') }}", title: "{{ pub.title | replace('"', '\\"') }}", peerReviewed: {{ "true" if pub.peerReviewed else "false" }}, openAccess: {{ pub.openAccess or 0 }}, doi: "{{ pub.doi or '' }}" },
    {% endfor %}
  ];

  // Semantic Scholar / OpenAlex data
  const s2Citations = {{ semanticscholar.metrics.doiCitations | jsonSafe | safe }};

  // 0. LASKETAAN TODELLISET METRIIKAT (vain tällä sivulla olevat julkaisut)
  let verifiedTotalCitations = 0;
  const citationArray = [];

  publications.forEach(p => {
    if (p.doi && s2Citations[p.doi.toLowerCase()]) {
      const cites = s2Citations[p.doi.toLowerCase()];
      verifiedTotalCitations += cites;
      citationArray.push(cites);
    }
  });

  // Lasketaan todellinen h-indeksi näille julkaisuille
  citationArray.sort((a,b) => b - a);
  let verifiedHIndex = 0;
  for (let i = 0; i < citationArray.length; i++) {
    if (citationArray[i] >= i + 1) {
      verifiedHIndex = i + 1;
    } else {
      break;
    }
  }

  // Päivitetään DOM
  const totalEl = document.getElementById('dynamicTotalCitations');
  if (totalEl) totalEl.textContent = verifiedTotalCitations;

  const hEl = document.getElementById('dynamicHIndex');
  if (hEl) hEl.textContent = verifiedHIndex;

  if (verifiedTotalCitations > 0) {
    const headingEl = document.getElementById('yearChartHeading');
    if (headingEl) {
      headingEl.innerHTML = headingEl.innerHTML + ' <span class="fw-normal text-secondary">(' + verifiedTotalCitations + {{ " viittausta)</span>" | pageText(lang) | jsonSafe | safe }};
    }
  }

  const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
  const textColor = isDark ? '#ccc' : '#666';
  const gridColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.08)';

  Chart.defaults.color = textColor;
  Chart.defaults.borderColor = gridColor;

  function sanitizeFilenamePart(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60) || 'viite';
  }

  function downloadTextFile(filename, text) {
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  const citationFormatSelect = document.getElementById('citationFormatSelect');
  const citationOutput = document.getElementById('citationOutput');
  const citationDownloadBtn = document.getElementById('citationDownloadBtn');
  const citationCopyBtn = document.getElementById('citationCopyBtn');
  const citationZoteroBtn = document.getElementById('citationZoteroBtn');
  const citationMendeleyBtn = document.getElementById('citationMendeleyBtn');
  const citationModalEl = document.getElementById('citationExportModal');
  let currentCitationPayload = null;

  // PUB-CITE1 Phase 4b: the citation modal is shared-renderer-only.
  // When csl is missing, the shared renderer failed to load, or the
  // renderer returns an empty result, sharedCitation() returns an
  // empty payload. Callers show a controlled "not available" state
  // rather than silently synthesising a hand-rolled citation.
  const UNAVAILABLE_MESSAGE = {{ "Viite ei ole saatavilla tälle julkaisulle." | pageText(lang) | jsonSafe | safe }};
  const STYLE_ALIASES = { bibtex: 'bibtex', ris: 'ris', mla: 'mla', chicago: 'chicago', apa: 'apa' };

  function sharedCitation(payload, format) {
    if (!payload || !payload.csl || !window.publicationCitation) {
      return { text: '', empty: true };
    }
    const style = STYLE_ALIASES[format] || 'apa';
    let rendered;
    try {
      rendered = window.publicationCitation.buildCitation({ csl: payload.csl, style });
    } catch (_) {
      return { text: '', empty: true };
    }
    if (!rendered || rendered.empty || !rendered.text) {
      return { text: '', empty: true };
    }
    return { text: rendered.text, empty: false };
  }

  function flashUnavailable(button, defaultLabel) {
    if (!button) return;
    const previous = button.innerHTML;
    button.disabled = true;
    button.innerHTML = defaultLabel;
    setTimeout(() => {
      button.innerHTML = previous;
      button.disabled = false;
    }, 1600);
  }

  function setCitationButtonsEnabled(enabled) {
    [citationCopyBtn, citationDownloadBtn, citationZoteroBtn, citationMendeleyBtn].forEach((btn) => {
      if (btn) btn.disabled = !enabled;
    });
  }

  function downloadRisFor(payload, filenameSuffix, button) {
    const rendered = sharedCitation(payload, 'ris');
    if (rendered.empty) {
      if (citationOutput) citationOutput.value = UNAVAILABLE_MESSAGE;
      setCitationButtonsEnabled(false);
      flashUnavailable(button, {{ "<i class=\"bi bi-exclamation-triangle me-1\"></i>Ei saatavilla" | pageText(lang) | jsonSafe | safe }});
      return;
    }
    const base = sanitizeFilenamePart(payload.title || payload.authors || 'viite');
    downloadTextFile(`${base}-${filenameSuffix}.ris`, rendered.text + '\n');
  }

  function renderCitationPreview() {
    if (!citationOutput) return;
    const format = citationFormatSelect?.value || 'apa';
    const rendered = sharedCitation(currentCitationPayload, format);
    if (rendered.empty) {
      citationOutput.value = UNAVAILABLE_MESSAGE;
      setCitationButtonsEnabled(false);
      return;
    }
    citationOutput.value = rendered.text;
    setCitationButtonsEnabled(true);
  }

  document.addEventListener('click', (event) => {
    const btn = event.target.closest('.export-citation-btn');
    if (!btn) return;
    let csl = null;
    if (btn.dataset.csl) {
      try { csl = JSON.parse(btn.dataset.csl); } catch (_) { csl = null; }
    }
    currentCitationPayload = {
      title: btn.dataset.title || '',
      authors: btn.dataset.authors || '',
      year: btn.dataset.year || '',
      journal: btn.dataset.journal || '',
      doi: btn.dataset.doi || '',
      url: btn.dataset.url || '',
      volume: btn.dataset.volume || '',
      issue: btn.dataset.issue || '',
      pages: btn.dataset.pages || '',
      publisher: btn.dataset.publisher || '',
      isbn: btn.dataset.isbn || '',
      csl: csl
    };
    if (citationFormatSelect) citationFormatSelect.value = 'apa';
    renderCitationPreview();
    if (window.bootstrap && window.bootstrap.Modal && citationModalEl) {
      window.bootstrap.Modal.getOrCreateInstance(citationModalEl).show();
    }
  });

  if (citationFormatSelect) {
    citationFormatSelect.addEventListener('change', renderCitationPreview);
  }

  if (citationDownloadBtn) {
    citationDownloadBtn.addEventListener('click', () => {
      if (!currentCitationPayload) return;
      const format = citationFormatSelect?.value || 'apa';
      const rendered = sharedCitation(currentCitationPayload, format);
      if (rendered.empty) {
        if (citationOutput) citationOutput.value = UNAVAILABLE_MESSAGE;
        setCitationButtonsEnabled(false);
        flashUnavailable(citationDownloadBtn, {{ "<i class=\"bi bi-exclamation-triangle me-1\"></i>Ei saatavilla" | pageText(lang) | jsonSafe | safe }});
        return;
      }
      const base = sanitizeFilenamePart(currentCitationPayload.title || currentCitationPayload.authors || 'viite');
      const ext = format === 'bibtex' ? 'bib' : 'txt';
      downloadTextFile(`${base}.${ext}`, rendered.text + '\n');
    });
  }

  if (citationCopyBtn) {
    citationCopyBtn.addEventListener('click', async () => {
      if (!citationOutput?.value || citationOutput.value === UNAVAILABLE_MESSAGE) return;
      try {
        await navigator.clipboard.writeText(citationOutput.value);
        citationCopyBtn.innerHTML = {{ "<i class=\"bi bi-check2 me-1\"></i>Kopioitu" | pageText(lang) | jsonSafe | safe }};
        setTimeout(() => {
          citationCopyBtn.innerHTML = {{ "<i class=\"bi bi-clipboard me-1\"></i>Kopioi" | pageText(lang) | jsonSafe | safe }};
        }, 1400);
      } catch (_) {
        citationOutput.select();
        document.execCommand('copy');
      }
    });
  }

  if (citationZoteroBtn) {
    citationZoteroBtn.addEventListener('click', () => {
      if (!currentCitationPayload) return;
      downloadRisFor(currentCitationPayload, 'zotero', citationZoteroBtn);
    });
  }

  if (citationMendeleyBtn) {
    citationMendeleyBtn.addEventListener('click', () => {
      if (!currentCitationPayload) return;
      downloadRisFor(currentCitationPayload, 'mendeley', citationMendeleyBtn);
    });
  }

  // 1. VUOSIKAAVIO
  const yearCounts = {};
  publications.forEach(p => { if(p.year) yearCounts[p.year] = (yearCounts[p.year]||0)+1; });
  const years = Object.keys(yearCounts).sort();
  // Citation counts per year from S2 data
  const citesPerYear = {};
  if (s2Citations) {
    publications.forEach(p => {
      if (p.year && p.doi && s2Citations[p.doi.toLowerCase()]) {
        citesPerYear[p.year] = (citesPerYear[p.year]||0) + s2Citations[p.doi.toLowerCase()];
      }
    });
  }

  const yearChartInst = new Chart(document.getElementById('yearChart'), {
    type: 'bar',
    data: {
      labels: years,
      datasets: [{
        label: {{ "Julkaisuja" | pageText(lang) | jsonSafe | safe }},
        data: years.map(y => yearCounts[y]),
        backgroundColor: isDark ? 'rgba(56,189,248,0.6)' : 'rgba(13,110,253,0.7)',
        borderRadius: 4,
        borderSkipped: false,
        yAxisID: 'y'
      },{
        label: {{ "Viittauksia" | pageText(lang) | jsonSafe | safe }},
        data: years.map(y => citesPerYear[y] || 0),
        type: 'line',
        borderColor: '#ffc107',
        backgroundColor: 'rgba(255,193,7,0.15)',
        fill: true,
        tension: 0.3,
        pointRadius: 3,
        yAxisID: 'y1'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, title: { display: true, text: {{ "Julkaisut" | pageText(lang) | jsonSafe | safe }}, font: { size: 10 } } },
        y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: {{ "Viittaukset" | pageText(lang) | jsonSafe | safe }}, font: { size: 10 } } },
        x: { ticks: { maxRotation: 45 } }
      }
    }
  });

  // 2. TYYPPIKAAVIO
  const typeCounts = {};
  const typeLabels = {
    'A1':{{ "Lehtiartikkeli (A1)" | pageText(lang) | jsonSafe | safe }}, 'A2':{{ "Katsausartikkeli (A2)" | pageText(lang) | jsonSafe | safe }},
    'A3':{{ "Kirjan osa (A3)" | pageText(lang) | jsonSafe | safe }}, 'A4':{{ "Konferenssi (A4)" | pageText(lang) | jsonSafe | safe }},
    'B1':{{ "Kirjoitus (B1)" | pageText(lang) | jsonSafe | safe }}, 'B3':{{ "Konferenssi ei-vertaisarv. (B3)" | pageText(lang) | jsonSafe | safe }},
    'C1':{{ "Tieteellinen teos (C1)" | pageText(lang) | jsonSafe | safe }}, 'C2':{{ "Toimitettu teos (C2)" | pageText(lang) | jsonSafe | safe }},
    'D1':{{ "Ammattiartikkeli (D1)" | pageText(lang) | jsonSafe | safe }}, 'D2':{{ "Ammatillinen kokoomat. (D2)" | pageText(lang) | jsonSafe | safe }},
    'E1':{{ "Yleistajuinen (E1)" | pageText(lang) | jsonSafe | safe }}, 'G4':{{ "Väitöskirja (G4)" | pageText(lang) | jsonSafe | safe }}, 'G5':{{ "Väitöskirja (G5)" | pageText(lang) | jsonSafe | safe }}
  };
  publications.forEach(p => { typeCounts[p.type] = (typeCounts[p.type]||0)+1; });
  const typeKeys = Object.keys(typeCounts).sort((a,b) => typeCounts[b]-typeCounts[a]);
  const typeColors = ['#0d6efd','#6610f2','#6f42c1','#d63384','#dc3545','#fd7e14','#ffc107','#198754','#20c997','#0dcaf0','#6c757d','#adb5bd','#495057'];
  const typeChartInst = new Chart(document.getElementById('typeChart'), {
    type: 'doughnut',
    data: {
      labels: typeKeys.map(k => typeLabels[k]||k),
      datasets: [{
        data: typeKeys.map(k => typeCounts[k]),
        backgroundColor: typeColors.slice(0, typeKeys.length),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', maxHeight: 72, labels: { boxWidth: 10, font: { size: 10 }, padding: 6 } }
      }
    }
  });

  // 3. LAADULLISET (peer review & OA)
  // Kategorisoidaan julkaisut toisensa poissulkeviin luokkiin
  const isPeerReviewed = (value) => value === true || value === 1 || value === '1' || String(value).toLowerCase() === 'true';
  const isOpenAccess = (value) => value === true || value === 1 || value === '1' || String(value).toLowerCase() === 'true';
  const prAndOa = publications.filter(p => isPeerReviewed(p.peerReviewed) && isOpenAccess(p.openAccess)).length;
  const prOnly = publications.filter(p => isPeerReviewed(p.peerReviewed) && !isOpenAccess(p.openAccess)).length;
  // {{ "Muu / ei vertaisarvioitu" | pageText(lang) | jsonSafe | safe }} sisältää sekä OA- että ei-OA-julkaisut.
  const nonPeerReviewed = publications.filter(p => !isPeerReviewed(p.peerReviewed)).length;

  const qualityChartInst = new Chart(document.getElementById('qualityChart'), {
    type: 'doughnut',
    data: {
      labels: [{{ "Vertaisarvioitu & OA" | pageText(lang) | jsonSafe | safe }}, {{ "Vain vertaisarvioitu" | pageText(lang) | jsonSafe | safe }}, {{ "Muu / ei vertaisarvioitu" | pageText(lang) | jsonSafe | safe }}],
      datasets: [{
        data: [prAndOa, prOnly, nonPeerReviewed],
        backgroundColor: ['#198754', '#20c997', '#dee2e6'],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', maxHeight: 72, labels: { boxWidth: 10, font: { size: 10 }, padding: 6 } }
      }
    }
  });

  // Mobiili-accordion: resize kaaviot kun collapse aukeaa (alustus tapahtuu display:none-tilassa)
  const analyticsDashEl = document.getElementById('analyticsDashboard');
  if (analyticsDashEl) {
    analyticsDashEl.addEventListener('shown.bs.collapse', () => {
      [yearChartInst, typeChartInst, qualityChartInst].forEach(c => c && c.resize());
    });
    // Pyöritetään chevron-ikoni auki/kiinni
    const toggleBtn = document.querySelector('[data-bs-target="#analyticsDashboard"]');
    if (toggleBtn) {
      analyticsDashEl.addEventListener('show.bs.collapse', () => toggleBtn.setAttribute('aria-expanded', 'true'));
      analyticsDashEl.addEventListener('hide.bs.collapse', () => toggleBtn.setAttribute('aria-expanded', 'false'));
    }
  }

  // KAAVION SUURENNOS (zoom modal)
  const chartInstances = { yearChart: yearChartInst, typeChart: typeChartInst, qualityChart: qualityChartInst };
  let zoomChartInst = null;
  const zoomModalEl = document.getElementById('chartZoomModal');
  const zoomModalLabel = document.getElementById('chartZoomModalLabel');

  function openZoomModal(sourceId, title) {
    const source = chartInstances[sourceId];
    if (!source) return;
    zoomModalLabel.textContent = title;
    const bsModal = bootstrap.Modal.getOrCreateInstance(zoomModalEl);
    bsModal.show();
  }

  zoomModalEl.addEventListener('shown.bs.modal', function() {
    const btn = zoomModalEl.querySelector('[data-zoom-active]') ||
                document.querySelector('.chart-zoom-btn[data-zoom-active]');
    // Reconstruct from active source id stored on modal
    const sourceId = zoomModalEl.dataset.activeChart;
    const source = chartInstances[sourceId];
    if (!source) return;
    if (zoomChartInst) { zoomChartInst.destroy(); zoomChartInst = null; }
    const canvas = document.getElementById('zoomCanvas');
    // Deep-clone config and enlarge legend
    const cfg = JSON.parse(JSON.stringify({ type: source.config.type, data: source.config.data, options: source.config.options }));
    if (cfg.options && cfg.options.plugins && cfg.options.plugins.legend) {
      cfg.options.plugins.legend.labels = cfg.options.plugins.legend.labels || {};
      cfg.options.plugins.legend.labels.font = { size: 13 };
      cfg.options.plugins.legend.labels.padding = 14;
      cfg.options.plugins.legend.labels.boxWidth = 14;
    }
    zoomChartInst = new Chart(canvas, cfg);
  });

  zoomModalEl.addEventListener('hidden.bs.modal', function() {
    if (zoomChartInst) { zoomChartInst.destroy(); zoomChartInst = null; }
  });

  // Sidotaan zoom-napit ja koko canvas-alue
  document.querySelectorAll('.chart-zoom-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const sourceId = this.dataset.zoomTarget;
      const title = this.dataset.zoomTitle;
      zoomModalEl.dataset.activeChart = sourceId;
      openZoomModal(sourceId, title);
    });
  });
  // Klikki suoraan canvakselle avaa myös zoomin
  ['yearChart','typeChart','qualityChart'].forEach(id => {
    const btn = document.querySelector(`.chart-zoom-btn[data-zoom-target="${id}"]`);
    const canvas = document.getElementById(id);
    if (canvas && btn) canvas.addEventListener('click', () => btn.click());
    if (canvas) canvas.style.cursor = 'zoom-in';
  });

  // 4. KANSSAKIRJOITTAJAT
  const coauthors = {};
  publications.forEach(p => {
    const authors = p.authors.split(';').map(a => a.trim()).filter(a => a.length > 0);
    authors.forEach(a => {
      if (!a.toLowerCase().startsWith('laru')) {
        coauthors[a] = (coauthors[a]||0) + 1;
      }
    });
  });
  const allCoauthors = Object.entries(coauthors).sort((a, b) => {
    const countDiff = b[1] - a[1];
    return countDiff || new Intl.Collator('fi').compare(a[0], b[0]);
  });
  const topCoauthors = allCoauthors.slice(0, 10);
  const tbody = document.querySelector('#coauthorTable tbody');
  if (tbody) {
    topCoauthors.forEach(([name, count]) => {
      const tr = document.createElement('tr');
      const isDarkTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark';
      const badgeStyle = isDarkTheme ? 'background-color: rgba(56,189,248,0.3); color: #e2e6ec;' : 'background-color: rgba(13,110,253,0.15); color: #0d6efd;';
      tr.innerHTML = `<td>${name}</td><td class="text-end"><span class="badge rounded-pill" style="${badgeStyle}">${count}</span></td>`;
      tbody.appendChild(tr);
    });
  }

  // Kanssatutkijat-kortti: häivytys + expand
  const coauthorFadeOverlay = document.getElementById('coauthorFadeOverlay');
  const coauthorTableWrap = document.getElementById('coauthorTableWrap');
  if (coauthorFadeOverlay && coauthorTableWrap) {
    coauthorFadeOverlay.addEventListener('click', () => {
      coauthorTableWrap.style.maxHeight = 'none';
      coauthorTableWrap.style.overflow = 'visible';
      coauthorFadeOverlay.style.display = 'none';
    });
  }

  // 5. SANAPILVI (Otsikon sanat, alkuperäinen toimivaksi todettu tapa)
  const stopwords = new Set(['the','of','in','for','a','an','and','to','on','with','from','by','at','as','is','are','was','were','or','using','based','their','its','towards','between','among','during','about','through','case','study','how','can','do','does','than','into','all','not','but','also','been','has','have','had','which','when','what','that','this','these','those','other','more','no','some','varhaiskasvatuksen']);
  const wordCounts = {};
  publications.forEach(p => {
    const words = p.title.toLowerCase().replace(/[^a-zäöüå\s-]/g, '').split(/\s+/);
    words.forEach(w => {
      if (w.length > 3 && !stopwords.has(w)) {
        wordCounts[w] = (wordCounts[w]||0) + 1;
      }
    });
  });
  const topWords = Object.entries(wordCounts).sort((a,b)=>b[1]-a[1]).slice(0,25);
  const cloudEl = document.getElementById('wordCloud');
  if (topWords.length > 0) {
    const maxCount = topWords[0]?.[1] || 1;
    topWords.forEach(([word, count]) => {
      const size = 0.7 + (count / maxCount) * 1.0;
      const opacity = 0.5 + (count / maxCount) * 0.5;
      const span = document.createElement('span');
      span.className = 'badge rounded-pill';
      span.style.cssText = `font-size:${size}rem; opacity:${opacity}; background-color: ${isDark ? 'rgba(56,189,248,0.3)' : 'rgba(13,110,253,0.15)'}; color: ${isDark ? '#e2e6ec' : '#004192'}; font-weight: 500;`;
      span.textContent = `${word} (${count})`;
      cloudEl.appendChild(span);
    });
  } else {
    cloudEl.innerHTML = {{ "<span class=\"text-muted small\">Ei avainsanoja saatavilla</span>" | pageText(lang) | jsonSafe | safe }};
  }
});
</script>
