{% import "ui.njk" as ui %}

{%- set canonicalPublications = publicationsPage.items or [] -%}
{%- set articleCount = 0 -%}
{%- set confCount = 0 -%}
{%- set bookCount = 0 -%}
{%- set peerReviewedCount = 0 -%}
{%- set openAccessCount = 0 -%}
{%- set pubsA = [] -%}
{%- set pubsB = [] -%}
{%- set pubsC = [] -%}
{%- set pubsD = [] -%}
{%- set pubsE = [] -%}
{%- set pubsG = [] -%}
{%- for pub in canonicalPublications -%}
  {%- set typeChar = pub.publicationGroup or ((pub.typeCode or '') | first) -%}
  {%- if typeChar == "A" -%}{%- set pubsA = (pubsA.push(pub), pubsA) -%}
  {%- elif typeChar == "B" -%}{%- set pubsB = (pubsB.push(pub), pubsB) -%}
  {%- elif typeChar == "C" -%}{%- set pubsC = (pubsC.push(pub), pubsC) -%}
  {%- elif typeChar == "D" -%}{%- set pubsD = (pubsD.push(pub), pubsD) -%}
  {%- elif typeChar == "E" -%}{%- set pubsE = (pubsE.push(pub), pubsE) -%}
  {%- elif typeChar == "G" -%}{%- set pubsG = (pubsG.push(pub), pubsG) -%}
  {%- endif -%}
  {%- if pub.typeCode == "A1" or pub.typeCode == "A2" -%}{%- set articleCount = articleCount + 1 -%}{%- endif -%}
  {%- if pub.typeCode == "A3" or pub.typeCode == "A4" or pub.typeCode == "B3" -%}{%- set confCount = confCount + 1 -%}{%- endif -%}
  {%- if pub.typeCode == "C1" or pub.typeCode == "C2" or pub.typeCode == "G4" or pub.typeCode == "G5" -%}{%- set bookCount = bookCount + 1 -%}{%- endif -%}
  {%- if pub.peerReviewed -%}{%- set peerReviewedCount = peerReviewedCount + 1 -%}{%- endif -%}
  {%- if pub.openAccess -%}{%- set openAccessCount = openAccessCount + 1 -%}{%- endif -%}
{%- endfor -%}

<section class="publications-hero py-4 py-lg-5">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <p class="text-uppercase small text-muted mb-2">{{ "Julkaisut" | pageText(lang) }}</p>
        <h1 class="display-6 fw-bold mb-2">{{ "Julkaisuluettelo" | pageText(lang) }}</h1>
        <p class="text-muted mb-3">{{ "Tällä sivulla on Jari Larun tieteellisten ja ammatillisten julkaisujen kokonaisluettelo. Aineisto päivittyy automaattisesti" | pageText(lang) }} <a href="{{ "https://research.fi/en/results/person/0000-0003-0347-0182" | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer">{{ "Research.fi-profiilista" | pageText(lang) }}</a>{{ ", ja se on ryhmitelty OKM:n julkaisutyyppiluokituksen (A–G) mukaisesti." | pageText(lang) }}</p>
      </div>
      <div class="col-lg-4">
        <div class="publications-hero-aside">
          <p class="publications-hero-kicker mb-2">{{ "Näin luettelo on ryhmitelty" | pageText(lang) }}</p>
          <ul class="publications-hero-list mb-0">
            <li><strong>{{ "Vertaisarvioidut" | pageText(lang) }}</strong> {{ "julkaisut (A ja C1): asiantuntijoiden arvioimat lehtiartikkelit, konferenssijulkaisut ja tieteelliset kirjat." | pageText(lang) }}</li>
            <li><strong>{{ "Ammatilliset" | pageText(lang) }}</strong> {{ "julkaisut (B ja D): opetusalan lehdet ja artikkelit, jotka eivät kulje vertaisarvioinnin läpi." | pageText(lang) }}</li>
            <li><strong>{{ "Yleistajuiset" | pageText(lang) }}</strong> {{ "julkaisut (E) ja muut (G): laajemmalle yleisölle suunnatut tekstit." | pageText(lang) }}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="publication-kpi-section">
  <div class="site-shell">
    <div class="row g-3">
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard(("julkaisua" | pageText(lang)), canonicalPublications.length, { tone: "julkaisut", extraClass: "publication-kpi-card" }) | pageText(lang) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard(("vertaisarvioitua julkaisua" | pageText(lang)), peerReviewedCount, { tone: "julkaisut", extraClass: "publication-kpi-card" }) | pageText(lang) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard(("viittausta" | pageText(lang)), "…", { id: "dynamicTotalCitations", title: "Lähde: " ~ semanticscholar.metrics.sources, tone: "julkaisut", extraClass: "publication-kpi-card" }) | pageText(lang) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard(("h-indeksi" | pageText(lang)), "…", { id: "dynamicHIndex", title: "Lähde: " ~ semanticscholar.metrics.sources, tone: "julkaisut", extraClass: "publication-kpi-card" }) | pageText(lang) }}
      </div>
    </div>
    <p class="publication-kpi-note text-muted mb-0 mt-3">{{ openAccessCount | pageText(lang) }} {{ "julkaisua on merkitty avoimesti saataviksi," | pageText(lang) }} {{ articleCount | pageText(lang) }} {{ "kuuluu lehtiartikkeleihin ja" | pageText(lang) }} {{ confCount | pageText(lang) }} {{ "konferenssiaineistoon." | pageText(lang) }}</p>
  </div>
</section>



