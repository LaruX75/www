      <ul class="starter-chips-list">
        <li><button type="button" class="starter-chip" data-starter-chip data-starter-chip-target="#researchEvidenceExploreTopic" data-starter-chip-value="tekoäly">{{ "Tekoäly" | pageText(lang) }}</button></li>
