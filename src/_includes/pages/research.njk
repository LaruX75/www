<!-- OMA VÄITÖSKIRJA JA PRO GRADU -->
<span id="varhaisvaihe"></span>
<section class="py-5" id="omat-opinnaytteet">
  <div class="site-shell">
    <div class="row g-4 align-items-end mb-3">
      <div class="col-lg-8">
        <p class="text-uppercase text-muted fw-semibold small mb-2">{{ "Tutkimustyön alkupiste" | pageText(lang) }}</p>
        <h2 class="h3 fw-bold mb-3">{{ "Väitöskirja ja pro gradu" | pageText(lang) }}</h2>
        <p class="text-muted mb-0">{{ "Tutkimusuran alkupiste löytyy mobiiliteknologian ja yhteisöllisen oppimisen kysymyksistä. Samat teemat näkyvät työssä edelleen uudessa muodossa." | pageText(lang) }}</p>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4">
            <span class="badge bg-primary mb-3">{{ "Väitöskirja 2012" | pageText(lang) }}</span>
            <h3 class="h5 fw-bold mb-2">{{ "Scaffolding learning activities with collaborative scripts and mobile devices" | pageText(lang) }}</h3>
            <p class="text-muted mb-2">{{ "Oulun yliopisto, kasvatustiede. Väitös 21.11.2012." | pageText(lang) }}</p>
            <p class="mb-3">{{ "Väitöskirja tutki, miten yhteisöllisiä skriptejä voidaan hyödyntää mobiililaitteiden tukemissa oppimisympäristöissä. Työ yhdistää CSCL-tutkimuksen (Computer-Supported Collaborative Learning) ja mobiiliteknologian." | pageText(lang) }}</p>
            <div class="d-flex flex-wrap gap-2">
              <a href="{{ "/vaitoskirja/" | localeUrl(lang) }}" class="btn btn-sm btn-outline-primary">{{ "Väitöskokonaisuus" | pageText(lang) }}</a>
              <a href="{{ "http://jultika.oulu.fi/Record/isbn978-951-42-9940-7" | localeUrl(lang) }}" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer">{{ "Jultika-arkisto" | pageText(lang) }}</a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4">
            <span class="badge bg-secondary mb-3">{{ "Pro gradu 2003" | pageText(lang) }}</span>
            <h3 class="h5 fw-bold mb-2">{{ "Langattomat päätelaitteet hajautetun asiantuntijuuden ja yhteisöllisen tiedonrakentelun tukena" | pageText(lang) }}</h3>
            <p class="text-muted mb-2">{{ "Goman, H. & Laru, J. (2003). Oulun yliopisto." | pageText(lang) }}</p>
            <p class="mb-3">{{ "Varhaisvaiheen tutkimus langattomien laitteiden mahdollisuuksista hajautetun asiantuntijuuden ja yhteisöllisen tiedonrakentelun välineinä – ennen älypuhelinaikaa." | pageText(lang) }}</p>
            <a href="{{ "https://www.researchgate.net/publication/259217800_Langattomat_paatelaitteet_hajautetun_asiantuntijuuden_ja_yhteisollisen_tiedonrakentelun_tukena" | localeUrl(lang) }}" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer">{{ "ResearchGate" | pageText(lang) }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HANKEHISTORIA -->
<section class="py-5 bg-body-tertiary border-top border-bottom" id="hankkeet">
  <div class="site-shell">
    <div class="row g-4 align-items-end mb-3">
      <div class="col-lg-8">
        <p class="text-uppercase text-muted fw-semibold small mb-2">{{ "Hankehistoria" | pageText(lang) }}</p>
        <h2 class="h3 fw-bold mb-3">{{ "Tutkimushankkeet 2003–" | pageText(lang) }}</h2>
        <p class="text-muted mb-0">{{ "Rahoitetut tutkimushankkeet, joissa Jari Laru on ollut mukana. Aktiiviset hankkeet on merkitty." | pageText(lang) }}</p>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle research-projects-table">
        <thead>
          <tr>
            <th scope="col" style="min-width: 7rem;">{{ "Vuodet" | pageText(lang) }}</th>
            <th scope="col">{{ "Hanke" | pageText(lang) }}</th>
            <th scope="col">{{ "Rahoittaja" | pageText(lang) }}</th>
            <th scope="col">{{ "Rooli" | pageText(lang) }}</th>
          </tr>
        </thead>
        <tbody>
          {% for project in researchProjects %}
          <tr>
            <td>
              <span class="fw-semibold">{{ project.period | pageText(lang) }}</span>
              {% if project.active %}<span class="badge bg-success ms-1" title="{{ "Aktiivinen hanke" | pageText(lang) }}">{{ "aktiivinen" | pageText(lang) }}</span>{% endif %}
            </td>
            <td>
              {% if project.url %}
                <a href="{{ project.url | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer" class="fw-semibold text-decoration-none">{{ project.name | pageText(lang) }} <i class="bi bi-box-arrow-up-right small ms-1"></i></a>
              {% else %}
                <span class="fw-semibold">{{ project.name | pageText(lang) }}</span>
              {% endif %}
              {% if project.fullName and project.fullName != project.name %}
                <div class="small text-muted">{{ project.fullName | pageText(lang) }}</div>
              {% endif %}
            </td>
            <td class="small">{{ project.funder | pageText(lang) }}</td>
            <td class="small">{{ project.role | pageText(lang) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

