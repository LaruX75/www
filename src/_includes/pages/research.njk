
{% set researchProgramModel = researchProgram or {} %}
{% set researchLines = researchProgramModel.visibleLines or researchProgramModel.lines or [] %}
{% set currentResearchLine = researchProgramModel.currentLine or null %}

<!-- HERO -->
<section class="research-hero py-5 bg-body-tertiary border-bottom">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-9">
        <p class="text-uppercase text-muted fw-semibold small mb-2">{{ "Tutkimus" | pageText(lang) }}</p>
        <h1 class="display-6 fw-bold mb-3">{{ "Tutkimuksen tarkasteluteemat: miten teknologia muuttaa oppimista ja opettamista" | pageText(lang) }}</h1>
        <p class="lead mb-4">{{ "Jari Larun tutkimus kulkee yhteisöllisestä oppimisesta ja mobiiliteknologiasta opettajien tekoälylukutaitoon. Tämä sivu kokoaa nykyisen tutkimusohjelman, kolme keskeistä tutkimuslinjaa ja tunnistetiedot ulkoisiin tutkijaprofiileihin." | pageText(lang) }}</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="{{ "/julkaisut/" | localeUrl(lang) }}" class="btn btn-primary rounded-pill px-4">{{ "Avaa julkaisuluettelo" | pageText(lang) }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- NYKYINEN OHJELMA: GENERATION AI -->
<section class="py-5" id="generation-ai">
  <div class="site-shell">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-7">
        <p class="text-uppercase text-muted fw-semibold small mb-2">{{ "Nykyinen tutkimusohjelma" | pageText(lang) }}</p>
        <h2 class="h3 fw-bold mb-3">{{ "Generation AI kokoaa tutkimuksen tämänhetkisen painopisteen" | pageText(lang) }}</h2>
        <p class="lead mb-3">{{ "Suomen Akatemian Strategisen tutkimuksen neuvoston (STN) rahoittama monitieteinen hanke (2022–) rakentaa pohjaa tekoäly- ja turvallisuuskasvatukselle esi- ja perusopetuksessa." | pageText(lang) }}</p>
        <p class="mb-3">{{ "Työssä yhdistyvät tutkimustiedon välittäminen, opettajankoulutus ja opettajien tekoälylukutaidon tutkimus. Tavoitteena on tehdä vaikeasta ilmiöstä ymmärrettävä ja käyttökelpoinen koulun arjessa." | pageText(lang) }}</p>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body p-4">
            <h3 class="h6 text-uppercase text-muted fw-bold mb-3">{{ "Mikä on keskiössä juuri nyt?" | pageText(lang) }}</h3>
            <ul class="mb-0 ps-3">
              <li>{{ "opettajien ja opettajaopiskelijoiden tekoälylukutaito" | pageText(lang) }}</li>
              <li>{{ "tekoälykasvatus esi- ja perusopetuksessa" | pageText(lang) }}</li>
              <li>{{ "tutkimustiedon vieminen koulun arkeen, materiaaleihin ja koulutuksiin" | pageText(lang) }}</li>
            </ul>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="{{ "https://www.generation-ai-stn.fi" | localeUrl(lang) }}" class="btn btn-success" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right me-1"></i>{{ "Hankkeen sivusto" | pageText(lang) }}</a>
        </div>
      </div>
      <div class="col-lg-5 research-current-evidence">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4 d-flex flex-column">
            <h3 class="h6 text-uppercase text-muted fw-bold mb-3">{{ "Tuore tutkimusnäyttö tästä linjasta" | pageText(lang) }}</h3>
            {% if currentResearchLine and currentResearchLine.publications.length %}
              <div class="d-grid gap-3">
                {% for pub in currentResearchLine.publications %}
                <article>
                  <p class="small fw-semibold mb-1">{{ pub.title | pageText(lang) }}</p>
                  <p class="small mb-2">{{ pub.citation | pageText(lang) }}</p>
                  <a href="{{ pub.url | localeUrl(lang) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">{{ "Julkaisun lähdeviite" | pageText(lang) }}</a>
                </article>
                {% endfor %}
              </div>
            {% else %}
              <p class="text-muted small mb-0">{{ "Julkaisunostoja ei löytynyt tähän painopisteeseen buildin aikana." | pageText(lang) }}</p>
            {% endif %}
            <hr class="my-4">
            <dl class="row mb-0 small">
              <dt class="col-5 text-muted">{{ "Rahoittaja" | pageText(lang) }}</dt>
              <dd class="col-7">{{ "Suomen Akatemian Strategisen tutkimuksen neuvosto" | pageText(lang) }}</dd>
              <dt class="col-5 text-muted">{{ "Rooli" | pageText(lang) }}</dt>
              <dd class="col-7">{{ "Vuorovaikutusasiantuntija, tutkija" | pageText(lang) }}</dd>
              <dt class="col-5 text-muted">{{ "Kohderyhmä" | pageText(lang) }}</dt>
              <dd class="col-7">{{ "Esi- ja perusopetus, opettajat" | pageText(lang) }}</dd>
              <dt class="col-5 text-muted">{{ "Organisaatio" | pageText(lang) }}</dt>
              <dd class="col-7">{{ "Oulun yliopisto" | pageText(lang) }}</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TUTKIMUSLINJAT -->
<section class="py-5 bg-body-tertiary border-top border-bottom" id="tutkimuslinjat">
  <div class="site-shell">
    <div class="row g-4 align-items-end mb-3">
      <div class="col-lg-8">
        <p class="text-uppercase text-muted fw-semibold small mb-2">{{ "Tutkimuslinjat" | pageText(lang) }}</p>
        <h2 class="h3 fw-bold mb-3">{{ "Kolme keskeistä tutkimuslinjaa" | pageText(lang) }}</h2>
        <p class="text-muted mb-0">{{ "Työn ydinkysymys ei ole vain mitä on julkaistu, vaan millä linjoilla työ etenee ja miten eri julkaisut, opinnäytteet ja käytännön sovellukset liittyvät toisiinsa." | pageText(lang) }}</p>
      </div>
    </div>

    <div class="row g-4">
      {% for line in researchLines %}
      <div class="col-lg-4">
        <article class="card border-0 shadow-sm h-100">
          <div class="card-body p-4 d-flex flex-column">
            <p class="small text-uppercase text-muted fw-semibold mb-2">{{ line.eyebrow | pageText(lang) }}</p>
            <h3 class="h5 fw-bold mb-2">{{ line.title | pageText(lang) }}</h3>
            <p class="text-muted small mb-3">{{ line.description | pageText(lang) }}</p>
            {% if line.publications.length %}
              <p class="small text-uppercase text-muted fw-semibold mb-2">{{ "Keskeinen julkaisu" | pageText(lang) }}</p>
              <div class="mb-3">
                {% set pub = line.publications[0] %}
                <p class="small fw-semibold mb-1">{{ pub.title | pageText(lang) }}</p>
                <p class="small text-muted mb-1">{{ pub.citation | pageText(lang) }}</p>
                <a href="{{ pub.url | localeUrl(lang) }}" class="small text-decoration-none">{{ "Avaa lähdeviite →" | pageText(lang) }}</a>
              </div>
            {% endif %}
            <div class="mt-auto d-flex flex-wrap gap-2">
              <a href="{{ line.themeUrl | localeUrl(lang) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">{{ (line.themeLabel or "Aiheprofiili") | pageText(lang) }}</a>
            </div>
          </div>
        </article>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

