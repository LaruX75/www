<section class="pol-hero mb-0">
  <div class="site-shell py-5">
    <div class="row g-5 align-items-stretch">
      <div class="col-lg-7">
        <p class="pol-eyebrow mb-2"><i class="bi bi-building2 me-1"></i>{{ "Politiikka" | pageText(lang) }}</p>
        <h1 class="pol-hero-title mb-3">{{ "Jari Laru, poliitikko" | pageText(lang) }}</h1>
        <p class="pol-hero-manifesto mb-3">{{ "Sivistys, palveluverkko ja avoin päätöksenteko eivät ole kunnallispolitiikan sivujuonteita vaan sen kovaa ydintä." | pageText(lang) }}</p>
        <p class="mb-4 pol-hero-text">{{ "Jari Laru tekee politiikkaa käytännöllisesti ja tietoon nojaten. Tavoitteena on, että päätöksenteko näkyy kuntalaiselle parempina oppimisympäristöinä, toimivampina palveluina ja valmisteluna, jota voi seurata ilman sisäpiiritietoa." | pageText(lang) }}</p>
        <div class="pol-hero-points mb-4">
          <div class="pol-hero-point">
            <span class="pol-hero-point-title">{{ "Sivistys" | pageText(lang) }}</span>
            <span class="pol-hero-point-text">{{ "Laadukkaat oppimisympäristöt, koulutuspolitiikka ja pitkät vaikutukset." | pageText(lang) }}</span>
          </div>
          <div class="pol-hero-point">
            <span class="pol-hero-point-title">{{ "Palveluverkko" | pageText(lang) }}</span>
            <span class="pol-hero-point-text">{{ "Koko Oulu mukaan kasvuun, ei vain keskusta tai yksittäiset hankkeet." | pageText(lang) }}</span>
          </div>
          <div class="pol-hero-point">
            <span class="pol-hero-point-title">{{ "Avoimuus" | pageText(lang) }}</span>
            <span class="pol-hero-point-text">{{ "Päätösten perustelut, data ja valmistelu näkyviksi myös kuntalaiselle." | pageText(lang) }}</span>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="{{ "#nykyinen-rooli" | localeUrl(lang) }}" class="btn pol-hero-btn-primary">{{ "Nykyinen rooli" | pageText(lang) }}</a>
          <a href="{{ "#paalinjat" | localeUrl(lang) }}" class="btn pol-hero-btn-outline">{{ "Päälinjat" | pageText(lang) }}</a>
          <a href="{{ "#naytto" | localeUrl(lang) }}" class="btn pol-hero-btn-outline">{{ "Näyttö käytännössä" | pageText(lang) }}</a>
        </div>
      </div>
      <div class="col-lg-5">
        <aside class="pol-hero-card pol-hero-card--profile h-100">
          <img src="/img/uploads/2020/01/WhatsApp-Image-2019-12-02-at-18.58.31-1.jpeg" alt="{{ "Jari Laru politiikassa" | pageText(lang) }}" class="pol-hero-img">
          <div class="pol-hero-side">
            <p class="pol-hero-side-kicker">{{ "Poliittinen työ" | pageText(lang) }}</p>
            <p class="pol-hero-caption">{{ "Käytännöllistä kunnallispolitiikkaa sivistyksen, lähipalvelujen ja avoimuuden puolesta." | pageText(lang) }}</p>
            <dl class="pol-hero-facts mb-0">
              <div>
                <dt>{{ "Puolue" | pageText(lang) }}</dt>
                <dd>{{ "Kansallinen Kokoomus (2000-luvun alusta lähtien)" | pageText(lang) }}</dd>
              </div>
              <div>
                <dt>{{ "Tapa toimia" | pageText(lang) }}</dt>
                <dd>{{ "Tietoon nojaten, pitkäjänteisesti, yhteistyökykyisesti" | pageText(lang) }}</dd>
              </div>
              <div>
                <dt>{{ "Kysymys jonka esitän" | pageText(lang) }}</dt>
                <dd>{{ "Miten päätös näkyy tavallisen oululaisen arjessa?" | pageText(lang) }}</dd>
              </div>
              <div>
                <dt>{{ "Näyttö" | pageText(lang) }}</dt>
                <dd>{{ "Puheenvuorot, valtuustoaloitteet ja kirjoitukset samasta linjasta" | pageText(lang) }}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>
<div class="pol-hero-divider"></div>

<nav class="pol-mobile-path" aria-label="{{ "Politiikkasivun tärkeimmät osiot" | pageText(lang) }}">
  <a href="{{ "#nykyinen-rooli" | localeUrl(lang) }}">{{ "Rooli" | pageText(lang) }}</a>
  <a href="{{ "#paalinjat" | localeUrl(lang) }}">{{ "Päälinjat" | pageText(lang) }}</a>
