{% set politicsWritingItems = [] %}
{% for post in collections.blog %}
  {% if post.data.politicsWritingRole %}
    {% set _ = politicsWritingItems.push({
      "role": post.data.politicsWritingRole,
      "order": post.data.politicsWritingOrder or 999,
      "type": "Blogi",
      "date": (post.date | dateFormat),
      "title": post.data.title,
      "href": post.url,
      "summary": post.data.politicsWritingSummary or post.data.description or ""
    }) %}
  {% endif %}
{% endfor %}
{% for item in collections.pub_mielipide %}
  {% if item.data.politicsWritingRole %}
    {% set _ = politicsWritingItems.push({
      "role": item.data.politicsWritingRole,
      "order": item.data.politicsWritingOrder or 999,
      "type": "Mielipide",
      "date": (item.date | dateFormat),
      "title": item.data.title,
      "href": item.url,
      "summary": item.data.politicsWritingSummary or item.data.description or ""
    }) %}
  {% endif %}
{% endfor %}
{% for item in collections.pub_kolumni %}
  {% if item.data.politicsWritingRole %}
    {% set _ = politicsWritingItems.push({
      "role": item.data.politicsWritingRole,
      "order": item.data.politicsWritingOrder or 999,
      "type": "Kolumni",
      "date": (item.date | dateFormat),
      "title": item.data.title,
      "href": item.url,
      "summary": item.data.politicsWritingSummary or item.data.description or ""
    }) %}
  {% endif %}
{% endfor %}
{% set sortedPoliticsWritingItems = politicsWritingItems | sort(false, false, "order") %}
{% set featuredPoliticalWritings = [] %}
{% set featuredHybridWritings = [] %}
{% for item in sortedPoliticsWritingItems %}
  {% if item.role == "political" %}
    {% set _ = featuredPoliticalWritings.push(item) %}
  {% elif item.role == "hybrid" %}
    {% set _ = featuredHybridWritings.push(item) %}
  {% endif %}
{% endfor %}
{% set politicalVideoHighlights = [
  {
    "title": "Oululaisia lapsia ja nuoria koskevien tilastotietojen tarkastelua",
    "url": "https://www.youtube.com/watch?v=7EXB54VvlsU&t=2s",
    "thumbnail": "https://i.ytimg.com/vi/7EXB54VvlsU/hqdefault.jpg",
    "date": "2026-01-19",
    "label": "Asiantuntijavideo",
    "context": "Palveluverkkokeskustelu 2026",
    "summary": "Video näyttää, miten lasten ja nuorten tilastotietoa voi käyttää palveluverkkokeskustelussa koko kaupunkiin kohdistuvien vaikutusten arviointiin."
  }
] | localizeCopy(lang) %}
{% set sortedPoliticalSpeeches = politicalSpeeches | sort(true, false, "date") %}
{% set latestPoliticalSpeech = sortedPoliticalSpeeches[0] %}
{% set latestInitiative = sortedInitiatives[0] %}
{% set latestPoliticalWriting = featuredPoliticalWritings[0] %}
{% set latestHybridWriting = featuredHybridWritings[0] %}
{% set councilMeetingItems = councilMeetings or [] %}
{% set councilMeetingSpeeches = [] %}
{% set councilMeetingInitiatives = [] %}
{% set councilMeetingQuestions = [] %}
{% for meeting in councilMeetingItems %}
  {% for item in meeting.speeches %}
    {% set _ = councilMeetingSpeeches.push(item) %}
  {% endfor %}
  {% for item in meeting.initiatives %}
    {% set _ = councilMeetingInitiatives.push(item) %}
  {% endfor %}
  {% for item in meeting.questions %}
    {% set _ = councilMeetingQuestions.push(item) %}
  {% endfor %}
{% endfor %}

<section class="py-5 mb-0 bg-body-tertiary" id="nykyinen-rooli">
  <div class="site-shell">
    <div class="pol-section-head">
      <p class="pol-eyebrow pol-eyebrow--dark mb-1"><i class="bi bi-person-badge me-1"></i>{{ "Nykyinen rooli" | pageText(lang) }}</p>
      <h2 class="pol-section-title">{{ "Nykyiset luottamustehtävät" | pageText(lang) }}</h2>
      <p class="pol-section-lead mb-0">{{ "Tämä sivu kertoo poliittisen profiilin. Vaalikausien historia, vaalitulokset ja viralliset sidonnaisuustiedot löytyvät omista näkymistään." | pageText(lang) }}</p>
    </div>

    <div class="pol-role-overview-grid">
      <article class="pol-current-card pol-role-current-card">
        <div class="pol-current-head">
          <div>
            <p class="pol-current-kicker mb-1">{{ "Vaalikausi 2025–2029 · Kansallisen Kokoomuksen valtuustoryhmässä" | pageText(lang) }}</p>
            <h3 class="pol-current-title">{{ "Työ jatkuu sivistyksen, palvelujen ja avoimuuden teemoissa" | pageText(lang) }}</h3>
            <p class="text-muted small mb-0">{{ "Nykyiset luottamustehtävät asettavat politiikan käytännön toimintaympäristön." | pageText(lang) }}</p>
          </div>
        </div>
        <div class="pol-role-list">
          {% for role in currentTrustRoles %}
          <article class="pol-role-item">
            <p class="pol-role-area">{{ role.area | pageText(lang) }}</p>
            <h4 class="pol-role-title">{{ role.title | pageText(lang) }}</h4>
            <p class="pol-role-org">{{ role.org | pageText(lang) }}</p>
          </article>
          {% endfor %}
        </div>
      </article>

      <div class="pol-role-link-stack">
        <article class="pol-route-card">
          <span class="pol-route-kicker">{{ "Kaupunginvaltuusto" | pageText(lang) }}</span>
          <h3>{{ "Valtuustotyö kokouksittain" | pageText(lang) }}</h3>
          <p>{{ councilMeetingItems.length | pageText(lang) }} {{ "kokousta, joihin on kytketty" | pageText(lang) }} {{ councilMeetingSpeeches.length | pageText(lang) }} {{ "pidettyä puheenvuoroa," | pageText(lang) }} {{ councilMeetingInitiatives.length | pageText(lang) }} {{ "valtuustoaloitetta ja" | pageText(lang) }} {{ councilMeetingQuestions.length | pageText(lang) }} {{ "valtuuston kyselytunnin kysymystä." | pageText(lang) }}</p>
          <a href="{{ "/politiikka/kaupunginvaltuusto/" | localeUrl(lang) }}">{{ "Avaa kaupunginvaltuusto" | pageText(lang) }}</a>
        </article>
        <article class="pol-route-card">
          <span class="pol-route-kicker">{{ "Sivistyslautakunta" | pageText(lang) }}</span>
          <h3>{{ "Lautakuntatyö kokouksittain" | pageText(lang) }}</h3>
          <p>{{ "Sivistyslautakunnan ja sitä edeltäneen sivistys- ja kulttuurilautakunnan kokoukset näyttävät, missä vaiheessa koulutuksen, varhaiskasvatuksen, kulttuurin ja palveluverkon valmisteluun on vaikutettu." | pageText(lang) }}</p>
          <a href="{{ "/politiikka/sivistyslautakunta/" | localeUrl(lang) }}">{{ "Avaa sivistyslautakunta" | pageText(lang) }}</a>
        </article>
        <article class="pol-route-card">
          <span class="pol-route-kicker">{{ "Vaalikaudet" | pageText(lang) }}</span>
          <h3>{{ "Kokemus rakentuu vaalikausittain" | pageText(lang) }}</h3>
          <p>{{ "Vaalitulokset, luottamustehtävät ja sisällöt asettuvat kausittain samaan aikajanaan." | pageText(lang) }}</p>
          <a href="{{ "/politiikka/vaalikaudet/" | localeUrl(lang) }}">{{ "Avaa vaalikaudet" | pageText(lang) }}</a>
        </article>
        <article class="pol-route-card">
          <span class="pol-route-kicker">{{ "Avoimuus" | pageText(lang) }}</span>
          <h3>{{ "Sidonnaisuudet ja vaalirahoitus samalla sivulla" | pageText(lang) }}</h3>
          <p>{{ "Viralliset rekisterilinkit, ilmoitukset ja keskeiset sidonnaisuustiedot on koottu tarkistettavaksi yhdelle sivulle." | pageText(lang) }}</p>
          <a href="{{ "/poliittinen-avoimuus/" | localeUrl(lang) }}">{{ "Avaa avoimuustiedot" | pageText(lang) }}</a>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="py-5 mb-0" id="paalinjat">
  <div class="site-shell">
    <div class="pol-section-head">
      <p class="pol-eyebrow pol-eyebrow--dark mb-1"><i class="bi bi-signpost-split me-1"></i>{{ "Poliittiset päälinjat" | pageText(lang) }}</p>
      <h2 class="pol-section-title">{{ "Neljä kuratoitua kokonaisuutta, joissa työ jatkuu vuodesta toiseen" | pageText(lang) }}</h2>
      <p class="pol-section-lead mb-0">{{ "Päälinjat kokoavat puheenvuorot, valtuustoaloitteet, mielipidekirjoitukset ja blogitekstit yhtenäiseksi aikajanaksi. Jokainen sivu näyttää argumentaation etenemisen ja perustelut, ei pelkkää artikkelilistaa." | pageText(lang) }}</p>
    </div>

    <div class="pol-topic-grid">
      {% for theme in politicsThemePages %}
      <a class="pol-topic-card pol-topic-card--featured" href="{{ theme.permalink | localeUrl(lang) }}" style="--pol-topic-accent: {{ theme.accent }}">
        <span class="pol-topic-type">{{ theme.eyebrow | pageText(lang) }}</span>
        <h3>{{ theme.title | pageText(lang) }}</h3>
        <p>{{ theme.description | pageText(lang) }}</p>
        <span class="pol-topic-source">{{ "Aikajana, perustelut ja valikoidut lähteet" | pageText(lang) }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-5 mb-0 bg-body-tertiary" id="naytto">
  <div class="site-shell">
    <div class="pol-section-head">
      <p class="pol-eyebrow pol-eyebrow--dark mb-1"><i class="bi bi-lightning-charge me-1"></i>{{ "Näyttö" | pageText(lang) }}</p>
      <h2 class="pol-section-title">{{ "Miltä linja näyttää käytännössä" | pageText(lang) }}</h2>
      <p class="pol-section-lead mb-0">{{ "Tässä on tiivis näyte aineistosta. Video nostetaan tarkoituksella suuremmaksi, koska se kertoo nopeasti, millä tavalla dataa ja perusteluja käytän poliittisessa keskustelussa." | pageText(lang) }}</p>
    </div>

    <div class="pol-evidence-grid">
      {% set video = politicalVideoHighlights[0] %}
      {% if video %}
      <article class="pol-evidence-card pol-evidence-card--feature">
        <a href="{{ video.url | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer" class="pol-evidence-thumb-link video-preview" aria-label="Katso video: {{ video.title }}">
          <img src="{{ video.thumbnail }}" alt="{{ video.title | pageText(lang) }}" class="pol-evidence-thumb" loading="lazy" decoding="async">
        </a>
        <div class="pol-evidence-copy">
          <div class="pol-evidence-meta">
            <span>{{ video.label | pageText(lang) }}</span>
            <span>{{ video.date | dateFormat | pageText(lang) }}</span>
          </div>
          <p class="pol-evidence-kicker">{{ video.context | pageText(lang) }}</p>
          <h3 class="pol-evidence-title"><a href="{{ video.url | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer">{{ video.title | pageText(lang) }}</a></h3>
          <p class="pol-evidence-summary">{{ video.summary | pageText(lang) }}</p>
          <a href="{{ video.url | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm rounded-pill px-3">{{ "Katso video" | pageText(lang) }} <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i></a>
        </div>
      </article>
      {% endif %}

      <div class="pol-evidence-side">
        {% if latestPoliticalSpeech %}
        <article class="pol-evidence-card">
          {% set latestSpeechIsCouncil = latestPoliticalSpeech.data.speechContext == "valtuusto" or latestPoliticalSpeech.data.speechContext == "kyselytunti" %}
          <div class="pol-evidence-meta">
            <span>{{ latestPoliticalSpeech | topicTypeLabel | pageText(lang) }}</span>
            <span>{{ latestPoliticalSpeech.date | dateFormat | pageText(lang) }}</span>
          </div>
          <h3 class="pol-evidence-title pol-evidence-title--small"><a href="{{ latestPoliticalSpeech.url | localeUrl(lang) }}">{{ latestPoliticalSpeech.data.title | pageText(lang) }}</a></h3>
          <p class="pol-evidence-summary">{{ "Uusin politiikkaan liittyvä puheenvuoro valtuustosta tai yhteiskunnallisesta tilaisuudesta." | pageText(lang) }}</p>
          <a href="{{ "/valtuustotyo/#puheet" if latestSpeechIsCouncil else "/lausunnot/#julkiset-puheet" }}" class="pol-inline-link">{{ "Kaikki valtuustopuheenvuorot" if latestSpeechIsCouncil else "Kaikki julkiset puheet" | pageText(lang) }}</a>
        </article>
        {% endif %}
        {% if latestInitiative %}
        <article class="pol-evidence-card">
          <div class="pol-evidence-meta">
            <span>{{ "Valtuustoaloite" | pageText(lang) }}</span>
            <span>{{ latestInitiative.date | dateFormat | pageText(lang) }}</span>
          </div>
          <h3 class="pol-evidence-title pol-evidence-title--small"><a href="{{ latestInitiative.url | localeUrl(lang) }}">{{ latestInitiative.data.title | pageText(lang) }}</a></h3>
          <p class="pol-evidence-summary">{{ "Valtuustoaloitteissa näkyy, miten periaatteet muuttuvat kirjallisiksi avauksiksi ja seurattaviksi päätöksiksi." | pageText(lang) }}</p>
          <a href="{{ "/valtuustotyo/#aloitteet" | localeUrl(lang) }}" class="pol-inline-link">{{ "Kaikki valtuustoaloitteet" | pageText(lang) }}</a>
        </article>
        {% endif %}
        {% if latestPoliticalWriting %}
        <article class="pol-evidence-card">
          <div class="pol-evidence-meta">
            <span>{{ latestPoliticalWriting.type | pageText(lang) }}</span>
            <span>{{ latestPoliticalWriting.date | pageText(lang) }}</span>
          </div>
          <h3 class="pol-evidence-title pol-evidence-title--small"><a href="{{ latestPoliticalWriting.href | localeUrl(lang) }}">{{ latestPoliticalWriting.title | pageText(lang) }}</a></h3>
          <p class="pol-evidence-summary">{{ latestPoliticalWriting.summary | pageText(lang) }}</p>
          <a href="{{ "/kirjoitukset/?opinions=political#mielipiteet" | localeUrl(lang) }}" class="pol-inline-link">{{ "Poliittiset mielipiteet" | pageText(lang) }}</a>
        </article>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<section class="py-5 mb-0" id="kirjoitukset">
  <div class="site-shell">
    <div class="pol-section-head">
      <p class="pol-eyebrow pol-eyebrow--dark mb-1"><i class="bi bi-journal-text me-1"></i>{{ "Kirjoitukset" | pageText(lang) }}</p>
      <h2 class="pol-section-title">{{ "Kirjoitukset avaavat päätösten taustoja" | pageText(lang) }}</h2>
      <p class="pol-section-lead mb-0">{{ "Mielipidekirjoituksissa ja blogiteksteissä Jari Laru käsittelee sivistystä, palveluverkkoa, kaupunkikehitystä ja avoimuutta laajemmin kuin yksittäisessä kokouspuheenvuorossa on yleensä mahdollista." | pageText(lang) }}</p>
    </div>

    <div class="pol-writing-focus-grid">
      <article class="pol-current-card pol-writing-focus-card pol-writing-focus-card--primary">
        <div class="pol-current-head">
          <div>
            <p class="pol-current-kicker mb-1">{{ "Kannanotot" | pageText(lang) }}</p>
