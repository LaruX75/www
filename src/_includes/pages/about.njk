<section class="about-section" id="roolit">
  <div class="site-shell">
    <div class="about-section-head">
      <p class="about-kicker">{{ "Roolit" | pageText(lang) }}</p>
      <h2>{{ "Neljä näkökulmaa samaan työhön" | pageText(lang) }}</h2>
      <p>{{ "Sama osaaminen näkyy koulutuksissa, yliopistotyössä, tutkimuksessa ja politiikassa eri tavoilla." | pageText(lang) }}</p>
    </div>

    <div class="about-role-grid">
      <article class="about-role-card about-role-card--primary">
        <p class="about-role-index">01</p>
        <h3>{{ "Kouluttaja ja puhuja" | pageText(lang) }}</h3>
        <p>{{ "Jari Laru kouluttaa tekoälystä, digipedagogiikasta ja teknologiatuetusta oppimisesta käytännönläheisesti. Tavoitteena on auttaa opettajia, kouluja ja organisaatioita tekemään parempia valintoja uuden teknologian keskellä." | pageText(lang) }}</p>
        <a href="{{ "/kouluttaja/" | localeUrl(lang) }}">{{ "Tutustu koulutuksiin" | pageText(lang) }}</a>
      </article>

      <article class="about-role-card">
        <p class="about-role-index">02</p>
        <h3>{{ "Yliopistonlehtori" | pageText(lang) }}</h3>
        <p>{{ "Yliopistotyössä Jari Laru opettaa tulevia opettajia, ohjaa opinnäytteitä ja kehittää opetusta tutkimuksen rinnalla. Työssä yhdistyvät pedagogiikka, teknologia ja opettajankoulutuksen arki." | pageText(lang) }}</p>
        <a href="{{ "/tyoni-yliopistonlehtorina/" | localeUrl(lang) }}">{{ "Lue yliopistotyöstä" | pageText(lang) }}</a>
      </article>

      <article class="about-role-card">
        <p class="about-role-index">03</p>
        <h3>{{ "Politiikka" | pageText(lang) }}</h3>
        <p>{{ "Politiikassa Jari Larulle tärkeitä ovat sivistys, palvelut, alueellinen yhdenvertaisuus ja valmistelun läpinäkyvyys. Päätöksiä pitää pystyä arvioimaan koko Oulun mittakaavassa." | pageText(lang) }}</p>
        <a href="{{ "/politiikka/" | localeUrl(lang) }}">{{ "Avaa politiikkasivu" | pageText(lang) }}</a>
      </article>

      <article class="about-role-card">
        <p class="about-role-index">04</p>
        <h3>{{ "Tutkija ja asiantuntija" | pageText(lang) }}</h3>
        <p>{{ "Tutkimus liittyy teknologiatuettuun oppimiseen, yhteisölliseen työskentelyyn ja tekoälylukutaitoon. Julkaisut, lausunnot, asiantuntijaroolit ja esitykset näyttävät, miten samat teemat jatkuvat eri yhteyksissä." | pageText(lang) }}</p>
        <a href="{{ "/tutkimus/" | localeUrl(lang) }}">{{ "Tutustu tutkimukseen" | pageText(lang) }}</a>
      </article>
    </div>
  </div>
</section>

<section class="about-section about-section--muted" id="profiili">
  <div class="site-shell">
    <div class="about-profile-layout">
      <div>
        <p class="about-kicker">{{ "Mikä yhdistää?" | pageText(lang) }}</p>
        <h2>{{ "Teknologia ei ole itseisarvo, vaan väline parempaan ajatteluun" | pageText(lang) }}</h2>
        <p>{{ "Jari Laru on tehnyt pitkään työtä tilanteissa, joissa teknologia lupaa paljon mutta onnistuminen riippuu ihmisistä, pedagogiikasta, toimintakulttuurista ja päätöksenteosta. Siksi hän katsoo tekoälyä ja digitaalisuutta ensisijaisesti sivistyksen, oppimisen ja organisaatioiden arjen näkökulmasta." | pageText(lang) }}</p>
        <p>{{ "Tämä näkyy myös julkisessa työssä: välineistä voi puhua suoraan, mutta lopulta tärkeämpää on se, millaisia ratkaisuja niillä tuetaan ja kenelle niistä on hyötyä." | pageText(lang) }}</p>
      </div>

      <div class="about-proof-grid" aria-label="{{ "Profiilin todisteita" | pageText(lang) }}">
        <a href="{{ "/esitykset/" | localeUrl(lang) }}" class="about-proof-card">
          <strong>{{ "Esitykset ja materiaalit" | pageText(lang) }}</strong>
          <span>{{ "Koulutukset, puheenvuorot ja avoimet oppimateriaalit." | pageText(lang) }}</span>
        </a>
        <a href="{{ "/lausunnot/#lausunnot" | localeUrl(lang) }}" class="about-proof-card">
          <strong>{{ "Lausunnot" | pageText(lang) }}</strong>
          <span>{{ "Asiantuntijatyötä valmistelun ja päätöksenteon tueksi." | pageText(lang) }}</span>
        </a>
        <a href="{{ "/julkaisut/" | localeUrl(lang) }}" class="about-proof-card">
          <strong>{{ "Julkaisut" | pageText(lang) }}</strong>
          <span>{{ "Tieteellinen työ ja tutkimusprofiilin laajempi näyttö." | pageText(lang) }}</span>
        </a>
        <a href="{{ "/mediassa/" | localeUrl(lang) }}" class="about-proof-card">
          <strong>{{ "Mediassa" | pageText(lang) }}</strong>
          <span>{{ "Haastattelut, podcastit ja julkiset asiantuntijakommentit." | pageText(lang) }}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="about-section" id="oulu">
  <div class="site-shell">
    <div class="about-place-grid">
      <div class="about-place-copy">
        <p class="about-kicker">{{ "Oulu ja arki" | pageText(lang) }}</p>
        <h2>{{ "Raahe, Oulu ja Jääli muodostavat paikallisen mittakaavan" | pageText(lang) }}</h2>
        <p>{{ "Jari Laru on viettänyt lapsuutensa ja nuoruutensa Raahessa ja oululaistunut opintojen myötä. Nykyään perhe asuu Jäälissä, mutta Oulu ei tarkoita vain yhtä kaupunginosaa tai aluetta. Se tarkoittaa 23 suuralueen ja 105 kaupunginosan kaupunkia, jossa päätösten vaikutukset näkyvät ihmisten arjessa eri tavoin." | pageText(lang) }}</p>
        <p>{{ "Siksi paikallisuus ei ole nurkkakuntaisuutta, vaan tapa kysyä, miten palvelut, liikkuminen, koulutus, kulttuuri ja osallisuus toimivat koko kaupungissa." | pageText(lang) }}</p>
      </div>

      <div class="about-place-images">
        <figure>
          <img src="/img/uploads/2021/03/suomi100-200x300.jpg" alt="{{ "Jari Laru Suomi 100 -juhlassa Oulussa 2017" | pageText(lang) }}" loading="lazy">
          <figcaption>{{ "Suomi 100 -juhla Oulussa, 2017" | pageText(lang) }}</figcaption>
        </figure>
        <figure>
          <img src="/img/uploads/2021/03/asyhds-300x225.jpg" alt="{{ "Jari Laru asukasyhdistyksen puheenjohtajana Jäälissä" | pageText(lang) }}" loading="lazy">
          <figcaption>{{ "Asukasyhdistystyötä Jäälissä" | pageText(lang) }}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

