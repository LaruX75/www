
<section class="about-hero-section">
  <div class="site-shell">
    <div class="about-hero-grid">
      <div class="about-hero-copy">
        <p class="about-kicker">{{ "Jari Laru" | pageText(lang) }}</p>
        <h1>{{ "Jari Laru" | pageText(lang) }}</h1>
        <p class="about-hero-lead">{{ "Raahessa kasvanut, opintojen myötä oululaistunut kouluttaja, yliopistonlehtori, tutkija ja poliittinen vaikuttaja." | pageText(lang) }}</p>
        <p>{{ "Jari Larun työ liikkuu opetuksen, teknologian, tutkimuksen ja päätöksenteon rajapinnoilla. Hän kouluttaa opettajia ja organisaatioita, opettaa tulevia opettajia yliopistossa, tutkii teknologiatuettua oppimista ja osallistuu Oulun päätöksentekoon." | pageText(lang) }}</p>
        <p>{{ "Yhteinen kysymys on pysynyt samana: miten teknologiaa, tekoälyä ja tietoa käytetään niin, että ne vahvistavat oppimista, sivistystä, osallisuutta ja läpinäkyvää päätöksentekoa." | pageText(lang) }}</p>
        <div class="about-hero-actions">
          <a href="{{ "/kouluttaja/" | localeUrl(lang) }}" class="btn btn-primary rounded-pill px-4">{{ "Kouluttaja ja puhuja" | pageText(lang) }}</a>
          <a href="{{ "/tyoni-yliopistonlehtorina/" | localeUrl(lang) }}" class="btn btn-outline-secondary rounded-pill px-4">{{ "Yliopistotyö" | pageText(lang) }}</a>
          <a href="{{ "/politiikka/" | localeUrl(lang) }}" class="btn btn-outline-secondary rounded-pill px-4">{{ "Politiikka" | pageText(lang) }}</a>
          <a href="{{ "/yhteystiedot/" | localeUrl(lang) }}" class="btn btn-outline-secondary rounded-pill px-4">{{ "Ota yhteyttä" | pageText(lang) }}</a>
        </div>
      </div>

      <aside class="about-hero-card" aria-label="{{ "Jari Laru lyhyesti" | pageText(lang) }}">
        <img src="/img/uploads/2026/07/jari-laru-tietoa-hero.jpg" alt="{{ "Jari Laru Biennalen edessä" | pageText(lang) }}" loading="eager" decoding="async">
        <div class="about-hero-card-body">
          <p class="about-kicker">{{ "Punainen lanka" | pageText(lang) }}</p>
          <ul class="about-signal-list">
            <li>{{ "Oppiminen, opetus ja tekoäly" | pageText(lang) }}</li>
            <li>{{ "Tutkimukseen perustuva käytännön asiantuntijuus" | pageText(lang) }}</li>
            <li>{{ "Avoimuus, osallisuus ja läpinäkyvä valmistelu" | pageText(lang) }}</li>
            <li>{{ "Oulu, arki ja päätöksenteon vaikutukset ihmisiin" | pageText(lang) }}</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
