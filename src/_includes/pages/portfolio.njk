          <p class="mb-0">{{ "Opetusajatteluani ohjaavat kolme periaatetta: teknologia kognitiivisena työkaluna, oppiminen yhteisöllisenä ongelmanratkaisuna ja selkeä ohjaus laatutekijänä." | pageText(lang) }}</p>
        </div>
        <p class="portfolio-stat-note mb-0 mt-3">
          {{ "Opinnäytteet:" | pageText(lang) }} <a href="{{ "https://oulurepo.oulu.fi/" | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer">{{ "OuluREPO" | pageText(lang) }}</a>{{ ".\n          Materiaalit: esitysarkisto, Canva ja" | pageText(lang) }} <a href="{{ "https://aoe.fi/" | localeUrl(lang) }}" target="_blank" rel="noopener noreferrer">{{ "AOE" | pageText(lang) }}</a>.
        </p>
