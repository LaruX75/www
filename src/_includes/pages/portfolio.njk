        {{ ui.kpiCard("merkittävää tunnustusta", "3", { extraClass: "research-kpi-card" }) | pageText(lang) }}
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="portfolio-tiivistelma">
          <p class="lead mb-3">{{ "Olen kasvatustieteiden tohtori (KT, 2012) ja Oulun yliopiston kasvatustieteiden tiedekunnan yliopistonlehtori teknologiatuetun oppimisen ja opettamisen alalla. Opetuskokemusta on kertynyt yli kaksi vuosikymmentä opettajankoulutuksessa sekä perustutkinto- että maisteriohjelmissa, suomeksi ja englanniksi." | pageText(lang) }}</p>
