
{% import "ui.njk" as ui %}
{% set totalSupervised = (theses.stats.totalGradut or 0) + (theses.stats.totalKandit or 0) %}
{% set latestPortfolioPresentations = (collections.presentations or []).slice(0, 4) %}
{% set portfolioMaterialKeys = [] %}
{% for item in ((canva and canva.tableRows) or []) %}
  {% set key = ((item.sourceUrl or item.url or item.pageUrl or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (portfolioMaterialKeys.indexOf(key) == -1) %}
    {% set _ = (portfolioMaterialKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in (collections.presentations or []) %}
  {% set key = ((((item.data and (item.data.sourceUrl or item.data.url or item.url)) or "") ~ "|" ~ ((item.data and item.data.title) or ""))) | trim %}
  {% if key != "|" and (portfolioMaterialKeys.indexOf(key) == -1) %}
    {% set _ = (portfolioMaterialKeys.push(key), null) %}
  {% endif %}
{% endfor %}
{% for item in ((finnaAoe and finnaAoe.rows) or []) %}
  {% set key = ((item.url or "") ~ "|" ~ (item.title or "")) | trim %}
  {% if key != "|" and (portfolioMaterialKeys.indexOf(key) == -1) %}
    {% set _ = (portfolioMaterialKeys.push(key), null) %}
  {% endif %}
{% endfor %}

{% set portfolioCopy = {
  heroTitle: "Opetan tulevia opettajia niin, että teknologia muuttuu ymmärrettäväksi osaksi opetuksen arkea.",
  heroLead: "Syventävä opetusportfolio, joka on suunnattu erityisesti opetusansioiden arvioijille (esim. tenuurihaku, dosentuurihakemus, palkitseminen). Kokonaisuus sisältää opetusajattelun, käytännön kokemuksen, arviot ja palautteet sekä osaamisen ylläpidon jäsenneltynä ja evidenssiin perustuen. Halutko yleiskuvan yliopistotyöstä? <a href=\"/tyoni-yliopistonlehtorina/\" class=\"portfolio-hero-lead-link\">Siirry Työni-sivulle</a>.",
  proofLead: "Portfolio näyttää sekä opetuksen periaatteet että konkreettiset näytöt: kurssit, ohjaukset, kehittämistyön, materiaalit ja tunnustukset.",
  philosophyLead: "Opetusajattelussani toistuu sama peruslinja riippumatta siitä, onko kyse luokanopettajaopiskelijoista, maisterivaiheen opinnoista, opinnäytteen ohjauksesta tai täydennyskoulutuksesta.",
  practiceLead: "Opetusosaaminen ei näy vain luentosalissa. Se näkyy myös ohjauksessa, oppimisympäristöissä, materiaaleissa ja tavoissa, joilla opetusta rakennetaan yhdessä muiden kanssa.",
  currentLead: "Viime vuosina opetustyöni on painottunut erityisesti tekoälylukutaitoon, digipedagogiikkaan ja siihen, miten vaikeat muutokset muutetaan opettajille käyttökelpoisiksi käytännöiksi.",
  evidenceLead: "Jos haluat tarkemman kuvan, alta löytyvät tutkintotausta, ohjauskokemus, opetusesimerkit ja kehittämisroolit.",
  archiveLead: "Näiltä sivuilta löydät portfolion tausta-aineiston: opinnäytteet, julkaisut, palkinnot, opiskelijapalautteen ja yliopistotyön laajemman kokonaisuuden."
} | localizeCopy(lang) %}

