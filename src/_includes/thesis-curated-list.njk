{% set thesisItems = thesisItems or [] %}
{% set thesisLang = thesisLang or (lang or "fi") %}
{% set thesisIsEn = thesisLang == "en" %}

{% if thesisItems.length %}
<div class="row g-3">
  {% for thesis in thesisItems %}
  <div class="col-12">
    <article class="card border-0 shadow-sm h-100 thesis-curated-card">
      <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-2">
          {% if thesis.thesisTypeLabel %}
          <span class="badge text-bg-primary">{{ thesis.thesisTypeLabel }}</span>
          {% endif %}
          {% if thesis.year %}
          <span class="badge text-bg-light border text-dark">{{ thesis.year }}</span>
          {% endif %}
          {% if thesis.lang == "en" %}
          <span class="badge text-bg-light border text-secondary">English</span>
          {% endif %}
        </div>
        <h3 class="h5 mb-2">
          <a href="{{ thesis.pageUrl }}" class="stretched-link text-decoration-none">{{ thesis.title }}</a>
        </h3>
        {% if thesis.authorLine %}
        <p class="small text-muted mb-2">{{ thesis.authorLine }}</p>
        {% endif %}
        {% if thesis.abstractSnippet %}
        <p class="small mb-3">{{ thesis.abstractSnippet }}</p>
        {% endif %}
        <div class="d-flex flex-wrap gap-2 align-items-center thesis-curated-actions">
          {% if thesis.categories and thesis.categories.length %}
            {% for category in thesis.categories | take(3) %}
          <span class="badge text-bg-light border text-dark">{{ category }}</span>
            {% endfor %}
          {% endif %}
          {% if thesis.abstract %}
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            data-thesis-abstract-trigger
            data-thesis-title="{{ thesis.title | escape }}"
            data-thesis-abstract="{{ thesis.abstract | escape }}"
            data-thesis-url="{{ thesis.sourceUrl | escape }}"
            data-thesis-authors="{{ thesis.authorLine | escape }}"
            data-thesis-year="{{ thesis.year }}"
            data-thesis-type="{{ thesis.thesisType | escape }}"
          >
            {{ "Summary" if thesisIsEn else "Tiivistelmä" }}
          </button>
          {% endif %}
          <button
            type="button"
            class="btn btn-outline-primary btn-sm"
            data-thesis-citation-trigger
            data-thesis-title="{{ thesis.title | escape }}"
            data-thesis-authors="{{ thesis.authorLine | escape }}"
            data-thesis-year="{{ thesis.year }}"
            data-thesis-type="{{ thesis.thesisType | escape }}"
            data-thesis-url="{{ thesis.sourceUrl | escape }}"
          >
            {{ "Export citation" if thesisIsEn else "Vie viite" }}
          </button>
          <a
            href="{{ thesis.sourceUrl }}"
            class="btn btn-outline-secondary btn-sm ms-auto"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ "Open in OuluREPO" if thesisIsEn else "Avaa OuluREPOssa" }}
          </a>
        </div>
      </div>
    </article>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="text-muted mb-0">{{ thesisEmptyLabel or ("No theses available." if thesisIsEn else "Opinnäytteitä ei löytynyt.") }}</p>
{% endif %}
