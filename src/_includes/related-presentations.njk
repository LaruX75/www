{#
  Parametrit (aseta ennen includeä):
    relatedSivuyhteys  — pakollinen, esim. "tyoni-yliopistonlehtorina"
    relatedTitle       — valinnainen, otsikko (oletus: "Aiheeseen liittyviä esityksiä")
    relatedLimit       — valinnainen, max esitysten määrä (oletus: 3)
    relatedLinkHref    — valinnainen, "katso kaikki" -linkki (oletus: "/esitykset/")
    relatedLinkLabel   — valinnainen, linkin teksti (oletus: "Kaikki esitykset →")
#}
{% set _sivuyhteys = relatedSivuyhteys %}
{% set _limit = relatedLimit if relatedLimit else 3 %}
{% set _heading = relatedTitle if relatedTitle else "Aiheeseen liittyviä esityksiä" %}
{% set _linkHref = relatedLinkHref if relatedLinkHref else "/esitykset/" %}
{% set _linkLabel = relatedLinkLabel if relatedLinkLabel else "Kaikki esitykset →" %}

{% set _kategoriaLabels = {
  "konferenssi-keynote": "Keynote",
  "kansainvälinen-konferenssi": "Kansainvälinen",
  "täydennyskoulutus": "Täydennyskoulutus",
  "webinaari": "Webinaari",
  "hanke-esittely": "Hanke",
  "tdk-luento": "Yliopistoopetus",
  "muu": ""
} %}

{# Kerätään ja järjestetään esitykset: paakortti ensin, sitten päivämäärä laskevasti #}
{% set _featured = [] %}
{% set _others = [] %}
{% for item in canva.tableRows | sort(true, false, "date") %}
  {% if item.sivuyhteys and _sivuyhteys in item.sivuyhteys %}
    {% if item.paakortti %}
      {% set _ = (_featured.push(item), null) %}
    {% else %}
      {% set _ = (_others.push(item), null) %}
    {% endif %}
  {% endif %}
{% endfor %}

{% set _showFeatured = _featured | take(_limit) %}
{% set _fillCount = _limit - (_showFeatured | length) %}
{% set _showOthers = _others | take(_fillCount) %}
{% set _totalShown = (_showFeatured | length) + (_showOthers | length) %}
{% set _totalAvail = (_featured | length) + (_others | length) %}

{% if _totalShown > 0 %}
<aside class="related-presentations mt-5 pt-4 border-top" aria-labelledby="related-pres-{{ _sivuyhteys }}-heading">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <p class="text-uppercase text-muted fw-semibold small mb-0" id="related-pres-{{ _sivuyhteys }}-heading">
      {{ _heading }}
    </p>
    {% if _totalAvail > _totalShown %}
    <a href="{{ _linkHref }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3">{{ _linkLabel }}</a>
    {% endif %}
  </div>

  <ul class="list-unstyled related-presentations-list mb-0">
    {% for item in _showFeatured %}
    <li class="related-presentations-item{% if item.paakortti %} related-presentations-item--featured{% endif %}">
      {% if item.thumbnail %}
      <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="related-presentations-thumb" aria-hidden="true" tabindex="-1">
        <img src="{{ item.thumbnail }}" alt="" loading="lazy" decoding="async">
      </a>
      {% else %}
      <span class="related-presentations-thumb related-presentations-thumb--empty">
        <i class="bi bi-easel2" aria-hidden="true"></i>
      </span>
      {% endif %}
      <div class="related-presentations-body">
        <div class="related-presentations-meta">
          {% set _kl = _kategoriaLabels[item.kategoria] %}
          {% if _kl %}<span class="badge text-bg-secondary" style="font-size:.65rem;">{{ _kl }}</span>{% endif %}
          {% if item.date %}<span class="text-muted small">{{ item.date | dateFormat }}</span>{% endif %}
        </div>
        <p class="related-presentations-title fw-semibold mb-1">
          <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
        </p>
        {% if item.jarjestaja %}
        <p class="related-presentations-org text-muted small mb-1">{{ item.jarjestaja }}</p>
        {% endif %}
        {% if item.description %}
        <p class="related-presentations-desc text-muted small mb-0">{{ item.description | truncate(120) }}</p>
        {% endif %}
      </div>
    </li>
    {% endfor %}

    {% for item in _showOthers %}
    <li class="related-presentations-item">
      {% if item.thumbnail %}
      <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="related-presentations-thumb" aria-hidden="true" tabindex="-1">
        <img src="{{ item.thumbnail }}" alt="" loading="lazy" decoding="async">
      </a>
      {% else %}
      <span class="related-presentations-thumb related-presentations-thumb--empty">
        <i class="bi bi-easel2" aria-hidden="true"></i>
      </span>
      {% endif %}
      <div class="related-presentations-body">
        <div class="related-presentations-meta">
          {% set _kl = _kategoriaLabels[item.kategoria] %}
          {% if _kl %}<span class="badge text-bg-secondary" style="font-size:.65rem;">{{ _kl }}</span>{% endif %}
          {% if item.date %}<span class="text-muted small">{{ item.date | dateFormat }}</span>{% endif %}
        </div>
        <p class="related-presentations-title fw-semibold mb-1">
          <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
        </p>
        {% if item.jarjestaja %}
        <p class="related-presentations-org text-muted small mb-1">{{ item.jarjestaja }}</p>
        {% endif %}
        {% if item.description %}
        <p class="related-presentations-desc text-muted small mb-0">{{ item.description | truncate(120) }}</p>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</aside>

<style>
.related-presentations-list {
  display: flex;
  flex-direction: column;
  gap: .75rem;
}
.related-presentations-item {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  padding: .875rem 1rem;
  border: 1px solid var(--bs-border-color);
  border-radius: .875rem;
  background: var(--bs-body-bg);
}
.related-presentations-item--featured {
  border-color: rgba(13,110,253,.22);
  background: color-mix(in srgb, var(--bs-primary) 4%, var(--bs-body-bg));
}
.related-presentations-thumb {
  flex-shrink: 0;
  width: 80px;
  height: 56px;
  border-radius: .5rem;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bs-tertiary-bg);
  color: var(--bs-secondary-color);
  font-size: 1.25rem;
}
.related-presentations-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.related-presentations-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .35rem;
  margin-bottom: .25rem;
}
.related-presentations-title a {
  color: inherit;
  text-decoration: none;
}
.related-presentations-title a:hover {
  text-decoration: underline;
}
.related-presentations-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
{% endif %}
