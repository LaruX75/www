---
layout: base.njk
title: Kirjoitukset, puheet ja kannanotot
description: "Jari Larun puheenvuorot, valtuustoaloitteet, lausunnot, mielipidekirjoitukset, kolumnit ja blogikirjoitukset päätöksenteon, julkisen keskustelun ja asiantuntijatyön näkökulmista."
permalink: /kynasta/
translationKey: writings_index
pageStyles:
  - /css/kynasta-page.css
schemaType: CollectionPage
schemaAbout:
  - "@type": "Thing"
    name: "Valtuustopuheenvuorot"
    description: "Puheenvuorot Oulun kaupunginvaltuuston ja hyvinvointialueen kokouksissa."
  - "@type": "Thing"
    name: "Valtuustoaloitteet"
    description: "Kirjalliset aloitteet päätöksenteon valmisteluun."
  - "@type": "Thing"
    name: "Asiantuntijalausunnot"
    description: "Lausunnot opetuksesta, koulutuksesta ja teknologiasta."
  - "@type": "Thing"
    name: "Mielipidekirjoitukset ja kolumnit"
    description: "Lehdissä julkaistut kannanotot ja poliittiset kirjoitukset."
  - "@type": "Thing"
    name: "Blogikirjoitukset"
    description: "Blogissa julkaistut kirjoitukset opetuksesta, teknologiasta ja yhteiskunnasta."
schemaMentions:
  - "@type": "GovernmentOrganization"
    name: "Oulun kaupunginvaltuusto"
    url: "https://www.ouka.fi/valtuusto"
  - "@type": "GovernmentOrganization"
    name: "Pohjois-Pohjanmaan hyvinvointialue"
    url: "https://pohde.fi/"
---
{% import "ui.njk" as ui %}
{% set statementItems = [] %}
{% for item in (collections.publications or []) %}
  {% if item.data.type == "lausunto" %}
    {% set _ = (statementItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set councilSpeechItems = [] %}
{% set publicSpeechItems = [] %}
{% for item in (collections.pub_puhe or []) %}
  {% set speechContext = item.data.speechContext or "" %}
  {% set forums = item.data.forum or [] %}
  {% if speechContext %}
    {% set isCouncilSpeech = speechContext == "valtuusto" or speechContext == "kyselytunti" %}
  {% else %}
    {% set isCouncilSpeech = item.data.event == "Oulun kaupunginvaltuusto" or forums.indexOf("Kaupunginvaltuusto") != -1 %}
  {% endif %}
  {% if isCouncilSpeech %}
    {% set _ = (councilSpeechItems.push(item), null) %}
  {% else %}
    {% set _ = (publicSpeechItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set latestSpeechHighlights = (councilSpeechItems or []).slice(0, 3) %}
{% set latestPublicSpeechHighlights = (publicSpeechItems or []).slice(0, 3) %}
{% set latestInitiativeHighlights = (collections.politics or []).slice(0, 3) %}
{% set latestBlogHighlights = (collections.blog or []).slice(0, 3) %}
{% set latestStatementHighlights = statementItems.slice(0, 3) %}
{% set latestOpinionHighlights = (collections.pub_mielipide or []).slice(0, 3) %}
{% set latestColumnHighlights = (collections.pub_kolumni or []).slice(0, 3) %}
{% set latestExpertOpinionHighlights = ((collections.pub_mielipide_expert or []) or []).slice(0, 3) %}
{% set speechCount = (collections.pub_puhe or []) | length %}
{% set councilSpeechCount = councilSpeechItems | length %}
{% set publicSpeechCount = publicSpeechItems | length %}
{% set initiativeCount = (collections.politics or []) | length %}
{% set statementCount = statementItems | length %}
{% set blogCount = (collections.blog or []) | length %}
{% set opinionCount = (collections.pub_mielipide or []) | length %}
{% set columnCount = (collections.pub_kolumni or []) | length %}
{% set politicalOpinionCount = (collections.pub_mielipide_political or []) | length %}
{% set expertOpinionCount = (collections.pub_mielipide_expert or []) | length %}
{% set hybridOpinionItems = [] %}
{% for item in (collections.pub_mielipide or []) %}
  {% set roles = item.data.opinionRoles or item.data.writingRoles or [] %}
  {% if roles.indexOf("political") != -1 and roles.indexOf("expert") != -1 %}
    {% set _ = (hybridOpinionItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set hybridOpinionCount = hybridOpinionItems | length %}
{% set decisionRouteCount = councilSpeechCount + initiativeCount + statementCount %}
{% set commentaryRouteCount = opinionCount + columnCount + blogCount %}
{% set expertRouteCount = statementCount + expertOpinionCount + publicSpeechCount %}

<section class="kynasta-hero py-3 py-lg-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <p class="text-uppercase small text-muted mb-2">Kynästä</p>
        <h1 class="display-6 fw-bold mb-2">Kirjoitukset, puheet ja kannanotot</h1>
        <p class="text-muted mb-3">Täältä löydät Jari Larun puheet, valtuustoaloitteet, lausunnot, mielipidekirjoitukset, kolumnit ja blogikirjoitukset. Voit aloittaa päätöksenteosta, julkisesta keskustelusta, asiantuntijataustaisista teksteistä tai arkistosta.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="nav-link" href="#reitti-paatoksenteko">
            Päätöksenteko <span class="nav-count">{{ decisionRouteCount }}</span>
          </a>
          <a class="nav-link" href="#reitti-kannanotot">
            Julkinen keskustelu <span class="nav-count">{{ commentaryRouteCount }}</span>
          </a>
          <a class="nav-link" href="#reitti-asiantuntijuus">
            Asiantuntijatausta <span class="nav-count">{{ expertRouteCount }}</span>
          </a>
          <a class="nav-link" href="#arkisto">
            Arkisto <span class="nav-count">{{ speechCount + initiativeCount + statementCount + opinionCount + columnCount + blogCount }}</span>
          </a>
        </div>
      </div>
      <div class="col-lg-5">
        <aside class="kynasta-hero-aside">
          <p class="kynasta-hero-aside-kicker mb-2">Näin löydät etsimäsi</p>
          <ul class="kynasta-hero-aside-list mb-0">
            <li>Valitse ensin, etsitkö päätöksentekoa, julkista keskustelua vai asiantuntijataustaisia tekstejä.</li>
            <li>Jos tiedät jo muodon, siirry suoraan puheisiin, aloitteisiin, lausuntoihin tai kirjoituksiin.</li>
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

<nav class="kynasta-mobile-path" aria-label="Kynästä-sivun tärkeimmät sisällöt">
  <div class="site-shell">
    <a href="#reitti-paatoksenteko">Päätökset</a>
    <a href="#reitti-kannanotot">Keskustelu</a>
    <a href="#reitti-asiantuntijuus">Asiantuntijatausta</a>
    <a href="#kynasta-topic-profiles-title">Aiheet</a>
    <a href="#arkisto">Arkisto</a>
  </div>
</nav>

<section id="aloita-tasta" class="py-5">
  <div class="site-shell">
    <div class="row g-4 align-items-end mb-2">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-2">Aloita tästä</p>
        <h2 class="h3 mb-2">Valitse, millaista tekstiä etsit</h2>
        <p class="text-muted mb-0">Jos etsit vaikuttamista, aloita päätöksenteosta. Jos haluat seurata julkista keskustelua, siirry lehtikirjoituksiin, kolumneihin ja blogiin. Jos taustalla kiinnostaa opetus, tutkimus tai teknologia, katso tekstit, joissa asiantuntijuus on mukana.</p>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-4" id="reitti-paatoksenteko">
        <article class="card border-0 shadow-sm h-100 kynasta-route-card">
          <div class="card-body p-4 d-flex flex-column">
            <p class="kynasta-entry-kicker">Päätöksenteko</p>
            <h3 class="h5 mb-2">Puheet, aloitteet ja lausunnot valmistelussa</h3>
            <p class="small text-muted mb-3">Täältä löydät sisällöt, joissa Jari Laru osallistuu valmisteluun, valtuustotyöhön tai julkiseen päätöksentekoon.</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <span class="badge text-bg-light border">Lausunnot {{ statementCount }}</span>
              <span class="badge text-bg-light border">Valtuustopuheet {{ councilSpeechCount }}</span>
              <span class="badge text-bg-light border">Aloitteet {{ initiativeCount }}</span>
            </div>
            <div class="d-grid gap-3 mb-4">
              {% if latestStatementHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Lausuntonosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestStatementHighlights[0].data.url or latestStatementHighlights[0].url }}">{{ latestStatementHighlights[0].data.title }}</a>
              </div>
              {% endif %}
              {% if latestSpeechHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Puheenvuoronosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestSpeechHighlights[0].data.url or latestSpeechHighlights[0].url }}">{{ latestSpeechHighlights[0].data.title }}</a>
              </div>
              {% endif %}
              {% if latestInitiativeHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Aloitenosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestInitiativeHighlights[0].data.url or latestInitiativeHighlights[0].url }}">{{ latestInitiativeHighlights[0].data.title }}</a>
              </div>
              {% endif %}
            </div>
            <div class="mt-auto d-flex flex-wrap gap-2">
              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="#lausunnot">Lausunnot</a>
              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="#puheet">Valtuustopuheet</a>
              <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" href="#aloitteet">Aloitteet</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-4" id="reitti-kannanotot">
        <article class="card border-0 shadow-sm h-100 kynasta-route-card">
          <div class="card-body p-4 d-flex flex-column">
            <p class="kynasta-entry-kicker">Julkinen keskustelu</p>
            <h3 class="h5 mb-2">Mielipiteet, kolumnit ja blogitekstit</h3>
            <p class="small text-muted mb-3">Täältä näet, miten samat aiheet jatkuvat lehtikirjoituksissa, kolumneissa ja blogissa.</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <span class="badge text-bg-light border">Mielipiteet {{ opinionCount }}</span>
              <span class="badge text-bg-light border">Kolumnit {{ columnCount }}</span>
              <span class="badge text-bg-light border">Blogi {{ blogCount }}</span>
            </div>
            <div class="d-grid gap-3 mb-4">
              {% if latestOpinionHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Mielipidenosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestOpinionHighlights[0].data.url or latestOpinionHighlights[0].url }}">{{ latestOpinionHighlights[0].data.title }}</a>
              </div>
              {% endif %}
              {% if latestColumnHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Kolumninosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestColumnHighlights[0].data.url or latestColumnHighlights[0].url }}">{{ latestColumnHighlights[0].data.title }}</a>
              </div>
              {% endif %}
              {% if latestBlogHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Bloginosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestBlogHighlights[0].url }}">{{ latestBlogHighlights[0].data.title }}</a>
              </div>
              {% endif %}
            </div>
            <div class="mt-auto d-flex flex-wrap gap-2">
              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="#mielipiteet">Mielipiteet</a>
              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="#kolumnit">Kolumnit</a>
              <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" href="#blogi">Blogi</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-4" id="reitti-asiantuntijuus">
        <article class="card border-0 shadow-sm h-100 kynasta-route-card">
          <div class="card-body p-4 d-flex flex-column">
            <p class="kynasta-entry-kicker">Asiantuntijatausta</p>
            <h3 class="h5 mb-2">Opetuksen, tutkimuksen ja teknologian näkökulmat</h3>
            <p class="small text-muted mb-3">Jos etsit tekstejä, joissa yliopistotyö ja koulutusalan osaaminen ovat mukana, aloita tästä.</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <span class="badge text-bg-light border">Lausunnot {{ statementCount }}</span>
              <span class="badge text-bg-light border">Asiantuntijataustaiset mielipiteet {{ expertOpinionCount }}</span>
              <span class="badge text-bg-light border">Julkiset puheet {{ publicSpeechCount }}</span>
            </div>
            <div class="d-grid gap-3 mb-4">
              {% if latestExpertOpinionHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Asiantuntijataustainen kirjoitus</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestExpertOpinionHighlights[0].data.url or latestExpertOpinionHighlights[0].url }}">{{ latestExpertOpinionHighlights[0].data.title }}</a>
              </div>
              {% endif %}
              {% if latestStatementHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Lausuntonosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestStatementHighlights[0].data.url or latestStatementHighlights[0].url }}">{{ latestStatementHighlights[0].data.title }}</a>
              </div>
              {% endif %}
              {% if latestPublicSpeechHighlights[0] %}
              <div>
                <p class="small text-uppercase text-muted fw-semibold mb-1">Julkisen puheen nosto</p>
                <a class="text-decoration-none fw-semibold" href="{{ latestPublicSpeechHighlights[0].data.url or latestPublicSpeechHighlights[0].url }}">{{ latestPublicSpeechHighlights[0].data.title }}</a>
              </div>
              {% endif %}
            </div>
            <div class="mt-auto d-flex flex-wrap gap-2">
              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="#lausunnot">Lausunnot</a>
              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="#julkiset-puheet">Julkiset puheet</a>
              <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" href="#mielipiteet">Asiantuntijataustaiset tekstit</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

{% set topicProfileKeys = ["oulun-palveluverkko-ja-kaupunkikehitys", "lapinakyva-paatoksenteko-ja-tiedolla-johtaminen", "opettajankoulutus", "tekoalylukutaito"] %}
{% set topicProfileTitleId = "kynasta-topic-profiles-title" %}
{% set topicProfileEyebrow = "Aiheittain" %}
{% set topicProfileTitle = "Kirjoitukset ja puheet teemoittain" %}
{% set topicProfileLead = "Samat kysymykset kulkevat puheissa, mielipiteissä, lausunnoissa ja blogikirjoituksissa. Teemoittelu auttaa löytämään samaan aiheeseen liittyvät tekstit yhdestä paikasta." %}
{% include "topic-profile-links.njk" %}

<section id="arkisto">
  <div class="site-shell">
    <div class="row g-4 align-items-stretch">
      <div class="col-12">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-1">
          <div>
            <p class="text-uppercase small text-muted mb-1">Arkisto</p>
            <h2 class="h3 mb-1">Selaa puheita, lausuntoja ja kirjoituksia</h2>
            <p class="text-muted mb-0">Kun tiedät jo, mitä etsit, voit siirtyä suoraan puheisiin, lausuntoihin, mielipidekirjoituksiin, kolumneihin, blogiin tai aloitteisiin.</p>
          </div>
        </div>
      </div>

      <div class="col-12">
        <div class="kynasta-type-grid" aria-label="Kynästä-sivun sisältötyypit">
          <a class="kynasta-type-card kynasta-entry-card--puheet" href="#puheet">
            <span class="kynasta-entry-kicker">Kaupunginvaltuusto</span>
            <strong>Valtuustopuheet</strong>
            <small>{{ councilSpeechCount }} puheenvuoroa</small>
          </a>
          <a class="kynasta-type-card kynasta-entry-card--public-speeches" href="#julkiset-puheet">
            <span class="kynasta-entry-kicker">Tilaisuudet</span>
            <strong>Julkiset puheet</strong>
            <small>{{ publicSpeechCount }} puhetta</small>
          </a>
          <a class="kynasta-type-card kynasta-entry-card--aloitteet" href="#aloitteet">
            <span class="kynasta-entry-kicker">Valtuusto</span>
            <strong>Valtuustoaloitteet</strong>
            <small>{{ initiativeCount }} aloitetta jätetty</small>
          </a>
          <a class="kynasta-type-card kynasta-entry-card--kirjoitukset" href="#blogi">
            <span class="kynasta-entry-kicker">Blogi</span>
            <strong>Blogikirjoitukset</strong>
            <small>{{ blogCount }} kirjoitusta</small>
          </a>
          <a class="kynasta-type-card kynasta-entry-card--opinions" href="#mielipiteet">
            <span class="kynasta-entry-kicker">Lehdet</span>
            <strong>Mielipidekirjoitukset</strong>
            <small>{{ opinionCount }} kirjoitusta</small>
          </a>
          <a class="kynasta-type-card kynasta-entry-card--statements" href="#lausunnot">
            <span class="kynasta-entry-kicker">Asiantuntijatausta</span>
            <strong>Lausunnot</strong>
            <small>{{ statementCount }} lausuntoa</small>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<details class="kynasta-mobile-disclosure" data-kynasta-mobile-collapse id="yhteenveto" open>
  <summary class="kynasta-mobile-disclosure-summary">Yhteenveto ja tilastot</summary>
<section>
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent">
        <h2 class="h4 mb-1"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Yhteenveto</h2>
        <p class="small text-muted mb-0">Puheet, lausunnot, kirjoitukset ja aloitteet yhdellä silmäyksellä. Tarkempi tilastografiikka avautuu tarvittaessa.</p>
      </div>
      <div class="card-body">
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-4 col-lg-2">
            {{ ui.kpiCard("Valtuustoaloitteet", "0", { href: "#aloitteet", id: "kpi-aloitteet", tone: "aloitteet" }) }}
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            {{ ui.kpiCard("Blogi", "0", { href: "#blogi", id: "kpi-blogi", tone: "blogi" }) }}
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            {{ ui.kpiCard("Kolumnit", "0", { href: "#kolumnit", id: "kpi-kolumnit", tone: "kolumnit" }) }}
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            {{ ui.kpiCard("Lausunnot", "0", { href: "#lausunnot", id: "kpi-lausunnot", tone: "lausunnot" }) }}
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            {{ ui.kpiCard("Mielipiteet", "0", { href: "#mielipiteet", id: "kpi-mielipiteet", tone: "mielipiteet" }) }}
          </div>
          <div class="col-6 col-md-4 col-lg-2">
            {{ ui.kpiCard("Valtuustopuheet", "0", { href: "#puheet", id: "kpi-puheet", tone: "puheet" }) }}
          </div>
        </div>

        <div class="mt-3">
          <button class="btn btn-outline-secondary w-100 d-flex justify-content-between align-items-center"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#kynastaChartsDashboard"
                  aria-expanded="false"
                  aria-controls="kynastaChartsDashboard">
            <span><i class="bi bi-bar-chart-fill me-2"></i>Tilastografiikka</span>
            <i class="bi bi-chevron-down kynasta-chevron"></i>
          </button>
        </div>

        <div class="collapse mt-3" id="kynastaChartsDashboard">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <h3 class="h6 text-muted mb-0">Kaaviot sisältöjen jakaumasta ja vuosittaisesta kehityksestä</h3>
            <span class="badge text-bg-primary">Chart.js</span>
          </div>
          <div class="row g-4 mt-0">
            <div class="col-lg-4">
              <h3 class="h6 text-muted mb-2">Sisältöjen jakauma</h3>
              <div class="chart-wrap">
                <canvas id="kynasta-summary-donut" height="260"></canvas>
              </div>
            </div>
            <div class="col-lg-8">
              <h3 class="h6 text-muted mb-2">Sisällöt vuosittain</h3>
              <div class="chart-wrap">
                <canvas id="kynasta-summary-trend" height="260"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</details>

<script id="lausunnot-data" type="application/json">
[
  {% for pub in statementItems %}
  {
    "title": {{ pub.data.title | jsonSafe | safe }},
    "date": "{{ pub.date }}",
    "formattedDate": "{{ pub.date | dateFormat }}",
    "description": {{ (pub.data.description or "") | jsonSafe | safe }},
    "publication": {{ (pub.data.publication or "") | jsonSafe | safe }},
    "url": "{{ pub.data.url or pub.url }}",
    "isExternal": {{ (pub.data.url != null) | jsonSafe | safe }},
    "categories": {{ (pub.data.categories or []) | jsonSafe | safe }},
    "keywords": {{ (pub.data.keywords or []) | jsonSafe | safe }},
    "writingRoles": {{ (pub.data.writingRoles or []) | jsonSafe | safe }},
    "statementAuthority": {{ (pub.data.statementAuthority or "") | jsonSafe | safe }},
    "diaryNumber": {{ (pub.data.diaryNumber or "") | jsonSafe | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
]
</script>

<span id="lausunnot-ja-asiantuntijakannanotot"></span>
<details class="kynasta-mobile-disclosure kynasta-archive-disclosure" data-kynasta-mobile-collapse>
  <summary class="kynasta-mobile-disclosure-summary">
    <span>Lausunnot</span>
    <small>{{ statementCount }} asiantuntijalausuntoa</small>
  </summary>
<section id="lausunnot">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between kynasta-section-header">
        <h2 class="h4 mb-0"><i class="bi bi-file-earmark-text-fill me-2"></i>Lausunnot</h2>
        <span class="badge kynasta-section-count">{{ statementCount }}</span>
      </div>
      <div class="card-body p-0">
