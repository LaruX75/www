  restoreArchiveFilterFromUrl(kolumnitYearSel, kolumnitUrlParams.get('columnsYear'));
  restoreArchiveFilterFromUrl(kolumnitPublicationSel, kolumnitUrlParams.get('columnsPublication'));

  function syncKolumnitUrl() {
    const nextUrl = new URL(window.location.href);
    const filters = [
      ['columnsRole', selectedKolumnitRole === 'all' ? '' : selectedKolumnitRole],
      ['columnsYear', kolumnitYearSel?.value || ''],
      ['columnsPublication', kolumnitPublicationSel?.value || '']
    ];
    filters.forEach(([key, value]) => value ? nextUrl.searchParams.set(key, value) : nextUrl.searchParams.delete(key));
    history.replaceState({}, '', `${nextUrl.pathname}${nextUrl.search}${window.location.hash}`);
  }

  function applyKolumnitFilters() {
    const q = kolumnitSearchInp ? kolumnitSearchInp.value.toLowerCase().trim() : '';
    const year = kolumnitYearSel?.value || '';
