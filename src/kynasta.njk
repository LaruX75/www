    const from = total === 0 ? 0 : start + 1;
    const to = Math.min(start + LAUSUNNOT_PAGE_SIZE, total);
    lausunnotInfo.textContent = `Näytetään ${from}–${to} / ${total}`;

    renderLausunnotPagination(totalPages);

    document.querySelectorAll('.lausunnot-table th.sortable').forEach((th) => {
      th.classList.remove('sort-asc', 'sort-desc');
      if (th.dataset.col === lausunnotSortCol) {
        th.classList.add(lausunnotSortDir === 1 ? 'sort-asc' : 'sort-desc');
      }
    });
  }

  function renderLausunnotPagination(total) {
    renderPaginationShared(lausunnotPagUl, total, lausunnotCurrentPage, page => {
      lausunnotCurrentPage = page;
      renderLausunnot();
      document.getElementById('lausunnot')?.scrollIntoView({behavior:'smooth', block:'start'});
    });
  }

  function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function slugify(str) {
    if (!str) return "";
    return str.toLowerCase().replace(/ä/g, "a").replace(/ö/g, "o").replace(/å/g, "a").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }

  if (lausunnotSearchInp) lausunnotSearchInp.addEventListener('input', applyLausunnotFilters);
  if (lausunnotYearSel) lausunnotYearSel.addEventListener('change', applyLausunnotFilters);

  const lausunnotResetBtn = document.getElementById('lausunnot-reset');
  if (lausunnotResetBtn) {
    lausunnotResetBtn.addEventListener('click', () => {
      if (lausunnotSearchInp) lausunnotSearchInp.value = '';
      if (lausunnotYearSel) lausunnotYearSel.value = '';
      applyLausunnotFilters();
    });
  }

  document.querySelectorAll('.lausunnot-table th.sortable').forEach((th) => {
    th.addEventListener('click', () => sortLausunnotData(th.dataset.col));
  });

  renderLausunnot();
})();

// --- Mielipiteet taulukon logiikka ---
(function () {
  const MIELIPITEET_PAGE_SIZE = 5;
  const mielipiteetDataEl = document.getElementById('mielipiteet-data');
  if (!mielipiteetDataEl) return;
  const mielipiteetData = JSON.parse(mielipiteetDataEl.textContent);
  const urlParams = new URLSearchParams(window.location.search);
  const initialOpinionRole = urlParams.get('opinions');

  let filteredMielipiteetData = [];
  let mielipiteetCurrentPage = 1;
  let mielipiteetSortCol = 'date';
  let mielipiteetSortDir = -1; // -1 = desc
  let selectedOpinionRole = ['political', 'expert', 'hybrid'].includes(initialOpinionRole) ? initialOpinionRole : 'all';

  const mielipiteetSearchInp = document.getElementById('mielipiteet-search');
  const mielipiteetYearSel = document.getElementById('mielipiteet-year');
  const mielipiteetPublicationSel = document.getElementById('mielipiteet-publication');
  const mielipiteetDateSortBtn = document.getElementById('mielipiteet-sort-date');
  const mielipiteetTitleSortBtn = document.getElementById('mielipiteet-sort-title');
  const mielipiteetTbody = document.getElementById('mielipiteet-tbody');
  const mielipiteetInfo = document.getElementById('mielipiteet-info');
  const mielipiteetPagUl = document.getElementById('mielipiteet-pagination');
  const opinionRoleButtons = Array.from(document.querySelectorAll('[data-opinion-role]'));
  const opinionRoleCards = Array.from(document.querySelectorAll('[data-opinion-role-card]'));

  populateArchiveFilter(mielipiteetYearSel, mielipiteetData.map((item) => archiveYear(item.date)), 'Kaikki vuodet', (a, b) => Number(b) - Number(a));
  populateArchiveFilter(mielipiteetPublicationSel, mielipiteetData.map((item) => item.publication), 'Kaikki julkaisut');
  restoreArchiveFilterFromUrl(mielipiteetYearSel, urlParams.get('opinionsYear'));
  restoreArchiveFilterFromUrl(mielipiteetPublicationSel, urlParams.get('opinionsPublication'));

  function sortMielipiteetArray(data) {
    return [...data].sort((a, b) => {
      let av = a[mielipiteetSortCol] ?? '';
      let bv = b[mielipiteetSortCol] ?? '';
      if (typeof av === 'string') av = av.toLowerCase();
      if (typeof bv === 'string') bv = bv.toLowerCase();
      if (mielipiteetSortCol === 'date') {
        return (new Date(av) - new Date(bv)) * mielipiteetSortDir;
      }
      return av.toString().localeCompare(bv.toString(), 'fi') * mielipiteetSortDir;
    });
  }

  function syncOpinionRoleButtons() {
    opinionRoleButtons.forEach((btn) => {
      const isActive = btn.dataset.opinionRole === selectedOpinionRole;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    opinionRoleCards.forEach((card) => {
      const isActive = card.dataset.opinionRoleCard === selectedOpinionRole;
      card.classList.toggle('is-active', isActive);
      card.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  function syncOpinionFiltersUrl() {
    const nextUrl = new URL(window.location.href);
    const filters = [
      ['opinions', selectedOpinionRole === 'all' ? '' : selectedOpinionRole],
      ['opinionsYear', mielipiteetYearSel?.value || ''],
      ['opinionsPublication', mielipiteetPublicationSel?.value || '']
    ];
    filters.forEach(([key, value]) => value ? nextUrl.searchParams.set(key, value) : nextUrl.searchParams.delete(key));
    history.replaceState({}, '', `${nextUrl.pathname}${nextUrl.search}${window.location.hash}`);
  }

  function applyMielipiteetFilters() {
    const q = mielipiteetSearchInp ? mielipiteetSearchInp.value.toLowerCase().trim() : '';
    const year = mielipiteetYearSel?.value || '';
    const publication = mielipiteetPublicationSel?.value || '';
    filteredMielipiteetData = sortMielipiteetArray(mielipiteetData.filter(d => {
      const roles = Array.isArray(d.opinionRoles) ? d.opinionRoles : [];
      const matchQ = !q ||
        (d.title || '').toLowerCase().includes(q) ||
        (d.description || '').toLowerCase().includes(q) ||
        (d.publication || '').toLowerCase().includes(q) ||
        writingRoleMatchesQuery(d.opinionRoles || d.writingRoles || [], q) ||
        (d.categories || []).some(c => c.toLowerCase().includes(q)) ||
        (d.keywords || []).some(k => k.toLowerCase().includes(q));
      const matchRole =
        selectedOpinionRole === 'all' ||
        roles.includes(selectedOpinionRole) ||
        (selectedOpinionRole === 'hybrid' && roles.includes('political') && roles.includes('expert'));
      return matchQ &&
        (!year || archiveYear(d.date) === year) &&
        (!publication || d.publication === publication) &&
        matchRole;
    }));
    mielipiteetCurrentPage = 1;
    syncOpinionRoleButtons();
    syncOpinionFiltersUrl();
    renderMielipiteet();
  }

  function sortMielipiteetData(col) {
    if (mielipiteetSortCol === col) { mielipiteetSortDir *= -1; }
    else { mielipiteetSortCol = col; mielipiteetSortDir = col === 'date' ? -1 : 1; }
    filteredMielipiteetData = sortMielipiteetArray(filteredMielipiteetData);
    mielipiteetCurrentPage = 1;
    renderMielipiteet();
  }

  function renderMielipiteet() {
    if (!mielipiteetTbody || !mielipiteetInfo) return;

    const totalPages = Math.max(1, Math.ceil(filteredMielipiteetData.length / MIELIPITEET_PAGE_SIZE));
    const start = (mielipiteetCurrentPage - 1) * MIELIPITEET_PAGE_SIZE;
    const slice = filteredMielipiteetData.slice(start, start + MIELIPITEET_PAGE_SIZE);

    if (slice.length === 0) {
      mielipiteetTbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-5">Ei tuloksia haulla</td></tr>';
    } else {
      mielipiteetTbody.innerHTML = slice.map(d => {
        const roleBadges = renderWritingRoleBadges(d.opinionRoles || d.writingRoles || [], { button: true });
        const catBadges = (d.categories || []).map(c => `<a href="/kategoriat/${slugify(c)}/" class="badge text-bg-secondary me-1 text-decoration-none">${c}</a>`).join('');
        const keyBadges = (d.keywords || []).map(k => `<a href="/avainsanat/${slugify(k)}/" class="badge text-bg-light text-dark border me-1 text-decoration-none">${k}</a>`).join('');

        const targetAttr = d.isExternal ? 'target="_blank" rel="noopener"' : '';
        const iconInfo = d.isExternal ? '<i class="bi bi-arrow-up-right"></i>' : '<i class="bi bi-arrow-right"></i>';
        const publicationTitle = d.publication ? `<strong class="d-block text-body mb-1">${escHtml(d.publication)}</strong>` : '';

        return `<tr>
          <td class="col-date text-center small text-muted font-monospace">${d.formattedDate}</td>
          <td class="col-title fw-medium"><a href="${d.url}" ${targetAttr} class="text-decoration-none">${escHtml(d.title)}</a></td>
          <td class="col-desc small text-muted">${publicationTitle}<span class="summary-text">${escHtml(d.description)}</span>${roleBadges}</td>
          <td class="col-taxonomy">
            <div class="mb-1">${catBadges}</div>
            <div>${keyBadges}</div>
          </td>
          <td class="col-action text-center">
            <a href="${d.url}" ${targetAttr} class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Avaa mielipidekirjoitus">
              ${iconInfo}
            </a>
          </td>
        </tr>`;
      }).join('');
    }

    const total = filteredMielipiteetData.length;
    const from = total === 0 ? 0 : start + 1;
    const to = Math.min(start + MIELIPITEET_PAGE_SIZE, total);
    mielipiteetInfo.textContent = `Näytetään ${from}–${to} / ${total}`;

    renderMielipiteetPagination(totalPages);

    syncArchiveSortButton(mielipiteetDateSortBtn, mielipiteetSortCol === 'date', mielipiteetSortDir, 'Päivämäärä');
    syncArchiveSortButton(mielipiteetTitleSortBtn, mielipiteetSortCol === 'title', mielipiteetSortDir, 'Otsikko');
  }

  function renderMielipiteetPagination(total) {
    renderPaginationShared(mielipiteetPagUl, total, mielipiteetCurrentPage, page => {
      mielipiteetCurrentPage = page;
      renderMielipiteet();
      document.getElementById('mielipiteet')?.scrollIntoView({behavior:'smooth', block:'start'});
    });
  }

  function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function slugify(str) {
    if (!str) return "";
    return str.toLowerCase().replace(/ä/g, "a").replace(/ö/g, "o").replace(/å/g, "a").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }

  if (mielipiteetSearchInp) mielipiteetSearchInp.addEventListener('input', applyMielipiteetFilters);
  if (mielipiteetYearSel) mielipiteetYearSel.addEventListener('change', applyMielipiteetFilters);
  if (mielipiteetPublicationSel) mielipiteetPublicationSel.addEventListener('change', applyMielipiteetFilters);
  if (mielipiteetDateSortBtn) mielipiteetDateSortBtn.addEventListener('click', () => sortMielipiteetData('date'));
  if (mielipiteetTitleSortBtn) mielipiteetTitleSortBtn.addEventListener('click', () => sortMielipiteetData('title'));

  if (mielipiteetTbody) {
    mielipiteetTbody.addEventListener('click', (event) => {
      const roleBtn = event.target.closest('[data-opinion-role-inline]');
      if (!roleBtn) return;
      event.preventDefault();
      selectedOpinionRole = roleBtn.dataset.opinionRoleInline || 'all';
      applyMielipiteetFilters();
      document.getElementById('mielipiteet')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  opinionRoleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedOpinionRole = btn.dataset.opinionRole || 'all';
      applyMielipiteetFilters();
    });
  });

  opinionRoleCards.forEach((card) => {
    card.addEventListener('click', () => {
      selectedOpinionRole = card.dataset.opinionRoleCard || 'all';
      applyMielipiteetFilters();
    });
  });
  
  const mielipiteetResetBtn = document.getElementById('mielipiteet-reset');
  if (mielipiteetResetBtn) {
    mielipiteetResetBtn.addEventListener('click', () => {
      if (mielipiteetSearchInp) mielipiteetSearchInp.value = '';
      if (mielipiteetYearSel) mielipiteetYearSel.value = '';
      if (mielipiteetPublicationSel) mielipiteetPublicationSel.value = '';
      selectedOpinionRole = 'all';
      applyMielipiteetFilters();
    });
  }

  applyMielipiteetFilters();
})();

}); // DOMContentLoaded
</script>

{# Staattinen arkistolista — takaa inlinkit kaikille julkaisuille hakukoneille #}
<section class="py-3">
  <div class="site-shell">
    <details>
      <summary class="text-muted small py-2">Kaikki kirjoitukset arkistona ({{ collections.publications | length }})</summary>
      <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-1 mt-2">
        {% for pub in collections.publications | sort(attribute="data.date", reverse=true) %}
        <li class="col"><a class="small text-decoration-none text-muted" href="{{ pub.url }}">{{ pub.data.title }}</a></li>
        {% endfor %}
      </ul>
    </details>
  </div>
</section>
