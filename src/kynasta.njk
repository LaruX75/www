  if (kolumnitDateSortBtn) kolumnitDateSortBtn.addEventListener('click', () => sortKolumnitData('date'));
  if (kolumnitTitleSortBtn) kolumnitTitleSortBtn.addEventListener('click', () => sortKolumnitData('title'));

  kolumnitRoleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedKolumnitRole = btn.dataset.kolumnitRole || 'all';
      applyKolumnitFilters();
    });
