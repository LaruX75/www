{# ---- Sisäisten linkkien säilyttäminen ---- #}
{# Vanhat ankkurit (esim. /kynasta/#lausunnot) ohjataan asiakassivustolla oikeille sivuille.
   Nämä ID:t on tarkoituksella ns. hidden-elementteinä — kohtaa /kynasta/#foo etsivät ulkoiset
   linkit löytävät edelleen kohteensa. Sisäiset ankkurit /kynasta/#kirjoitukset, #valtuustotyo,
   #asiantuntijatyo on vastaavasti käytössä uudessa hub-rakenteessa (ks. <section id=...>). #}
<span id="lausunnot" class="visually-hidden" data-legacy-anchor data-target="/lausunnot/#lausunnot"></span>
<span id="julkiset-puheet" class="visually-hidden" data-legacy-anchor data-target="/lausunnot/#julkiset-puheet"></span>
<span id="puheet" class="visually-hidden" data-legacy-anchor data-target="/valtuustotyo/#puheet"></span>
<span id="aloitteet" class="visually-hidden" data-legacy-anchor data-target="/valtuustotyo/#aloitteet"></span>
<span id="blogi" class="visually-hidden" data-legacy-anchor data-target="/kirjoitukset/#blogi"></span>
<span id="mielipiteet" class="visually-hidden" data-legacy-anchor data-target="/kirjoitukset/#mielipiteet"></span>
<span id="kolumnit" class="visually-hidden" data-legacy-anchor data-target="/kirjoitukset/#kolumnit"></span>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var hash = (window.location.hash || '').replace('#', '');
  if (!hash) return;
  var anchor = document.querySelector('[id="' + hash + '"][data-legacy-anchor]');
  if (anchor && anchor.dataset.target) {
    window.location.replace(anchor.dataset.target);
  }
});
</script>
