{# Kerätään kaikki puheet JSON-muotoon JS:ää varten #}
<script id="puheet-data" type="application/json">
[
  {% for pub in councilSpeechItems %}
  {% set resolvedUrl = pub.data.url or pub.url %}
  {% set councilMeta = oukaCouncilSpeechProtocols.overrides[resolvedUrl] or {} %}
  {% set resolvedEvent = councilMeta.event or pub.data.event or "" %}
  {% set resolvedAsiakohta = councilMeta.asiakohta or pub.data.asiakohta or "" %}
  {% set publicationDate = pub.date | isoDate %}
  {% set declaredMeetingDate = (pub.data.meetingDate or councilMeta.meetingDate or pub.date) | isoDate %}
  {% set publicationMeetingMeta = councilMeetingMeta.byDate[publicationDate] or {} %}
  {% set meetingDate = publicationMeetingMeta.timelineTitle and publicationDate or declaredMeetingDate %}
  {% set meetingMeta = councilMeetingMeta.byDate[meetingDate] or {} %}
  {% set protocolUrl = councilMeta.protocolUrl or (resolvedEvent == "Oulun kaupunginvaltuusto" and oukaCouncilSpeechProtocols.protocolsByDate[meetingDate]) %}
  {% set councilVideos = councilSpeechVideos.byUrl[resolvedUrl] or councilSpeechVideos.byUrl[pub.data.source_url] or [] %}
  {
    "title": {{ pub.data.title | jsonSafe | safe }},
    "date": "{{ pub.date }}",
    "formattedDate": "{{ pub.date | dateFormat }}",
    "description": {{ (pub.data.description or "") | jsonSafe | safe }},
    "event": {{ resolvedEvent | jsonSafe | safe }},
    "meetingNumber": {{ (meetingMeta.meetingNumber or "") | jsonSafe | safe }},
    "meetingLabel": {{ (meetingMeta.meetingNumber or meetingMeta.timelineTitle or "") | jsonSafe | safe }},
    "asiakohta": {{ resolvedAsiakohta | jsonSafe | safe }},
    "protocolUrl": {{ (protocolUrl or "") | jsonSafe | safe }},
    "councilVideos": {{ councilVideos | jsonSafe | safe }},
    "url": "{{ resolvedUrl }}",
    "isExternal": {{ (pub.data.url != null) | jsonSafe | safe }},
    "speechContext": {{ (pub.data.speechContext or "") | jsonSafe | safe }},
    "categories": {{ (pub.data.categories or []) | jsonSafe | safe }},
    "keywords": {{ (pub.data.keywords or []) | jsonSafe | safe }},
    "tags": {{ (pub.data.tags or []) | jsonSafe | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
]
</script>

