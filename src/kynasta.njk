  function applyAloitteetFilters() {
    const q = aloitteetSearchInp ? aloitteetSearchInp.value.toLowerCase().trim() : '';
    const year = aloitteetYearSel?.value || '';
    filteredAloitteetData = aloitteetData.filter(d => {
      const matchQ = !q ||
        (d.title || '').toLowerCase().includes(q) ||
        (d.description || '').toLowerCase().includes(q) ||
        (d.meeting || '').toLowerCase().includes(q) ||
        (d.formattedMeetingDate || '').toLowerCase().includes(q) ||
        (d.initiative_type || '').toLowerCase().includes(q) ||
        (d.categories || []).some(c => c.toLowerCase().includes(q)) ||
        (d.keywords || []).some(k => k.toLowerCase().includes(q));
      return matchQ && (!year || archiveYear(d.meetingDate || d.date) === year);
    }).sort((a, b) => new Date(b.meetingDate || b.date) - new Date(a.meetingDate || a.date));
    aloitteetCurrentPage = 1;
    renderAloitteet();
  }

  function sortAloitteetData(col) {
    if (aloitteetSortCol === col) { aloitteetSortDir *= -1; }
    else { aloitteetSortCol = col; aloitteetSortDir = col === 'date' || col === 'meetingDate' ? -1 : 1; }
    
    filteredAloitteetData.sort((a, b) => {
      let av = a[col] ?? '';
      let bv = b[col] ?? '';
      if (typeof av === 'string') av = av.toLowerCase();
      if (typeof bv === 'string') bv = bv.toLowerCase();
      if (col === 'date' || col === 'meetingDate') {
        return (new Date(av) - new Date(bv)) * aloitteetSortDir;
      }
      return av.toString().localeCompare(bv.toString(), 'fi') * aloitteetSortDir;
    });
    aloitteetCurrentPage = 1;
    renderAloitteet();
