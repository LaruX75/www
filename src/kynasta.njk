{# KYNÄSTÄ-HUB-02: content-rich SSR hub.
   All grouping, sorting and latest-5 slicing lives in the canonical
   kynastaHubPage projection (src/_utils/kynastaHubPage.js). Nunjucks
   only renders — no classification, no counting, no .slice() here. #}
{% set model = kynastaHubPage %}

<section class="kynasta-hero py-4 py-lg-5">
  <div class="site-shell">
    <div class="row align-items-start g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-2">Kynästä</p>
        <h1 class="display-6 fw-bold mb-3">Kirjoitukset, puheet ja kannanotot</h1>
        <p class="text-muted mb-3">Yhteensä <strong>{{ model.totalCount }}</strong> tekstiä ja puheenvuoroa on koottu kolmeen kokonaisuuteen: kirjoituksia, valtuustotyötä ja asiantuntijatyötä. Kussakin osiossa näet viisi tuoreinta tekstiä ja linkin koko arkistoon.</p>
      </div>
      <div class="col-lg-4">
        <aside class="kynasta-hero-aside">
          <p class="kynasta-hero-aside-kicker mb-2">Näin löydät etsimäsi</p>
          <ul class="kynasta-hero-aside-list mb-0">
            <li><strong>Kirjoitukset:</strong> blogia, mielipiteitä ja kolumneja — vapaamuotoisia tekstejä.</li>
            <li><strong>Valtuustotyö:</strong> puheenvuoroja ja aloitteita kaupunginvaltuustossa.</li>
            <li><strong>Asiantuntijatyö:</strong> asiantuntijalausuntoja ja julkisia puheita.</li>
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

{# ---- Kirjoitukset ---- #}
<section class="kynasta-hub-section py-4 py-lg-5" id="kirjoitukset" aria-labelledby="kynasta-writings-heading">
  <div class="site-shell">
    <header class="kynasta-hub-section-header mb-4">
      <p class="text-uppercase small text-muted mb-1">Kirjoitukset</p>
      <h2 id="kynasta-writings-heading" class="h3 mb-2">Vapaamuotoiset kirjoitukset ja julkaistut kannanotot</h2>
      <p class="text-muted mb-0">Blogitekstit, mielipidekirjoitukset ja kolumnit yhteensä <strong>{{ model.writings.count }}</strong> tekstiä.</p>
    </header>
    <div class="row g-4">
      <div class="col-md-6 col-lg-4">
        {% set subsectionHeading = "Blogi" %}
        {% set subsectionDescription = "Blogin syvempiä pohdintoja opetuksesta, teknologiasta ja avoimesta tieteestä." %}
        {% set subsectionItems = model.writings.groups.blog.latestItems %}
        {% set subsectionCount = model.writings.groups.blog.count %}
        {% set subsectionArchiveUrl = "/kirjoitukset/#blogi" %}
        {% set subsectionArchiveLabel = "Näytä kaikki blogitekstit" %}
        {% set subsectionLang = "fi" %}
        {% set subsectionEmptyText = "Ei blogitekstejä." %}
        {% include "kynasta-hub-subsection.njk" %}
      </div>
      <div class="col-md-6 col-lg-4">
        {% set subsectionHeading = "Mielipidekirjoitukset" %}
        {% set subsectionDescription = "Lehdissä julkaistut kannanotot ja mielipidekirjoitukset." %}
        {% set subsectionItems = model.writings.groups.opinion.latestItems %}
        {% set subsectionCount = model.writings.groups.opinion.count %}
        {% set subsectionArchiveUrl = "/kirjoitukset/#mielipiteet" %}
        {% set subsectionArchiveLabel = "Näytä kaikki mielipidekirjoitukset" %}
        {% set subsectionLang = "fi" %}
        {% set subsectionEmptyText = "Ei mielipidekirjoituksia." %}
        {% include "kynasta-hub-subsection.njk" %}
      </div>
      <div class="col-md-6 col-lg-4">
        {% set subsectionHeading = "Kolumnit ja blogivierailut" %}
        {% set subsectionDescription = "Lehtiin ja verkkojulkaisuihin kirjoitetut kolumnit sekä vieraskirjoitukset." %}
        {% set subsectionItems = model.writings.groups.column.latestItems %}
        {% set subsectionCount = model.writings.groups.column.count %}
        {% set subsectionArchiveUrl = "/kirjoitukset/#kolumnit" %}
        {% set subsectionArchiveLabel = "Näytä kaikki kolumnit" %}
        {% set subsectionLang = "fi" %}
        {% set subsectionEmptyText = "Ei kolumneja." %}
        {% include "kynasta-hub-subsection.njk" %}
      </div>
    </div>
  </div>
</section>

