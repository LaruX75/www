    filteredKolumnitData = kolumnitData.filter(d => {
      const roles = d.writingRoles || [];
      const matchQ = !q ||
        (d.title || '').toLowerCase().includes(q) ||
        (d.description || '').toLowerCase().includes(q) ||
        (d.publication || '').toLowerCase().includes(q) ||
        writingRoleMatchesQuery(roles, q) ||
        (d.categories || []).some(c => c.toLowerCase().includes(q)) ||
        (d.keywords || []).some(k => k.toLowerCase().includes(q));
      return matchQ &&
        (!year || archiveYear(d.date) === year) &&
        (!publication || d.publication === publication) &&
        writingRoleMatchesFilter(roles, selectedKolumnitRole);
    }).sort((a, b) => new Date(b.date) - new Date(a.date));
    kolumnitCurrentPage = 1;
    syncWritingRoleFilterButtons(kolumnitRoleButtons, selectedKolumnitRole);
    syncKolumnitUrl();
    renderKolumnit();
  }

  function sortKolumnitData(col) {
    if (kolumnitSortCol === col) { kolumnitSortDir *= -1; }
    else { kolumnitSortCol = col; kolumnitSortDir = col === 'date' ? -1 : 1; }
    
    filteredKolumnitData.sort((a, b) => {
      let av = a[col] ?? '';
      let bv = b[col] ?? '';
      if (typeof av === 'string') av = av.toLowerCase();
      if (typeof bv === 'string') bv = bv.toLowerCase();
      if (col === 'date') {
        return (new Date(av) - new Date(bv)) * kolumnitSortDir;
      }
      return av.toString().localeCompare(bv.toString(), 'fi') * kolumnitSortDir;
    });
    kolumnitCurrentPage = 1;
    renderKolumnit();
  }

