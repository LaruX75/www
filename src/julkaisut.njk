---
layout: base.njk
title: Julkaisuluettelo
metaTitle: Julkaisuluettelo
description: "Jari Larun tieteellisten ja ammatillisten julkaisujen kokonaisluettelo Research.fi-profiilista. Ryhmiteltynä OKM:n julkaisutyyppiluokituksen (A–G) mukaisesti."
permalink: /julkaisut/
translationKey: publications_index
suppressTableFilters: true
pageStyles:
  - /css/publications-page.css
  - /css/find-explore.css
pageScripts:
  - /js/find-explore.js
  - /js/publication-citation.js
schemaType: CollectionPage
---
{% import "ui.njk" as ui %}

{%- set canonicalPublications = publicationsPage.items or [] -%}
{%- set articleCount = 0 -%}
{%- set confCount = 0 -%}
{%- set bookCount = 0 -%}
{%- set peerReviewedCount = 0 -%}
{%- set openAccessCount = 0 -%}
{%- set pubsA = [] -%}
{%- set pubsB = [] -%}
{%- set pubsC = [] -%}
{%- set pubsD = [] -%}
{%- set pubsE = [] -%}
{%- set pubsG = [] -%}
{%- for pub in canonicalPublications -%}
  {%- set typeChar = pub.publicationGroup or ((pub.typeCode or '') | first) -%}
  {%- if typeChar == "A" -%}{%- set pubsA = (pubsA.push(pub), pubsA) -%}
  {%- elif typeChar == "B" -%}{%- set pubsB = (pubsB.push(pub), pubsB) -%}
  {%- elif typeChar == "C" -%}{%- set pubsC = (pubsC.push(pub), pubsC) -%}
  {%- elif typeChar == "D" -%}{%- set pubsD = (pubsD.push(pub), pubsD) -%}
  {%- elif typeChar == "E" -%}{%- set pubsE = (pubsE.push(pub), pubsE) -%}
  {%- elif typeChar == "G" -%}{%- set pubsG = (pubsG.push(pub), pubsG) -%}
  {%- endif -%}
  {%- if pub.typeCode == "A1" or pub.typeCode == "A2" -%}{%- set articleCount = articleCount + 1 -%}{%- endif -%}
  {%- if pub.typeCode == "A3" or pub.typeCode == "A4" or pub.typeCode == "B3" -%}{%- set confCount = confCount + 1 -%}{%- endif -%}
  {%- if pub.typeCode == "C1" or pub.typeCode == "C2" or pub.typeCode == "G4" or pub.typeCode == "G5" -%}{%- set bookCount = bookCount + 1 -%}{%- endif -%}
  {%- if pub.peerReviewed -%}{%- set peerReviewedCount = peerReviewedCount + 1 -%}{%- endif -%}
  {%- if pub.openAccess -%}{%- set openAccessCount = openAccessCount + 1 -%}{%- endif -%}
{%- endfor -%}

<section class="publications-hero py-4 py-lg-5">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <p class="text-uppercase small text-muted mb-2">Julkaisut</p>
        <h1 class="display-6 fw-bold mb-2">Julkaisuluettelo</h1>
        <p class="text-muted mb-3">Tällä sivulla on Jari Larun tieteellisten ja ammatillisten julkaisujen kokonaisluettelo. Aineisto päivittyy automaattisesti <a href="https://research.fi/en/results/person/0000-0003-0347-0182" target="_blank" rel="noopener noreferrer">Research.fi-profiilista</a>, ja se on ryhmitelty OKM:n julkaisutyyppiluokituksen (A–G) mukaisesti.</p>
      </div>
      <div class="col-lg-4">
        <div class="publications-hero-aside">
          <p class="publications-hero-kicker mb-2">Näin luettelo on ryhmitelty</p>
          <ul class="publications-hero-list mb-0">
            <li><strong>Vertaisarvioidut</strong> julkaisut (A ja C1): asiantuntijoiden arvioimat lehtiartikkelit, konferenssijulkaisut ja tieteelliset kirjat.</li>
            <li><strong>Ammatilliset</strong> julkaisut (B ja D): opetusalan lehdet ja artikkelit, jotka eivät kulje vertaisarvioinnin läpi.</li>
            <li><strong>Yleistajuiset</strong> julkaisut (E) ja muut (G): laajemmalle yleisölle suunnatut tekstit.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="publication-kpi-section">
  <div class="site-shell">
    <div class="row g-3">
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("julkaisua", canonicalPublications.length, { tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("vertaisarvioitua julkaisua", peerReviewedCount, { tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("viittausta", "…", { id: "dynamicTotalCitations", title: "Lähde: " ~ semanticscholar.metrics.sources, tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("h-indeksi", "…", { id: "dynamicHIndex", title: "Lähde: " ~ semanticscholar.metrics.sources, tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
    </div>
    <p class="publication-kpi-note text-muted mb-0 mt-3">{{ openAccessCount }} julkaisua on merkitty avoimesti saataviksi, {{ articleCount }} kuuluu lehtiartikkeleihin ja {{ confCount }} konferenssiaineistoon.</p>
  </div>
</section>



