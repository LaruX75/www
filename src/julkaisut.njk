---
layout: base.njk
title: Julkaisuluettelo
metaTitle: Julkaisuluettelo
description: "Jari Larun tieteellisten ja ammatillisten julkaisujen kokonaisluettelo Research.fi-profiilista. Ryhmiteltynä OKM:n julkaisutyyppiluokituksen (A–G) mukaisesti."
permalink: /julkaisut/
translationKey: publications_index
pageStyles:
  - /css/publications-page.css
pageScripts:
  - /js/pe-list-render.js
schemaType: CollectionPage
---
{% import "ui.njk" as ui %}

{%- set articleCount = 0 -%}
{%- set confCount = 0 -%}
{%- set bookCount = 0 -%}
{%- set peerReviewedCount = 0 -%}
{%- set openAccessCount = 0 -%}
{%- set pubsA = [] -%}
{%- set pubsB = [] -%}
{%- set pubsC = [] -%}
{%- set pubsD = [] -%}
{%- set pubsE = [] -%}
{%- set pubsG = [] -%}
{%- for pub in researchfi -%}
  {%- set typeChar = pub.typeCode | first -%}
  {%- if typeChar == "A" -%}{%- set pubsA = (pubsA.push(pub), pubsA) -%}
  {%- elif typeChar == "B" -%}{%- set pubsB = (pubsB.push(pub), pubsB) -%}
  {%- elif typeChar == "C" -%}{%- set pubsC = (pubsC.push(pub), pubsC) -%}
  {%- elif typeChar == "D" -%}{%- set pubsD = (pubsD.push(pub), pubsD) -%}
  {%- elif typeChar == "E" -%}{%- set pubsE = (pubsE.push(pub), pubsE) -%}
  {%- elif typeChar == "G" -%}{%- set pubsG = (pubsG.push(pub), pubsG) -%}
  {%- endif -%}
  {%- if pub.typeCode == "A1" or pub.typeCode == "A2" -%}{%- set articleCount = articleCount + 1 -%}{%- endif -%}
  {%- if pub.typeCode == "A3" or pub.typeCode == "A4" or pub.typeCode == "B3" -%}{%- set confCount = confCount + 1 -%}{%- endif -%}
  {%- if pub.typeCode == "C1" or pub.typeCode == "C2" or pub.typeCode == "G4" or pub.typeCode == "G5" -%}{%- set bookCount = bookCount + 1 -%}{%- endif -%}
  {%- if pub.peerReviewed -%}{%- set peerReviewedCount = peerReviewedCount + 1 -%}{%- endif -%}
  {%- if pub.openAccess -%}{%- set openAccessCount = openAccessCount + 1 -%}{%- endif -%}
{%- endfor -%}
{%- for item in collections.publications -%}
  {%- if item.data.publicationType -%}
    {%- set typeChar = item.data.publicationType | first -%}
    {%- set manualPub = [item] | toManualPub -%}
    {%- if typeChar == "A" -%}{%- set pubsA = (pubsA.push(manualPub), pubsA) -%}
    {%- elif typeChar == "B" -%}{%- set pubsB = (pubsB.push(manualPub), pubsB) -%}
    {%- elif typeChar == "C" -%}{%- set pubsC = (pubsC.push(manualPub), pubsC) -%}
    {%- elif typeChar == "D" -%}{%- set pubsD = (pubsD.push(manualPub), pubsD) -%}
    {%- elif typeChar == "E" -%}{%- set pubsE = (pubsE.push(manualPub), pubsE) -%}
    {%- elif typeChar == "G" -%}{%- set pubsG = (pubsG.push(manualPub), pubsG) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- set researchPublicationMeta = researchProgram.publicationMetaByAnchor or {} -%}

<section class="publications-hero py-4 py-lg-5">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <p class="text-uppercase small text-muted mb-2">Julkaisut</p>
        <h1 class="display-6 fw-bold mb-2">Julkaisuluettelo</h1>
        <p class="text-muted mb-3">Tällä sivulla on Jari Larun tieteellisten ja ammatillisten julkaisujen kokonaisluettelo. Aineisto päivittyy automaattisesti <a href="https://research.fi/en/results/person/0000-0003-0347-0182" target="_blank" rel="noopener noreferrer">Research.fi-profiilista</a>, ja se on ryhmitelty OKM:n julkaisutyyppiluokituksen (A–G) mukaisesti.</p>
      </div>
      <div class="col-lg-4">
        <div class="publications-hero-aside">
          <p class="publications-hero-kicker mb-2">Näin luettelo on ryhmitelty</p>
          <ul class="publications-hero-list mb-0">
            <li><strong>Vertaisarvioidut</strong> julkaisut (A ja C1): asiantuntijoiden arvioimat lehtiartikkelit, konferenssijulkaisut ja tieteelliset kirjat.</li>
            <li><strong>Ammatilliset</strong> julkaisut (B ja D): opetusalan lehdet ja artikkelit, jotka eivät kulje vertaisarvioinnin läpi.</li>
            <li><strong>Yleistajuiset</strong> julkaisut (E) ja muut (G): laajemmalle yleisölle suunnatut tekstit.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="publication-kpi-section">
  <div class="site-shell">
    <div class="row g-3">
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("julkaisua", researchfi.length, { tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("vertaisarvioitua julkaisua", peerReviewedCount, { tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("viittausta", "…", { id: "dynamicTotalCitations", title: "Lähde: " ~ semanticscholar.metrics.sources, tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
      <div class="col-6 col-xl-3">
        {{ ui.kpiCard("h-indeksi", "…", { id: "dynamicHIndex", title: "Lähde: " ~ semanticscholar.metrics.sources, tone: "julkaisut", extraClass: "publication-kpi-card" }) }}
      </div>
    </div>
    <p class="publication-kpi-note text-muted mb-0 mt-3">{{ openAccessCount }} julkaisua on merkitty avoimesti saataviksi, {{ articleCount }} kuuluu lehtiartikkeleihin ja {{ confCount }} konferenssiaineistoon.</p>
  </div>
</section>



<!-- KAAVION SUURENNOS -MODAL -->
<div class="modal fade" id="chartZoomModal" tabindex="-1" aria-labelledby="chartZoomModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title h6" id="chartZoomModalLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sulje"></button>
      </div>
      <div class="modal-body">
        <div style="position:relative; height:500px;">
          <canvas id="zoomCanvas"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ANALYTIIKKA-DASHBOARD -->
<section id="analyticsPanel" class="py-4 bg-body-tertiary">
  <div class="site-shell">
    <div class="card border-0 shadow-sm publication-analytics-card">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div>
            <p class="text-uppercase small text-muted mb-1">Tilastografiikka</p>
            <h2 class="h4 mb-1">Vaikuttavuus, yhteistyö ja aihepiirit</h2>
            <p class="text-muted mb-0">Kaaviot kokoavat julkaisut vuosittain, julkaisutyypeittäin sekä viittausten, kanssatutkijoiden ja otsikkoavainsanojen näkökulmista.</p>
          </div>
          <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#analyticsDashboard"
                  aria-expanded="false"
                  aria-controls="analyticsDashboard">
            <span>Näytä analytiikka</span>
            <i class="bi bi-chevron-down analytics-chevron"></i>
          </button>
        </div>

        <div class="collapse mt-4" id="analyticsDashboard">
        <div class="row g-4">

      <!-- Julkaisut vuosittain -->
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h2 class="h6 text-uppercase text-muted fw-bold mb-0" id="yearChartHeading"><i class="bi bi-bar-chart-fill me-2"></i>Julkaisut & viittaukset vuosittain</h2>
              <button class="btn btn-sm btn-link p-0 chart-zoom-btn" data-zoom-target="yearChart" data-zoom-title="Julkaisut & viittaukset vuosittain" title="Suurenna"><i class="bi bi-fullscreen"></i></button>
            </div>
            <div style="position:relative; flex:1; min-height:160px;">
              <canvas id="yearChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- Julkaisutyypit -->
      <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h2 class="h6 text-uppercase text-muted fw-bold mb-0"><i class="bi bi-pie-chart-fill me-2"></i>Julkaisutyypit</h2>
              <button class="btn btn-sm btn-link p-0 chart-zoom-btn" data-zoom-target="typeChart" data-zoom-title="Julkaisutyypit" title="Suurenna"><i class="bi bi-fullscreen"></i></button>
            </div>
            <div style="position:relative; flex:1; min-height:160px;">
              <canvas id="typeChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- Open Access & Vertaisarvioitu -->
      <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h2 class="h6 text-uppercase text-muted fw-bold mb-0"><i class="bi bi-unlock-fill me-2"></i>Laatuindikaattorit</h2>
              <button class="btn btn-sm btn-link p-0 chart-zoom-btn" data-zoom-target="qualityChart" data-zoom-title="Laatuindikaattorit" title="Suurenna"><i class="bi bi-fullscreen"></i></button>
            </div>
            <div style="position:relative; flex:1; min-height:160px;">
              <canvas id="qualityChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- Yhteistyöverkosto -->
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100" id="coauthorCard">
          <div class="card-body">
            <h2 class="h6 text-uppercase text-muted fw-bold mb-3"><i class="bi bi-people-fill me-2"></i>Top 10 kanssakirjoittajaa</h2>
            <div id="coauthorFilterStatus" class="small mb-2 visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
            <div class="coauthor-table-wrap" id="coauthorTableWrap">
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0 pub-table" id="coauthorTable" data-no-header-filters>
                  <thead><tr><th>Tutkija</th><th class="text-end">Yhteisjulkaisut</th></tr></thead>
                  <tbody></tbody>
                </table>
              </div>
              <div class="coauthor-fade-overlay" id="coauthorFadeOverlay">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                  <i class="bi bi-chevron-down me-1"></i>Näytä kaikki
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Aihepiirijakauma -->
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h2 class="h6 text-uppercase text-muted fw-bold mb-3"><i class="bi bi-tags-fill me-2"></i>Avainsanat (otsikoista)</h2>
            <div id="wordCloud" class="d-flex flex-wrap gap-2 align-items-center"></div>
          </div>
        </div>
      </div>

        </div>
        </div>{# /collapse #}
      </div>
    </div>
  </div>
</section>

<!-- AVAINSANASUODATTIMEN STATUSBANNERI -->
<div id="keyword-filter-bar" class="site-shell pb-0 pt-2 d-none">
  <div class="alert alert-info py-2 d-flex align-items-center gap-2 mb-0">
    <i class="bi bi-tag-fill me-1"></i>
    Avainsanasuodatin: <strong id="active-keyword-label"></strong>
    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto py-0 px-2" id="clear-keyword-filter">
      <i class="bi bi-x-circle me-1"></i>Poista suodatin
    </button>
  </div>
</div>

<!-- VÄITÖSKIRJA-NOSTO -->
<!-- JULKAISULISTA -->
<section id="julkaisuluokat" class="py-5">
  <div class="site-shell">
    <div class="card border-0 shadow-sm publication-nav-card mb-4">
      <div class="card-body">
        <p class="text-uppercase small text-muted mb-1">Julkaisuluokat</p>
        <h2 class="h3 mb-1">Selaa koko julkaisuarkistoa ryhmittäin</h2>
        <p class="text-muted mb-3">Alla julkaisut on jaettu tutkimusjulkaisuihin, ammatillisiin teksteihin, suurelle yleisölle suunnattuihin kirjoituksiin sekä opinnäytteisiin. Jokaisessa osiossa on oma suodatus.</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="#card-pub-table-a" class="btn btn-outline-secondary btn-sm rounded-pill">A-luokka <span class="ms-1 text-muted">{{ pubsA.length }}</span></a>
          <a href="#card-pub-table-b" class="btn btn-outline-secondary btn-sm rounded-pill">B-luokka <span class="ms-1 text-muted">{{ pubsB.length }}</span></a>
          <a href="#card-pub-table-c" class="btn btn-outline-secondary btn-sm rounded-pill">C-luokka <span class="ms-1 text-muted">{{ pubsC.length }}</span></a>
          <a href="#card-pub-table-d" class="btn btn-outline-secondary btn-sm rounded-pill">D-luokka <span class="ms-1 text-muted">{{ pubsD.length }}</span></a>
          <a href="#card-pub-table-e" class="btn btn-outline-secondary btn-sm rounded-pill">E-luokka <span class="ms-1 text-muted">{{ pubsE.length }}</span></a>
          <a href="#card-pub-table-g" class="btn btn-outline-secondary btn-sm rounded-pill">G-luokka <span class="ms-1 text-muted">{{ pubsG.length }}</span></a>
        </div>
      </div>
    </div>

    {% if researchfi.length %}

      {# Macros for reuse #}
      {% macro drawTable(groupCode, title, allItems, tableId, subtypes) %}
      {# Progressive enhancement: SSR renderoi 15 uusinta per OKM-luokka.
         JS (alempana) fetch:aa julkaisudatan ja korvaa tbody:jen sisallon
         KAIKILLA julkaisuilla ennen suodatuksen aktivointia. #}
      {% set items = allItems | take(15) %}
      {% if allItems.length %}
      <div class="card shadow-sm mb-5 section-card" id="card-{{ tableId }}">
        <div class="card-header bg-transparent py-3 publication-section-header">
          <div class="d-flex align-items-start justify-content-between">
            <div>
              <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <span class="publication-group-code">{{ groupCode }}</span>
                <h3 class="h5 mb-0">{{ title }}</h3>
              </div>
              {% if subtypes and subtypes.length %}
              <div class="mt-1 d-flex flex-wrap">
                {% for st in subtypes %}
                  {% if (items | selectattr("typeCode", "equalto", st.code) | list).length %}
                  <span class="me-3 mt-1" style="font-size:0.78rem; color: var(--bs-secondary-color);">
                    <strong style="font-size:0.76rem;">{{ st.code }}</strong>&nbsp;{{ st.desc }}
                  </span>
                  {% endif %}
                {% endfor %}
              </div>
              {% endif %}
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-3 mt-1">
              <span class="publication-filter-indicator badge border border-info text-info d-none" data-filter-indicator="{{ tableId }}"></span>
              <span class="badge publication-section-count">{{ allItems.length }}</span>
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="p-3 border-bottom publication-filter-bar">
            <div class="row g-2 align-items-end">
              <div class="col-md-9">
                <label for="search-{{ tableId }}" class="form-label small text-muted mb-1">Suodata</label>
                <input type="search" id="search-{{ tableId }}" class="form-control form-control-sm" placeholder="Hae otsikosta, tekijästä tai julkaisusta..." autocomplete="off" data-pub-search="{{ tableId }}">
              </div>
            </div>
          </div>
          <div id="{{ tableId }}">
            {# ── Desktop: taulukko (piilotetaan mobiilissa) ── #}
            <div class="d-none d-md-block">
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0 pub-table">
                  <thead>
                    <tr>
                      <th class="text-center" style="width:125px" data-filter-skip="true">
                        <div class="table-header-filter-wrap">
                          <div class="table-header-filter-label">Vuosi</div>
                          <div class="table-header-filter-controls">
                            <label class="visually-hidden" for="publication-year-select-{{ tableId }}">Rajaa julkaisuvuodella</label>
                            <select class="form-select form-select-sm table-header-sort-select" id="publication-year-select-{{ tableId }}" data-publication-year-select>
                              <option value="">Kaikki vuodet</option>
                            </select>
                            <button type="button" class="table-header-sort-button" data-publication-sort="year" title="Lajittele julkaisuvuoden mukaan" aria-label="Lajittele julkaisuvuoden mukaan">
                              <i class="bi bi-arrow-down-up" aria-hidden="true"></i>
                            </button>
                          </div>
                        </div>
                      </th>
                      <th style="width:150px" data-filter-skip="true">
                        <div class="table-header-filter-wrap">
                          <div class="table-header-filter-label">Luokka</div>
                          <div class="table-header-filter-controls">
                            <label class="visually-hidden" for="publication-type-select-{{ tableId }}">Rajaa julkaisuluokalla</label>
                            <select class="form-select form-select-sm table-header-sort-select" id="publication-type-select-{{ tableId }}" data-publication-type-select>
                              <option value="">Kaikki julkaisuluokat</option>
                            </select>
                            <button type="button" class="table-header-sort-button" data-publication-sort="type" title="Lajittele julkaisuluokan mukaan" aria-label="Lajittele julkaisuluokan mukaan">
                              <i class="bi bi-arrow-down-up" aria-hidden="true"></i>
                            </button>
                          </div>
                        </div>
                      </th>
                      <th>Otsikko & Julkaisu</th>
                      <th style="width:200px" data-filter-skip="true">
                        <div class="table-header-filter-wrap">
                          <div class="table-header-filter-label">Tekijä(t)</div>
                          <div class="table-header-filter-controls">
                            <label class="visually-hidden" for="coauthor-select-{{ tableId }}">Rajaa kanssakirjoittajalla</label>
                            <select class="form-select form-select-sm table-header-sort-select" id="coauthor-select-{{ tableId }}" data-coauthor-select>
                              <option value="">Kaikki kanssakirjoittajat</option>
                            </select>
                            <button type="button" class="table-header-sort-button" data-publication-sort="authors" title="Lajittele tekijän mukaan" aria-label="Lajittele tekijän mukaan">
                              <i class="bi bi-arrow-down-up" aria-hidden="true"></i>
                            </button>
                          </div>
                        </div>
                      </th>
                      <th style="width:100px" class="text-center" data-filter-skip="true">
                        <div class="table-header-filter-wrap">
                          <div class="table-header-filter-label">Avaa</div>
                        </div>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for pub in items %}
                    {% set researchMeta = researchPublicationMeta[pub.anchorId] or {} %}
                    <tr{% if pub.anchorId %} id="{{ pub.anchorId }}"{% endif %} data-authors="{{ pub.authors | escape }}" data-publication-year="{{ pub.year or '' }}" data-publication-type="{{ pub.typeCode or '' }}" data-publication-type-label="{{ pub.typeFi | escape }}" data-research-line="{{ researchMeta.researchLine or '' }}" data-research-themes="{{ (researchMeta.researchThemes or []) | join('|') }}" data-research-audiences="{{ (researchMeta.researchAudience or []) | join('|') }}">
                      <td class="text-center font-monospace small fw-bold publication-year">{{ pub.year or '—' }}</td>
                      <td><span class="badge bg-secondary" title="{{ pub.typeFi }}">{{ pub.typeShort }}</span></td>
                      <td>
                        <span class="fw-medium d-block mb-1">{{ pub.title }}</span>
                        {% if pub.journal %}
                          <span class="text-muted small fst-italic">{{ pub.journal }}</span>{% if pub.volume %}<span class="text-muted small">, <strong>{{ pub.volume }}</strong>{% if pub.issue %}({{ pub.issue }}){% endif %}</span>{% endif %}{% if pub.pages %}<span class="text-muted small">, s.&nbsp;{{ pub.pages }}</span>{% endif %}{% if pub.isbn %}<span class="text-muted small"> — ISBN {{ pub.isbn }}</span>{% endif %}
                        {% elif pub.publisher %}
                          <span class="text-muted small fst-italic">{{ pub.publisher }}{% if pub.isbn %} — ISBN {{ pub.isbn }}{% endif %}</span>
                        {% endif %}
                        {% set citationCount = (semanticscholar.metrics.doiCitations[pub.doi | lower] if pub.doi and semanticscholar.metrics.doiCitations[pub.doi | lower] else 0) %}
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                          {% if pub.jufoLevel != null and pub.jufoLevel != undefined %}
                            {% if pub.jufoLevel == "3" %}
                              <span class="badge rounded-pill publication-jufo publication-jufo--3" title="Julkaisufoorumi-taso 3 – johtava taso">JUFO 3</span>
                            {% elif pub.jufoLevel == "2" %}
                              <span class="badge rounded-pill publication-jufo publication-jufo--2" title="Julkaisufoorumi-taso 2 – korkea taso">JUFO 2</span>
                            {% elif pub.jufoLevel == "1" %}
                              <span class="badge rounded-pill publication-jufo publication-jufo--1" title="Julkaisufoorumi-taso 1 – perustaso">JUFO 1</span>
                            {% else %}
                              <span class="badge rounded-pill publication-jufo publication-jufo--0" title="Julkaisufoorumi-taso 0 – ei luokiteltu">JUFO 0</span>
                            {% endif %}
                          {% endif %}
                          <span class="badge publication-citation-badge rounded-pill" title="Viittaukset">
                            <i class="bi bi-quote me-1"></i>{{ citationCount }} {{ "viite" if citationCount == 1 else "viittausta" }}
                          </span>
                          <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary rounded-pill export-citation-btn"
                            data-title="{{ pub.title | escape }}"
                            data-authors="{{ pub.authors | escape }}"
                            data-year="{{ pub.year or '' }}"
                            data-journal="{{ pub.journal | escape }}"
                            data-doi="{{ pub.doi or '' }}"
                            data-url="{{ pub.url or pub.doiUrl or '' }}"
                            data-volume="{{ pub.volume or '' }}"
                            data-issue="{{ pub.issue or '' }}"
                            data-pages="{{ pub.pages or '' }}"
                            data-publisher="{{ pub.publisher or '' }}"
                            data-isbn="{{ pub.isbn or '' }}"
                            title="Vie lähdeviite"
                          >
                            <i class="bi bi-download me-1"></i>Vie viite
                          </button>
                        </div>
                      </td>
                      <td class="text-body-secondary small">{{ pub.authors }}</td>
                      <td class="text-center">
                        {% if pub.url %}
                          <a href="{{ pub.url }}" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" rel="noopener noreferrer" title="Avaa julkaisu" aria-label="Avaa julkaisu uuteen välilehteen"><i class="bi bi-box-arrow-up-right"></i></a>
                        {% elif pub.doiUrl %}
                          <a href="{{ pub.doiUrl }}" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" rel="noopener noreferrer" title="Avaa DOI" aria-label="Avaa DOI uuteen välilehteen"><i class="bi bi-box-arrow-up-right"></i></a>
                        {% endif %}
                      </td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>

            {# ── Mobiilinäkymä: kompakti korttilista (piilotetaan desktopissa) ── #}
            <ul class="list-unstyled mb-0 d-md-none pub-mobile-list" role="list">
              {% for pub in items %}
              {% set researchMeta = researchPublicationMeta[pub.anchorId] or {} %}
              {% set citationCount = (semanticscholar.metrics.doiCitations[pub.doi | lower] if pub.doi and semanticscholar.metrics.doiCitations[pub.doi | lower] else 0) %}
              <li{% if pub.anchorId %} id="{{ pub.anchorId }}-mobile"{% endif %} class="pub-mobile-item px-3 py-3 border-bottom" data-authors="{{ pub.authors | escape }}" data-publication-year="{{ pub.year or '' }}" data-publication-type="{{ pub.typeCode or '' }}" data-publication-type-label="{{ pub.typeFi | escape }}" data-research-line="{{ researchMeta.researchLine or '' }}" data-research-themes="{{ (researchMeta.researchThemes or []) | join('|') }}" data-research-audiences="{{ (researchMeta.researchAudience or []) | join('|') }}" role="listitem">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="font-monospace small fw-bold publication-year">{{ pub.year or '—' }}</span>
                  <span class="badge bg-secondary" title="{{ pub.typeFi }}">{{ pub.typeShort }}</span>
                  {% if pub.jufoLevel != null and pub.jufoLevel != undefined %}
                    {% if pub.jufoLevel == "3" %}
                      <span class="badge rounded-pill publication-jufo publication-jufo--3">JUFO 3</span>
                    {% elif pub.jufoLevel == "2" %}
                      <span class="badge rounded-pill publication-jufo publication-jufo--2">JUFO 2</span>
                    {% elif pub.jufoLevel == "1" %}
                      <span class="badge rounded-pill publication-jufo publication-jufo--1">JUFO 1</span>
                    {% else %}
                      <span class="badge rounded-pill publication-jufo publication-jufo--0">JUFO 0</span>
                    {% endif %}
                  {% endif %}
                </div>
                <p class="fw-medium mb-1 lh-sm">
                  {% if pub.url %}
                    <a href="{{ pub.url }}" target="_blank" rel="noopener noreferrer" class="text-body text-decoration-none">{{ pub.title }}</a>
                  {% elif pub.doiUrl %}
                    <a href="{{ pub.doiUrl }}" target="_blank" rel="noopener noreferrer" class="text-body text-decoration-none">{{ pub.title }}</a>
                  {% else %}
                    {{ pub.title }}
                  {% endif %}
                </p>
                <p class="small text-body-secondary mb-1">{{ pub.authors }}</p>
                {% if pub.journal %}
                  <p class="small text-muted fst-italic mb-1">{{ pub.journal }}{% if pub.volume %}, <strong>{{ pub.volume }}</strong>{% if pub.issue %}({{ pub.issue }}){% endif %}{% endif %}{% if pub.pages %}, s.&nbsp;{{ pub.pages }}{% endif %}{% if pub.isbn %} — ISBN {{ pub.isbn }}{% endif %}</p>
                {% elif pub.publisher %}
                  <p class="small text-muted fst-italic mb-1">{{ pub.publisher }}{% if pub.isbn %} — ISBN {{ pub.isbn }}{% endif %}</p>
                {% endif %}
                <div class="d-flex gap-2 flex-wrap align-items-center mt-1">
                  <span class="badge publication-citation-badge rounded-pill" title="Viittaukset">
                    <i class="bi bi-quote me-1"></i>{{ citationCount }} {{ "viite" if citationCount == 1 else "viittausta" }}
                  </span>
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary rounded-pill export-citation-btn"
                    data-title="{{ pub.title | escape }}"
                    data-authors="{{ pub.authors | escape }}"
                    data-year="{{ pub.year or '' }}"
                    data-journal="{{ pub.journal | escape }}"
                    data-doi="{{ pub.doi or '' }}"
                    data-url="{{ pub.url or pub.doiUrl or '' }}"
                    data-volume="{{ pub.volume or '' }}"
                    data-issue="{{ pub.issue or '' }}"
                    data-pages="{{ pub.pages or '' }}"
                    data-publisher="{{ pub.publisher or '' }}"
                    data-isbn="{{ pub.isbn or '' }}"
                    title="Vie lähdeviite"
                  ><i class="bi bi-download me-1"></i>Vie viite</button>
                  {% if pub.url %}
                    <a href="{{ pub.url }}" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill" rel="noopener noreferrer" aria-label="Avaa julkaisu uuteen välilehteen"><i class="bi bi-box-arrow-up-right me-1"></i>Avaa</a>
                  {% elif pub.doiUrl %}
                    <a href="{{ pub.doiUrl }}" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill" rel="noopener noreferrer" aria-label="Avaa DOI uuteen välilehteen"><i class="bi bi-box-arrow-up-right me-1"></i>Avaa</a>
                  {% endif %}
                </div>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {% endif %}
      {% endmacro %}

      {% set subtypesA = [
        {code: 'A1', desc: 'Alkuperäisartikkeli tieteellisessä aikakauslehdessä'},
        {code: 'A2', desc: 'Katsausartikkeli tieteellisessä aikakauslehdessä'},
        {code: 'A3', desc: 'Kirjan tai muun kokoomateoksen osa'},
        {code: 'A4', desc: 'Artikkeli konferenssijulkaisussa'}
      ] %}
      {% set subtypesB = [
        {code: 'B1', desc: 'Kirjoitus tieteellisessä aikakauslehdessä'},
        {code: 'B2', desc: 'Kirjan tai muun kokoomateoksen osa'},
        {code: 'B3', desc: 'Vertaisarvioimaton artikkeli konferenssijulkaisussa'}
      ] %}
      {% set subtypesC = [
        {code: 'C1', desc: 'Kustannettu tieteellinen erillisteos'},
        {code: 'C2', desc: 'Toimitettu kirja, kokoomateos, konferenssijulkaisu tai lehden erikoisnumero'}
      ] %}
      {% set subtypesD = [
        {code: 'D1', desc: 'Artikkeli ammattilehdessä'},
        {code: 'D2', desc: 'Artikkeli ammatillisessa kokoomateoksessa'},
        {code: 'D3', desc: 'Artikkeli ammatillisessa konferenssijulkaisussa'}
      ] %}
      {% set subtypesE = [
        {code: 'E1', desc: 'Yleistajuinen artikkeli, sanomalehtiartikkeli'},
        {code: 'E2', desc: 'Yleistajuinen monografia'}
      ] %}
      {% set subtypesG = [
        {code: 'G4', desc: 'Väitöskirja (artikkeli)'},
        {code: 'G5', desc: 'Väitöskirja (monografia)'}
      ] %}

      {{ drawTable('A', 'Vertaisarvioidut tieteelliset artikkelit', pubsA, 'pub-table-a', subtypesA) }}
      {{ drawTable('B', 'Vertaisarvioimattomat tieteelliset kirjoitukset', pubsB, 'pub-table-b', subtypesB) }}
      {{ drawTable('C', 'Tieteelliset kirjat', pubsC, 'pub-table-c', subtypesC) }}
      {{ drawTable('D', 'Ammattiyhteisölle suunnatut julkaisut', pubsD, 'pub-table-d', subtypesD) }}
      {{ drawTable('E', 'Suurelle yleisölle suunnatut julkaisut', pubsE, 'pub-table-e', subtypesE) }}
      {{ drawTable('G', 'Opinnäytteet', pubsG, 'pub-table-g', subtypesG) }}
      
    {% else %}
      <div class="alert alert-warning">Ei julkaisuja saatavilla.</div>
    {% endif %}
  </div>
</section>

