<script>
// Progressive enhancement: hydratoi OKM-luokkien tbody + mobiili-lista
// KAIKILLA researchfi-julkaisuilla ennen kuin suodattimet aktivoituvat.
// SSR renderoi 15 uusinta per luokka (avausjoukko ilman JS:aa).
window.publicationsHydration = (async () => {
  if (!window.PE || typeof window.PE.loadJsonEndpoint !== 'function') return null;
  const data = await window.PE.loadJsonEndpoint('/data/researchfi.json', { items: [] });
  const items = Array.isArray(data.items) ? data.items : [];
  if (!items.length) return items;

  const esc = window.PE.escHtml;
  const groups = { A: [], B: [], C: [], D: [], E: [], G: [] };
  items.forEach((p) => {
    const g = String(p.typeCode || '').charAt(0).toUpperCase();
    if (groups[g]) groups[g].push(p);
  });
  Object.values(groups).forEach((arr) => arr.sort((a, b) => {
    const ya = a.year || 0, yb = b.year || 0;
    if (yb !== ya) return yb - ya;
    return String(a.title).localeCompare(String(b.title));
  }));

  function jufoBadge(level) {
    if (level == null) return '';
    const s = String(level);
    const cls = s === '3' ? '3' : s === '2' ? '2' : s === '1' ? '1' : '0';
    const title = cls === '3' ? 'Julkaisufoorumi-taso 3 – johtava taso'
      : cls === '2' ? 'Julkaisufoorumi-taso 2 – korkea taso'
      : cls === '1' ? 'Julkaisufoorumi-taso 1 – perustaso'
      : 'Julkaisufoorumi-taso 0 – ei luokiteltu';
    return `<span class="badge rounded-pill publication-jufo publication-jufo--${cls}" title="${esc(title)}">JUFO ${cls}</span>`;
  }
  function citationBadge(count) {
    const label = count === 1 ? 'viite' : 'viittausta';
    return `<span class="badge publication-citation-badge rounded-pill" title="Viittaukset"><i class="bi bi-quote me-1"></i>${count} ${label}</span>`;
  }
  function exportBtn(pub) {
    return `<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill export-citation-btn"`
      + ` data-title="${esc(pub.title)}" data-authors="${esc(pub.authors || '')}" data-year="${esc(pub.year || '')}"`
      + ` data-journal="${esc(pub.journal || '')}" data-doi="${esc(pub.doi || '')}"`
      + ` data-url="${esc(pub.url || pub.doiUrl || '')}" data-volume="${esc(pub.volume || '')}"`
      + ` data-issue="${esc(pub.issue || '')}" data-pages="${esc(pub.pages || '')}"`
      + ` data-publisher="${esc(pub.publisher || '')}" data-isbn="${esc(pub.isbn || '')}"`
      + ` title="Vie lähdeviite"><i class="bi bi-download me-1"></i>Vie viite</button>`;
  }
  function meta(pub) {
    if (pub.journal) {
      let s = `<span class="text-muted small fst-italic">${esc(pub.journal)}</span>`;
      if (pub.volume) {
        s += `<span class="text-muted small">, <strong>${esc(pub.volume)}</strong>`;
        if (pub.issue) s += `(${esc(pub.issue)})`;
        s += `</span>`;
      }
      if (pub.pages) s += `<span class="text-muted small">, s.&nbsp;${esc(pub.pages)}</span>`;
      if (pub.isbn) s += `<span class="text-muted small"> — ISBN ${esc(pub.isbn)}</span>`;
      return s;
    }
    if (pub.publisher) {
      let s = `<span class="text-muted small fst-italic">${esc(pub.publisher)}`;
      if (pub.isbn) s += ` — ISBN ${esc(pub.isbn)}`;
      return s + `</span>`;
    }
    return '';
  }
  function openLink(pub, mobile) {
    const cls = mobile ? 'btn btn-sm btn-outline-primary rounded-pill' : 'btn btn-sm btn-outline-primary py-0 px-2 rounded-pill';
    if (pub.url) {
      return `<a href="${esc(pub.url)}" target="_blank" class="${cls}" rel="noopener noreferrer" title="Avaa julkaisu" aria-label="Avaa julkaisu uuteen välilehteen"><i class="bi bi-box-arrow-up-right${mobile ? ' me-1' : ''}"></i>${mobile ? 'Avaa' : ''}</a>`;
    }
    if (pub.doiUrl) {
      return `<a href="${esc(pub.doiUrl)}" target="_blank" class="${cls}" rel="noopener noreferrer" title="Avaa DOI" aria-label="Avaa DOI uuteen välilehteen"><i class="bi bi-box-arrow-up-right${mobile ? ' me-1' : ''}"></i>${mobile ? 'Avaa' : ''}</a>`;
    }
    return '';
  }
  function titleLink(pub) {
    if (pub.url) return `<a href="${esc(pub.url)}" target="_blank" rel="noopener noreferrer" class="text-body text-decoration-none">${esc(pub.title)}</a>`;
    if (pub.doiUrl) return `<a href="${esc(pub.doiUrl)}" target="_blank" rel="noopener noreferrer" class="text-body text-decoration-none">${esc(pub.title)}</a>`;
    return esc(pub.title);
  }
  function dataAttrs(pub, mobile) {
    const themes = Array.isArray(pub.researchThemes) ? pub.researchThemes.join('|') : '';
    const auds = Array.isArray(pub.researchAudience) ? pub.researchAudience.join('|') : '';
    const idAttr = pub.anchorId ? ` id="${esc(pub.anchorId)}${mobile ? '-mobile' : ''}"` : '';
    return idAttr
      + ` data-authors="${esc(pub.authors || '')}"`
      + ` data-publication-year="${esc(pub.year || '')}"`
      + ` data-publication-type="${esc(pub.typeCode || '')}"`
      + ` data-publication-type-label="${esc(pub.type || '')}"`
      + ` data-research-line="${esc(pub.researchLine || '')}"`
      + ` data-research-themes="${esc(themes)}"`
      + ` data-research-audiences="${esc(auds)}"`;
  }
  function renderRow(pub) {
    const cites = pub.citationCount || 0;
    return `<tr${dataAttrs(pub, false)}>`
      + `<td class="text-center font-monospace small fw-bold publication-year">${esc(pub.year || '—')}</td>`
      + `<td><span class="badge bg-secondary" title="${esc(pub.type || '')}">${esc(pub.typeCode || '')}</span></td>`
      + `<td><span class="fw-medium d-block mb-1">${esc(pub.title)}</span>${meta(pub)}`
      + `<div class="d-flex flex-wrap align-items-center gap-2 mt-1">${jufoBadge(pub.jufoLevel)}${citationBadge(cites)}${exportBtn(pub)}</div></td>`
      + `<td class="text-body-secondary small">${esc(pub.authors || '')}</td>`
      + `<td class="text-center">${openLink(pub, false)}</td>`
      + `</tr>`;
  }
  function metaMobile(pub) {
    if (pub.journal) {
      let s = esc(pub.journal);
      if (pub.volume) {
        s += `, <strong>${esc(pub.volume)}</strong>`;
        if (pub.issue) s += `(${esc(pub.issue)})`;
      }
      if (pub.pages) s += `, s.&nbsp;${esc(pub.pages)}`;
      if (pub.isbn) s += ` — ISBN ${esc(pub.isbn)}`;
      return `<p class="small text-muted fst-italic mb-1">${s}</p>`;
    }
    if (pub.publisher) {
      let s = esc(pub.publisher);
      if (pub.isbn) s += ` — ISBN ${esc(pub.isbn)}`;
      return `<p class="small text-muted fst-italic mb-1">${s}</p>`;
    }
    return '';
  }
  function renderMobile(pub) {
    const cites = pub.citationCount || 0;
    return `<li${dataAttrs(pub, true)} class="pub-mobile-item px-3 py-3 border-bottom" role="listitem">`
      + `<div class="d-flex align-items-center gap-2 mb-1"><span class="font-monospace small fw-bold publication-year">${esc(pub.year || '—')}</span>`
      + `<span class="badge bg-secondary" title="${esc(pub.type || '')}">${esc(pub.typeCode || '')}</span>${jufoBadge(pub.jufoLevel)}</div>`
      + `<p class="fw-medium mb-1 lh-sm">${titleLink(pub)}</p>`
      + `<p class="small text-body-secondary mb-1">${esc(pub.authors || '')}</p>`
      + metaMobile(pub)
      + `<div class="d-flex gap-2 flex-wrap align-items-center mt-1">${citationBadge(cites)}${exportBtn(pub)}${openLink(pub, true)}</div>`
      + `</li>`;
  }

  const tableIds = { A: 'pub-table-a', B: 'pub-table-b', C: 'pub-table-c', D: 'pub-table-d', E: 'pub-table-e', G: 'pub-table-g' };
  Object.entries(tableIds).forEach(([g, id]) => {
    const arr = groups[g];
    const tbody = document.querySelector(`#${id} tbody`);
    if (tbody) tbody.innerHTML = arr.map(renderRow).join('');
    const ul = document.querySelector(`#${id} .pub-mobile-list`);
    if (ul) ul.innerHTML = arr.map(renderMobile).join('');
    const badge = document.querySelector(`#card-${id} .publication-section-count`);
    if (badge) badge.textContent = String(arr.length);
  });
  return items;
})().catch((err) => { console.error('[julkaisut] hydration epaonnistui', err); return null; });
</script>

<script>
document.addEventListener('DOMContentLoaded', async function() {
  // Odota progressive enhancement -hydration ennen suodattimien aktivointia
  await (window.publicationsHydration || Promise.resolve(null));
  // Inline data from Eleventy
  const publications = [
    {% for pub in researchfi %}
    { year: {{ pub.year or 0 }}, type: "{{ pub.typeCode }}", authors: "{{ pub.authors | replace('"', '\\"') }}", title: "{{ pub.title | replace('"', '\\"') }}", peerReviewed: {{ "true" if pub.peerReviewed else "false" }}, openAccess: {{ pub.openAccess or 0 }}, doi: "{{ pub.doi or '' }}" },
    {% endfor %}
  ];

  // Semantic Scholar / OpenAlex data
  const s2Citations = {{ semanticscholar.metrics.doiCitations | jsonSafe | safe }};

  // 0. LASKETAAN TODELLISET METRIIKAT (vain tällä sivulla olevat julkaisut)
  let verifiedTotalCitations = 0;
  const citationArray = [];
  
  publications.forEach(p => {
    if (p.doi && s2Citations[p.doi.toLowerCase()]) {
      const cites = s2Citations[p.doi.toLowerCase()];
      verifiedTotalCitations += cites;
      citationArray.push(cites);
    }
  });
  
  // Lasketaan todellinen h-indeksi näille julkaisuille
  citationArray.sort((a,b) => b - a);
  let verifiedHIndex = 0;
  for (let i = 0; i < citationArray.length; i++) {
    if (citationArray[i] >= i + 1) {
      verifiedHIndex = i + 1;
    } else {
      break;
    }
  }

  // Päivitetään DOM
  const totalEl = document.getElementById('dynamicTotalCitations');
  if (totalEl) totalEl.textContent = verifiedTotalCitations;

  const hEl = document.getElementById('dynamicHIndex');
  if (hEl) hEl.textContent = verifiedHIndex;

  if (verifiedTotalCitations > 0) {
    const headingEl = document.getElementById('yearChartHeading');
    if (headingEl) {
      headingEl.innerHTML = headingEl.innerHTML + ' <span class="fw-normal text-secondary">(' + verifiedTotalCitations + ' viittausta)</span>';
    }
  }

  const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
  const textColor = isDark ? '#ccc' : '#666';
  const gridColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.08)';

  Chart.defaults.color = textColor;
  Chart.defaults.borderColor = gridColor;

  // Pagination for pub tables. Mobile publication cards are text-heavy, so use
  // a tighter page size there without changing the desktop archive rhythm.
  const DESKTOP_ITEMS_PER_PAGE = 10;
  const MOBILE_ITEMS_PER_PAGE = 5;
  const publicationPageSizeMq = window.matchMedia('(max-width: 767.98px)');
  const getPublicationPageSize = () => publicationPageSizeMq.matches ? MOBILE_ITEMS_PER_PAGE : DESKTOP_ITEMS_PER_PAGE;
  const urlState = new URL(window.location.href);
  const urlParams = urlState.searchParams;
  const initialCoauthor = (urlParams.get('coauthor') || '').trim();
  const initialKeyword = (urlParams.get('pk') || '').trim();
  const initialPublicationType = (urlParams.get('ptype') || '').trim();
  const initialPublicationYear = (urlParams.get('pyear') || '').trim();
  const [initialSortKey, initialSortDirection] = (urlParams.get('psort') || '').split(':');
  let activeCoauthor = '';
  let activeKeyword = '';
  let activePublicationType = '';
  let activePublicationYear = '';
  let activePublicationSort = ['year', 'type', 'authors'].includes(initialSortKey)
    && ['asc', 'desc'].includes(initialSortDirection)
    ? { key: initialSortKey, direction: initialSortDirection }
    : null;
  const tableFilterRefreshers = [];
  const researchFilterInputs = Array.from(document.querySelectorAll('[data-research-filter]'));
  const publicationYearSelects = Array.from(document.querySelectorAll('[data-publication-year-select]'));
  const publicationTypeSelects = Array.from(document.querySelectorAll('[data-publication-type-select]'));
  const publicationSortButtons = Array.from(document.querySelectorAll('[data-publication-sort]'));
  const researchFilterParams = { line: 'prl', theme: 'prt', audience: 'pra' };

  const getPubSearchKey = (tableId) => `pq_${tableId}`;
  const setFilterParam = (key, value) => {
    if (!value) {
      urlParams.delete(key);
      return;
    }
    urlParams.set(key, String(value).trim());
  };
  const updateFilterUrl = () => {
    const qs = urlParams.toString();
    const next = qs ? `${window.location.pathname}?${qs}${window.location.hash}` : `${window.location.pathname}${window.location.hash}`;
    window.history.replaceState({}, '', next);
  };
  const syncPublicationFiltersToUrl = () => {
    document.querySelectorAll('[data-pub-search]').forEach((input) => {
      setFilterParam(getPubSearchKey(input.dataset.pubSearch), input.value || '');
    });
    researchFilterInputs.forEach((input) => {
      setFilterParam(researchFilterParams[input.dataset.researchFilter], input.value || '');
    });
    setFilterParam('pyear', activePublicationYear);
    setFilterParam('ptype', activePublicationType);
    setFilterParam('psort', activePublicationSort ? `${activePublicationSort.key}:${activePublicationSort.direction}` : '');
    setFilterParam('coauthor', activeCoauthor);
    setFilterParam('pk', activeKeyword);
    updateFilterUrl();
  };
  const applyPublicationFiltersFromUrl = () => {
    document.querySelectorAll('[data-pub-search]').forEach((input) => {
      const key = getPubSearchKey(input.dataset.pubSearch);
      const val = urlParams.get(key);
      if (val) input.value = val;
    });
    researchFilterInputs.forEach((input) => {
      const val = urlParams.get(researchFilterParams[input.dataset.researchFilter]);
      if (val) input.value = val;
    });
  };
  applyPublicationFiltersFromUrl();

  function activeResearchFilterValues() {
    return Object.fromEntries(researchFilterInputs.map((input) => [
      input.dataset.researchFilter,
      input.value
    ]));
  }

  function activeResearchFilterLabels() {
    return researchFilterInputs
      .filter((input) => input.value)
      .map((input) => input.options[input.selectedIndex]?.text || input.value);
  }

  function updateResearchFilterStatus() {
    const labels = activeResearchFilterLabels();
    const status = document.getElementById('research-filter-status');
    const clearButton = document.getElementById('clear-research-filters');
    if (status) {
      status.textContent = labels.length
        ? `Rajaus näyttää vain julkaisut, joille on annettu: ${labels.join(', ')}.`
        : '';
      status.classList.toggle('d-none', !labels.length);
    }
    if (clearButton) clearButton.classList.toggle('d-none', !labels.length);
  }

  function matchesResearchFilters(element) {
    const filters = activeResearchFilterValues();
    const hasValue = (attribute, value) => (
      String(element.dataset[attribute] || '').split('|').includes(value)
    );
    return (!filters.line || element.dataset.researchLine === filters.line)
      && (!filters.theme || hasValue('researchThemes', filters.theme))
      && (!filters.audience || hasValue('researchAudiences', filters.audience));
  }

  function refreshResearchFilters() {
    updateResearchFilterStatus();
    tableFilterRefreshers.forEach((refresh) => refresh());
    syncPublicationFiltersToUrl();
  }

  researchFilterInputs.forEach((input) => input.addEventListener('change', refreshResearchFilters));
  document.getElementById('clear-research-filters')?.addEventListener('click', () => {
    researchFilterInputs.forEach((input) => { input.value = ''; });
    refreshResearchFilters();
  });
  updateResearchFilterStatus();

  function sanitizeFilenamePart(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60) || 'viite';
  }

  function toBibtexAuthors(authors) {
    return String(authors || '')
      .split(';')
      .map((a) => a.trim())
      .filter(Boolean)
      .join(' and ');
  }

  function buildBibtexEntry(payload) {
    const rawAuthors = String(payload.authors || '').trim();
    const authors = toBibtexAuthors(rawAuthors || 'Tuntematon Tekija');
    const year = String(payload.year || '').trim() || 'n.d.';
    const title = String(payload.title || '').trim() || 'Nimeton julkaisu';
    const journal = String(payload.journal || '').trim();
    const doi = String(payload.doi || '').trim();
    const url = String(payload.url || '').trim();
    const volume = String(payload.volume || '').trim();
    const issue = String(payload.issue || '').trim();
    const pages = String(payload.pages || '').trim();
    const publisher = String(payload.publisher || '').trim();
    const isbn = String(payload.isbn || '').trim();
    const firstAuthorToken = (rawAuthors.split(';')[0] || 'tekijä')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '');
    const keyBase = sanitizeFilenamePart(title.split(/\s+/).slice(0, 6).join('-')).replace(/-/g, '');
    const bibKey = `${firstAuthorToken || 'tekijä'}${year}${keyBase || 'julkaisu'}`;

    const lines = [
      `@article{${bibKey},`,
      `  author = {${authors}},`,
      `  title = {${title}},`,
      `  year = {${year}},`
    ];
    if (journal) lines.push(`  journal = {${journal}},`);
    if (volume) lines.push(`  volume = {${volume}},`);
    if (issue) lines.push(`  number = {${issue}},`);
    if (pages) lines.push(`  pages = {${pages}},`);
    if (publisher) lines.push(`  publisher = {${publisher}},`);
    if (isbn) lines.push(`  isbn = {${isbn}},`);
    if (doi) lines.push(`  doi = {${doi}},`);
    if (url) lines.push(`  url = {${url}},`);
    lines.push('}');
    return lines.join('\n');
  }

  function buildApaCitation(payload) {
    const authors = String(payload.authors || '').trim() || 'Tuntematon tekijä';
    const year = String(payload.year || '').trim() || 'n.d.';
    const title = String(payload.title || '').trim() || 'Nimetön julkaisu';
    const journal = String(payload.journal || '').trim();
    const doi = String(payload.doi || '').trim();
    const url = String(payload.url || '').trim();
    const volume = String(payload.volume || '').trim();
    const issue = String(payload.issue || '').trim();
    const pages = String(payload.pages || '').trim();
    let citation = `${authors} (${year}). ${title}.`;
    if (journal) {
      citation += ` ${journal}`;
      if (volume) citation += `, ${volume}${issue ? `(${issue})` : ''}`;
      if (pages) citation += `, ${pages}`;
      citation += '.';
    }
    if (doi) citation += ` https://doi.org/${doi}`;
    else if (url) citation += ` ${url}`;
    return citation.trim();
  }

  function buildMlaCitation(payload) {
    const authors = String(payload.authors || '').trim() || 'Tuntematon tekijä';
    const year = String(payload.year || '').trim() || 'n.d.';
    const title = String(payload.title || '').trim() || 'Nimetön julkaisu';
    const journal = String(payload.journal || '').trim();
    const doi = String(payload.doi || '').trim();
    const url = String(payload.url || '').trim();
    const volume = String(payload.volume || '').trim();
    const issue = String(payload.issue || '').trim();
    const pages = String(payload.pages || '').trim();
    let citation = `${authors}. "${title}."`;
    if (journal) citation += ` ${journal}`;
    if (volume) citation += `, vol. ${volume}`;
    if (issue) citation += `, no. ${issue}`;
    citation += `, ${year}`;
    if (pages) citation += `, pp. ${pages}`;
    citation += '.';
    if (doi) citation += ` doi:${doi}.`;
    else if (url) citation += ` ${url}.`;
    return citation.trim();
  }

  function buildChicagoCitation(payload) {
    const authors = String(payload.authors || '').trim() || 'Tuntematon tekijä';
    const year = String(payload.year || '').trim() || 'n.d.';
    const title = String(payload.title || '').trim() || 'Nimetön julkaisu';
    const journal = String(payload.journal || '').trim();
    const doi = String(payload.doi || '').trim();
    const url = String(payload.url || '').trim();
    const volume = String(payload.volume || '').trim();
    const issue = String(payload.issue || '').trim();
    const pages = String(payload.pages || '').trim();
    let citation = `${authors}. "${title}."`;
    if (journal) citation += ` ${journal}`;
    if (volume) citation += ` ${volume}`;
    if (issue) citation += `, no. ${issue}`;
    citation += ` (${year})`;
    if (pages) citation += `: ${pages}`;
    citation += '.';
    if (doi) citation += ` https://doi.org/${doi}.`;
    else if (url) citation += ` ${url}.`;
    return citation.trim();
  }

  function buildRisEntry(payload) {
    const authors = String(payload.authors || '')
      .split(';')
      .map((a) => a.trim())
      .filter(Boolean);
    const year = String(payload.year || '').trim();
    const title = String(payload.title || '').trim();
    const journal = String(payload.journal || '').trim();
    const doi = String(payload.doi || '').trim();
    const url = String(payload.url || '').trim();
    const lines = ['TY  - JOUR'];
    authors.forEach((author) => lines.push(`AU  - ${author}`));
    if (year) lines.push(`PY  - ${year}`);
    if (title) lines.push(`TI  - ${title}`);
    if (journal) lines.push(`JO  - ${journal}`);
    if (doi) lines.push(`DO  - ${doi}`);
    if (url) lines.push(`UR  - ${url}`);
    lines.push('ER  -');
    return lines.join('\n');
  }

  function downloadTextFile(filename, text) {
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  const citationFormatSelect = document.getElementById('citationFormatSelect');
  const citationOutput = document.getElementById('citationOutput');
  const citationDownloadBtn = document.getElementById('citationDownloadBtn');
  const citationCopyBtn = document.getElementById('citationCopyBtn');
  const citationZoteroBtn = document.getElementById('citationZoteroBtn');
  const citationMendeleyBtn = document.getElementById('citationMendeleyBtn');
  const citationModalEl = document.getElementById('citationExportModal');
  let currentCitationPayload = null;

  function getCitationByFormat(payload, format) {
    if (!payload) return '';
    if (format === 'apa') return buildApaCitation(payload);
    if (format === 'mla') return buildMlaCitation(payload);
    if (format === 'chicago') return buildChicagoCitation(payload);
    return buildBibtexEntry(payload);
  }

  function renderCitationPreview() {
    if (!citationOutput) return;
    const format = citationFormatSelect?.value || 'apa';
    citationOutput.value = getCitationByFormat(currentCitationPayload, format);
  }

  document.querySelectorAll('.export-citation-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCitationPayload = {
        title: btn.dataset.title || '',
        authors: btn.dataset.authors || '',
        year: btn.dataset.year || '',
        journal: btn.dataset.journal || '',
        doi: btn.dataset.doi || '',
        url: btn.dataset.url || '',
        volume: btn.dataset.volume || '',
        issue: btn.dataset.issue || '',
        pages: btn.dataset.pages || '',
        publisher: btn.dataset.publisher || '',
        isbn: btn.dataset.isbn || ''
      };
      if (citationFormatSelect) citationFormatSelect.value = 'apa';
      renderCitationPreview();
      if (window.bootstrap && window.bootstrap.Modal && citationModalEl) {
        window.bootstrap.Modal.getOrCreateInstance(citationModalEl).show();
      }
    });
  });

  if (citationFormatSelect) {
    citationFormatSelect.addEventListener('change', renderCitationPreview);
  }

  if (citationDownloadBtn) {
    citationDownloadBtn.addEventListener('click', () => {
      if (!currentCitationPayload) return;
      const format = citationFormatSelect?.value || 'apa';
      const citation = getCitationByFormat(currentCitationPayload, format);
      const base = sanitizeFilenamePart(currentCitationPayload.title || currentCitationPayload.authors || 'viite');
      const ext = format === 'bibtex' ? 'bib' : 'txt';
      downloadTextFile(`${base}.${ext}`, citation + '\n');
    });
  }

  if (citationCopyBtn) {
    citationCopyBtn.addEventListener('click', async () => {
      if (!citationOutput?.value) return;
      try {
        await navigator.clipboard.writeText(citationOutput.value);
        citationCopyBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Kopioitu';
        setTimeout(() => {
          citationCopyBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Kopioi';
        }, 1400);
      } catch (_) {
        citationOutput.select();
        document.execCommand('copy');
      }
    });
  }

  if (citationZoteroBtn) {
    citationZoteroBtn.addEventListener('click', () => {
      if (!currentCitationPayload) return;
      const base = sanitizeFilenamePart(currentCitationPayload.title || currentCitationPayload.authors || 'viite');
      downloadTextFile(`${base}-zotero.ris`, buildRisEntry(currentCitationPayload) + '\n');
    });
  }

  if (citationMendeleyBtn) {
    citationMendeleyBtn.addEventListener('click', () => {
      if (!currentCitationPayload) return;
      const base = sanitizeFilenamePart(currentCitationPayload.title || currentCitationPayload.authors || 'viite');
      downloadTextFile(`${base}-mendeley.ris`, buildRisEntry(currentCitationPayload) + '\n');
    });
  }

  function setCoauthorFilter(authorName, options = {}) {
    const { toggle = false } = options;
    const nextAuthor = String(authorName || '').trim();
    activeCoauthor = toggle && activeCoauthor === nextAuthor ? '' : nextAuthor;
    tableFilterRefreshers.forEach((refresh) => refresh());

    document.querySelectorAll('[data-coauthor-select]').forEach((select) => {
      select.value = activeCoauthor;
    });

    const statusEl = document.getElementById('coauthorFilterStatus');
    if (!statusEl) return;
    if (activeCoauthor) {
      statusEl.className = 'small mb-2 text-info';
      statusEl.innerHTML = `Rajaus aktiivinen: <strong>${activeCoauthor}</strong> <button type="button" id="clearCoauthorFilter" class="btn btn-sm btn-outline-secondary rounded-pill ms-2 py-0 px-2">Poista rajaus</button>`;
      const clearBtn = document.getElementById('clearCoauthorFilter');
      if (clearBtn) clearBtn.addEventListener('click', () => setCoauthorFilter(''));
    } else {
      statusEl.className = 'small mb-2 visually-hidden';
      statusEl.textContent = 'Rajaus poistettu.';
    }
    syncPublicationFiltersToUrl();
  }

  function publicationTypeLabel() {
    const selected = publicationTypeSelects.find((select) => select.value === activePublicationType);
    return selected?.options[selected.selectedIndex]?.text || activePublicationType;
  }

  function setPublicationTypeFilter(typeCode) {
    activePublicationType = String(typeCode || '').trim();
    publicationTypeSelects.forEach((select) => {
      select.value = activePublicationType;
    });
    tableFilterRefreshers.forEach((refresh) => refresh());
    syncPublicationFiltersToUrl();
  }

  function setPublicationYearFilter(year) {
    activePublicationYear = String(year || '').trim();
    publicationYearSelects.forEach((select) => {
      select.value = activePublicationYear;
    });
    tableFilterRefreshers.forEach((refresh) => refresh());
    syncPublicationFiltersToUrl();
  }

  function updatePublicationSortButtons() {
    publicationSortButtons.forEach((button) => {
      const key = button.dataset.publicationSort;
      const isActive = activePublicationSort?.key === key;
      const direction = isActive ? activePublicationSort.direction : null;
      const icon = button.querySelector('i');
      if (icon) icon.className = `bi ${direction === 'asc' ? 'bi-arrow-up' : direction === 'desc' ? 'bi-arrow-down' : 'bi-arrow-down-up'}`;
      button.classList.toggle('active', isActive);
      const label = key === 'year' ? 'julkaisuvuoden' : key === 'type' ? 'julkaisuluokan' : 'tekijän';
      button.title = direction === 'asc' ? `Lajittelu: ${label} mukaan nousevasti` : direction === 'desc' ? `Lajittelu: ${label} mukaan laskevasti` : `Lajittele ${label} mukaan`;
      button.setAttribute('aria-label', button.title);
    });
  }

  function togglePublicationSort(key) {
    const defaultDirection = key === 'year' ? 'desc' : 'asc';
    activePublicationSort = activePublicationSort?.key === key
      ? { key, direction: activePublicationSort.direction === 'asc' ? 'desc' : 'asc' }
      : { key, direction: defaultDirection };
    updatePublicationSortButtons();
    tableFilterRefreshers.forEach((refresh) => refresh());
    syncPublicationFiltersToUrl();
  }

  function sortPublicationEntries(entries) {
    if (!activePublicationSort) return entries;
    const { key, direction } = activePublicationSort;
    const multiplier = direction === 'asc' ? 1 : -1;
    const collator = new Intl.Collator('fi', { numeric: true, sensitivity: 'base' });
    return [...entries].sort((a, b) => {
      if (key === 'year') {
        const aYear = Number(a.dataset.publicationYear || 0);
        const bYear = Number(b.dataset.publicationYear || 0);
        return multiplier * (aYear - bYear);
      }
      const attribute = key === 'type' ? 'publicationType' : 'authors';
      return multiplier * collator.compare(a.dataset[attribute] || '', b.dataset[attribute] || '');
    });
  }

  publicationSortButtons.forEach((button) => {
    button.addEventListener('click', () => togglePublicationSort(button.dataset.publicationSort));
  });
  updatePublicationSortButtons();

  function initPubPagination(tableId) {
    const tableContainer = document.getElementById(tableId);
    if (!tableContainer) return;

    const table = tableContainer.querySelector('table');
    if (!table) return;

    const tbody = table.querySelector('tbody');
    let rows = Array.from(tbody.querySelectorAll('tr'));
    let mobileItems = Array.from(tableContainer.querySelectorAll('.pub-mobile-item'));

      // 5. Build Pagination UI
    let paginationNav = tableContainer.querySelector('.pub-pagination');
    if (!paginationNav) {
      paginationNav = document.createElement('div');
      const containerId = tableContainer.id || Math.random().toString(36).substring(7);
      paginationNav.className = 'pub-pagination site-pagination-bar site-pagination-bar--bottom mt-3';
      paginationNav.innerHTML = `
        <small class="site-pagination-info text-muted"></small>
        <nav aria-label="Taulukon sivutus ${containerId}">
          <ul class="pagination pagination-sm mb-0 flex-wrap site-pag"></ul>
        </nav>
      `;
      tableContainer.appendChild(paginationNav);
    }

    const ul = paginationNav.querySelector('ul');
    const paginationInfo = paginationNav.querySelector('.site-pagination-info');
    const filterIndicator = document.querySelector(`[data-filter-indicator="${tableId}"]`);
    let currentPage = 1;
    let filteredRows = [...rows];
    let filteredMobileItems = [...mobileItems];

    const searchInput = document.querySelector(`[data-pub-search="${tableId}"]`);

    function renderPage(page) {
      currentPage = page;
      const itemsPerPage = getPublicationPageSize();
      const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
      if (currentPage < 1) currentPage = 1;
      if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

      rows.forEach(r => r.style.display = 'none');
      mobileItems.forEach(r => r.style.display = 'none');

      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      filteredRows.slice(start, end).forEach(r => r.style.display = '');
      filteredMobileItems.slice(start, end).forEach(r => r.style.display = '');
      if (paginationInfo) {
        paginationInfo.textContent = filteredRows.length > 0
          ? `${start + 1}-${Math.min(end, filteredRows.length)} / ${filteredRows.length} julkaisua`
          : 'Ei julkaisuja';
      }

      renderPaginationControls(totalPages);

      if (filterIndicator) {
        const filters = activeResearchFilterLabels();
        if (activePublicationYear) filters.push(`vuosi ${activePublicationYear}`);
        if (activePublicationType) filters.push(`luokka ${publicationTypeLabel()}`);
        if (activeCoauthor) {
          const noun = filteredRows.length === 1 ? 'julkaisuun' : 'julkaisuihin';
          filters.push(`yhteistyö ${activeCoauthor} (${noun})`);
        }
        if (filters.length) {
          filterIndicator.textContent = `Rajattu: ${filters.join(', ')}`;
          filterIndicator.classList.remove('d-none');
        } else {
          filterIndicator.textContent = '';
          filterIndicator.classList.add('d-none');
        }
      }
    }

    function renderPaginationControls(totalPages) {
      ul.innerHTML = '';
      if (totalPages <= 1) return;

      const prevLi = document.createElement('li');
      prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
      prevLi.innerHTML = `<button type="button" class="page-link" aria-label="Edellinen sivu">&laquo;</button>`;
      prevLi.addEventListener('click', (e) => { e.preventDefault(); if(currentPage > 1) renderPage(currentPage - 1); });
      ul.appendChild(prevLi);

      for (let i = 1; i <= totalPages; i++) {
        const li = document.createElement('li');
        li.className = `page-item ${i === currentPage ? 'active' : ''}`;
        li.innerHTML = `<button type="button" class="page-link" aria-label="Sivu ${i}">${i}</button>`;
        li.addEventListener('click', (e) => { e.preventDefault(); renderPage(i); });
        ul.appendChild(li);
      }

      const nextLi = document.createElement('li');
      nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
      nextLi.innerHTML = `<button type="button" class="page-link" aria-label="Seuraava sivu">&raquo;</button>`;
      nextLi.addEventListener('click', (e) => { e.preventDefault(); if(currentPage < totalPages) renderPage(currentPage + 1); });
      ul.appendChild(nextLi);
    }

    function reorderEntries(parent, preferredOrder, allEntries) {
      if (!activePublicationSort) return;
      const preferredSet = new Set(preferredOrder);
      const targetOrder = [
        ...preferredOrder,
        ...allEntries.filter((entry) => !preferredSet.has(entry))
      ];
      const currentOrder = Array.from(parent.children).filter((entry) => allEntries.includes(entry));
      const alreadyOrdered = targetOrder.length === currentOrder.length
        && targetOrder.every((entry, index) => entry === currentOrder[index]);
      if (!alreadyOrdered) targetOrder.forEach((entry) => parent.appendChild(entry));
    }

    function applyFilters() {
      rows = Array.from(tbody.querySelectorAll('tr'));
      mobileItems = Array.from(tableContainer.querySelectorAll('.pub-mobile-item'));
      const q = (searchInput?.value || '').toLowerCase();
      const coauthorNeedle = activeCoauthor.toLowerCase();
      const matchFn = el => {
        const text = el.textContent.toLowerCase();
        const matchesSearch = !q || text.includes(q);
        const authors = (el.dataset.authors || '').toLowerCase();
        const matchesCoauthor = !coauthorNeedle || authors.includes(coauthorNeedle);
        const matchesPublicationYear = !activePublicationYear || el.dataset.publicationYear === activePublicationYear;
        const matchesPublicationType = !activePublicationType || el.dataset.publicationType === activePublicationType;
        return matchesSearch && matchesCoauthor && matchesPublicationYear && matchesPublicationType && matchesResearchFilters(el);
      };
      filteredRows = sortPublicationEntries(rows.filter(matchFn));
      filteredMobileItems = sortPublicationEntries(mobileItems.filter(matchFn));
      reorderEntries(tbody, filteredRows, rows);
      reorderEntries(tableContainer.querySelector('.pub-mobile-list'), filteredMobileItems, mobileItems);
      syncPublicationFiltersToUrl();
      renderPage(1);
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    tableFilterRefreshers.push(applyFilters);
    applyFilters();

    if (typeof publicationPageSizeMq.addEventListener === 'function') {
      publicationPageSizeMq.addEventListener('change', () => renderPage(1));
    } else if (typeof publicationPageSizeMq.addListener === 'function') {
      publicationPageSizeMq.addListener(() => renderPage(1));
    }

    // Kun table-filters.js lajittelee DOM-rivit uudelleen, kutsutaan applyFilters,
    // joka lukee rivit aina tuoreena DOM:sta (rows päivitetään applyFilters-alussa).
    new MutationObserver(() => {
      applyFilters();
    }).observe(tbody, { childList: true });
  }

  ['pub-table-a', 'pub-table-b', 'pub-table-c', 'pub-table-d', 'pub-table-e', 'pub-table-g'].forEach(initPubPagination);

  // 1. VUOSIKAAVIO
  const yearCounts = {};
  publications.forEach(p => { if(p.year) yearCounts[p.year] = (yearCounts[p.year]||0)+1; });
  const years = Object.keys(yearCounts).sort();
  // Citation counts per year from S2 data
  const citesPerYear = {};
  if (s2Citations) {
    publications.forEach(p => {
      if (p.year && p.doi && s2Citations[p.doi.toLowerCase()]) {
        citesPerYear[p.year] = (citesPerYear[p.year]||0) + s2Citations[p.doi.toLowerCase()];
      }
    });
  }

  const yearChartInst = new Chart(document.getElementById('yearChart'), {
    type: 'bar',
    data: {
      labels: years,
      datasets: [{
        label: 'Julkaisuja',
        data: years.map(y => yearCounts[y]),
        backgroundColor: isDark ? 'rgba(56,189,248,0.6)' : 'rgba(13,110,253,0.7)',
        borderRadius: 4,
        borderSkipped: false,
        yAxisID: 'y'
      },{
        label: 'Viittauksia',
        data: years.map(y => citesPerYear[y] || 0),
        type: 'line',
        borderColor: '#ffc107',
        backgroundColor: 'rgba(255,193,7,0.15)',
        fill: true,
        tension: 0.3,
        pointRadius: 3,
        yAxisID: 'y1'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } } },
      scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 }, title: { display: true, text: 'Julkaisut', font: { size: 10 } } },
        y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Viittaukset', font: { size: 10 } } },
        x: { ticks: { maxRotation: 45 } }
      }
    }
  });

  // 2. TYYPPIKAAVIO
  const typeCounts = {};
  const typeLabels = {
    'A1':'Lehtiartikkeli (A1)', 'A2':'Katsausartikkeli (A2)',
    'A3':'Kirjan osa (A3)', 'A4':'Konferenssi (A4)',
    'B1':'Kirjoitus (B1)', 'B3':'Konferenssi ei-vertaisarv. (B3)',
    'C1':'Tieteellinen teos (C1)', 'C2':'Toimitettu teos (C2)',
    'D1':'Ammattiartikkeli (D1)', 'D2':'Ammatillinen kokoomat. (D2)',
    'E1':'Yleistajuinen (E1)', 'G4':'Väitöskirja (G4)', 'G5':'Väitöskirja (G5)'
  };
  publications.forEach(p => { typeCounts[p.type] = (typeCounts[p.type]||0)+1; });
  const typeKeys = Object.keys(typeCounts).sort((a,b) => typeCounts[b]-typeCounts[a]);
  const typeColors = ['#0d6efd','#6610f2','#6f42c1','#d63384','#dc3545','#fd7e14','#ffc107','#198754','#20c997','#0dcaf0','#6c757d','#adb5bd','#495057'];
  const typeChartInst = new Chart(document.getElementById('typeChart'), {
    type: 'doughnut',
    data: {
      labels: typeKeys.map(k => typeLabels[k]||k),
      datasets: [{
        data: typeKeys.map(k => typeCounts[k]),
        backgroundColor: typeColors.slice(0, typeKeys.length),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', maxHeight: 72, labels: { boxWidth: 10, font: { size: 10 }, padding: 6 } }
      }
    }
  });

  // 3. LAADULLISET (peer review & OA)
  // Kategorisoidaan julkaisut toisensa poissulkeviin luokkiin
  const isPeerReviewed = (value) => value === true || value === 1 || value === '1' || String(value).toLowerCase() === 'true';
  const isOpenAccess = (value) => value === true || value === 1 || value === '1' || String(value).toLowerCase() === 'true';
  const prAndOa = publications.filter(p => isPeerReviewed(p.peerReviewed) && isOpenAccess(p.openAccess)).length;
  const prOnly = publications.filter(p => isPeerReviewed(p.peerReviewed) && !isOpenAccess(p.openAccess)).length;
  // "Muu / ei vertaisarvioitu" sisältää sekä OA- että ei-OA-julkaisut.
  const nonPeerReviewed = publications.filter(p => !isPeerReviewed(p.peerReviewed)).length;
  
  const qualityChartInst = new Chart(document.getElementById('qualityChart'), {
    type: 'doughnut',
    data: {
      labels: ['Vertaisarvioitu & OA', 'Vain vertaisarvioitu', 'Muu / ei vertaisarvioitu'],
      datasets: [{
        data: [prAndOa, prOnly, nonPeerReviewed],
        backgroundColor: ['#198754', '#20c997', '#dee2e6'],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom', maxHeight: 72, labels: { boxWidth: 10, font: { size: 10 }, padding: 6 } }
      }
    }
  });

  // Mobiili-accordion: resize kaaviot kun collapse aukeaa (alustus tapahtuu display:none-tilassa)
  const analyticsDashEl = document.getElementById('analyticsDashboard');
  if (analyticsDashEl) {
    analyticsDashEl.addEventListener('shown.bs.collapse', () => {
      [yearChartInst, typeChartInst, qualityChartInst].forEach(c => c && c.resize());
    });
    // Pyöritetään chevron-ikoni auki/kiinni
    const toggleBtn = document.querySelector('[data-bs-target="#analyticsDashboard"]');
    if (toggleBtn) {
      analyticsDashEl.addEventListener('show.bs.collapse', () => toggleBtn.setAttribute('aria-expanded', 'true'));
      analyticsDashEl.addEventListener('hide.bs.collapse', () => toggleBtn.setAttribute('aria-expanded', 'false'));
    }
  }

  // KAAVION SUURENNOS (zoom modal)
  const chartInstances = { yearChart: yearChartInst, typeChart: typeChartInst, qualityChart: qualityChartInst };
  let zoomChartInst = null;
  const zoomModalEl = document.getElementById('chartZoomModal');
  const zoomModalLabel = document.getElementById('chartZoomModalLabel');

  function openZoomModal(sourceId, title) {
    const source = chartInstances[sourceId];
    if (!source) return;
    zoomModalLabel.textContent = title;
    const bsModal = bootstrap.Modal.getOrCreateInstance(zoomModalEl);
    bsModal.show();
  }

  zoomModalEl.addEventListener('shown.bs.modal', function() {
    const btn = zoomModalEl.querySelector('[data-zoom-active]') ||
                document.querySelector('.chart-zoom-btn[data-zoom-active]');
    // Reconstruct from active source id stored on modal
    const sourceId = zoomModalEl.dataset.activeChart;
    const source = chartInstances[sourceId];
    if (!source) return;
    if (zoomChartInst) { zoomChartInst.destroy(); zoomChartInst = null; }
    const canvas = document.getElementById('zoomCanvas');
    // Deep-clone config and enlarge legend
    const cfg = JSON.parse(JSON.stringify({ type: source.config.type, data: source.config.data, options: source.config.options }));
    if (cfg.options && cfg.options.plugins && cfg.options.plugins.legend) {
      cfg.options.plugins.legend.labels = cfg.options.plugins.legend.labels || {};
      cfg.options.plugins.legend.labels.font = { size: 13 };
      cfg.options.plugins.legend.labels.padding = 14;
      cfg.options.plugins.legend.labels.boxWidth = 14;
    }
    zoomChartInst = new Chart(canvas, cfg);
  });

  zoomModalEl.addEventListener('hidden.bs.modal', function() {
    if (zoomChartInst) { zoomChartInst.destroy(); zoomChartInst = null; }
  });

  // Sidotaan zoom-napit ja koko canvas-alue
  document.querySelectorAll('.chart-zoom-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const sourceId = this.dataset.zoomTarget;
      const title = this.dataset.zoomTitle;
      zoomModalEl.dataset.activeChart = sourceId;
      openZoomModal(sourceId, title);
    });
  });
  // Klikki suoraan canvakselle avaa myös zoomin
  ['yearChart','typeChart','qualityChart'].forEach(id => {
    const btn = document.querySelector(`.chart-zoom-btn[data-zoom-target="${id}"]`);
    const canvas = document.getElementById(id);
    if (canvas && btn) canvas.addEventListener('click', () => btn.click());
    if (canvas) canvas.style.cursor = 'zoom-in';
  });

  // 4. JULKAISULUOKAT
  const publicationYears = [...new Set(
    [...document.querySelectorAll('[data-publication-year]')]
      .map((item) => String(item.dataset.publicationYear || '').trim())
      .filter(Boolean)
  )].sort((a, b) => Number(b) - Number(a));
  publicationYearSelects.forEach((select) => {
    publicationYears.forEach((year) => select.add(new Option(year, year)));
    select.addEventListener('change', () => setPublicationYearFilter(select.value));
  });
  if (initialPublicationYear && publicationYears.includes(initialPublicationYear)) {
    setPublicationYearFilter(initialPublicationYear);
  }

  const publicationTypeLabels = new Map();
  document.querySelectorAll('[data-publication-type]').forEach((item) => {
    const code = String(item.dataset.publicationType || '').trim();
    const label = String(item.dataset.publicationTypeLabel || '').trim();
    if (code && !publicationTypeLabels.has(code)) publicationTypeLabels.set(code, label);
  });
  const publicationTypeOptions = [...publicationTypeLabels.entries()].sort((a, b) => (
    new Intl.Collator('fi', { numeric: true }).compare(a[0], b[0])
  ));
  publicationTypeSelects.forEach((select) => {
    publicationTypeOptions.forEach(([code, label]) => {
      select.add(new Option(label ? `${code} - ${label}` : code, code));
    });
    select.addEventListener('change', () => setPublicationTypeFilter(select.value));
  });
  if (initialPublicationType && publicationTypeLabels.has(initialPublicationType)) {
    setPublicationTypeFilter(initialPublicationType);
  }

  // 5. KANSSAKIRJOITTAJAT
  const coauthors = {};
  publications.forEach(p => {
    const authors = p.authors.split(';').map(a => a.trim()).filter(a => a.length > 0);
    authors.forEach(a => {
      if (!a.toLowerCase().startsWith('laru')) {
        coauthors[a] = (coauthors[a]||0) + 1;
      }
    });
  });
  const allCoauthors = Object.entries(coauthors).sort((a, b) => {
    const countDiff = b[1] - a[1];
    return countDiff || new Intl.Collator('fi').compare(a[0], b[0]);
  });
  const topCoauthors = allCoauthors.slice(0, 10);
  const coauthorSelects = document.querySelectorAll('[data-coauthor-select]');
  coauthorSelects.forEach((select) => {
    allCoauthors.forEach(([name, count]) => {
      select.add(new Option(`${name} (${count})`, name));
    });
    select.addEventListener('change', () => setCoauthorFilter(select.value));
  });
  const tbody = document.querySelector('#coauthorTable tbody');
  topCoauthors.forEach(([name, count]) => {
    const tr = document.createElement('tr');
    const isDarkTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark';
    const badgeStyle = isDarkTheme ? 'background-color: rgba(56,189,248,0.3); color: #e2e6ec;' : 'background-color: rgba(13,110,253,0.15); color: #0d6efd;';
    tr.innerHTML = `
      <td>
        <button type="button" class="btn btn-link p-0 text-start coauthor-filter-btn" data-coauthor="${name}" title="Rajaa julkaisut tekijällä ${name}">
          ${name}
        </button>
      </td>
      <td class="text-end"><span class="badge rounded-pill" style="${badgeStyle}">${count}</span></td>
    `;
    tbody.appendChild(tr);
  });

  document.querySelectorAll('.coauthor-filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => setCoauthorFilter(btn.dataset.coauthor || '', { toggle: true }));
  });
  if (initialCoauthor) {
    setCoauthorFilter(initialCoauthor);
  }

  // Kanssatutkijat-kortti: häivytys + expand
  const coauthorFadeOverlay = document.getElementById('coauthorFadeOverlay');
  const coauthorTableWrap = document.getElementById('coauthorTableWrap');
  if (coauthorFadeOverlay && coauthorTableWrap) {
    coauthorFadeOverlay.addEventListener('click', () => {
      coauthorTableWrap.style.maxHeight = 'none';
      coauthorTableWrap.style.overflow = 'visible';
      coauthorFadeOverlay.style.display = 'none';
    });
  }

  // 5. SANAPILVI (Otsikon sanat, alkuperäinen toimivaksi todettu tapa)
  const stopwords = new Set(['the','of','in','for','a','an','and','to','on','with','from','by','at','as','is','are','was','were','or','using','based','their','its','towards','between','among','during','about','through','case','study','how','can','do','does','than','into','all','not','but','also','been','has','have','had','which','when','what','that','this','these','those','other','more','no','some','varhaiskasvatuksen']);
  const wordCounts = {};
  publications.forEach(p => {
    const words = p.title.toLowerCase().replace(/[^a-zäöüå\s-]/g, '').split(/\s+/);
    words.forEach(w => {
      if (w.length > 3 && !stopwords.has(w)) {
        wordCounts[w] = (wordCounts[w]||0) + 1;
      }
    });
  });
  const topWords = Object.entries(wordCounts).sort((a,b)=>b[1]-a[1]).slice(0,25);
  const cloudEl = document.getElementById('wordCloud');
  const keywordFilterBar = document.getElementById('keyword-filter-bar');
  const activeKeywordLabel = document.getElementById('active-keyword-label');
  const clearKeywordBtn = document.getElementById('clear-keyword-filter');

  function applyKeywordFilter(word, options = {}) {
    const { skipScroll = false } = options;
    activeKeyword = (activeKeyword === word) ? '' : word;

    document.querySelectorAll('[data-pub-search]').forEach(input => {
      input.value = activeKeyword;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    });

    if (keywordFilterBar) {
      if (activeKeyword) {
        if (activeKeywordLabel) activeKeywordLabel.textContent = activeKeyword;
        keywordFilterBar.classList.remove('d-none');
      } else {
        keywordFilterBar.classList.add('d-none');
      }
    }

    cloudEl.querySelectorAll('.keyword-badge').forEach(btn => {
      const isActive = btn.dataset.word === activeKeyword;
      btn.style.outline = isActive ? '2px solid currentColor' : '';
      btn.style.opacity = isActive ? '1' : btn.dataset.opacity;
    });

    if (activeKeyword && !skipScroll) {
      document.getElementById('julkaisuluokat')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    syncPublicationFiltersToUrl();
  }

  if (clearKeywordBtn) {
    clearKeywordBtn.addEventListener('click', () => applyKeywordFilter(''));
  }

  if (topWords.length > 0) {
    const maxCount = topWords[0]?.[1] || 1;
    topWords.forEach(([word, count]) => {
      const size = 0.7 + (count / maxCount) * 1.0;
      const opacity = 0.5 + (count / maxCount) * 0.5;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'badge rounded-pill border-0 keyword-badge';
      btn.dataset.word = word;
      btn.dataset.opacity = opacity;
      btn.style.cssText = `font-size:${size}rem; opacity:${opacity}; background-color: ${isDark ? 'rgba(56,189,248,0.3)' : 'rgba(13,110,253,0.15)'}; color: ${isDark ? '#e2e6ec' : '#004192'}; font-weight: 500; cursor: pointer; transition: outline 0.1s;`;
      btn.title = `Suodata julkaisut avainsanalla "${word}"`;
      btn.textContent = `${word} (${count})`;
      btn.addEventListener('click', () => applyKeywordFilter(word));
      cloudEl.appendChild(btn);
    });
    if (initialKeyword) {
      const keywordExists = topWords.some(([word]) => word === initialKeyword);
      if (keywordExists) {
        applyKeywordFilter(initialKeyword, { skipScroll: true });
      }
    }
  } else {
    cloudEl.innerHTML = '<span class="text-muted small">Ei avainsanoja saatavilla</span>';
  }
});
</script>
