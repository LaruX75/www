---
layout: base.njk
title: Blogi, mielipidekirjoitukset ja kolumnit
description: "Jari Larun blogikirjoitukset, mielipidekirjoitukset ja kolumnit koottuna yhteen hakuun ja suodatukseen sopivaksi näkymäksi. Painopisteet: opetus, tekoäly, koulutus, kuntapolitiikka ja avoin tiede."
permalink: /kirjoitukset/
translationKey: writings_texts
pageStyles:
  - /css/kynasta-page.css
schemaType: CollectionPage
schemaAbout:
  - "@type": "Thing"
    name: "Blogikirjoitukset"
    description: "Blogissa julkaistut kirjoitukset opetuksesta, teknologiasta ja yhteiskunnasta."
  - "@type": "Thing"
    name: "Mielipidekirjoitukset"
    description: "Lehdissä julkaistut kannanotot ja mielipidetekstit."
  - "@type": "Thing"
    name: "Kolumnit ja blogivierailut"
    description: "Kolumnimuotoiset tekstit ja vierailut ulkoisissa blogeissa."
---
{% import "ui.njk" as ui %}
{% set statementItems = [] %}
{% for item in (collections.publications or []) %}
  {% if item.data.type == "lausunto" %}
    {% set _ = (statementItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set councilSpeechItems = [] %}
{% set publicSpeechItems = [] %}
{% for item in (collections.pub_puhe or []) %}
  {% set speechContext = item.data.speechContext or "" %}
  {% set forums = item.data.forum or [] %}
  {% if speechContext %}
    {% set isCouncilSpeech = speechContext == "valtuusto" or speechContext == "kyselytunti" %}
  {% else %}
    {% set isCouncilSpeech = item.data.event == "Oulun kaupunginvaltuusto" or forums.indexOf("Kaupunginvaltuusto") != -1 %}
  {% endif %}
  {% if isCouncilSpeech %}
    {% set _ = (councilSpeechItems.push(item), null) %}
  {% else %}
    {% set _ = (publicSpeechItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set latestSpeechHighlights = (councilSpeechItems or []).slice(0, 3) %}
{% set latestPublicSpeechHighlights = (publicSpeechItems or []).slice(0, 3) %}
{% set latestInitiativeHighlights = (collections.politics or []).slice(0, 3) %}
{% set latestBlogHighlights = (collections.blog or []).slice(0, 3) %}
{% set latestStatementHighlights = statementItems.slice(0, 3) %}
{% set latestOpinionHighlights = (collections.pub_mielipide or []).slice(0, 3) %}
{% set latestColumnHighlights = (collections.pub_kolumni or []).slice(0, 3) %}
{% set latestExpertOpinionHighlights = ((collections.pub_mielipide_expert or []) or []).slice(0, 3) %}
{% set speechCount = (collections.pub_puhe or []) | length %}
{% set councilSpeechCount = councilSpeechItems | length %}
{% set publicSpeechCount = publicSpeechItems | length %}
{% set initiativeCount = (collections.politics or []) | length %}
{% set statementCount = statementItems | length %}
{% set blogCount = (collections.blog or []) | length %}
{% set opinionCount = (collections.pub_mielipide or []) | length %}
{% set columnCount = (collections.pub_kolumni or []) | length %}
{% set politicalOpinionCount = (collections.pub_mielipide_political or []) | length %}
{% set expertOpinionCount = (collections.pub_mielipide_expert or []) | length %}
{% set hybridOpinionItems = [] %}
{% for item in (collections.pub_mielipide or []) %}
  {% set roles = item.data.opinionRoles or item.data.writingRoles or [] %}
  {% if roles.indexOf("political") != -1 and roles.indexOf("expert") != -1 %}
    {% set _ = (hybridOpinionItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set hybridOpinionCount = hybridOpinionItems | length %}
{% set decisionRouteCount = councilSpeechCount + initiativeCount + statementCount %}
{% set commentaryRouteCount = opinionCount + columnCount + blogCount %}
{% set expertRouteCount = statementCount + expertOpinionCount + publicSpeechCount %}

<section class="kynasta-hero py-3 py-lg-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-2">Kirjoitukset</p>
        <h1 class="display-6 fw-bold mb-2">Blogi, mielipidekirjoitukset ja kolumnit</h1>
        <p class="text-muted mb-3">Vapaamuotoiset omat tekstit yhdellä sivulla: {{ blogCount }} blogikirjoitusta, {{ opinionCount }} mielipidekirjoitusta ja {{ columnCount }} kolumnia. Voit hakea, suodattaa ja lajitella niitä alla.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="nav-link" href="#blogi">Blogi <span class="nav-count">{{ blogCount }}</span></a>
          <a class="nav-link" href="#mielipiteet">Mielipiteet <span class="nav-count">{{ opinionCount }}</span></a>
          <a class="nav-link" href="#kolumnit">Kolumnit <span class="nav-count">{{ columnCount }}</span></a>
        </div>
        <p class="small text-muted mt-3 mb-0">
          Etsitkö puheenvuoroja, valtuustoaloitteita tai lausuntoja? <a href="/kynasta/">Palaa Kynästä-hubiin</a> — löydät sieltä kaikki sisältölajit.
        </p>
      </div>
    </div>
  </div>
</section>



{# Kerätään kaikki mielipiteet JSON-muotoon JS:ää varten #}
<script id="mielipiteet-data" type="application/json">
[
  {% for pub in collections.pub_mielipide %}
  {
    "title": {{ pub.data.title | jsonSafe | safe }},
    "date": "{{ pub.date }}",
    "formattedDate": "{{ pub.date | dateFormat }}",
    "description": {{ (pub.data.description or "") | jsonSafe | safe }},
    "publication": {{ (pub.data.publication or "") | jsonSafe | safe }},
    "url": "{{ pub.data.url or pub.url }}",
    "isExternal": {{ (pub.data.url != null) | jsonSafe | safe }},
    "categories": {{ (pub.data.categories or []) | jsonSafe | safe }},
    "keywords": {{ (pub.data.keywords or []) | jsonSafe | safe }},
    "writingRoles": {{ (pub.data.writingRoles or []) | jsonSafe | safe }},
    "opinionRoles": {{ (pub.data.opinionRoles or []) | jsonSafe | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
]
</script>

<span id="mielipidekirjoitukset-eri-sanomalehdissa"></span>
<section id="mielipiteet" class="bg-body-tertiary">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between kynasta-section-header">
        <h2 class="h4 mb-0"><i class="bi bi-chat-square-quote-fill me-2"></i>Mielipidekirjoitukset</h2>
        <span class="badge kynasta-section-count">{{ collections.pub_mielipide.length }}</span>
      </div>
      <div class="card-body p-0">
        <div class="px-3 pt-3 pb-0">
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <button type="button"
                      class="opinion-role-card w-100 text-start"
                      data-opinion-role-card="political"
                      aria-pressed="false">
                <div class="d-flex align-items-start justify-content-between gap-3">
                  <div>
                    <p class="opinion-role-kicker mb-1">Päätöksenteko</p>
                    <h3 class="h6 mb-1">Kannanotot politiikasta ja palveluista</h3>
                    <p class="small text-muted mb-0">Kirjoitukset, joissa näkökulma liittyy vaaleihin, päätöksentekoon, palveluihin tai kunnalliseen vaikuttamiseen.</p>
                  </div>
                  <span class="opinion-role-count">{{ politicalOpinionCount }}</span>
                </div>
              </button>
            </div>
            <div class="col-md-4">
              <button type="button"
                      class="opinion-role-card w-100 text-start"
                      data-opinion-role-card="expert"
                      aria-pressed="false">
                <div class="d-flex align-items-start justify-content-between gap-3">
                  <div>
                    <p class="opinion-role-kicker mb-1">Asiantuntijatausta</p>
                    <h3 class="h6 mb-1">Opetus, tutkimus ja teknologia</h3>
                    <p class="small text-muted mb-0">Kirjoitukset, joissa painopiste on tutkimuksessa, opetuksessa, koulutuksessa tai teknologiassa.</p>
                  </div>
                  <span class="opinion-role-count">{{ expertOpinionCount }}</span>
                </div>
              </button>
            </div>
            <div class="col-md-4">
              <button type="button"
                      class="opinion-role-card w-100 text-start"
                      data-opinion-role-card="hybrid"
                      aria-pressed="false">
                <div class="d-flex align-items-start justify-content-between gap-3">
                  <div>
                    <p class="opinion-role-kicker mb-1">Asiantuntijuus mukana</p>
                    <h3 class="h6 mb-1">Kun työtausta liittyy päätöksiin</h3>
                    <p class="small text-muted mb-0">Kirjoitukset, joissa opetus, tutkimus tai teknologia auttaa avaamaan päätöksenteon kysymyksiä.</p>
                  </div>
                  <span class="opinion-role-count">{{ hybridOpinionCount }}</span>
                </div>
              </button>
            </div>
          </div>
          <p class="small text-muted mb-3">
            Valinnat auttavat erottamaan päätöksentekoon liittyvät kannanotot, asiantuntijataustaiset kirjoitukset ja tekstit, joissa nämä kaksi näkökulmaa kulkevat yhdessä.
          </p>
        </div>
        {# ---- Suodatuspalkki ---- #}
        <div class="p-3 bg-body-tertiary border-bottom">
          <div class="row g-2 align-items-end">
            <div class="col-lg-5">
              <label for="mielipiteet-search" class="form-label small text-muted mb-1">Hae mielipidekirjoituksia</label>
              <input type="search" id="mielipiteet-search" class="form-control form-control-sm"
                     placeholder="Hae otsikosta, julkaisusta, aiheesta tai näkökulmasta, esim. asiantuntijatausta..." autocomplete="off">
            </div>
            <div class="col-sm-3 col-lg-2">
              <label for="mielipiteet-year" class="form-label small text-muted mb-1">Vuosi</label>
              <select id="mielipiteet-year" class="form-select form-select-sm" aria-label="Rajaa mielipidekirjoitukset vuoden mukaan"><option value="" selected>Kaikki vuodet</option></select>
            </div>
            <div class="col-sm-5 col-lg-3">
              <label for="mielipiteet-publication" class="form-label small text-muted mb-1">Julkaisu</label>
              <select id="mielipiteet-publication" class="form-select form-select-sm" aria-label="Rajaa mielipidekirjoitukset julkaisun mukaan"><option value="" selected>Kaikki julkaisut</option></select>
            </div>
            <div class="col-sm-4 col-lg-2 d-flex justify-content-md-end gap-2">
              <button id="mielipiteet-reset" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-circle me-1"></i>Tyhjennä
              </button>
            </div>
          </div>
        </div>

        {# ---- Taulukko ---- #}
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table mielipiteet-table" data-no-header-filters>
            <thead>
              <tr>
                <th class="text-center" data-mobile-label="Päivämäärä" style="width:170px">
                  <div class="table-header-filter-controls">
                    <span class="table-header-filter-label">Päivämäärä</span>
                    <button id="mielipiteet-sort-date" type="button" class="table-header-sort-button" aria-pressed="true"><i class="bi bi-arrow-down"></i></button>
                  </div>
                </th>
                <th data-mobile-label="Otsikko" style="min-width:200px">
                  <div class="table-header-filter-controls">
                    <span class="table-header-filter-label">Otsikko</span>
                    <button id="mielipiteet-sort-title" type="button" class="table-header-sort-button" aria-pressed="false"><i class="bi bi-arrow-down"></i></button>
                  </div>
                </th>
                <th data-mobile-label="Tiivistelmä ja julkaisu" style="min-width:200px">
                  Tiivistelmä & Julkaisu
                </th>
                <th>Kategoriat & Avainsanat</th>
                <th style="width:80px" class="text-center">Lue</th>
              </tr>
            </thead>
            <tbody id="mielipiteet-tbody">
              <tr><td colspan="5" class="text-center text-muted py-4">Ladataan mielipidekirjoituksia...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      {{ ui.paginationBar("mielipiteet-info", "mielipiteet-pagination", { extraClass: "card-footer bg-transparent kynasta-table-pager" }) }}
    </div>
  </div>
</section>

