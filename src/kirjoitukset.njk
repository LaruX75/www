            <a href="${d.url}" ${targetAttr} class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Avaa mielipidekirjoitus">
              ${iconInfo}
            </a>
          </td>
        </tr>`;
      }).join('');
    }

    const total = filteredMielipiteetData.length;
    const from = total === 0 ? 0 : start + 1;
    const to = Math.min(start + MIELIPITEET_PAGE_SIZE, total);
    mielipiteetInfo.textContent = `Näytetään ${from}–${to} / ${total}`;

    renderMielipiteetPagination(totalPages);

    syncArchiveSortButton(mielipiteetDateSortBtn, mielipiteetSortCol === 'date', mielipiteetSortDir, 'Päivämäärä');
    syncArchiveSortButton(mielipiteetTitleSortBtn, mielipiteetSortCol === 'title', mielipiteetSortDir, 'Otsikko');
  }

  function renderMielipiteetPagination(total) {
    renderPaginationShared(mielipiteetPagUl, total, mielipiteetCurrentPage, page => {
      mielipiteetCurrentPage = page;
      renderMielipiteet();
      document.getElementById('mielipiteet')?.scrollIntoView({behavior:'smooth', block:'start'});
    });
  }

  function escHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function slugify(str) {
    if (!str) return "";
    return str.toLowerCase().replace(/ä/g, "a").replace(/ö/g, "o").replace(/å/g, "a").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  }

  if (mielipiteetSearchInp) mielipiteetSearchInp.addEventListener('input', applyMielipiteetFilters);
  if (mielipiteetYearSel) mielipiteetYearSel.addEventListener('change', applyMielipiteetFilters);
  if (mielipiteetPublicationSel) mielipiteetPublicationSel.addEventListener('change', applyMielipiteetFilters);
  if (mielipiteetDateSortBtn) mielipiteetDateSortBtn.addEventListener('click', () => sortMielipiteetData('date'));
  if (mielipiteetTitleSortBtn) mielipiteetTitleSortBtn.addEventListener('click', () => sortMielipiteetData('title'));

  if (mielipiteetTbody) {
    mielipiteetTbody.addEventListener('click', (event) => {
      const roleBtn = event.target.closest('[data-opinion-role-inline]');
      if (!roleBtn) return;
      event.preventDefault();
      selectedOpinionRole = roleBtn.dataset.opinionRoleInline || 'all';
      applyMielipiteetFilters();
      document.getElementById('mielipiteet')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  opinionRoleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedOpinionRole = btn.dataset.opinionRole || 'all';
      applyMielipiteetFilters();
    });
  });

  opinionRoleCards.forEach((card) => {
    card.addEventListener('click', () => {
      selectedOpinionRole = card.dataset.opinionRoleCard || 'all';
      applyMielipiteetFilters();
    });
  });
  
  const mielipiteetResetBtn = document.getElementById('mielipiteet-reset');
  if (mielipiteetResetBtn) {
    mielipiteetResetBtn.addEventListener('click', () => {
      if (mielipiteetSearchInp) mielipiteetSearchInp.value = '';
      if (mielipiteetYearSel) mielipiteetYearSel.value = '';
      if (mielipiteetPublicationSel) mielipiteetPublicationSel.value = '';
      selectedOpinionRole = 'all';
      applyMielipiteetFilters();
    });
  }

  applyMielipiteetFilters();
})();

}); // DOMContentLoaded
</script>
