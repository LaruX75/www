          <a class="btn btn-outline-secondary rounded-pill px-4" href="#lectio">Watch lectio</a>
          <a class="btn btn-outline-secondary rounded-pill px-4" href="#papers">Original publications</a>
        </div>
      </div>
      <aside class="col-lg-5">
