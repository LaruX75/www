              <a class="btn btn-outline-primary btn-sm rounded-pill px-3" href="{{ paper.external }}" target="_blank" rel="noopener noreferrer">External source</a>
              {% endif %}
            </div>
          </div>
        </article>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

