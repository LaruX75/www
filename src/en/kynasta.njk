      <li><a class="btn btn-outline-primary btn-sm" href="/lausunnot/#julkiset-puheet" lang="fi" hreflang="fi">Julkiset puheet (Finnish) <span class="text-muted">({{ model.expert.groups.publicSpeeches.count }})</span></a></li>
