      <li><a class="btn btn-outline-primary btn-sm" href="/valtuustotyo/#aloitteet" lang="fi" hreflang="fi">Valtuustoaloitteet (Finnish) <span class="text-muted">({{ model.council.groups.initiatives.count }})</span></a></li>
    </ul>
