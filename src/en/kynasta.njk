{# KYNÄSTÄ-HUB-02 (EN): partial hub. Writings section fully populated
   from EN-scoped items. Council + Expert sections render an honest
   "Available only in Finnish" note with links to the FI archives —
   no fabricated EN content, matches spec §9. #}
{% set model = kynastaHubPage %}

<section class="kynasta-hero py-4 py-lg-5">
  <div class="site-shell">
    <div class="row align-items-start g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-2">Kynästä</p>
        <h1 class="display-6 fw-bold mb-3">Writings, speeches and statements</h1>
        <p class="text-muted mb-3">Jari Laru's public writing organised into three domains. English content is available for the writings section (blog, opinion, column). Council work and expert statements are currently published only in Finnish; links to the Finnish archives are provided below.</p>
      </div>
      <div class="col-lg-4">
        <aside class="kynasta-hero-aside">
          <p class="kynasta-hero-aside-kicker mb-2">How to browse</p>
          <ul class="kynasta-hero-aside-list mb-0">
            <li><strong>Writings:</strong> blog, opinion pieces and columns — free-form English texts.</li>
            <li><strong>Council work:</strong> speeches and initiatives in the Oulu city council (Finnish).</li>
            <li><strong>Expert work:</strong> expert statements and public speeches (Finnish).</li>
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

{# ---- Writings (EN) ---- #}
<section class="kynasta-hub-section py-4 py-lg-5" id="writings" aria-labelledby="kynasta-writings-heading">
  <div class="site-shell">
    <header class="kynasta-hub-section-header mb-4">
      <p class="text-uppercase small text-muted mb-1">Writings</p>
      <h2 id="kynasta-writings-heading" class="h3 mb-2">Free-form writing and published pieces</h2>
      <p class="text-muted mb-0">Blog posts, opinion pieces and columns — {{ model.writings.count }} English items in total.</p>
    </header>
    <div class="row g-4">
      <div class="col-md-6 col-lg-4">
        {% set subsectionHeading = "Blog" %}
        {% set subsectionDescription = "In-depth reflections on teaching, technology and open science." %}
        {% set subsectionItems = model.writings.groups.blog.latestItems %}
        {% set subsectionCount = model.writings.groups.blog.count %}
        {% set subsectionArchiveUrl = "/en/writings/#blog" %}
        {% set subsectionArchiveLabel = "Show all blog posts" %}
        {% set subsectionLang = "en" %}
        {% set subsectionEmptyText = "No English blog posts yet." %}
        {% include "kynasta-hub-subsection.njk" %}
      </div>
      <div class="col-md-6 col-lg-4">
        {% set subsectionHeading = "Opinion pieces" %}
        {% set subsectionDescription = "Published opinion pieces in newspapers and magazines." %}
        {% set subsectionItems = model.writings.groups.opinion.latestItems %}
        {% set subsectionCount = model.writings.groups.opinion.count %}
        {% set subsectionArchiveUrl = "/en/writings/#opinion" %}
        {% set subsectionArchiveLabel = "Show all opinion pieces" %}
        {% set subsectionLang = "en" %}
        {% set subsectionEmptyText = "No English opinion pieces yet." %}
        {% include "kynasta-hub-subsection.njk" %}
      </div>
      <div class="col-md-6 col-lg-4">
        {% set subsectionHeading = "Columns and guest posts" %}
        {% set subsectionDescription = "Columns for magazines and guest posts on other blogs." %}
        {% set subsectionItems = model.writings.groups.column.latestItems %}
        {% set subsectionCount = model.writings.groups.column.count %}
        {% set subsectionArchiveUrl = "/en/writings/#column" %}
        {% set subsectionArchiveLabel = "Show all columns" %}
        {% set subsectionLang = "en" %}
        {% set subsectionEmptyText = "No English columns yet." %}
        {% include "kynasta-hub-subsection.njk" %}
      </div>
    </div>
  </div>
</section>

