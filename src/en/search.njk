---
layout: base.njk
title: Search the site
metaTitle: Search the site
description: "Search Jari Laru's site for writings, speeches, media appearances, presentations, and scientific publications."
permalink: /en/search/
translationKey: search
lang: en
robots: noindex, follow
pageStyles:
  - /pagefind/pagefind-modular-ui.css
pageScripts:
  - /js/search-result-presenter.js
  - /js/global-search-modular-ui.js
---

<section class="content-detail-hero content-detail-hero--search py-5 border-bottom">
  <div class="site-shell">
    <div>
      <p class="content-detail-eyebrow mb-2">Site search</p>
      <h1 class="content-detail-title mb-3">Search the site</h1>
      <p class="content-detail-lead mb-0">Search for writings, speeches, media appearances, presentations, and scientific publications. Over 2,500 pages of content indexed.</p>
    </div>
  </div>
</section>

<section class="py-4">
  <div class="site-shell">
    <form class="card border-0 shadow-sm mb-4 site-search-page-fallback" action="/en/search/" method="get" role="search" data-search-page-fallback>
      <div class="card-body p-3 p-md-4">
        <label class="form-label fw-semibold" for="siteSearchFallbackInputEn">Search term</label>
        <div class="input-group input-group-lg">
          <input
            id="siteSearchFallbackInputEn"
            class="form-control"
            type="search"
            name="q"
            placeholder="Type a search term..."
            autocomplete="off"
            data-search-page-fallback-input
          >
          <button class="btn btn-primary px-4" type="submit">
            <i class="bi bi-search me-1" aria-hidden="true"></i>Search
          </button>
        </div>
        <p class="form-text mb-0 mt-2">Search works best when the site index has loaded. You can search for writings, presentations, media appearances, or publications.</p>
      </div>
    </form>
    {% include "_search-page-config.njk" %}
    <div
      id="siteSearchPageUi"
      class="site-search-page-ui"
    ></div>
    <noscript>
      <p class="alert alert-warning mt-3">Search requires JavaScript. Please enable JavaScript to use search.</p>
    </noscript>
  </div>
</section>
