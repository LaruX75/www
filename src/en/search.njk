---
layout: base.njk
title: Search the site
metaTitle: Search the site
description: "Search Jari Laru's site for writings, speeches, media appearances, presentations, and scientific publications."
permalink: /en/search/
translationKey: search
lang: en
robots: noindex, follow
suppressSubpageHero: true
---

<section class="py-4">
  <div class="site-shell">
    <h1 class="h2 mb-2">Search the site</h1>
    <p class="text-body-secondary mb-4">Search for writings, presentations, media appearances, theses, and scientific publications.</p>

    {% include "_search-page-config.njk" %}

    <form class="input-group input-group-lg mb-3 site-search-page-shell"
          role="search"
          action="/en/search/"
          method="get"
          data-search-page-fallback>
      <label for="siteSearchPageInput" class="visually-hidden">Search term</label>
      <input
        id="siteSearchPageInput"
        class="form-control"
        type="search"
        name="q"
        placeholder="Type a search term..."
        aria-label="Search the site"
        autocomplete="off"
        data-search-page-fallback-input
        data-search-modular-input
      >
      <button class="btn btn-primary px-4" type="submit">
        <i class="bi bi-search me-1" aria-hidden="true"></i>Search
      </button>
    </form>

    <div
      id="siteSearchPageUi"
      class="site-search-page-ui"
    ></div>

    <noscript>
      <p class="alert alert-warning mt-3">Search requires JavaScript. Please enable JavaScript to use search.</p>
    </noscript>
  </div>
</section>
