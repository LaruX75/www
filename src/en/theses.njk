---
layout: base.njk
title: Supervised Theses
description: "Master's theses and bachelor's theses supervised by Jari Laru from OuluREPO, searchable by year, keyword, and topic."
translationKey: theses_index
lang: en
suppressTableFilters: true
pageStyles:
  - /css/theses-page.css
  - /css/find-explore.css
pageScripts:
  # TH-CITE1 Phase 4B: thesis-hub-actions.js moved to the thesis
  # detail template. The archive has no citation triggers after
  # Phase 3 and does not ship the modal interaction JS anymore.
  - /js/find-explore.js
schemaType: CollectionPage
pagination:
  data: thesesArchivePagesEn.pages
  size: 1
  alias: thesesArchive
permalink: "{{ thesesArchive.permalink }}"
eleventyComputed:
  eleventyExcludeFromCollections: "{{ 'true' if thesesArchive.pageKind != 'landing' else '' }}"
  sitemap:
    ignore: "{{ 'true' if thesesArchive.pageKind != 'landing' else '' }}"
  robots: "{{ 'noindex, follow' if thesesArchive.pageKind != 'landing' else 'index, follow' }}"
---
{% set pageModel = thesesFindExplorePage %}
{% set findExploreKind = "theses" %}
{% set findExploreScope = "en" %}
{% set findExploreLang = "en" %}
{% set findExploreSearchLanguage = "fi,en" %}
{% set findExploreEyebrow = "Find & Explore" %}
{% set findExploreTitle = "Explore theses" %}
{% set findExploreDescription = "Type a query or use the filters. Search runs against the same canonical thesis set as the archive tables." %}
{% set findExploreSearchLabel = "Search by title, author or topic" %}
{% set findExplorePlaceholder = "Try AI, teacher education, mathematics, Riikonen..." %}
{% set findExploreTypeLabel = "Type" %}
{% set findExploreAllTypesLabel = "All theses" %}
{% set findExploreRoleLabel = "Role" %}
{% set findExploreAllRolesLabel = "All roles" %}
{% set findExploreYearLabel = "Year" %}
{% set findExploreAllYearsLabel = "All years" %}
{% set findExploreTopicLabel = "Topic" %}
{% set findExploreAllTopicsLabel = "All topics" %}
{% set findExploreResetLabel = "Clear" %}
{% set findExploreMoreLabel = "Show more" %}
{% set findExploreInitialStatus = "The canonical archive table is visible below. A query or filter replaces the same table rows with Pagefind matches; Clear restores the server-rendered rows already on this page." %}
{% set findExploreNoScript = "Interactive search requires JavaScript. The archive tables and their pagination remain available without JavaScript." %}
{% set findExploreHideTypeControl = true %}
{% set findExploreHideRoleControl = true %}
{% set findExploreHideYearControl = true %}
{% set findExploreExternalYearOrderId = "thesesArchiveYearOrderEn" %}
{% set findExploreExternalAuthorSortId = "thesesArchiveAuthorSortEn" %}
{% set findExploreExternalTypeRoleId = "thesesArchiveTypeRoleEn" %}
{% set findExploreTypeOptions = [
  { value: "masterThesis", label: "Master's theses", count: pageModel.typeCounts.masterThesis },
  { value: "bachelorThesis", label: "Bachelor's theses", count: pageModel.typeCounts.bachelorThesis }
] %}
{% set findExploreRoleOptions = [
  { value: "advised", label: "Supervised", count: pageModel.roleCounts.advised },
  { value: "reviewed", label: "Reviewed", count: pageModel.roleCounts.reviewed }
] %}
{% set findExploreYears = pageModel.years %}
{% set findExploreTopicOptions = pageModel.topicOptions %}
{% set findExploreExternalResultsId = "thesesArchiveTbodyEn" %}

<section class="kynasta-hero py-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-1">Supervision</p>
        <h1 class="display-6 fw-bold mb-2">Supervised theses</h1>
        <p class="text-muted mb-0">A single local archive table for OuluREPO-based supervision work. The thesis title opens the site's canonical detail page, while the original OuluREPO source stays available as a separate external action.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-4">
  <div class="site-shell">
    <div class="row g-3 thesis-stats-row">
      <div class="col-6 col-md-3">
        <div class="card text-center border-primary h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-primary">{{ pageModel.advisedMasterItems.length }}</div>
            <div class="text-muted">Master's theses</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center border-info h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-info">{{ pageModel.advisedBachelorItems.length }}</div>
            <div class="text-muted">Bachelor's theses</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold">{{ pageModel.count }}</div>
            <div class="text-muted">theses in total</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center border-secondary h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-secondary">{{ pageModel.reviewedItems.length }}</div>
            <div class="text-muted">reviewed theses</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pb-4">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <p class="text-uppercase small text-muted mb-1">Opening routes</p>
            <h2 class="h4 mb-1">Topic entry points</h2>
            <p class="text-muted mb-0">Category chips lead to topic-scoped search pages. The archive tables below serve as the primary browsing view.</p>
          </div>
          <span class="badge text-bg-light border text-dark">{{ theses.stats.firstYear }}–{{ theses.stats.lastYear }}</span>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          {% for option in pageModel.topicHighlights %}
          <a href="/en/categories/{{ option.value | slugify }}/" class="btn btn-outline-secondary btn-sm rounded-pill">{{ option.label }} <span class="text-muted">({{ option.count }})</span></a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% include "find-explore-writings.njk" %}

{% set thesisArchiveTableId = "thesesArchiveTableEn" %}
{% set thesisArchiveTbodyId = "thesesArchiveTbodyEn" %}
{% set thesisArchiveHeading = "Thesis archive" %}
{% set thesisArchiveDescription = "One server-rendered archive table shows the same canonical thesis set that Find & Explore uses during active search." %}
{% set thesisArchiveLang = "en" %}
{% set thesisArchiveLandingUrl = "/en/theses/" %}
{% set thesisArchivePageBase = "/en/theses/page/" %}
{% set thesisArchiveYearOrderId = "thesesArchiveYearOrderEn" %}
{% set thesisArchiveAuthorSortId = "thesesArchiveAuthorSortEn" %}
{% set thesisArchiveTypeRoleId = "thesesArchiveTypeRoleEn" %}
{% set thesisArchiveTypeRoleOptions = pageModel.typeRoleOptionsEn %}
{% include "thesis-archive-table.njk" %}

<section class="pb-5">
  <div class="site-shell">
    <p class="text-muted small mb-0">
      Source: <a href="https://oulurepo.oulu.fi" target="_blank" rel="noopener noreferrer" class="text-decoration-underline">OuluREPO</a>, University of Oulu publication archive. Canonical metadata, abstract provenance and source semantics remain on the thesis detail layer.
    </p>
  </div>
 </section>
{# TH-CITE1 Phase 4B: modals no longer live on the archive page.
   The citation/export modal is now scoped to the thesis detail
   template where the trigger exists. #}
