---
layout: base.njk
title: Supervised Theses
description: "Master's theses and bachelor's theses supervised by Jari Laru from OuluREPO, searchable by year, keyword, and topic."
permalink: /en/theses/
translationKey: theses_index
lang: en
suppressTableFilters: true
pageStyles:
  - /css/theses-page.css
  - /css/find-explore.css
pageScripts:
  - /js/find-explore.js
  - /js/thesis-hub-actions.js
schemaType: CollectionPage
---
{% set pageModel = thesesFindExplorePage %}
{% set findExploreKind = "theses" %}
{% set findExploreScope = "en" %}
{% set findExploreLang = "en" %}
{% set findExploreSearchLanguage = "fi,en" %}
{% set findExploreSeedQuery = "__find_explore_theses__" %}
{% set findExploreEyebrow = "Find & Explore" %}
{% set findExploreTitle = "Explore theses" %}
{% set findExploreDescription = "Search supervised theses by title, author or topic, or browse by year and thesis type. Results always lead to the local canonical thesis detail page." %}
{% set findExploreSearchLabel = "Search by title, author or topic" %}
{% set findExplorePlaceholder = "Try AI, teacher education, mathematics, Riikonen..." %}
{% set findExploreTypeLabel = "Type" %}
{% set findExploreAllTypesLabel = "All theses" %}
{% set findExploreYearLabel = "Year" %}
{% set findExploreAllYearsLabel = "All years" %}
{% set findExploreTopicLabel = "Topic" %}
{% set findExploreAllTopicsLabel = "All topics" %}
{% set findExploreResetLabel = "Clear" %}
{% set findExploreMoreLabel = "Show more" %}
{% set findExploreInitialStatus = "You can type a query or browse with filters only. The curated opening sections below remain useful without JavaScript." %}
{% set findExploreNoScript = "Interactive Find & Explore requires JavaScript. The introductory sections and normal thesis detail links remain available." %}
{% set findExploreTypeOptions = [
  { value: "masterThesis", label: "Master's theses", count: pageModel.typeCounts.masterThesis },
  { value: "bachelorThesis", label: "Bachelor's theses", count: pageModel.typeCounts.bachelorThesis }
] %}
{% set findExploreYears = pageModel.years %}
{% set findExploreTopicOptions = pageModel.topicOptions %}

<section class="kynasta-hero py-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-1">Supervision</p>
        <h1 class="display-6 fw-bold mb-2">Supervised theses</h1>
        <p class="text-muted mb-0">A local thesis hub for OuluREPO-based supervision work. Search results point first to the site's own thesis detail page, and the original OuluREPO record remains one clear click away there.</p>
      </div>
      <div class="col-lg-4">
        <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
          <a class="nav-link" href="#masters">Master's <span class="nav-count">{{ theses.stats.totalGradut }}</span></a>
          <a class="nav-link" href="#bachelors">Bachelor's <span class="nav-count">{{ theses.stats.totalKandit }}</span></a>
          {% if pageModel.reviewedItems.length %}
          <a class="nav-link" href="#reviewed">Reviewed <span class="nav-count">{{ theses.stats.totalReviewer }}</span></a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-4">
  <div class="site-shell">
    <div class="row g-3 thesis-stats-row">
      <div class="col-6 col-md-3">
        <div class="card text-center border-primary h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-primary">{{ theses.stats.totalGradut }}</div>
            <div class="text-muted">Master's theses</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center border-info h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-info">{{ theses.stats.totalKandit }}</div>
            <div class="text-muted">Bachelor's theses</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold">{{ pageModel.count }}</div>
            <div class="text-muted">theses in total</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center border-secondary h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-secondary">{{ theses.stats.totalReviewer }}</div>
            <div class="text-muted">reviewed theses</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pb-4">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <p class="text-uppercase small text-muted mb-1">Opening routes</p>
            <h2 class="h4 mb-1">Topic entry points and recent work</h2>
            <p class="text-muted mb-0">The interactive search layer is an enhancement. These links remain ordinary SSR HTML and work as navigable opening routes even without JavaScript.</p>
          </div>
          <span class="badge text-bg-light border text-dark">{{ theses.stats.firstYear }}–{{ theses.stats.lastYear }}</span>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          {% for option in pageModel.topicHighlights %}
          <a href="/en/categories/{{ option.value | slugify }}/" class="btn btn-outline-secondary btn-sm rounded-pill">{{ option.label }} <span class="text-muted">({{ option.count }})</span></a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% include "find-explore-writings.njk" %}

<section id="masters" class="bg-body-tertiary py-4">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Supervised master's theses</h2>
            <p class="text-muted mb-0">A curated SSR opening to the most recent supervised master's theses. Find & Explore covers the full canonical set.</p>
          </div>
          <span class="badge text-bg-primary">{{ theses.stats.totalGradut }}</span>
        </div>
        {% set thesisItems = pageModel.opening.advisedMasterItems %}
        {% set thesisLang = "en" %}
        {% set thesisEmptyLabel = "No master's theses available." %}
        {% include "thesis-curated-list.njk" %}
      </div>
    </div>
  </div>
</section>

<section id="bachelors" class="py-4">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1"><i class="bi bi-book-half me-2 text-info"></i>Supervised bachelor's theses</h2>
            <p class="text-muted mb-0">Recent bachelor's theses with the same local-detail-first routing model as the Finnish archive view.</p>
          </div>
          <span class="badge text-bg-info">{{ theses.stats.totalKandit }}</span>
        </div>
        {% set thesisItems = pageModel.opening.advisedBachelorItems %}
        {% set thesisLang = "en" %}
        {% set thesisEmptyLabel = "No bachelor's theses available." %}
        {% include "thesis-curated-list.njk" %}
      </div>
    </div>
  </div>
</section>

{% if pageModel.reviewedItems.length %}
<section id="reviewed" class="bg-body-tertiary py-4">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1"><i class="bi bi-eye-fill me-2 text-secondary"></i>Reviewed theses</h2>
            <p class="text-muted mb-0">A separate opening series for theses where Jari Laru acted as reviewer rather than primary supervisor.</p>
          </div>
          <span class="badge text-bg-secondary">{{ theses.stats.totalReviewer }}</span>
        </div>
        {% set thesisItems = pageModel.opening.reviewedItems %}
        {% set thesisLang = "en" %}
        {% set thesisEmptyLabel = "No reviewed theses available." %}
        {% include "thesis-curated-list.njk" %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="pb-5">
  <div class="site-shell">
    <p class="text-muted small mb-0">
      Source: <a href="https://oulurepo.oulu.fi" target="_blank" rel="noopener noreferrer" class="text-decoration-underline">OuluREPO</a>, University of Oulu publication archive. Canonical metadata, abstract provenance and source semantics remain on the thesis detail layer.
    </p>
  </div>
 </section>
{% include "thesis-hub-modals.njk" %}
