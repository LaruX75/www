---
layout: base.njk
title: Supervised Theses
description: "Master's theses and bachelor's theses supervised by Jari Laru plus reviewed works. Latest picks per group with links to full paginated archives."
translationKey: theses_index
lang: en
suppressTableFilters: true
pageStyles:
  - /css/theses-page.css
  - /css/find-explore.css
pageScripts:
  - /js/find-explore.js
schemaType: CollectionPage
permalink: "/en/theses/"
---
{# THESIS-HUB-02: standalone EN hub landing.
   Mirrors src/opinnaytteet.njk. Three subarchives own paginated routes:
     /en/theses/masters/    (supervised master's theses)
     /en/theses/bachelors/  (supervised bachelor's theses)
     /en/theses/reviewed/   (reviewed, not supervised)
   Hub sections show the 5 newest per group from the same canonical model. #}
{% set pageModel = thesesFindExplorePage %}
{# THESIS-HUB-02 hub FE: complete canonical thesis set, no type/role pin. #}
{% set findExploreKind = "theses" %}
{% set findExploreScope = "en" %}
{% set findExploreLang = "en" %}
{% set findExploreSearchLanguage = "fi,en" %}
{% set findExploreEyebrow = "Find & Explore" %}
{% set findExploreTitle = "Search theses" %}
{% set findExploreDescription = "Search theses by title, author or topic. You can narrow the results by year and topic." %}
{% set findExploreSearchLabel = "Search by title, author or topic" %}
{% set findExplorePlaceholder = "Try AI, teacher education, mathematics..." %}
{% set findExploreYearLabel = "Year" %}
{% set findExploreAllYearsLabel = "All years" %}
{% set findExploreTopicLabel = "Topic" %}
{% set findExploreAllTopicsLabel = "All topics" %}
{% set findExploreResetLabel = "Clear" %}
{% set findExploreMoreLabel = "Show more" %}
{% set findExploreInitialStatus = "Type a query or use the filters." %}
{% set findExploreNoScript = "Interactive search requires JavaScript. The group-scoped archives below remain available without it." %}
{% set findExploreHideTypeControl = true %}
{% set findExploreHideRoleControl = true %}
{% set findExploreHideYearControl = false %}
{# THESIS-SEARCH-UX-01: eager Pagefind warmup on the dedicated thesis
   search surface. Bypasses the 2.5-second idle-callback ceiling that
   dominated first-search latency. Still no auto-search. #}
{% set findExploreEagerWarmup = true %}
{% set findExploreYears = pageModel.years %}
{% set findExploreTopicOptions = pageModel.topicOptions %}
{% set hubMasters = thesisDetails.advisedMasters or [] %}
{% set hubBachelors = thesisDetails.advisedBachelors or [] %}
{% set hubReviewed = thesisDetails.reviewed or [] %}

<section class="kynasta-hero py-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-1">Supervision</p>
        <h1 class="display-6 fw-bold mb-2">Supervised theses</h1>
        <p class="text-muted mb-0">OuluREPO-based view of theses supervised or reviewed by Jari Laru. The five newest works per group are highlighted below; the full archive per group is one link away. Thesis titles open the site's canonical detail page while the original OuluREPO record stays available as a separate external action.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-4">
  <div class="site-shell">
    <div class="row g-3 thesis-stats-row">
      <div class="col-6 col-md-3">
        <div class="card text-center border-primary h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-primary">{{ hubMasters.length }}</div>
            <div class="text-muted">Master's theses</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center border-info h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-info">{{ hubBachelors.length }}</div>
            <div class="text-muted">Bachelor's theses</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold">{{ thesisDetails.count }}</div>
            <div class="text-muted">theses in total</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card text-center border-secondary h-100 thesis-stat-card">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="display-4 fw-bold text-secondary">{{ hubReviewed.length }}</div>
            <div class="text-muted">reviewed theses</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pb-4">
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <p class="text-uppercase small text-muted mb-1">Opening routes</p>
            <h2 class="h4 mb-1">Topic entry points</h2>
            <p class="text-muted mb-0">Category chips lead to topic-scoped search pages. The group-scoped archives below serve as the primary browsing view.</p>
          </div>
          <span class="badge text-bg-light border text-dark">{{ theses.stats.firstYear }}–{{ theses.stats.lastYear }}</span>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          {% for option in pageModel.topicHighlights %}
          <a href="/en/categories/{{ option.value | slugify }}/" class="btn btn-outline-secondary btn-sm rounded-pill">{{ option.label }} <span class="text-muted">({{ option.count }})</span></a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% include "find-explore-writings.njk" %}

{% macro renderHubSection(heading, description, items, archiveUrl, archiveCtaLabel, totalCount) %}
<section class="thesis-hub-section py-4" data-thesis-hub-section>
  <div class="site-shell">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h4 mb-1">{{ heading }}</h2>
            <p class="text-muted mb-0">{{ description }}</p>
          </div>
          <span class="badge text-bg-light border text-dark">{{ totalCount }}</span>
        </div>
        {% if items.length %}
        <div class="table-responsive">
          <table class="table table-sm thesis-archive-table align-top mb-0">
            <thead>
              <tr>
                <th scope="col" class="thesis-archive-col-year">Year</th>
                <th scope="col" class="thesis-archive-col-author">Author</th>
                <th scope="col" class="thesis-archive-col-title">Title</th>
                <th scope="col" class="thesis-archive-col-source text-end">Source</th>
              </tr>
            </thead>
            <tbody>
              {% for item in items %}
              <tr class="thesis-archive-row">
                <td class="thesis-archive-col-year small text-muted"><span class="d-inline-block">{{ item.year }}</span></td>
                <td class="thesis-archive-col-author small text-muted">{{ item.authorLine }}</td>
                <th scope="row" class="thesis-archive-col-title">
                  <a class="thesis-archive-title-link fw-semibold text-decoration-none d-block" href="{{ item.pageUrl }}">{{ item.title }}</a>
                </th>
                <td class="thesis-archive-col-source text-end">
                  {% if item.sourceUrl %}
                  <a class="btn btn-sm btn-outline-secondary"
                     href="{{ item.sourceUrl }}"
                     target="_blank"
                     rel="noopener noreferrer"
                     aria-label="Open in OuluREPO: {{ item.title }}">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    <span class="ms-1">OuluREPO</span>
                  </a>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <p class="text-muted small mb-0">No theses in this group yet.</p>
        {% endif %}
        <div class="mt-3">
          <a class="btn btn-outline-primary btn-sm" href="{{ archiveUrl }}">
            {{ archiveCtaLabel }} <span class="text-muted">({{ totalCount }})</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endmacro %}

{{ renderHubSection(
  "Latest supervised master's theses",
  "Five newest supervised master's theses. Full archive available with pagination.",
  hubMasters.slice(0, 5),
  "/en/theses/masters/",
  "Browse all master's theses",
  hubMasters.length
) }}

{{ renderHubSection(
  "Latest supervised bachelor's theses",
  "Five newest supervised bachelor's theses. Full archive available with pagination.",
  hubBachelors.slice(0, 5),
  "/en/theses/bachelors/",
  "Browse all bachelor's theses",
  hubBachelors.length
) }}

{{ renderHubSection(
  "Latest reviewed theses",
  "Five newest works where Jari Laru served as a reviewer (not as supervisor).",
  hubReviewed.slice(0, 5),
  "/en/theses/reviewed/",
  "Browse all reviewed theses",
  hubReviewed.length
) }}

<section class="pb-5">
  <div class="site-shell">
    <p class="text-muted small mb-0">
      Source: <a href="https://oulurepo.oulu.fi" target="_blank" rel="noopener noreferrer" class="text-decoration-underline">OuluREPO</a>, University of Oulu publication archive. Canonical metadata, abstract provenance and source semantics remain on the thesis detail layer.
    </p>
  </div>
</section>
