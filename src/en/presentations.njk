---
layout: base.njk
title: Presentations
description: Jari Laru presentations and open learning materials — Canva, AOE, Google Slides and SlideShare
permalink: /en/presentations/
translationKey: presentations_index
lang: en
pageStyles:
  - /css/presentations-page.css
schemaType: CollectionPage
---

{% set tocSource %}
<h2 id="aoe-heading">AOE Learning Materials</h2>
<h2 id="canva-heading">Canva Presentations</h2>
<h2 id="slideshare-heading">SlideShare Presentations</h2>
<h2 id="youtube-heading">YouTube Videos</h2>
{% endset %}
{% set tocMarkup = tocSource | toc %}

{% set pageModel = presentationsPage %}
{% set canonicalItems = (pageModel and pageModel.items) or [] %}
{% set aoeItems = [] %}
{% set enCanvaItems = [] %}
{% set slideshareItems = [] %}
{% set youtubeVideoItems = [] %}
{% set youtubePlaylistItems = [] %}
{% set localPresentationPageItems = [] %}
{% for item in canonicalItems %}
  {% if item.pageUrl %}
    {% set _ = (localPresentationPageItems.push(item), null) %}
  {% endif %}
  {% if item.sourceKey == "aoe" %}
    {% set _ = (aoeItems.push(item), null) %}
  {% elif item.sourceKey == "canva" and item.lang == "en" %}
    {% set _ = (enCanvaItems.push(item), null) %}
  {% elif item.sourceKey == "slideshare" %}
    {% set _ = (slideshareItems.push(item), null) %}
  {% elif item.sourceKey == "youtubeVideos" %}
    {% set _ = (youtubeVideoItems.push(item), null) %}
  {% elif item.sourceKey == "youtube" %}
    {% set _ = (youtubePlaylistItems.push(item), null) %}
  {% endif %}
{% endfor %}

<div class="site-shell py-5">
  <header class="mb-5 text-center">
    <h1 class="display-4 fw-bold mb-3">Presentations and Learning Materials</h1>
    <p class="lead text-muted">Presentations, open learning materials and more from various platforms.</p>
  </header>

  {% if tocMarkup %}
  <div class="row justify-content-center mb-5">
    <div class="col-lg-8">
      <aside class="card border-0 bg-light">
        <div class="card-body p-3">
          <p class="text-uppercase small text-muted mb-2">On this page</p>
          {{ tocMarkup | safe }}
        </div>
      </aside>
    </div>
  </div>
  {% endif %}

  {# ===================== AOE ===================== #}
  <section class="mb-5" aria-labelledby="aoe-heading">
    <h2 id="aoe-heading" class="section-title mb-4">
      <i class="bi bi-book-fill text-success me-2" style="font-size: 1rem;"></i>AOE Learning Materials
    </h2>
    {% if aoeItems.length %}
      <div id="featured-aoe"></div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Description</th>
              <th class="text-nowrap">Date / year</th>
              <th class="text-nowrap">Open</th>
            </tr>
          </thead>
          <tbody id="table-body-aoe"></tbody>
        </table>
      </div>
      <nav class="mt-3" aria-label="AOE pagination">
        <ul class="pagination pagination-sm mb-0" id="pagination-aoe"></ul>
      </nav>
      <div class="mt-3 text-muted small">
        Source: <a href="https://www.finna.fi/" target="_blank" rel="noopener noreferrer">Finna</a> / <a href="https://aoe.fi/" target="_blank" rel="noopener noreferrer">Open Educational Resources Library (AOE)</a>.
      </div>
    {% else %}
      <p class="text-muted">No AOE learning materials available.</p>
    {% endif %}
  </section>

  {# ===================== CANVA ===================== #}
  <section class="mb-5" aria-labelledby="canva-heading">
    <h2 id="canva-heading" class="section-title mb-4">
      <i class="bi bi-star-fill text-warning me-2" style="font-size: 1rem;"></i>Canva Presentations
    </h2>

    {# CTA card: Canva analysis #}
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning">
      <div class="card-body p-4">
        <div class="row align-items-center g-3">
          <div class="col-auto d-none d-sm-block">
            <i class="bi bi-bar-chart-line text-warning" style="font-size:2rem;"></i>
          </div>
          <div class="col">
            <p class="text-uppercase text-muted fw-semibold small mb-1">Analysis</p>
            <h3 class="h5 fw-bold mb-1">Canva presentations 2021–2026 – 83 presentations analysed</h3>
            <p class="text-muted small mb-0">Topics, trajectories, most extensive presentations and common threads — the decade of AI literacy.</p>
          </div>
          <div class="col-12 col-sm-auto">
            <a href="/esitykset/canva-analyysi/" class="btn btn-warning btn-sm px-3 text-dark">
              Read analysis in Finnish <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    {% if enCanvaItems.length %}
      <div id="featured-canva"></div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th class="text-center" style="width:140px">Date</th>
              <th style="min-width:170px">Preview</th>
              <th style="min-width:200px;max-width:260px;">Title</th>
              <th style="min-width:220px">Summary</th>
              <th style="min-width:190px">Keywords</th>
              <th style="width:90px" class="text-center">Open</th>
            </tr>
          </thead>
          <tbody id="table-body-canva"></tbody>
        </table>
      </div>
      <nav class="mt-3" aria-label="Canva pagination">
        <ul class="pagination pagination-sm mb-0" id="pagination-canva"></ul>
      </nav>
      <div class="mt-3 text-muted small">
        Source: Canva (JSON).
      </div>
    {% else %}
      <p class="text-muted">No Canva presentations available.</p>
    {% endif %}
  </section>


  {# ================= SLIDESHARE ================== #}
  <section class="mb-5" aria-labelledby="slideshare-heading">
    <h2 id="slideshare-heading" class="section-title mb-4">
      <i class="bi bi-collection-play me-2" style="font-size: 1rem;"></i>SlideShare Presentations
    </h2>

    {# CTA card: SlideShare analysis #}
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-primary">
      <div class="card-body p-4">
        <div class="row align-items-center g-3">
          <div class="col-auto d-none d-sm-block">
            <i class="bi bi-bar-chart-line text-primary" style="font-size:2rem;"></i>
          </div>
          <div class="col">
            <p class="text-uppercase text-muted fw-semibold small mb-1">Analysis</p>
            <h3 class="h5 fw-bold mb-1">SlideShare presentations 2009–2020 – 117 presentations analysed</h3>
            <p class="text-muted small mb-0">Topics, trajectories, most-viewed presentations and common threads by decade — from mobile learning to AI.</p>
          </div>
          <div class="col-12 col-sm-auto">
            <a href="/esitykset/slideshare-analyysi/" class="btn btn-primary btn-sm px-3">
              Read analysis in Finnish <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    {% if slideshareItems.length %}
      <div id="featured-slideshare"></div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th class="text-center" style="width:140px">Date</th>
              <th style="min-width:170px">Preview</th>
              <th style="min-width:200px;max-width:260px;">Title</th>
              <th style="min-width:220px">Summary</th>
              <th style="min-width:190px">Keywords</th>
              <th style="width:90px" class="text-center">Open</th>
            </tr>
          </thead>
          <tbody id="table-body-slideshare"></tbody>
        </table>
      </div>
      <nav class="mt-3" aria-label="SlideShare pagination">
        <ul class="pagination pagination-sm mb-0" id="pagination-slideshare"></ul>
      </nav>
    {% else %}
      <p class="text-muted">No SlideShare presentations available.</p>
    {% endif %}

    <div class="mt-4 text-center">
      <a href="https://www.slideshare.net/larux" target="_blank" rel="noopener noreferrer" class="btn btn-primary px-4 py-2">
        View all on SlideShare ({{ slideshareItems.length }}) <i class="bi bi-arrow-up-right"></i>
      </a>
    </div>
  </section>

  {# ===================== YOUTUBE ===================== #}
  <section class="mb-5" aria-labelledby="youtube-heading">
    <h2 id="youtube-heading" class="section-title mb-4">
      <i class="bi bi-youtube text-danger me-2" style="font-size: 1rem;"></i>YouTube Videos
    </h2>

    {% if youtubeVideoItems.length %}
      <div id="featured-youtubeVideos"></div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th style="min-width:140px">Preview</th>
              <th style="min-width:200px">Title</th>
              <th style="min-width:220px">Description</th>
              <th class="text-nowrap">Date</th>
              <th class="text-nowrap">Open</th>
            </tr>
          </thead>
          <tbody id="table-body-youtubeVideos"></tbody>
        </table>
      </div>
      <nav class="mt-3" aria-label="YouTube video pagination">
        <ul class="pagination pagination-sm mb-0" id="pagination-youtubeVideos"></ul>
      </nav>
      <div class="mt-3 text-muted small">
        Source: YouTube Data API v3.
      </div>
    {% endif %}

    {% if youtubePlaylistItems.length %}
      <h3 class="h6 text-uppercase text-muted fw-semibold mt-5 mb-2" style="letter-spacing:.04em;">Playlists</h3>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pub-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Description</th>
              <th class="text-nowrap">Date / year</th>
              <th class="text-nowrap">Open</th>
            </tr>
          </thead>
          <tbody id="table-body-youtube"></tbody>
        </table>
      </div>
      <nav class="mt-3" aria-label="YouTube pagination">
        <ul class="pagination pagination-sm mb-0" id="pagination-youtube"></ul>
      </nav>
    {% endif %}

    {% if not (youtubeVideoItems.length or youtubePlaylistItems.length) %}
      <div class="card border-0 bg-light-subtle">
        <div class="card-body">
          <p class="mb-2 fw-semibold">Could not fetch YouTube content.</p>
          <p class="text-muted mb-0 small">
            Set <code>YOUTUBE_API_KEY</code> and, if needed, <code>YOUTUBE_CHANNEL_ID</code> or <code>YOUTUBE_HANDLE</code>.
          </p>
        </div>
      </div>
    {% endif %}
  </section>

  {# Archive list: static link list for all presentation pages (SEO navigation) #}
  <section class="mb-5">
    <div class="site-shell">
      {% set archiveTotal = localPresentationPageItems.length + aoeItems.length + youtubePlaylistItems.length %}
      <details>
        <summary class="text-muted small py-2" style="cursor:pointer;">All presentations and materials as archive ({{ archiveTotal }})</summary>

        <div class="mt-3">
          <h3 class="h6 fw-bold">Presentation pages on this site</h3>
          <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mt-1">
            {% for item in localPresentationPageItems %}
              <li class="col">
                <a class="small fw-semibold text-decoration-none" href="{{ item.pageUrl }}">{{ item.title }}</a>
                <div class="small text-muted mt-1">
                  {{ item.sourceLabel or item.sourceKey or "presentation" }}{% if item.date %} · {{ item.date | dateFormat }}{% endif %}
                </div>
                {% if item.description %}
                  <div class="small text-muted">{{ item.description }}</div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>

        {% if aoeItems.length %}
          <div class="mt-4">
            <h3 class="h6 fw-bold">AOE learning materials</h3>
            <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mt-1">
              {% for row in aoeItems %}
                <li class="col">
                  <a class="small fw-semibold text-decoration-none" href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.title }}</a>
                  <div class="small text-muted mt-1">AOE / Finna{% if row.year or row.date %} · {{ row.year or row.date }}{% endif %}</div>
                  {% if row.description %}
                    <div class="small text-muted">{{ row.description }}</div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}


        {% if youtubePlaylistItems.length %}
          <div class="mt-4">
            <h3 class="h6 fw-bold">YouTube playlists</h3>
            <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mt-1">
              {% for row in youtubePlaylistItems %}
                <li class="col">
                  <a class="small fw-semibold text-decoration-none" href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.title }}</a>
                  <div class="small text-muted mt-1">YouTube{% if row.date or row.year %} · {{ row.date or row.year }}{% endif %}</div>
                  {% if row.description %}
                    <div class="small text-muted">{{ row.description }}</div>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </details>
    </div>
  </section>

</div>

<script>
(() => {
  const PAGE_SIZE = 6;
  const canonicalItems = {{ canonicalItems | jsonSafe | safe }};

  const sectionItems = {
    aoe: canonicalItems.filter((item) => item?.sourceKey === "aoe"),
    canva: canonicalItems.filter((item) => item?.sourceKey === "canva" && item?.lang === "en"),
    youtubeVideos: canonicalItems.filter((item) => item?.sourceKey === "youtubeVideos"),
    youtube: canonicalItems.filter((item) => item?.sourceKey === "youtube"),
    slideshare: canonicalItems.filter((item) => item?.sourceKey === "slideshare")
  };

  const iconByKey = {
    aoe: "bi-book",
    canva: "bi-file-earmark-slides",
    youtubeVideos: "bi-youtube",
    youtube: "bi-youtube",
    slideshare: "bi-collection-play"
  };

  const linkLabelByKey = {
    aoe: "Open in Finna",
    canva: "Open",
    youtubeVideos: "Watch",
    youtube: "YouTube",
    slideshare: "SlideShare"
  };

  function escHtml(value) {
    return String(value || "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function truncate(value, max = 120) {
    const text = String(value || "").trim();
    if (!text) return "";
    return text.length > max ? `${text.slice(0, max).trim()}…` : text;
  }

  function isExternalUrl(url) {
    return /^https?:\/\//i.test(String(url || ""));
  }

  function linkAttrs(url) {
    return isExternalUrl(url) ? ' target="_blank" rel="noopener noreferrer"' : "";
  }

  function primaryUrl(item) {
    return item.url || item.pageUrl || item.externalUrl || "";
  }

  function toIsoDate(value) {
    if (!value) return null;
    const raw = String(value).trim();
    if (/^\d{4}$/.test(raw)) return `${raw}-12-31`;
    if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;
    const parsed = new Date(raw);
    if (Number.isNaN(parsed.getTime())) return null;
    const year = parsed.getUTCFullYear();
    const month = String(parsed.getUTCMonth() + 1).padStart(2, "0");
    const day = String(parsed.getUTCDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function toDisplayDate(value) {
    if (!value) return "";
    const raw = String(value).trim();
    if (/^\d{4}$/.test(raw)) return raw;
    const iso = toIsoDate(raw);
    if (!iso) return raw;
    const parsed = new Date(iso);
    if (Number.isNaN(parsed.getTime())) return raw;
    return new Intl.DateTimeFormat("en-GB").format(parsed);
  }

  function sortByDateDesc(rows) {
    return [...rows].sort((a, b) => {
      const aDate = toIsoDate(a?.date || "") || "";
      const bDate = toIsoDate(b?.date || "") || "";
      const dateDiff = bDate.localeCompare(aDate);
      if (dateDiff !== 0) return dateDiff;
      return String(a?.title || "").localeCompare(String(b?.title || ""));
    });
  }

  function metaFor(item) {
    if (item?.sourceKey === "aoe") return "AOE / Learning material";
    if (item?.sourceKey === "canva") return "Canva";
    if (item?.sourceKey === "youtubeVideos") return "YouTube video";
    if (item?.sourceKey === "youtube") return `${item?.itemCount || 0} videos`;
    if (item?.sourceKey === "slideshare") return "SlideShare";
    return item?.sourceLabel || "";
  }

  function keywordsFor(item) {
    const values = [
      ...(Array.isArray(item?.categories) ? item.categories : []),
      ...(Array.isArray(item?.keywords) ? item.keywords : [])
    ].map((value) => String(value || "").trim()).filter(Boolean);
    return [...new Set(values)];
  }

  function pickFourRandom(rows) {
    if (!rows.length) return [];
    const shuffled = [...rows];
    for (let i = shuffled.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    const picked = shuffled.slice(0, Math.min(4, shuffled.length));
    while (picked.length < 4) {
      picked.push(shuffled[picked.length % shuffled.length]);
    }
    return picked;
  }

  function renderFeatured(key, rows) {
    const host = document.getElementById(`featured-${key}`);
    if (!host || !rows.length) return;
    const item = rows[0];
    const icon = escHtml(iconByKey[key] || "bi-file-earmark");
    const thumb = item.thumbnail
      ? `<img src="${escHtml(item.thumbnail)}" alt="${escHtml(item.title)}" class="featured-thumb" style="object-fit:cover;" loading="lazy" decoding="async" onerror="this.style.display='none';">`
      : `<div class="featured-thumb" style="background:var(--bs-secondary-bg);display:flex;align-items:center;justify-content:center;color:var(--bs-secondary-color);font-size:1.5rem;"><i class="bi ${icon}"></i></div>`;
    const label = escHtml(linkLabelByKey[key] || "Open");
    const desc = escHtml(truncate(item.description || metaFor(item) || "", 130));
    const href = primaryUrl(item);
    const buttonLabel = item.url ? label : "Open page";
    host.innerHTML = `
      <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <div class="d-flex align-items-stretch">
          <div class="flex-shrink-0 overflow-hidden">${thumb}</div>
          <div class="card-body py-2 px-3 d-flex flex-column justify-content-center">
            <p class="text-muted small mb-1">
              ${item.date ? `<i class="bi bi-calendar3 me-1"></i>${escHtml(toDisplayDate(item.date))}&ensp;` : ""}
              <span class="badge text-bg-warning text-dark fw-semibold" style="font-size:.65rem;">Latest</span>
            </p>
            <h3 class="h6 fw-bold mb-1 lh-sm">${escHtml(item.title)}</h3>
            ${desc ? `<p class="text-muted small mb-2">${desc}</p>` : ""}
            ${href ? `<a href="${escHtml(href)}"${linkAttrs(href)} class="btn btn-primary btn-sm rounded-pill px-3 align-self-start">${buttonLabel} <i class="bi bi-arrow-up-right"></i></a>` : ""}
          </div>
        </div>
      </div>`;
  }

  function renderScroller(key, rows) {
    const host = document.querySelector(`.presentation-scroller[data-key="${key}"] .presentation-scroller-track`);
    if (!host) return;
    const cards = pickFourRandom(rows);
    if (!cards.length) {
      host.innerHTML = "";
      return;
    }

    const htmlCards = cards.map((item) => {
      const thumb = item.thumbnail
        ? `<div class="scroller-media">
             <img src="${escHtml(item.thumbnail)}" class="card-img-top" alt="${escHtml(item.title)}" loading="lazy" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
             <div class="scroller-placeholder" style="display:none;"><i class="bi ${escHtml(iconByKey[key] || "bi-file-earmark")}"></i></div>
           </div>`
        : `<div class="scroller-placeholder"><i class="bi ${escHtml(iconByKey[key] || "bi-file-earmark")}"></i></div>`;
      const href = primaryUrl(item);
      const link = href
        ? `<a href="${escHtml(href)}"${linkAttrs(href)} class="btn btn-primary btn-sm rounded-pill px-3">${escHtml(item.url ? (linkLabelByKey[key] || "Open") : "Open page")} <i class="bi bi-arrow-up-right"></i></a>`
        : `<span class="text-muted small"><i class="bi bi-link-45deg"></i> No link</span>`;
      const pageLink = item.url && item.pageUrl
        ? `<a href="${escHtml(item.pageUrl)}" class="btn btn-outline-secondary btn-sm rounded-pill px-2 ms-1" title="Presentation page"><i class="bi bi-file-earmark-text"></i></a>`
        : "";
      return `
        <article class="card border-0 shadow-sm presentation-scroller-card">
          ${thumb}
          <div class="card-body p-3">
            <h3 class="h6 mb-1">${escHtml(item.title)}</h3>
            ${item.date ? `<p class="text-muted small mb-1"><i class="bi bi-calendar3 me-1"></i>${escHtml(toDisplayDate(item.date))}</p>` : ""}
            <p class="text-muted small mb-3">${escHtml(truncate(metaFor(item) || item.description, 72))}</p>
            ${link}${pageLink}
          </div>
        </article>
      `;
    }).join("");

    host.innerHTML = `${htmlCards}${htmlCards}`;
  }

  function renderPagination(key, rows, page, onChange) {
    const host = document.getElementById(`pagination-${key}`);
    if (!host) return;
    const pageCount = Math.ceil(rows.length / PAGE_SIZE);
    if (pageCount <= 1) {
      host.innerHTML = "";
      return;
    }

    let html = "";
    for (let p = 1; p <= pageCount; p += 1) {
      html += `
        <li class="page-item ${p === page ? "active" : ""}">
          <button class="page-link" type="button" data-page="${p}">${p}</button>
        </li>
      `;
    }
    host.innerHTML = html;
    host.querySelectorAll("button[data-page]").forEach((btn) => {
      btn.addEventListener("click", () => onChange(Number(btn.dataset.page)));
    });
  }

  function renderTable(key, rows, page, onChange) {
    const tbody = document.getElementById(`table-body-${key}`);
    if (!tbody) return;
    const start = (page - 1) * PAGE_SIZE;
    const pageRows = rows.slice(start, start + PAGE_SIZE);

    if (key === "youtubeVideos") {
      tbody.innerHTML = pageRows.map((item) => {
        const preview = item.thumbnail
          ? `<img src="${escHtml(item.thumbnail)}" alt="${escHtml(item.title)}" class="img-fluid border" style="max-height:72px;object-fit:cover;" loading="lazy" decoding="async" onerror="this.outerHTML='<span class=&quot;text-muted small&quot;>Not available</span>';">`
          : '<span class="text-muted small">Not available</span>';
        const desc = item.description ? escHtml(truncate(item.description, 140)) : '<span class="text-muted small">-</span>';
        return `
          <tr>
            <td class="small text-muted text-center" data-label="Preview">${preview}</td>
            <td class="fw-semibold" data-label="Title">${escHtml(item.title)}</td>
            <td class="small" data-label="Description">${desc}</td>
            <td class="text-nowrap" data-label="Date">${escHtml(toDisplayDate(item.date) || "-")}</td>
            <td data-label="Open">
              ${primaryUrl(item)
                ? `<a href="${escHtml(primaryUrl(item))}"${linkAttrs(primaryUrl(item))} class="btn btn-outline-primary btn-sm rounded-pill px-3">${item.url ? "Watch" : "Open page"}</a>`
                : `<span class="text-muted small">No link</span>`}
            </td>
          </tr>
        `;
      }).join("");
      renderPagination(key, rows, page, onChange);
      return;
    }

    if (key === "canva" || key === "slideshare") {
      tbody.innerHTML = pageRows.map((item) => {
        const keywords = keywordsFor(item);
        const keywordHtml = keywords.length
          ? keywords.map((k) => `<span class="badge text-bg-light text-dark border me-1 mb-1">${escHtml(k)}</span>`).join("")
          : '<span class="text-muted small">Not available</span>';
        const preview = item.thumbnail
          ? `<img src="${escHtml(item.thumbnail)}" alt="${escHtml(item.title)}" class="img-fluid border" style="max-height:72px;object-fit:cover;" loading="lazy" decoding="async" onerror="this.outerHTML='<span class=&quot;text-muted small&quot;>Not available</span>';">`
          : '<span class="text-muted small">Not available</span>';
        const summary = item.description ? escHtml(truncate(item.description, 220)) : '<span class="text-muted small">Not available</span>';
        return `
          <tr>
            <td class="text-center small text-muted font-monospace" data-label="Date">${escHtml(toDisplayDate(item.date) || "Not available")}</td>
            <td class="small text-muted text-center" data-label="Preview">${preview}</td>
            <td class="fw-semibold" data-label="Title">${escHtml(item.title)}</td>
            <td class="small" data-label="Summary">${summary}</td>
            <td data-label="Keywords">${keywordHtml}</td>
            <td class="text-center" data-label="Open">
              <div class="d-flex gap-1 justify-content-center flex-wrap">
              ${primaryUrl(item)
                ? `<a href="${escHtml(primaryUrl(item))}"${linkAttrs(primaryUrl(item))} class="btn btn-outline-primary btn-sm rounded-pill px-2" title="${item.url ? "Open presentation" : "Open page"}"><i class="bi bi-arrow-up-right"></i></a>`
                : `<span class="text-muted small">No link</span>`}
              ${item.url && item.pageUrl
                ? `<a href="${escHtml(item.pageUrl)}" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Presentation page"><i class="bi bi-file-earmark-text"></i></a>`
                : ""}
              </div>
            </td>
          </tr>
        `;
      }).join("");
    } else {
      tbody.innerHTML = pageRows.map((item) => `
        <tr>
          <td class="fw-semibold" data-label="Title">${escHtml(item.title)}</td>
          <td data-label="Description">
            <div class="small">${escHtml(truncate(item.description, 140) || "-")}</div>
            <div class="small text-muted">${escHtml(metaFor(item) || "")}</div>
          </td>
          <td class="text-nowrap" data-label="Date / year">${escHtml(toDisplayDate(item.date) || "-")}</td>
          <td data-label="Open">
            ${primaryUrl(item)
              ? `<a href="${escHtml(primaryUrl(item))}"${linkAttrs(primaryUrl(item))} class="btn btn-outline-primary btn-sm rounded-pill px-3">${escHtml(item.url ? (linkLabelByKey[key] || "Open") : "Open page")}</a>`
              : `<span class="text-muted small">No link</span>`}
          </td>
        </tr>
      `).join("");
    }

    renderPagination(key, rows, page, onChange);
  }

  Object.entries(sectionItems).forEach(([key, rows]) => {
    const sortedRows = sortByDateDesc(rows);
    if (!sortedRows.length) return;
    const hasFeatured = !!document.getElementById(`featured-${key}`);
    if (hasFeatured) renderFeatured(key, sortedRows);
    const rest = hasFeatured ? sortedRows.slice(1) : sortedRows;
    if (!rest.length) return;
    let currentPage = 1;
    const rerender = (newPage) => {
      currentPage = newPage;
      renderTable(key, rest, currentPage, rerender);
    };
    rerender(1);
  });
})();
</script>
