<span id="public-speeches"></span>
<section id="julkiset-puheet">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
        <div>
          <h2 class="h4 mb-1"><i class="bi bi-megaphone-fill me-2"></i>Public speeches</h2>
          <p class="small text-muted mb-0">Ceremonial speeches, university talks and other public addresses outside council meetings.</p>
        </div>
        <span class="badge text-bg-secondary">{{ publicSpeechCount }}</span>
      </div>
      <div class="card-body p-0">
        <div class="px-3 pt-3 pb-0">
          <p class="small text-muted mb-3">The linked speech texts and recordings are in Finnish. This section gives English navigation context for the original materials.</p>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table" data-no-header-filters>
            <thead>
              <tr>
                <th class="text-center" style="width:140px">Date</th>
                <th style="min-width:220px">Title</th>
                <th style="min-width:220px">Event</th>
                <th style="min-width:260px">Summary</th>
                <th style="width:90px" class="text-center">Read</th>
              </tr>
            </thead>
            <tbody id="public-speeches-tbody">
              {% for pub in pageModel.publicSpeechItems %}
                {% set href = pub.url %}
                <tr>
                  <td class="col-date text-center small text-muted font-monospace">{{ pub.date | dateFormat }}</td>
                  <td class="col-title fw-medium">
                    <a href="{{ href }}" class="text-decoration-none"{% if pub.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a>
                  </td>
                  <td class="small text-muted">{{ pub.event or pub.speechContext or "Public speech" }}</td>
                  <td class="small text-muted">{{ pub.description or "Public speech in Finnish." }}</td>
                  <td class="text-center">
                    <a href="{{ href }}" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Open original Finnish speech"{% if pub.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %}>
                      <i class="bi bi-arrow-{% if pub.isExternal %}up-right{% else %}right{% endif %}"></i>
                    </a>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">No public speeches listed yet.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

