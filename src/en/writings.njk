---
layout: base.njk
title: Writings and Speeches
description: "Jari Laru's writings, council speeches, political motions, blog posts, presentations, and open materials in one archive."
permalink: /en/writings/
translationKey: writings_index
lang: en
pageScripts:
  - /js/pe-list-render.js
  - /js/content-presets.js
  - /js/content-engine.js
schemaType: CollectionPage
---
{% set pageModel = englishWritingsPage %}
{% set uniqueMaterialKeys = [] %}
{% for row in (canva.tableRows or []) %}
  {% set key = (row.sourceUrl or row.url or row.pageUrl or row.title or ('canva-' ~ loop.index)) %}
  {% if key and (key not in uniqueMaterialKeys) %}
    {% set uniqueMaterialKeys = uniqueMaterialKeys.concat([key]) %}
  {% endif %}
{% endfor %}
{% for item in (collections.presentations or []) %}
  {% set key = (item.data.sourceUrl or item.data.url or item.url or item.fileSlug or ('slideshare-' ~ loop.index)) %}
  {% if key and (key not in uniqueMaterialKeys) %}
    {% set uniqueMaterialKeys = uniqueMaterialKeys.concat([key]) %}
  {% endif %}
{% endfor %}
{% for row in (aoeRows or []) %}
  {% set key = (row.url or row.title or ('aoe-' ~ loop.index)) %}
  {% if key and (key not in uniqueMaterialKeys) %}
    {% set uniqueMaterialKeys = uniqueMaterialKeys.concat([key]) %}
  {% endif %}
{% endfor %}
{% set totalMaterialsCount = uniqueMaterialKeys | length %}
{% set politicalOpinionCount = pageModel.politicalOpinionCount %}
{% set expertOpinionCount = pageModel.expertOpinionCount %}
{% set hybridOpinionCount = pageModel.hybridOpinionCount %}
{% set statementCount = pageModel.statementCount %}
{% set publicSpeechCount = pageModel.publicSpeechCount %}

<section class="kynasta-hero py-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-2">Writings</p>
        <h1 class="display-6 fw-bold mb-2">Writings, speeches and publications</h1>
        <p class="text-muted">A consolidated view of opinion pieces, columns, initiatives, speeches and publications.</p>
        <p class="small text-muted mb-0">This English view provides structure, summaries and metadata. Most full texts are original Finnish-language sources and are marked accordingly.</p>
      </div>
      <div class="col-lg-4">
        <nav class="nav nav-pills flex-wrap gap-2 justify-content-lg-end" aria-label="Writings section navigation">
          <a class="nav-link" href="#opinions">
            Opinions <span class="nav-count">{{ pageModel.opinionCount }}</span>
          </a>
          <a class="nav-link" href="#kolumnit">
            Columns <span class="nav-count">{{ pageModel.columnCount }}</span>
          </a>
          <a class="nav-link" href="#aloitteet">
            Initiatives <span class="nav-count">{{ pageModel.initiativeCount }}</span>
          </a>
          <a class="nav-link" href="#puheet">
            Speeches <span class="nav-count">{{ pageModel.speechCount }}</span>
          </a>
          <a class="nav-link" href="#lausunnot">
            Statements <span class="nav-count">{{ statementCount }}</span>
          </a>
          <a class="nav-link" href="#julkiset-puheet">
            Public speeches <span class="nav-count">{{ publicSpeechCount }}</span>
          </a>
          <a class="nav-link" href="#blogi">
            Blog <span class="nav-count">{{ pageModel.blogCount }}</span>
          </a>
          <a class="nav-link" href="#materials">
            Materials <span class="nav-count">{{ totalMaterialsCount }}</span>
          </a>
          <a class="nav-link" href="#publications">
            Publications <span class="nav-count">{{ pageModel.publicationCount }}</span>
          </a>
        </nav>
      </div>
    </div>
  </div>
</section>

<section id="materials" class="mb-5">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
        <h2 class="h4 mb-0"><i class="bi bi-book-fill me-2 text-info"></i>Presentations and learning materials</h2>
        <span class="badge text-bg-info text-dark">{{ totalMaterialsCount }}</span>
      </div>
      <div class="card-body">
        <p class="text-muted mb-3">This total combines Canva presentations, SlideShare presentations, and AOE/Finna learning materials.</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/en/presentations/" class="btn btn-outline-primary btn-sm rounded-pill">Open presentations</a>
          <a href="https://www.finna.fi/Search/Results?lookfor=Jari+Laru&type=Author&filter[]=format%3A%220%2FLearningMaterial%2F%22" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm rounded-pill">AOE / Finna <i class="bi bi-arrow-up-right"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<span id="statements"></span>
<section id="lausunnot">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
        <div>
          <h2 class="h4 mb-1"><i class="bi bi-file-earmark-text-fill me-2"></i>Statements</h2>
          <p class="small text-muted mb-0">Expert statements submitted to public consultation and preparation processes.</p>
        </div>
        <span class="badge text-bg-secondary">{{ statementCount }}</span>
      </div>
      <div class="card-body p-0">
        <div class="px-3 pt-3 pb-0">
          <p class="small text-muted mb-3">This English section provides navigation metadata and summaries. The linked original statement texts are mainly in Finnish.</p>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table" data-no-header-filters>
            <thead>
              <tr>
                <th class="text-center" style="width:140px">Date</th>
                <th style="min-width:220px">Title</th>
                <th style="min-width:240px">Summary / channel</th>
                <th style="min-width:180px">Reference</th>
                <th style="width:90px" class="text-center">Read</th>
              </tr>
            </thead>
            <tbody id="statements-tbody">
              {% for pub in pageModel.statementItems %}
                {% set href = pub.url %}
                <tr>
                  <td class="col-date text-center small text-muted font-monospace">{{ pub.date | dateFormat }}</td>
                  <td class="col-title fw-medium">
                    <a href="{{ href }}" class="text-decoration-none"{% if pub.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a>
                  </td>
                  <td class="small text-muted">
                    {{ pub.description or "Expert statement." }}
                  </td>
                  <td class="small text-muted">
                    {{ pub.publication or "Public consultation" }}
                  </td>
                  <td class="text-center">
                    <a href="{{ href }}" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Open original statement"{% if pub.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %}>
                      <i class="bi bi-arrow-{% if pub.isExternal %}up-right{% else %}right{% endif %}"></i>
                    </a>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">No statements listed yet.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

