<span id="mielipidekirjoitukset-eri-sanomalehdissa"></span>
<span id="opinions"></span>
<section id="mielipiteet">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
        <h2 class="h4 mb-0">Opinion pieces</h2>
        <span class="badge text-bg-secondary">{{ pageModel.opinionCount }}</span>
      </div>
      <div class="card-body p-0">
        <div class="px-3 pt-3 pb-0">
          <p class="small text-muted mb-3">
            {{ politicalOpinionCount }} texts are marked political, {{ expertOpinionCount }} expert-facing, and {{ hybridOpinionCount }} sit at the boundary of both roles.
          </p>
        </div>
        {# ---- Suodatuspalkki ---- #}
        <div class="p-3 bg-light border-bottom">
          <div class="row g-2 align-items-end">
            <div class="col-md-7">
              <label for="mielipiteet-search" class="form-label small text-muted mb-1">Search opinion pieces</label>
              <input type="search" id="mielipiteet-search" class="form-control form-control-sm"
                     placeholder="Search by title, summary, publication, categories..." autocomplete="off">
            </div>
            <div class="col-md-3">
              <label class="form-label small text-muted mb-1">Filter by role</label>
              <div class="btn-group btn-group-sm d-flex flex-wrap" role="group" aria-label="Opinion role">
                <button type="button" class="btn btn-outline-secondary active" data-opinion-role="all">All</button>
                <button type="button" class="btn btn-outline-secondary" data-opinion-role="political">Political</button>
                <button type="button" class="btn btn-outline-secondary" data-opinion-role="expert">Expert</button>
                <button type="button" class="btn btn-outline-secondary" data-opinion-role="hybrid">Political + expert</button>
              </div>
            </div>
            <div class="col-md-2 d-flex justify-content-md-end gap-2">
              <button id="mielipiteet-reset" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-circle me-1"></i>Clear
              </button>
            </div>
          </div>
        </div>

        {# ---- Taulukko ---- #}
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table mielipiteet-table">
            <thead>
              <tr>
                <th class="sortable text-center" data-col="date" style="width:140px">
                  Date <i class="bi bi-arrow-down-up sort-icon small opacity-50"></i>
                </th>
                <th class="sortable" data-col="title" style="min-width:200px">
                  Title <i class="bi bi-arrow-down-up sort-icon small opacity-50"></i>
                </th>
                <th style="min-width:200px">Summary / Publication</th>
                <th>Categories / Keywords</th>
                <th style="width:80px" class="text-center">Read</th>
              </tr>
            </thead>
            <tbody id="mielipiteet-tbody">
              {# Progressive enhancement: SSR renders 5 most recent opinion pieces.
                 JS replaces this opening set with ALL opinion pieces + filters. #}
              {% for pub in pageModel.openingOpinionItems %}
              {% set externalUrl = pub.url %}
              <tr>
                <td class="text-center text-nowrap small">{{ pub.date | dateFormat }}</td>
                <td>
                  <a href="{{ externalUrl }}"{% if pub.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ pub.title }}</a>
                </td>
                <td class="small text-muted">
                  {% if pub.description %}{{ pub.description | truncate(150) }}{% endif %}
                  {% if pub.publication %}<div class="small fst-italic mt-1">{{ pub.publication }}</div>{% endif %}
                </td>
                <td class="small">
                  {% for cat in (pub.categories or []) %}{% if loop.index0 < 3 %}<span class="badge text-bg-secondary me-1">{{ cat }}</span>{% endif %}{% endfor %}
                </td>
                <td class="text-center"><a href="{{ externalUrl }}"{% if pub.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %} class="btn btn-outline-primary btn-sm rounded-pill px-2" aria-label="{{ pub.title | escape }}"><i class="bi bi-arrow-right"></i></a></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer bg-transparent d-flex flex-wrap align-items-center justify-content-between gap-2 border-top">
        <small id="mielipiteet-info" class="text-muted"></small>
        <nav aria-label="Opinion pieces pagination">
          <ul id="mielipiteet-pagination" class="pagination pagination-sm mb-0 flex-wrap"></ul>
        </nav>
      </div>
    </div>
  </div>
</section>

