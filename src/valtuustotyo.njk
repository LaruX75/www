{# VALTUUSTOTYO-SSR-01: JS layer only handles user interaction
   (search/filter/sort/pagination) over the SSR rows above. No fetch,
   no innerHTML row construction, no runtime JSON. If JS is disabled,
   all rows above stay visible; only filter/sort/paginate degrade. #}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const PAGE_SIZE = 5;

  function makeArchive({ sectionId, tbodyId, infoId, pagUlId, tableSelector, searchId, yearId, meetingId, resetId, rowSelector, emptySelector, initialSort }) {
    const tbody = document.getElementById(tbodyId);
    const info = document.getElementById(infoId);
    const pagUl = document.getElementById(pagUlId);
    if (!tbody || !info) return;
    const rowsAll = Array.from(tbody.querySelectorAll(rowSelector));
    if (!rowsAll.length) return;
    const empty = tbody.querySelector(emptySelector);
    const searchInp = document.getElementById(searchId);
    const yearSel = document.getElementById(yearId);
    const meetingSel = meetingId ? document.getElementById(meetingId) : null;
    const resetBtn = document.getElementById(resetId);

    // Preserve SSR canonical order as the "reset" reference.
    const canonicalOrder = rowsAll.slice();

    let sortCol = initialSort.col;
    let sortDir = initialSort.dir; // -1 = desc, 1 = asc
    let currentPage = 1;
    let filtered = canonicalOrder.slice();

    function readDate(el) {
      return el.dataset.date || el.dataset.meetingDate || '';
    }

    function applyFilters() {
      const q = (searchInp?.value || '').toLowerCase().trim();
      const year = yearSel?.value || '';
      const meeting = meetingSel?.value || '';
      filtered = canonicalOrder.filter((row) => {
        if (q && !(row.dataset.searchText || '').includes(q)) return false;
        if (year && row.dataset.year !== year) return false;
        if (meeting && row.dataset.meeting !== meeting) return false;
        return true;
      });
      applySort();
      currentPage = 1;
      render();
    }

    function applySort() {
      const col = sortCol;
      const dir = sortDir;
      filtered.sort((a, b) => {
        if (col === 'title') {
          const cmp = String(a.dataset.title || '').localeCompare(String(b.dataset.title || ''), 'fi');
          if (cmp !== 0) return cmp * dir;
          return (readDate(b) || '').localeCompare(readDate(a) || '');
        }
        if (col === 'date' || col === 'meetingDate') {
          const av = col === 'meetingDate' ? (a.dataset.meetingDate || a.dataset.date || '') : (a.dataset.date || '');
          const bv = col === 'meetingDate' ? (b.dataset.meetingDate || b.dataset.date || '') : (b.dataset.date || '');
          if (av !== bv) return (av > bv ? 1 : -1) * dir;
          const t = String(a.dataset.title || '').localeCompare(String(b.dataset.title || ''), 'fi');
          if (t !== 0) return t;
          return String(a.dataset.url || '').localeCompare(String(b.dataset.url || ''));
        }
        return 0;
      });
    }

    function toggleSort(col) {
      if (sortCol === col) {
        sortDir *= -1;
      } else {
        sortCol = col;
        sortDir = (col === 'date' || col === 'meetingDate') ? -1 : 1;
      }
      applySort();
      currentPage = 1;
      render();
    }

    function render() {
      // Reorder DOM: detach all rows, append in filtered order, hide out-of-page rows.
      // Also toggle empty state.
      canonicalOrder.forEach((row) => { row.classList.add('d-none'); });
      if (empty) empty.classList.add('d-none');

      if (filtered.length === 0) {
        if (empty) empty.classList.remove('d-none');
      } else {
        const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        const start = (currentPage - 1) * PAGE_SIZE;
        const pageSlice = filtered.slice(start, start + PAGE_SIZE);
        // Reorder DOM only when needed (sort or filter changed the order).
        pageSlice.forEach((row) => {
          row.classList.remove('d-none');
          tbody.appendChild(row);
        });
      }

      const total = filtered.length;
      const from = total === 0 ? 0 : (currentPage - 1) * PAGE_SIZE + 1;
      const to = Math.min(currentPage * PAGE_SIZE, total);
      info.textContent = 'Näytetään ' + from + '–' + to + ' / ' + total;

      const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      if (pagUl && typeof window.renderPaginationShared === 'function') {
        window.renderPaginationShared(pagUl, totalPages, currentPage, function (p) {
          currentPage = p;
          render();
          document.getElementById(sectionId)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      const table = document.querySelector(tableSelector);
      if (table) {
        table.querySelectorAll('th.sortable').forEach((th) => {
          th.classList.remove('sort-asc', 'sort-desc');
          if (th.dataset.col === sortCol) {
            th.classList.add(sortDir === 1 ? 'sort-asc' : 'sort-desc');
          }
        });
      }
    }

    if (searchInp) searchInp.addEventListener('input', applyFilters);
    if (yearSel) yearSel.addEventListener('change', applyFilters);
    if (meetingSel) meetingSel.addEventListener('change', applyFilters);
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInp) searchInp.value = '';
        if (yearSel) yearSel.value = '';
        if (meetingSel) meetingSel.value = '';
        applyFilters();
      });
    }
    const table = document.querySelector(tableSelector);
    if (table) {
      table.querySelectorAll('th.sortable').forEach((th) => {
        th.addEventListener('click', () => toggleSort(th.dataset.col));
      });
    }

    // Initial render — SSR order is already canonical; JS only hides
    // rows beyond page 1 and sets up interactivity.
    applySort();
    render();
  }

  makeArchive({
    sectionId: 'puheet',
    tbodyId: 'puheet-tbody',
    infoId: 'puheet-info',
    pagUlId: 'puheet-pagination',
    tableSelector: '.puheet-table',
    searchId: 'puheet-search',
    yearId: 'puheet-year',
    meetingId: 'puheet-meeting',
    resetId: 'puheet-reset',
    rowSelector: '[data-council-row]',
    emptySelector: '[data-council-empty]',
    initialSort: { col: 'date', dir: -1 }
  });

  makeArchive({
    sectionId: 'aloitteet',
    tbodyId: 'aloitteet-tbody',
    infoId: 'aloitteet-info',
    pagUlId: 'aloitteet-pagination',
    tableSelector: '.aloitteet-table',
    searchId: 'aloitteet-search',
    yearId: 'aloitteet-year',
    meetingId: null,
    resetId: 'aloitteet-reset',
    rowSelector: '[data-initiative-row]',
    emptySelector: '[data-initiative-empty]',
    initialSort: { col: 'meetingDate', dir: -1 }
  });

  // Mobile responsive: sync data-label for pub-tables.
  function syncMobileTableLabels() {
    document.querySelectorAll('.pub-table').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th')).map((th) => (th.dataset.mobileLabel || th.textContent || '')
        .replace(/Ei lajittelua|Pienin ensin|Suurin ensin|Uusin ensin|Vanhin ensin|A-ÖÖ-A/gi, '')
        .replace(/\s+/g, ' ')
        .trim());
      table.querySelectorAll('tbody tr').forEach((row) => {
        Array.from(row.children).forEach((cell, idx) => {
          if (cell.tagName !== 'TD') return;
          if (cell.hasAttribute('colspan')) { cell.setAttribute('data-label', ''); return; }
          cell.setAttribute('data-label', headers[idx] || '');
        });
      });
    });
  }
  syncMobileTableLabels();
});
</script>
