                <th style="min-width:200px">Tiivistelmä & Tyyppi</th>
                <th>Kategoriat & Avainsanat</th>
                <th style="width:80px" class="text-center">Lue</th>
              </tr>
            </thead>
            <tbody id="aloitteet-tbody">
              <tr><td colspan="5" class="text-center text-muted py-4">Ladataan aloitteita...</td></tr>
            </tbody>
