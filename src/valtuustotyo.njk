        <span class="badge kynasta-section-count">{{ collections.politics.length }}</span>
      </div>
      <div class="card-body p-0">
        {# ---- Suodatuspalkki ---- #}
        <div class="p-3 bg-body-tertiary border-bottom">
          <div class="row g-2 align-items-end">
            <div class="col-lg-7">
              <label for="aloitteet-search" class="form-label small text-muted mb-1">Hae valtuustoaloitteita</label>
              <input type="search" id="aloitteet-search" class="form-control form-control-sm"
                     placeholder="Hae otsikosta, tiivistelmästä, tyypistä, kategorioista..." autocomplete="off">
