---
layout: base.njk
title: Valtuustotyö — puheenvuorot ja aloitteet
description: "Jari Larun valtuustopuheenvuorot ja valtuustoaloitteet Oulun kaupunginvaltuustossa ja hyvinvointialueella. Aineisto koottu hakuun ja suodatukseen sopivaksi näkymäksi."
permalink: /valtuustotyo/
translationKey: writings_council
pageStyles:
  - /css/kynasta-page.css
schemaType: CollectionPage
schemaAbout:
  - "@type": "Thing"
    name: "Valtuustopuheenvuorot"
    description: "Puheenvuorot Oulun kaupunginvaltuuston ja hyvinvointialueen kokouksissa."
  - "@type": "Thing"
    name: "Valtuustoaloitteet"
    description: "Kirjalliset aloitteet päätöksenteon valmisteluun."
schemaMentions:
  - "@type": "GovernmentOrganization"
    name: "Oulun kaupunginvaltuusto"
    url: "https://www.ouka.fi/valtuusto"
  - "@type": "GovernmentOrganization"
    name: "Pohjois-Pohjanmaan hyvinvointialue"
    url: "https://pohde.fi/"
---
{% import "ui.njk" as ui %}
{% set statementItems = [] %}
{% for item in (collections.publications or []) %}
  {% if item.data.type == "lausunto" %}
    {% set _ = (statementItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set councilSpeechItems = [] %}
{% set publicSpeechItems = [] %}
{% for item in (collections.pub_puhe or []) %}
  {% set speechContext = item.data.speechContext or "" %}
  {% set forums = item.data.forum or [] %}
  {% if speechContext %}
    {% set isCouncilSpeech = speechContext == "valtuusto" or speechContext == "kyselytunti" %}
  {% else %}
    {% set isCouncilSpeech = item.data.event == "Oulun kaupunginvaltuusto" or forums.indexOf("Kaupunginvaltuusto") != -1 %}
  {% endif %}
  {% if isCouncilSpeech %}
    {% set _ = (councilSpeechItems.push(item), null) %}
  {% else %}
    {% set _ = (publicSpeechItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set latestSpeechHighlights = (councilSpeechItems or []).slice(0, 3) %}
{% set latestPublicSpeechHighlights = (publicSpeechItems or []).slice(0, 3) %}
{% set latestInitiativeHighlights = (collections.politics or []).slice(0, 3) %}
{% set latestBlogHighlights = (collections.blog or []).slice(0, 3) %}
{% set latestStatementHighlights = statementItems.slice(0, 3) %}
{% set latestOpinionHighlights = (collections.pub_mielipide or []).slice(0, 3) %}
{% set latestColumnHighlights = (collections.pub_kolumni or []).slice(0, 3) %}
{% set latestExpertOpinionHighlights = ((collections.pub_mielipide_expert or []) or []).slice(0, 3) %}
{% set speechCount = (collections.pub_puhe or []) | length %}
{% set councilSpeechCount = councilSpeechItems | length %}
{% set publicSpeechCount = publicSpeechItems | length %}
{% set initiativeCount = (collections.politics or []) | length %}
{% set statementCount = statementItems | length %}
{% set blogCount = (collections.blog or []) | length %}
{% set opinionCount = (collections.pub_mielipide or []) | length %}
{% set columnCount = (collections.pub_kolumni or []) | length %}
{% set politicalOpinionCount = (collections.pub_mielipide_political or []) | length %}
{% set expertOpinionCount = (collections.pub_mielipide_expert or []) | length %}
{% set hybridOpinionItems = [] %}
{% for item in (collections.pub_mielipide or []) %}
  {% set roles = item.data.opinionRoles or item.data.writingRoles or [] %}
  {% if roles.indexOf("political") != -1 and roles.indexOf("expert") != -1 %}
    {% set _ = (hybridOpinionItems.push(item), null) %}
  {% endif %}
{% endfor %}
{% set hybridOpinionCount = hybridOpinionItems | length %}
{% set decisionRouteCount = councilSpeechCount + initiativeCount + statementCount %}
{% set commentaryRouteCount = opinionCount + columnCount + blogCount %}
{% set expertRouteCount = statementCount + expertOpinionCount + publicSpeechCount %}

<section class="kynasta-hero py-3 py-lg-4">
  <div class="site-shell">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <p class="text-uppercase small text-muted mb-2">Valtuustotyö</p>
        <h1 class="display-6 fw-bold mb-2">Puheenvuorot ja aloitteet valtuustossa</h1>
        <p class="text-muted mb-3">Kaupunginvaltuuston puheenvuorot ja valtuustoaloitteet yhdellä sivulla: {{ councilSpeechCount }} valtuustopuhetta ja {{ initiativeCount }} aloitetta. Voit hakea, suodattaa ja lajitella niitä alla.</p>
        <div class="d-flex flex-wrap gap-2">
          <a class="nav-link" href="#puheet">Valtuustopuheet <span class="nav-count">{{ councilSpeechCount }}</span></a>
          <a class="nav-link" href="#aloitteet">Aloitteet <span class="nav-count">{{ initiativeCount }}</span></a>
        </div>
        <p class="small text-muted mt-3 mb-0">
          Etsitkö julkisia puheita, lausuntoja, blogia tai mielipidekirjoituksia? <a href="/kynasta/">Palaa Kynästä-hubiin</a> — löydät sieltä kaikki sisältölajit. Politiikan kokonaiskuva näkyy myös <a href="/politiikka/">Politiikka-sivulla</a>.
        </p>
      </div>
    </div>
  </div>
</section>







{# Kerätään kaikki aloitteet JSON-muotoon JS:ää varten #}
<script id="aloitteet-data" type="application/json">
[
  {% for item in collections.politics %}
  {% set itemMeetingDate = item.data.meetingDate or (item.date | isoDate) %}
  {
    "title": {{ item.data.title | jsonSafe | safe }},
    "date": "{{ item.date }}",
    "formattedDate": "{{ item.date | dateFormat }}",
    "meetingDate": "{{ itemMeetingDate | isoDate }}",
    "formattedMeetingDate": "{{ itemMeetingDate | dateFormat }}",
    "meeting": {{ (item.data.meeting or "") | jsonSafe | safe }},
    "description": {{ (item.data.description or "") | jsonSafe | safe }},
    "initiative_type": {{ (item.data.initiative_type or "") | jsonSafe | safe }},
    "url": "{{ item.data.url or item.url }}",
    "isExternal": {{ (item.data.url != null) | jsonSafe | safe }},
    "categories": {{ (item.data.categories or []) | jsonSafe | safe }},
    "keywords": {{ (item.data.keywords or []) | jsonSafe | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
]
</script>

<details class="kynasta-mobile-disclosure kynasta-archive-disclosure" data-kynasta-mobile-collapse>
  <summary class="kynasta-mobile-disclosure-summary">
    <span>Valtuustoaloitteet ja adressit</span>
    <small>{{ collections.politics.length }} aloitetta jätetty</small>
  </summary>
<section id="aloitteet">
  <div class="site-shell">
    <div class="card shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between kynasta-section-header">
        <h2 class="h4 mb-0"><i class="bi bi-megaphone-fill me-2"></i>Valtuustoaloitteet ja adressit</h2>
        <span class="badge kynasta-section-count">{{ collections.politics.length }}</span>
      </div>
      <div class="card-body p-0">
        {# ---- Suodatuspalkki ---- #}
        <div class="p-3 bg-body-tertiary border-bottom">
          <div class="row g-2 align-items-end">
            <div class="col-lg-7">
              <label for="aloitteet-search" class="form-label small text-muted mb-1">Hae valtuustoaloitteita</label>
              <input type="search" id="aloitteet-search" class="form-control form-control-sm"
                     placeholder="Hae otsikosta, tiivistelmästä, tyypistä, kategorioista..." autocomplete="off">
            </div>
            <div class="col-sm-5 col-lg-3">
              <label for="aloitteet-year" class="form-label small text-muted mb-1">Vuosi</label>
              <select id="aloitteet-year" class="form-select form-select-sm" aria-label="Rajaa valtuustoaloitteet vuoden mukaan"><option value="" selected>Kaikki vuodet</option></select>
            </div>
            <div class="col-sm-7 col-lg-2 d-flex justify-content-md-end gap-2">
              <button id="aloitteet-reset" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-circle me-1"></i>Tyhjennä
              </button>
            </div>
          </div>
        </div>

        {# ---- Taulukko ---- #}
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pub-table aloitteet-table" data-no-header-filters>
            <thead>
              <tr>
                <th class="sortable text-center" data-col="meetingDate" style="width:150px">
                  Kokouspvm <i class="bi bi-arrow-down-up sort-icon small opacity-50"></i>
                </th>
                <th class="sortable" data-col="title" style="min-width:200px">
                  Otsikko <i class="bi bi-arrow-down-up sort-icon small opacity-50"></i>
                </th>
                <th style="min-width:200px">Tiivistelmä & Tyyppi</th>
                <th>Kategoriat & Avainsanat</th>
                <th style="width:80px" class="text-center">Lue</th>
              </tr>
            </thead>
            <tbody id="aloitteet-tbody">
              <tr><td colspan="5" class="text-center text-muted py-4">Ladataan aloitteita...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
      {{ ui.paginationBar("aloitteet-info", "aloitteet-pagination", { extraClass: "card-footer bg-transparent kynasta-table-pager" }) }}
    </div>
  </div>
</section>
</details>

{# Kerätään kaikki puheet JSON-muotoon JS:ää varten #}
<script id="puheet-data" type="application/json">
[
  {% for pub in councilSpeechItems %}
  {% set resolvedUrl = pub.data.url or pub.url %}
  {% set councilMeta = oukaCouncilSpeechProtocols.overrides[resolvedUrl] or {} %}
  {% set resolvedEvent = councilMeta.event or pub.data.event or "" %}
  {% set resolvedAsiakohta = councilMeta.asiakohta or pub.data.asiakohta or "" %}
  {% set publicationDate = pub.date | isoDate %}
  {% set declaredMeetingDate = (pub.data.meetingDate or councilMeta.meetingDate or pub.date) | isoDate %}
  {% set publicationMeetingMeta = councilMeetingMeta.byDate[publicationDate] or {} %}
  {% set meetingDate = publicationMeetingMeta.timelineTitle and publicationDate or declaredMeetingDate %}
  {% set meetingMeta = councilMeetingMeta.byDate[meetingDate] or {} %}
  {% set protocolUrl = councilMeta.protocolUrl or (resolvedEvent == "Oulun kaupunginvaltuusto" and oukaCouncilSpeechProtocols.protocolsByDate[meetingDate]) %}
  {% set councilVideos = councilSpeechVideos.byUrl[resolvedUrl] or councilSpeechVideos.byUrl[pub.data.source_url] or [] %}
  {
    "title": {{ pub.data.title | jsonSafe | safe }},
    "date": "{{ pub.date }}",
    "formattedDate": "{{ pub.date | dateFormat }}",
    "description": {{ (pub.data.description or "") | jsonSafe | safe }},
    "event": {{ resolvedEvent | jsonSafe | safe }},
    "meetingNumber": {{ (meetingMeta.meetingNumber or "") | jsonSafe | safe }},
    "meetingLabel": {{ (meetingMeta.meetingNumber or meetingMeta.timelineTitle or "") | jsonSafe | safe }},
    "asiakohta": {{ resolvedAsiakohta | jsonSafe | safe }},
    "protocolUrl": {{ (protocolUrl or "") | jsonSafe | safe }},
    "councilVideos": {{ councilVideos | jsonSafe | safe }},
    "url": "{{ resolvedUrl }}",
    "isExternal": {{ (pub.data.url != null) | jsonSafe | safe }},
    "speechContext": {{ (pub.data.speechContext or "") | jsonSafe | safe }},
    "categories": {{ (pub.data.categories or []) | jsonSafe | safe }},
    "keywords": {{ (pub.data.keywords or []) | jsonSafe | safe }},
    "tags": {{ (pub.data.tags or []) | jsonSafe | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
]
</script>

