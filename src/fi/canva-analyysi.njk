---
title: "Canva-esitysten analyysi"
permalink: /esitykset/canva-analyysi/
layout: base.njk
lang: fi
description: "Datavetoinen analyysi Canva-esityksistä – teemat, kehityskaaret ja laajimmat esitykset."
templateEngineOverride: njk
pageScopeClass: presentation-analysis-page
---

{# Data-lähde: src/_data/canva-analyse.json (Vaihe 4). Loaderi: src/_data/canvaAnalyse.js #}
{% set a = canvaAnalyse %}
{% set esityksia = a.coverage.siteRecords or 0 %}
{% set diaaYht = a.stats.totalSlides or 0 %}
{% set vuosiEka = a.stats.years.first %}
{% set vuosiViim = a.stats.years.last %}
{% set vuosiSpan = a.stats.years.span or 0 %}
{% set kokoRange = vuosiEka + "–" + vuosiViim %}
{% set fiCount = a.kielet.total.fi or 0 %}
{% set enCount = a.kielet.total.en or 0 %}
{% set fiEnCount = a.kielet.total["fi-en"] or 0 %}
{% set fiPercent = ((fiCount / esityksia) * 100) | round %}
{% set aktiivisin = a.vuosistat | sort(true, false, "count") | first %}

<section class="py-5 bg-body-tertiary border-bottom presentation-analysis-hero">
  <div class="site-shell">
    <p class="text-uppercase text-muted fw-semibold small mb-2">Esitykset &rsaquo; Canva</p>
    <h1 class="display-6 fw-bold mb-3">Canva-esitykset {{ kokoRange }}</h1>
    <p class="lead mb-3">Analyysi {{ esityksia }} esityksestä – tekoälylukutaidon vuosikymmen kouluttajan, tutkijan ja kansainvälisen asiantuntijan näkökulmasta.</p>
    <div class="d-flex flex-wrap gap-2">
      <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">{{ esityksia }} esitystä</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">{{ diaaYht }} diaa</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">{{ vuosiSpan }} vuotta</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">{{ aktiivisin.year }} aktiivisin ({{ aktiivisin.count }} kpl)</span>
      <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">{{ fiPercent }} % suomenkielisiä</span>
      <a href="https://www.canva.com/" target="_blank" rel="noopener noreferrer" class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle text-decoration-none">Canva-profiili <i class="bi bi-arrow-up-right ms-1"></i></a>
    </div>
  </div>
</section>

<nav class="presentation-analysis-mobile-path" aria-label="Canva-analyysin tärkeimmät kohdat">
  <div class="site-shell">
    <a href="#kaudet">Kaudet</a>
    <a href="#langat">Punaiset langat</a>
    <a href="#laajimmat">Laajimmat</a>
    <a href="#aihepiirit">Aihepiirit</a>
    <a href="#vertailu">Vertailu</a>
  </div>
</nav>

{# KPI-kortit #}
<section class="py-5 border-bottom canva-analysis-kpi">
  <div class="site-shell">
    <div class="row g-3 mb-2">
      <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm text-center p-3 analysis-card">
          <div class="display-6 fw-bold text-primary mb-1">{{ esityksia }}</div>
          <div class="text-muted small">esitystä</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm text-center p-3 analysis-card">
          <div class="display-6 fw-bold text-primary mb-1">{{ diaaYht }}</div>
          <div class="text-muted small">diaa yhteensä</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm text-center p-3 analysis-card">
          <div class="display-6 fw-bold text-primary mb-1">{{ fiPercent }} %</div>
          <div class="text-muted small">suomenkielisiä</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card h-100 border-0 shadow-sm text-center p-3 analysis-card">
          <div class="display-6 fw-bold text-primary mb-1">{{ aktiivisin.year }}</div>
          <div class="text-muted small">aktiivisin vuosi ({{ aktiivisin.count }} kpl)</div>
        </div>
      </div>
    </div>
  </div>
</section>

{# Kaudet — datalähtöisesti a.kaudet-taulukosta #}
{% set kausiVarit = ["bg-primary", "bg-success", "bg-warning text-dark", "bg-info text-dark"] %}
<section class="py-5 border-bottom canva-analysis-phase" id="kaudet">
  <div class="site-shell">
    <h2 class="h3 fw-bold mb-4">{{ a.kaudet | length }} kautta</h2>
    <div class="row g-4">

      {% for kausi in a.kaudet %}
      {% set variantti = kausiVarit[loop.index0 % kausiVarit | length] %}
      <div class="col-md-6 col-lg-{{ (12 / (a.kaudet | length)) | round }}">
        <div class="card h-100 border-0 shadow-sm analysis-card">
          <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="badge {{ variantti }} fs-6 px-3 py-2">{{ kausi.years }}</span>
              <span class="text-muted small">{{ kausi.count }} esitystä</span>
            </div>
            <h3 class="h5 fw-bold mb-2">{{ kausi.name }}</h3>
            <p class="text-muted small mb-0">{{ kausi.summary }}</p>
          </div>
          <div class="card-footer bg-transparent border-0 p-4 pt-0">
            <div class="d-flex gap-2 flex-wrap">
              {% for teema in kausi.keyThemes %}
              <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ teema }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
      {% endfor %}

    </div>
  </div>
</section>

{# Punaiset langat — datalähtöisesti a.punaisetLangat-taulukosta #}
{% set langaIkonit = ["bi-graph-up-arrow", "bi-eye", "bi-shield-check", "bi-globe", "bi-people", "bi-book"] %}
<section class="py-5 border-bottom bg-body-tertiary" id="langat">
  <div class="site-shell">
    <h2 class="h3 fw-bold mb-4">Punaiset langat läpi kaikkien kausien</h2>
    <div class="row g-4">
      {% for lanka in a.punaisetLangat %}
      {% set ikoni = langaIkonit[loop.index0 % langaIkonit | length] %}
      <div class="col-md-6">
        <div class="d-flex gap-3 analysis-thread-item">
          <div class="flex-shrink-0 text-primary" style="font-size:1.5rem;"><i class="bi {{ ikoni }}"></i></div>
          <div>
            <h3 class="h6 fw-bold mb-1">{{ lanka.name }}</h3>
            <p class="text-muted small mb-0">{{ lanka.description }}{% if lanka.spanning %} <span class="text-body-tertiary">[{{ lanka.spanning }}]</span>{% endif %}</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Top 10 — datalähtöisesti a.laajimmat-taulukosta #}
{% set vuosiVarit = {"2023": "bg-secondary", "2024": "bg-success", "2025": "bg-primary", "2026": "bg-warning text-dark"} %}
<section class="py-5 border-bottom" id="laajimmat">
  <div class="site-shell">
    <h2 class="h3 fw-bold mb-4">Laajimmat esitykset</h2>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th style="width:2.5rem">#</th>
            <th>Otsikko</th>
            <th style="width:5rem" class="text-center">Vuosi</th>
            <th style="width:7rem" class="text-end">Dioja</th>
            <th>Teemat</th>
          </tr>
        </thead>
        <tbody>
          {% for esitys in a.laajimmat %}
          {% set vuosiBadge = vuosiVarit[esitys.year | string] or "bg-secondary" %}
          <tr>
            <td class="text-muted fw-bold">{{ loop.index }}</td>
            <td>{{ esitys.title }}</td>
            <td class="text-center"><span class="badge {{ vuosiBadge }}">{{ esitys.year }}</span></td>
            <td class="text-end fw-bold">{{ esitys.slideCount }}</td>
            <td class="text-muted small">{{ esitys.themes | join(", ") }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="text-muted small mt-2"><i class="bi bi-info-circle me-1"></i>Keskimääräinen esitys on {{ a.stats.slideCountAvg }} diaa (mediaani {{ a.stats.slideCountMedian }}) — huomattavasti enemmän kuin SlideShare-kaudella.</p>
  </div>
</section>

{# Aihepiirit — datalähtöisesti a.aihepiirit-frekvensseistä #}
<section class="py-5 border-bottom bg-body-tertiary" id="aihepiirit">
  <div class="site-shell">
    <h2 class="h3 fw-bold mb-4">Aihepiirit korpuksessa</h2>
    <p class="text-muted small mb-4">{{ a.aihepiirit | length }} eri teemaa {{ esityksia }} esityksessä. Alla top-{{ a.aihepiirit | length if a.aihepiirit | length < 20 else 20 }} yleisyyden mukaan; jokaisen perässä esiintymisvuodet.</p>
    <div class="row g-2">
      {% for aihe in a.aihepiirit | take(20) %}
      <div class="col-12 col-md-6">
        <div class="d-flex gap-3 align-items-start py-2 analysis-year-item">
          <span class="badge bg-secondary flex-shrink-0" style="min-width:3.5rem;text-align:center;">{{ aihe.count }}</span>
          <span class="text-muted small">
            <strong>{{ aihe.theme }}</strong>
            {% set yearParts = [] %}
            {% for y, n in aihe.years %}{% set _ = yearParts.push(y + ":" + n) %}{% endfor %}
            <span class="text-body-tertiary">({{ yearParts | join(", ") }})</span>
            {% if aihe.tulkinta %}<br><span class="d-block mt-1">{{ aihe.tulkinta }}</span>{% endif %}
          </span>
        </div>
      </div>
      {% endfor %}
    </div>
    {% if a.aihepiirit | length > 20 %}
    <p class="text-muted small mt-3">Muut {{ a.aihepiirit | length - 20 }} teemaa: {% for aihe in a.aihepiirit | skip(20) %}{{ aihe.theme }} ({{ aihe.count }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {% endif %}
  </div>
</section>

{# SlideShare-vertailu — datalähtöisesti a.vertailuSlideShare-objektista #}
<section class="py-5 border-bottom" id="vertailu">
  <div class="site-shell">
    <h2 class="h3 fw-bold mb-4">SlideShare-kaudesta Canva-kauteen</h2>
    {% if a.vertailuSlideShare.ero %}
    <p class="lead mb-4">{{ a.vertailuSlideShare.ero }}</p>
    {% endif %}
    <div class="row g-4">
      {% if a.vertailuSlideShare.jatkuvuudet %}
      <div class="col-md-4">
        <div class="d-flex gap-3 analysis-thread-item h-100">
          <div class="flex-shrink-0 text-primary" style="font-size:1.5rem;"><i class="bi bi-arrow-repeat"></i></div>
          <div>
            <h3 class="h6 fw-bold mb-2">Jatkuvuudet</h3>
            <ul class="text-muted small mb-0 ps-3">
              {% for item in a.vertailuSlideShare.jatkuvuudet %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {% endif %}
      {% if a.vertailuSlideShare.uudet %}
      <div class="col-md-4">
        <div class="d-flex gap-3 analysis-thread-item h-100">
          <div class="flex-shrink-0 text-primary" style="font-size:1.5rem;"><i class="bi bi-plus-circle"></i></div>
          <div>
            <h3 class="h6 fw-bold mb-2">Uudet Canva-kaudella</h3>
            <ul class="text-muted small mb-0 ps-3">
              {% for item in a.vertailuSlideShare.uudet %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {% endif %}
      {% if a.vertailuSlideShare.vaimenevat %}
      <div class="col-md-4">
        <div class="d-flex gap-3 analysis-thread-item h-100">
          <div class="flex-shrink-0 text-primary" style="font-size:1.5rem;"><i class="bi bi-arrow-down-circle"></i></div>
          <div>
            <h3 class="h6 fw-bold mb-2">Vaimenevat</h3>
            <ul class="text-muted small mb-0 ps-3">
              {% for item in a.vertailuSlideShare.vaimenevat %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
    <p class="text-muted small mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Vertailu perustuu Canva-korpuksen richSummary-analyysiin ja aiempaan SlideShare-analyysiin (2009–2020).</p>
  </div>
</section>

{# CTA alareuna #}
<section class="py-5">
  <div class="site-shell">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <h2 class="h4 fw-bold mb-1">Kaikki esitykset</h2>
          <p class="text-muted mb-0">Selaa kaikkia Canva-esityksiä esityssivulla.</p>
        </div>
        <a href="/esitykset/#canva-heading" class="btn btn-primary px-4">
          <i class="bi bi-collection-play me-2"></i>Esitykset-sivu
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.analysis-card {
  border-radius: 0.9rem;
}

.analysis-thread-item,
.analysis-year-item {
  padding: 0.75rem;
  border: 1px solid var(--bs-border-color);
  border-radius: 0.75rem;
  background: var(--bs-body-bg);
  height: 100%;
}

@media (min-width: 992px) {
  .canva-analysis-phase .analysis-card .card-body {
    min-height: 270px;
  }
}
</style>
