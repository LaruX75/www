<script>
  // /mediassa/-selaus: dataa ladataan async /data/media.json:sta ja
  // renderoidaan client-side. Ennen tata SSR-renderoi kaikki 72 korttia
  // (~160 KB HTML) jonka JS suodatti DOM:ssa. Nyt kortit tulevat JSON:sta,
  // sama suodatuslogiikka.
  document.addEventListener('DOMContentLoaded', async () => {
    const browser = document.querySelector('[data-media-browser]');
    if (!browser) return;

    const cardGrid = browser.querySelector('[data-media-card-grid]');
    const controls = Array.from(browser.querySelectorAll('[data-media-filter]'));
    const jumpControls = Array.from(document.querySelectorAll('[data-media-jump-filter]'));
    const pagination = browser.querySelector('[data-media-page-controls]');
    const pageInfo = browser.querySelector('[data-media-page-info]');
    const status = browser.querySelector('[data-media-browser-status]');
    const desktopPageSize = Number(browser.dataset.pageSize) || 9;
    const mobilePageSize = Number(browser.dataset.mobilePageSize) || Math.min(desktopPageSize, 4);
    const mobilePageSizeMq = window.matchMedia('(max-width: 767.98px)');
    const getPageSize = () => mobilePageSizeMq.matches ? mobilePageSize : desktopPageSize;
    let activeFilter = 'all';
    let currentPage = 1;
    let allItems = [];

    const topicAliases = {
      politiikka: ['politiikka', 'kuntapolitiikka', 'valtuusto', 'vaalit', 'päätöksenteko', 'paatoksenteko', 'kampusratkaisu', 'palveluverkko'],
      tekoaly: ['tekoäly', 'tekoaly', 'tekoälylukutaito', 'tekoalylukutaito', 'chatgpt', 'generation ai', 'koulutusteknologia', 'digipedagogiikka', 'opetus'],
      avoin: ['avoin tiede', 'avoimuus', 'avoin oppiminen', 'avoimet oppimateriaalit'],
      paikallinen: ['oulu', 'jääli', 'jaali', 'kiiminki', 'rantapohja', 'munoulu', 'kaupunginosa', 'paikallisuus', 'asukas']
    };

    // Rakennetaan indexoinnit haku- ja suodatusnopeutta varten
    function normalizeItem(item) {
      const categories = item.categories || [];
      const keywords = item.keywords || [];
      const topicText = [
        ...categories, ...keywords, item.title || '', item.description || ''
      ].join(' ').toLowerCase();
      return { ...item, _topicText: topicText };
    }

    async function loadData() {
      try {
        const res = await fetch('/data/media.json');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        return (Array.isArray(data.items) ? data.items : []).map(normalizeItem);
      } catch (e) {
        console.error('mediassa: fetch /data/media.json failed:', e);
        return [];
      }
    }

    const escHtml = (v) => String(v || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

    const _fiDateFormatter = new Intl.DateTimeFormat('fi-FI', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
    const fmtDate = (iso) => iso ? _fiDateFormatter.format(new Date(iso)) : '';

    const MEDIA_TYPE_LABELS = {
      article: 'Lehtijuttu', podcast: 'Podcast', video: 'Video',
      radio: 'Radio', tv: 'TV', assignment: 'Asiantuntijatehtävä'
    };
    const MEDIA_ROLE_LABELS = {
      about: 'Minusta tehty', guest: 'Vieraana',
      interviewer: 'Haastattelijana', expertAssignment: 'Asiantuntijarooli'
    };

    function renderMediaThumb(item) {
      if (!item.thumbnail) {
        return '<span class="media-thumb media-thumb--empty"><i class="bi bi-newspaper" aria-hidden="true"></i></span>';
      }
      const isVideo = item.mediaType === 'video'
        || (item.sourceUrl && (item.sourceUrl.includes('youtube.com') || item.sourceUrl.includes('youtu.be')));
      const cls = 'media-thumb' + (isVideo ? ' video-preview video-preview--sm' : '');
      return `<span class="${cls}"><img src="${escHtml(item.thumbnail)}" alt="${escHtml(item.title)}" loading="lazy" decoding="async"></span>`;
    }

    function renderCard(item) {
      const externalUrl = item.sourceUrl || item.url;
      const meta = [
        `<span>${escHtml(MEDIA_TYPE_LABELS[item.mediaType] || item.mediaType || '')}</span>`,
        `<span>${escHtml(MEDIA_ROLE_LABELS[item.mediaRole] || item.mediaRole || '')}</span>`,
        item.mediaOutlet ? `<span>${escHtml(item.mediaOutlet)}</span>` : '',
        item.date ? `<span>${escHtml(fmtDate(item.date))}</span>` : ''
      ].filter(Boolean).join('');
      const categories = (item.categories || []).slice(0, 4)
        .map(c => `<span>${escHtml(c)}</span>`).join('');
      const description = item.description
        ? `<p>${escHtml(item.description)}</p>` : '';
      return `
        <article class="media-archive-card"
          data-media-card
          data-media-type="${escHtml(item.mediaType || '')}"
          data-media-role="${escHtml(item.mediaRole || '')}">
          <a href="${escHtml(externalUrl)}" target="_blank" rel="noopener noreferrer" class="media-archive-thumb-link">
            ${renderMediaThumb(item)}
          </a>
          <div class="media-archive-card-body">
            <div class="media-meta-row media-meta-row--small">${meta}</div>
            <h3><a href="${escHtml(externalUrl)}" target="_blank" rel="noopener noreferrer">${escHtml(item.title)}</a></h3>
            ${description}
            ${categories ? `<div class="media-topic-row">${categories}</div>` : ''}
            <div class="media-card-actions">
              <a href="${escHtml(externalUrl)}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill px-3">Avaa lähde</a>
              <a href="${escHtml(item.url)}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Lisätiedot</a>
            </div>
          </div>
        </article>`;
    }

    const matchesFilter = (item) => {
      if (activeFilter === 'all') return true;
      const [kind, value] = activeFilter.split(':');
      if (kind === 'type') return item.mediaType === value;
      if (kind === 'role') return item.mediaRole === value;
      if (kind === 'topic') {
        return (topicAliases[value] || [value]).some((needle) => item._topicText.includes(needle));
      }
      return true;
    };

    const filteredItems = () => allItems.filter(matchesFilter);

    const updateControls = () => {
      controls.forEach((control) => {
        const isActive = control.dataset.mediaFilter === activeFilter;
        control.classList.toggle('is-active', isActive);
        control.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    const renderPagination = (pageCount) => {
      if (!pagination) return;
      pagination.innerHTML = '';
      if (pageCount <= 1) return;

      for (let page = 1; page <= pageCount; page += 1) {
        const li = document.createElement('li');
        li.className = `page-item${page === currentPage ? ' active' : ''}`;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'page-link';
        button.dataset.mediaPage = String(page);
        button.setAttribute('aria-label', `Sivu ${page}`);
        button.textContent = String(page);
        li.appendChild(button);
        pagination.appendChild(li);
      }
    };

    const render = () => {
      const visibleItems = filteredItems();
      const pageSize = getPageSize();
      const pageCount = Math.max(1, Math.ceil(visibleItems.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const start = (currentPage - 1) * pageSize;
      const end = start + pageSize;
      const pageItems = visibleItems.slice(start, end);

      if (cardGrid) {
        cardGrid.innerHTML = pageItems.map(renderCard).join('');
        cardGrid.removeAttribute('aria-busy');
      }

      const shownStart = visibleItems.length ? start + 1 : 0;
      const shownEnd = Math.min(end, visibleItems.length);
      if (status) {
        status.textContent = visibleItems.length === 1
          ? 'Löytyi 1 mediaosuma.'
          : `Löytyi ${visibleItems.length} mediaosumaa.`;
      }
      if (pageInfo) {
        pageInfo.textContent = visibleItems.length
          ? `Näytetään ${shownStart}-${shownEnd} / ${visibleItems.length}`
          : 'Tällä suodattimella ei löytynyt mediaosumia.';
      }

      updateControls();
      renderPagination(pageCount);
    };

    const setFilter = (filter, shouldScroll = false) => {
      activeFilter = filter || 'all';
      currentPage = 1;
      render();
      if (shouldScroll) {
        document.getElementById('media-arkisto')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    const filterFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const type = params.get('type');
      const role = params.get('role');
      const topic = params.get('topic');
      if (type) return `type:${type}`;
      if (role) return `role:${role}`;
      if (topic) return `topic:${topic}`;
      return 'all';
    };

    controls.forEach((control) => {
      control.setAttribute('aria-pressed', control.classList.contains('is-active') ? 'true' : 'false');
      control.addEventListener('click', () => setFilter(control.dataset.mediaFilter));
    });

    jumpControls.forEach((control) => {
      control.addEventListener('click', () => setFilter(control.dataset.mediaJumpFilter, true));
    });

    pagination?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-media-page]');
      if (!button) return;
      const nextPage = Number(button.dataset.mediaPage);
      if (!Number.isFinite(nextPage) || nextPage === currentPage) return;
      currentPage = nextPage;
      render();
    });

    if (typeof mobilePageSizeMq.addEventListener === 'function') {
      mobilePageSizeMq.addEventListener('change', () => {
        currentPage = 1;
        render();
      });
    } else if (typeof mobilePageSizeMq.addListener === 'function') {
      mobilePageSizeMq.addListener(() => {
        currentPage = 1;
        render();
      });
    }

    // Aloitus: hae data ja renderoi
    allItems = await loadData();
    setFilter(filterFromUrl(), window.location.search.length > 0);
  });
</script>
