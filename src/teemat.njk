---js
{
  layout: "base.njk",
  eleventyComputed: {
    title: data => `${data.topic?.title || "Teemaprofiili"}`,
    description: data => data.topic?.description || data.topic?.lead || "Jari Larun sivuston teemaprofiili.",
    robots: () => "index, follow"
  },
  pagination: {
    data: "seoTopics",
    size: 1,
    alias: "topic"
  },
  permalink: data => `/teemat/${data.topic.slug}/`
}
---
{# v4.3 PR-2: haetaan suurempi topicItems-joukko (60), ryhmitellaan
   sisaltotyypeittain (per ryhma 5 kpl, ohitetaan tyhjat). Vanhat
   featuredItems (4) + archiveItems (10) korvattu ryhmilla. #}
{% set topicItems = collections | topicItems(topic, 60) %}
{% set groupedTopicSections = topicItems | groupByContentType({ perGroupLimit: 5, lang: "fi" }) %}
{% set researchPublications = researchfiContent | curatedResearchForTopic(topic.researchThemes, 3) %}
{% set topicContentCount = topicItems.totalCount + researchPublications.length %}

<section class="topic-profile">
  <div class="site-shell">
    <header class="topic-profile-hero">
      <div class="topic-profile-hero-main">
        <p class="taxonomy-kicker">{{ topic.eyebrow }}</p>
        <h1>{{ topic.title }}</h1>
        <p class="topic-profile-lead">{{ topic.lead }}</p>
        <p class="topic-profile-context">{{ topic.context }}</p>
        <div class="topic-profile-actions">
          <a class="btn btn-primary" href="#naytto">Katso sisältönostot</a>
          <a class="btn btn-outline-primary" href="/teemat/">Kaikki teemaprofiilit</a>
        </div>
      </div>
      <aside class="topic-profile-summary">
        <span class="taxonomy-stat-number">{{ topicContentCount }}</span>
        <span class="taxonomy-stat-label">aiheeseen liittyvää sisältöä</span>
        <span class="taxonomy-stat-range">eri aineistoista</span>
      </aside>
    </header>

    {% if topic.linkedPolitics and topic.linkedPolitics.length %}
    <aside class="topic-profile-callout" aria-labelledby="topic-linked-politics-title">
      <div>
        <p class="taxonomy-kicker">Syvempää taustoitusta</p>
        <h2 id="topic-linked-politics-title">Poliittinen päälinja aiheesta</h2>
        <p>Kuratoitu aikajana ja argumentaation kaari — vain keskeiset teot ja niiden perustelut.</p>
      </div>
      <div class="topic-profile-link-row">
        {% for link in topic.linkedPolitics %}
          <a class="btn btn-outline-primary" href="{{ link.href }}">{{ link.label }} →</a>
        {% endfor %}
      </div>
    </aside>
    {% endif %}

    <section class="topic-profile-section topic-profile-promise" aria-labelledby="topic-promise-title">
      <div>
        <p class="taxonomy-kicker">Mitä tästä saa irti?</p>
        <h2 id="topic-promise-title">{{ topic.promise }}</h2>
      </div>
      <div class="topic-profile-link-row">
        {% for link in topic.primaryLinks %}
          <a href="{{ link.href }}">{{ link.label }}</a>
        {% endfor %}
      </div>
    </section>

    {% if researchPublications.length %}
    <section class="topic-profile-section topic-research-section" aria-labelledby="topic-research-title">
      <div class="topic-profile-section-head">
        <p class="taxonomy-kicker">Tutkimusjulkaisut</p>
        <h2 id="topic-research-title">Valittuja tutkimusjulkaisuja</h2>
        <p>Toimitettu tutkimusnäyttö tästä aiheesta. Viitteet avautuvat julkaisuarkiston oikeaan kohtaan.</p>
      </div>
      <div class="topic-research-list">
        {% for publication in researchPublications %}
        <article class="topic-research-item">
          <p class="topic-research-meta">Research.fi · {{ publication.year or "—" }}</p>
          <h3><a href="{{ publication.url }}">{{ publication.title }}</a></h3>
          {% if publication.researchSummary %}
          <p class="topic-research-summary">{{ publication.researchSummary }}</p>
          {% endif %}
          <p class="topic-research-citation">{{ (publication.csl | publicationCitation("apa")) or publication.citation }}</p>
          <a class="topic-research-link" href="{{ publication.url }}">Avaa lähdeviite julkaisuarkistossa</a>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# v4.3 PR-2: sisaltotyyppikohtaiset ryhmat korvaavat aiempaan featured
       + archive -jaon. Ryhmat renderoidaan CONTENT_TYPE_GROUP_ORDER:in
       jarjestyksessa; tyhjia ryhmia ei nayteta (nykyinen scoring
       + TOPIC_MIN_SCORE=5 suodattaa jo). #}
    {% if groupedTopicSections.length %}
    <section class="topic-profile-section topic-profile-section--groups" id="naytto" aria-labelledby="topic-groups-title">
      <div class="topic-profile-section-head">
        <p class="taxonomy-kicker">Näyttöä aiheesta</p>
        <h2 id="topic-groups-title">Aiheeseen liittyvät sisällöt</h2>
        <p>Ryhmiteltynä sisältötyypeittäin — kussakin ryhmässä relevanssin mukaan.</p>
      </div>

      {% for group in groupedTopicSections %}
      <section class="topic-profile-group topic-profile-group--{{ group.key }}" aria-labelledby="topic-group-{{ group.key }}-title">
        <header class="topic-profile-group-head">
          <h3 id="topic-group-{{ group.key }}-title" class="topic-profile-group-title">{{ group.label }}</h3>
          {% if group.totalCount > group.items.length %}
          <span class="topic-profile-group-count">{{ group.items.length }} / {{ group.totalCount }}</span>
          {% else %}
          <span class="topic-profile-group-count">{{ group.items.length }}</span>
          {% endif %}
        </header>
        <div class="topic-profile-group-list">
          {% for item in group.items %}
          <article class="topic-profile-list-item">
            <div>
              <span>{{ item.typeLabel }}{% if item.date %} · {{ item.date | dateFormat }}{% endif %}</span>
              <h4><a href="{{ item.url }}">{{ item.data.title }}</a></h4>
              {% if item.data.description %}
                <p class="topic-profile-item-desc">{{ item.data.description | truncate(180) }}</p>
              {% endif %}
            </div>
            {% if item.data.categories and item.data.categories.length %}
              <div class="topic-profile-terms">
                {% for category in item.data.categories | take(2) %}
                  <a href="/kategoriat/{{ category | slugify }}/">{{ category }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </article>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </section>
    {% endif %}
  </div>
</section>

{% set topicBaseUrl = site.url or "https://www.jarilaru.fi" %}
{% set topicPageUrl = page.url | absoluteUrl(topicBaseUrl) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ topic.title | jsonSafe | safe }},
  "description": {{ (topic.description or topic.lead) | jsonSafe | safe }},
  "url": {{ topicPageUrl | jsonSafe | safe }},
  "inLanguage": "fi-FI",
  "about": {
    "@type": "DefinedTerm",
    "name": {{ topic.title | jsonSafe | safe }},
    "description": {{ topic.lead | jsonSafe | safe }},
    "url": {{ topicPageUrl | jsonSafe | safe }},
    "keywords": {{ (topic.keywords or []) | jsonSafe | safe }}
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": {{ topicBaseUrl | jsonSafe | safe }}
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": {{ ("Sisällöt aiheesta " ~ topic.title) | jsonSafe | safe }},
    "numberOfItems": {{ topicItems.length }},
    "itemListElement": [
      {% for item in topicItems %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "item": {
          "@type": "CreativeWork",
          "name": {{ item.data.title | jsonSafe | safe }},
          "url": {{ (item.url | absoluteUrl(topicBaseUrl)) | jsonSafe | safe }},
          "encodingFormat": {{ item.typeLabel | jsonSafe | safe }}{% if item.date %},
          "datePublished": {{ (item.date | dateToRfc3339) | jsonSafe | safe }}{% endif %}{% if item.data.description %},
          "description": {{ item.data.description | jsonSafe | safe }}{% endif %}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>
