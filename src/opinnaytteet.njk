{# THESIS-HUB-02: standalone hub landing.
   No pagination on this page — the three subarchives own their own
   paginated routes:
     /opinnaytteet/gradut/       (ohjatut pro gradut)
     /opinnaytteet/kandit/       (ohjatut kandit)
     /opinnaytteet/tarkastetut/  (tarkastetut, ei ohjatut)
   Each section below renders the 5 newest items per group from the
   same canonical thesisDetails model those archives paginate — the
   invariant hub.first5 === archive.first5 must hold. #}
{% set pageModel = thesesFindExplorePage %}
{# THESIS-HUB-02 hub FE: complete canonical thesis set, no type/role pin.
   Searches across gradut + kandit + tarkastetut. Results render into
   the FE's own container (no external tbody). Reset clears results
   and the SSR 3 x 5 hub sections below remain the primary content. #}
{% set findExploreKind = "theses" %}
{% set findExploreScope = "fi" %}
{% set findExploreLang = "fi" %}
{% set findExploreSearchLanguage = "fi,en" %}
{% set findExploreEyebrow = "Find & Explore" %}
{% set findExploreTitle = "Hae opinnäytteistä" %}
{% set findExploreDescription = "Haku ulottuu koko canonical thesis -joukkoon: ohjatut pro gradut, ohjatut kandit ja tarkastetut työt yhtenä kokonaisuutena. Alempana olevat nostosectionit näkyvät vaikka haku olisi käynnissä; tyhjennys palauttaa perustilan." %}
{% set findExploreSearchLabel = "Hae otsikolla, tekijällä tai aiheella" %}
{% set findExplorePlaceholder = "Esim. tekoäly, opettajankoulutus, matematiikka, Riikonen..." %}
{% set findExploreYearLabel = "Vuosi" %}
{% set findExploreAllYearsLabel = "Kaikki vuodet" %}
{% set findExploreTopicLabel = "Aihe" %}
{% set findExploreAllTopicsLabel = "Kaikki aiheet" %}
{% set findExploreResetLabel = "Tyhjennä" %}
{% set findExploreMoreLabel = "Näytä lisää" %}
{% set findExploreInitialStatus = "Kirjoita hakusana. Alla olevat nostosectionit toimivat myös ilman hakua." %}
{% set findExploreNoScript = "Interaktiivinen haku vaatii JavaScriptin. Ryhmäkohtaiset arkistot ovat käytettävissä alempana ilman JavaScriptiä." %}
{% set findExploreHideTypeControl = true %}
{% set findExploreHideRoleControl = true %}
{% set findExploreHideYearControl = false %}
{% set findExploreYears = pageModel.years %}
{% set findExploreTopicOptions = pageModel.topicOptions %}
{% set hubMasters = thesisDetails.advisedMasters or [] %}
{% set hubBachelors = thesisDetails.advisedBachelors or [] %}
{% set hubReviewed = thesisDetails.reviewed or [] %}

